        .PAGE    'MACASM: MTU 6502 MACRO ASSEMBLER'
LIST    =       1       ;SPECIFI LIST==7 TO FORCE FULL LIST
        .LIST   LIST
; =============================================================================
; MACASM.ASM  -  MTU 6502 MACRO ASSEMBLER  VERSION 1.1
; =============================================================================
; COPYRIGHT 1981-1982 MICRO TECHNOLOGY UNLIMITED (MTU)
; AUTHOR: BRUCE D. CARBREY
; DATE:   21-OCT-1982
;
; TARGET CPU  : MOS TECHNOLOGY 6502
; HOST OS     : CODOS (MTU DISK OPERATING SYSTEM)
; ASSEMBLER   : CA65
;
; TWO-PASS ASSEMBLER
; ------------------
;   PASS 1 (P1_MAIN_LP):  SCANS EVERY SOURCE LINE, BUILDS THE SYMBOL
;     TABLE WITH PRELIMINARY VALUES, DOES NOT EMIT OBJECT CODE.  ADVANCES
;     THE LOCATION COUNTER FOR EACH INSTRUCTION/DIRECTIVE TO ESTABLISH
;     ADDRESSES.
;   PASS 2 (P2_MAIN_LP):  RE-READS EVERY SOURCE LINE, RESOLVES ALL
;     OPERANDS, EMITS OBJECT CODE VIA EM_B_PAS2/OBJ_WR_B,
;     AND WRITES THE ASSEMBLY LISTING.
;
; KNOWN BUGS / ISSUES
; -------------------
;   BUG-1  INIT_LN_WS:  'STA LISTING_BUF' SHOULD BE 'STA LISTING_BUF,X'.
;          AS WRITTEN, EVERY ITERATION OF THE CLEARING LOOP OVERWRITES THE
;          SAME BYTE (LISTING_BUF[0]) INSTEAD OF SWEEPING THE WHOLE BUFFER.
;          THIS BUG IS ALREADY ANNOTATED WITH 'FIXME' IN THE ORIGINAL SOURCE.
;
;   BUG-2  EM_B_PAS2:  WHEN PASSFLG = $00 (PASS 1) THE CODE
;          EXECUTES 'BRK / RTS', WHICH CODOS INTERPRETS AS SVC $60 (OPCODE
;          OF RTS = $60).  SVC $60 IS UNDOCUMENTED; THE CODE APPEARS TO
;          RELY ON THE OS RETURNING NORMALLY TO ACT AS A PASS-1 NO-OP.
;
;   BUG-3  @UNREACH:  UNREACHABLE DEAD CODE ('BIT URESFLG / BMI @ERROR3')
;          PLACED IMMEDIATELY AFTER A 'JSR ERROR_RANGE'
;          (ERROR HANDLER THAT NEVER RETURNS). THE ORIGINAL COMMENT
;          SUGGESTS THE BRANCH AT @ALT_EMIT ('BCS @CHK_ABS') SHOULD
;          INSTEAD BRANCH HERE.
;
; =============================================================================

            .READ   MTU130EQU.A

NOT         = 1             ; AUXILIARY DEFINITION FOR CONDITIONAL ASSEMBLY
KIM1        = 0             ; SET TO 1 FOR KIM-1

TABTBL      = $06E0         ; GLOBAL TABULATION TABLE

SPREGREN    = $BFC7         ; Special registers read enable
SPREGREAD   = $BFC3         ; Special registers read byte
BNKCTL      = $BFE0         ; Bank control data register

; UNOFFICIAL HLT (JAM, KIL) INSTRUCTION
; FREEZES THE CPU, RESET REQUIRED
;
HLT         .MACRO
            .BYTE   $02
            .ENDMAC

ZEROPAGE    = $40                       ; ZERO PAGE ADDRESSES START AT $40
CODE1       = $0700                     ; LOW APPLICATION RAM
CODE2       = $2000                     ; HIGH APPLICATION RAM

            .IF NOT-KIM1

DATA        = $3F00                     ; DATA STORAGE RAM
BSS         = $3400                     ; BSS SEGMENT BASE
BSS3        = $0000                     ; BSS3 SEGMENT BASE (BANK 3)

            .ELSE

DATA        = $4900                     ; DATA STORAGE RAM
BSS         = $3E00                     ; BSS SEGMENT BASE

            .ENDIF

BSS2        = $AC00                     ; BSS2 SEGMENT BASE

; =============================================================================
; ZERO PAGE SCRATCH VARIABLES  ($40-$73)
; DEFINED IN THE .ZEROPAGE SEGMENT; ACTUAL RUNTIME ADDRESSES ARE $40-$73.
; =============================================================================

            *=  ZEROPAGE

SYMTBLP     *=*+    2   ; SYMBOL TABLE ENTRY POINTER ($40)
SYMVALP     *=*+    2   ; SYMBOL VALUE-STORE PTR - NEXT FREE BYTE IN HEAP ($42)
HASHTBLP    *=*+    2   ; HASH-TABLE BUCKET PROBE POINTER ($44)
MATCHP      *=*+    2   ; MATCHED SYMBL ENTRY PTR (RESULT OF HASH LOOKUP) ($46)
SEGHEADP    *=*+    2   ; OBJECT SEGMENT HEADER WRITE POINTER ($48)
MACTBLP     *=*+    2   ; MACRO TABLE BASE POINTER ($4A)
SCRATCHP    *=*+    2   ; GENERAL-PURPOSE SECONDARY TRAVERSAL POINTER ($4C)
SYMNAMP     *=*+    2   ; SYMBOL NAME POINTER - SORT COMPARATOR A ($4E)
SYMNAMP2    *=*+    2   ; SYMBOL NAME POINTER - SORT COMPARATOR B ($50)
TEMPP       *=*+    2   ; GENERIC TEMPORARY POINTER ($52)
LSTOUTP     *=*+    2   ; LISTING OUTPUT WRITE POINTER ($54)
SYMVAL      *=*+    3   ; 24-BIT ASSEMBLED/EVALUATED VALUE (LO, MID, HI) ($56)
TMPVAL      *=*+    3   ; 24-BIT SCRATCH A (MULTIPLY/DIVIDE) ($59)
TMPVAL2     *=*+    3   ; 24-BIT SCRATCH B (MULTIPLY/DIVIDE REMAINDER) ($5C)
URESFLG     *=*+    1   ; UNRESOLVED-REFERENCE FLAG: $C0 = UNRESOLVED ($5F)
PASSFLG     *=*+    1   ; PASS FLAG: $00 = PASS 1, $80 = PASS 2 ($60)
LOCCNT      *=*+    2   ; LOCATION COUNTER (CURRENT ASSEMBLY ADDRESS) ($61)
LOCCNT2     *=*+    2   ; LOC. COUNTER SNAPSHOT AT START OF CURRENT LINE ($63)
SAVEX       *=*+    1   ; SAVED X REGISTER SCRATCH ($65)
MACBODYP    *=*+    2   ; MACRO BODY START ADDRESS ($66)
OPCTBLP     *=*+    2   ; OPCODE TABLE SEQUENTIAL READ POINTER ($68)
MARGSTRP    *=*+    2   ; MACRO PARAMETER STRING READ POINTER ($6A)
MARGWRTP    *=*+    2   ; MACRO ARGUMENT WRITE POINTER (INTO MACSTACK) ($6C)
RETADDRP    *=*+    2   ; PRTSTR: INLINE STRING PTR (RETURN ADDR SCRATCH) ($6E)
HEAP2PRP    *=*+    2   ; SECONDARY-HEAP MEMORY PROBE POINTER ($70)
HEAP2WRP    *=*+    2   ; SECONDARY-HEAP (EXPANSION RAM) WRITE POINTER ($72)

            *=  CODE1

; =============================================================================
; START  -  JUMP TABLE
; =============================================================================
START       JMP     MAIN_ENTRY          ; NORMAL ENTRY: INITIALISE AND ASSEMBLE
            JMP     ABORT_ASM      ; ERROR EXIT: FLUSH + RETURN TO CODOS

; =============================================================================
; CONFIGURATION / RELOCATABLE POINTER TABLE
;
; THESE WORDS ARE PATCHED BY THE COMMAND-LINE PARSER AND MEMORY PROBE TO
; DEFINE THE LAYOUT OF THE FIVE HEAP/BUFFER REGIONS.  ALL POINTERS MUST BE
; PAGE-ALIGNED.
;
;   SRCST   / SRCEND   SOURCE PROGRAM READ BUFFER
;   LSTST   / LSTEND   LISTING OUTPUT ACCUMULATION BUFFER
;   HEAPST  / HEAPEND  SYMBOL-TABLE PRIMARY HEAP (NAMES AND VALUES)
;   HASHTST / HASHTEND OPEN-ADDRESS HASH TABLE (2-BYTE BUCKET ENTRIES)
;   MACSST  / MACSEND  MACRO INVOCATION ARGUMENT STACK
;   HEAP2ST / HEAP2END SECONDARY HEAP IN EXPANSION-RAM BANK 3
; =============================================================================
SRCST       .WORD   SRCPRBUF        ; START OF SOURCE BUFFER ($0706)
SRCEND      .WORD   LSTNGBUF        ; END+1 OF SRC BUF (PAGE-ALIGNED) ($0708)
LSTST       .WORD   LSTNGBUF        ; START OF LISTING BUFFER ($070A)
LSTEND      .WORD   TABLE           ; END+1 OF LST. BUF. (PAGE-ALIGNED) ($070C)
HEAPST      .WORD   TABLE           ; START OF SYM-TABLE PRIMARY HEAP ($070E)
HEAPEND     .WORD   SYMHASHT        ; END+1 OF PRMARY HEAP (PAG-ALIGN.) ($0710)
HASHTST     .WORD   SYMHASHT        ; START OF HASH TABLE (RELOCATABLE) ($0712)
HASHTEND    .WORD   MACSTACK        ; END+1 OF HASH TABLE ($0714)

            .IF     NOT-KIM1
HEAP2ST     .WORD   SCNDHEAP+4      ; START OF SECONDARY HEAP (BANK 3) ($0716)
HEAP2END    .WORD   SCNDHEAP+$FF00  ; END+1 OF SECONDARY HEAP (BANK 3) ($0718)
            .ENDIF

MACSST      .WORD   MACSTACK        ; START OF MACRO ARG. STACK ($071A)
MACSPTR     .WORD   MACSTACK        ; CUR. WRTE POS. IN MACRO ARG STACK ($071C)
MACSEND     .WORD   MACSTACK+$200   ; END+1 OF MACRO ARGUMENT STACK ($071E)

; =============================================================================
; HASH TABLE SIZE CODE  ($0720)
; ENCODES THE AND MASK APPLIED TO THE HASH SUM TO SELECT THE BUCKET INDEX.
;   $0F -> 4 K-BUCKET TABLE (8 KB)
;   $07 -> 2 K-BUCKET TABLE (4 KB)
;   $03 -> 1 K-BUCKET TABLE (2 KB)
; HASHSIZEC IS THE ACTIVE SIZE CODE; HASHSIZEC+1 TO HASHSIZEC+3 ARE ALTERNATIVE
; CODES SELECTABLE VIA THE COMMAND-LINE (CURRENTLY UNUSED AT RUNTIME).
; =============================================================================
HASHSIZEC   .BYTE   $0F         ; ACTIVE HASH MASK: $0F -> 4 K BUCKETS ($0720)
            .BYTE   $09
            .BYTE   $11
            .BYTE   $19

; SUBSTITUTION VALUE FOR AN UNDEF. / UNRESOLVED OPERAND (24-BIT, ALL BITS SET)
UNDEFSUBST  .WORD   $FFFF       ; LOW AND MIDDLE BYTES OF SUBST. VALUE ($0724)
            .BYTE   $00         ; HIGH BYTE

; =============================================================================
; LISTING / CROSS-REFERENCE FORMATTING PARAMETERS  ($0727-$072A)
; =============================================================================
LISTLINESPP .BYTE   $39     ; LINES PER PAGE IN LISTING OUTPUT ($0727)
XRNAMCOLMAX .BYTE   $3D     ; MAX COL. FOR SYMBOL NAME IN XREF LISTING ($0728)
LISTTABSPC  .BYTE   $14     ; TAB WIDTH BETWEEN COLS IN SYM TBL LISTING ($0729)
XRNUMCOLMAX .BYTE   $4B     ; MAX COL. FOR A CROSS-REFERENCE NUMBER ($072A)

; =============================================================================
; CONFIGURABLE OPERATOR / SYNTAX CHARACTERS  ($072B-$073E)
; ALL OF THESE CAN BE CHANGED TO SUIT NATIONAL KEYBOARDS OR USER PREFERENCE.
; =============================================================================
ARITHOPS    .BYTE   '~'     ; EXCLUSIVE-OR OPERATOR ($072B)
            .BYTE   '|'     ; OR OPERATOR ($072C)
            .BYTE   '&'     ; AND OPERATOR ($072D)
            .BYTE   '\'     ; REMAINDER (MODULO) OPERATOR ($072E)
            .BYTE   '/'     ; DIVISION OPERATOR ($072F)
            .BYTE   '*'     ; MULTIPLICATION OPERATOR ($0730)
SUBSOP      .BYTE   '-'     ; SUBTRACTION OPERATOR ($0731)
ADDOP       .BYTE   '+'     ; ADDITION OPERATOR ($0732)
LBRACKET    .BYTE   '['     ; LEFT GROUPING BRACKET ($0733)
RBRACKET    .BYTE   ']'     ; RIGHT GROUPING BRACKET ($0734)
LOBYTE      .BYTE   '<'     ; LOW-BYTE EXTRACTION OPERATOR ($0735)
HIBYTE      .BYTE   '>'     ; HIGH-BYTE EXTRACTION OPERATOR ($0736)
HEXPREFIX   .BYTE   '$'     ; HEXADECIMAL LITERAL PREFIX ($0737)
OCTPREFIX   .BYTE   '@'     ; OCTAL LITERAL PREFIX ($0738)
BINPREFIX   .BYTE   '%'     ; BINARY LITERAL PREFIX ($0739)
APOSTROPHE  .BYTE   $27     ; CHARACTER LITERAL QUOTE (APOSTROPHE) ($073A)
TABCHAR     .BYTE   $09     ; TAB CHAR (USED IN LINE-CONT. HANDLING) ($073B)
ARGLEADIN   .BYTE   '!'     ; MACRO ARGUMENT LEAD-IN CHARACTER ($073C)
ARGLEFT     .BYTE   '{'     ; MACRO ARGUMENT STRING LEFT DELIMITER ($073D)
ARGRIGHT    .BYTE   '}'     ; MACRO ARGUMENT STRING RIGHT DELIMITER ($073E)
ARGCOUNT    .BYTE   '#'     ; '!#' IN MACRO. REPLACED BY ACTUAL ARG CNT ($073F)
; CHARACTERS PERMITTED INSIDE IDENTIFIERS IN ADDITION TO A-Z AND 0-9
DOT         .BYTE   '.'     ; EMBEDDED IDENTIFIER CHARS: '.', '?', '_' ($0740)
QMARK       .BYTE   '?'     ; EMBEDDED IDENTIFIER CHARS: '.', '?', '_' ($0741)
UNDERSCORE  .BYTE   '_'     ; EMBEDDED IDENTIFIER CHARS: '.', '?', '_' ($0742)
PCSYMBOL    .BYTE   '*'     ; PROGRAM-COUNTER SYMBOL (CURRENT ADDRESS) ($0743)
COMMENT     .BYTE   ';'     ; COMMENT DELIMITER CHARACTER ($0744)
; =============================================================================
; ASSEMBLER FLAGS AND VARIABLES
; =============================================================================

FST_FF_FLG  .BYTE   $00     ; ($0745) $00 = EMIT FORM-FEED BEFORE FIRST PAGE
                            ;         $80 = SUPPRESS IT (SAVE PAPER IF
                            ;         PRINTER ALREADY AT TOP-OF-FORM)
HASH_PB_WR  .BYTE   $00     ; ($0746) HASH COLLISION WRAP COUNTER
HEX_DG_FL   .BYTE   $00     ; ($0747) NON-ZERO WHILE PARSING HEX LITERAL
ERR_LST_R   .BYTE   $00     ; ($0748) $80 = PASS 1 IS BEING RE-RUN TO PRODUCE
                            ;       THE ERROR LISTING TO FILE
                            ;       (SET ONLY ON ERRORS)
XREF_MODE   .BYTE   $80     ; ($0749) $80 = CROSS-REF MODE (EMIT XREF RECORDS)
LST_ACT     .BYTE   $00     ; ($074A) $80 = LIST IS BEING PRODUCED ON THIS LINE
LST_F_OPN   .BYTE   $80     ; ($074B) $80 = LISTING OUTPUT FILE/CHANNEL IS OPEN
LN_LST_FLG  .BYTE   $80     ; ($074C) PER-LINE LISTING CONTROL BITS
LISTING_ON  .BYTE   $00     ; ($074D) CURRENT EFFECTIVE LISTING-ON/OFF STATE
SYMTBL_INIT .BYTE   $00     ; ($074E) $80 = SYM. TBL INITIALISATION IN PROGRESS
                            ;        (SUPPRESSES NORMAL HASH-TABLE NAME WRITES)
LINE_CONT   .BYTE   $00     ; ($074F) $80 = CURRENTLY READING A CONTINUED
                            ;               (TAB-SPLIT) LINE
XREF_ENAB   .BYTE   $80     ; ($0750) $80 = PRNT CROSS-REF. TBL. AFTER ASSEMBLY
END_SEEN    .BYTE   $00     ; ($0751) $80 = .END DIRECTIVE HAS BEEN PROCESSED
INCLUDE_POP .BYTE   $00     ; ($0752) $80 = RET FROM .READ/INCL STACK REQUESTED
OBJSEG_OPEN .BYTE   $00     ; ($0753) $80 = AN OBJ. SEGMENT HDR IS OPEN/PENDING
COND_DEPTH  .BYTE   $00     ; ($0754) BIT MASK TRACKING .IF NESTING DEPTH
COND_ELSE   .BYTE   $00     ; ($0755) BIT MASK TRACKING .ELSE STATE PER NESTING
                            ;               LEVEL
IFCMP_ZERO  .BYTE   $00     ; ($0756) $FF = BOTH .IFXX OPERANDS WERE EQUAL
IFCMP_NEG   .BYTE   $00     ; ($0757) $FF = FIRST .IFXX OPERAND WAS LESS THAN
                            ;               THE SECOND
ENT_DEF     .BYTE   $00     ; ($0758) $80 = .ENTRY DIRECTIVE HAS BEEN SEEN
DIR_DEF_AC  .BYTE   $00     ; ($0759) $80 = '==' COMMAND-LINE REDIRECT ACTIVE
LST_SUPR    .BYTE   $00     ; ($075A) $80 = SUPPRESS LINE-NUM INCR. (.LIST OFF)
ENDIANNESS  .BYTE   $00     ; ($075B) $80 = EMIT BYTES BE FOR DBYTE
RELAD_FLG   .BYTE   $00     ; ($075C) RELATIVE-ADDR MODE FLAG FOR BRANCH OPS

            .IF     NOT-KIM1
EXP_BANK    .BYTE   $FD     ; ($075D) $80 = EXP RAM (BANK 3) PRESENT AND USABLE
            .ENDIF

VAL_OUT     .BYTE   $00     ; ($075E) $80 = VAL DIGITS ALREADY WRTTN TO LISTING
VAL_SUPR    .BYTE   $00     ; ($075F) $80 = SUPPRESS VAL DIGIT OUT IN LISTING
IN_STRING   .BYTE   $00     ; ($0760) IN-STRING FLG FOR COMMENT-CHAR SCANNING
MAC_EXP     .BYTE   $00     ; ($0761) $80 = CURRENTLY INSIDE A MACRO EXPANSION
LST_SPR2    .BYTE   $00     ; ($0762) SECONDARY LISTING-SUPPRESS FLAG
ENT_TY_FL   .BYTE   $00     ; ($0763) TYPE/FLG BYTE OF CURRENT SYM-TABLE ENTRY
INSTR_FLAGS .BYTE   $00     ; ($0764) INSTRUCTION FLAGS FOR CURRENT OPCODE
MACRO_FLAGS .BYTE   $00     ; ($0765) MACRO-EXPANSION STATE FLAGS
LINE_NUM    .WORD   $0000   ; ($0766) CURRENT SOURCE LINE NUMBER (16-BIT)
PG_LIN_CNT  .BYTE   $00     ; ($0768) LINE COUNTER ON THE CURRENT LISTING PAGE
            .BYTE   $00     ; ($0769) UNUSED
ADDR_MODE   .BYTE   $00     ; ($076A) RESOLVED ADDRESSING MODE INDEX (0-$0A)
FAT_ERR_CD  .BYTE   $00     ; ($076B) FATAL ERR CODE ENC. BY ERR. LADDER
ERR_TY_CD   .BYTE   $00     ; ($076C) ERROR TYPE COD ENC. BY ERR_TYPE_LADDER
            .BYTE   $00     ; ($076D) UNUSED
ERR_CNT     .WORD   $0000   ; ($076E) LINE-ERROR COUNT (16-BIT)
            .BYTE   $00     ; ($0770) UNUSED
            .BYTE   $00     ; ($0771) UNUSED
SAVED_SP    .BYTE   $00     ; ($0772) STACK POINTER SAVED FOR ERROR LONGJMP
SAVED_RET   .WORD   $0000   ; ($0773) SAVED RETURN ADDRESS (16-BIT)
SYM_COUNT   .WORD   $0000   ; ($0775) NUMBER OF SYMBOLS DEFINED (16-BIT)
REF_COUNT   .WORD   $0000   ; ($0777) TOTAL CROSS-REFERENCE ENTRIES (16-BIT)
SORTED_END  .WORD   $0000   ; ($0779) SORTED HASH-TABLE END PTR (16-BIT)
SORT_GAP    .WORD   $0000   ; ($077B) SHELL-SORT GAP (16-BIT)
SORT_LIMIT  .WORD   $0000   ; ($077D) SHELL-SORT UPPER BOUND (16-BIT)
XREF_COL1   .BYTE   $00     ; ($077F) XREF LISTING COLUMN 1 (NEXT TAB STOP)
XREF_COL2   .BYTE   $00     ; ($0780) XREF LISTING SYMBOL-VALUE COLUMN
DEC_DIGIT   .BYTE   $00     ; ($0781) ASCII DIGIT SCRATCH FOR FORMAT_DEC16
SIGN_FLAG   .BYTE   $00     ; ($0782) $80 = PRODUCT/QUOTIENT IS NEGATIVE
VAL_ST_TP   .BYTE   $00     ; ($0783) EXPRESSION EVALUATOR VALUE STACK TOP
OPR_ST_TP   .BYTE   $00     ; ($0784) EXPRESSION EVALUATOR OPERATOR STACK TOP
IFCMP_VAL   .BYTE   $00     ; ($0785) IFCMP_VAL[0]: .IFXX FIRST OPERAND, BYTE 0
            .BYTE   $00     ;         IFCMP_VAL[1]: .IFXX FIRST OPERAND, BYTE 1
            .BYTE   $00     ;         IFCMP_VAL[2]: .IFXX FIRST OPERAND, BYTE 2
OVL_NUM     .BYTE   $00     ; ($0788) OVERLAY NUMBER FROM .OVL
BANK_NUM    .BYTE   $00     ; ($0789) BANK NUMBER FROM .BANK
SVP_SAVE    .WORD   $0000   ; ($078A) SAVED SYMVALP (16-BIT)
ENTRY_ADDR  .WORD   $0000   ; ($078C) .ENTRY ADDRESS  (16-BIT)
LOCCNT_BASE .WORD   $0000   ; ($078E) LAST SEGMENT CHECKPOINT (16-BIT) 
SEG_SIZE    .WORD   $0000   ; ($0790) CURRENT SEGMENT SIZE (16-BIT)
DDEFS_END   .WORD   $0000   ; ($0792) END PTR OF DIRECT-DEFS BUFFER
HASH_LAST   .WORD   MACSTACK-2 ; ($0794) LAST HASH BUCKET PTR
OP_HANDLER  .WORD   $0000   ; ($0796) CURRENT OPERATOR-HANDLER VECTOR
MAC_BOD_V   .WORD   $0000   ; ($0798) MACRO BODY EXPANSION VECTOR
ERRFNP      .WORD   $0000   ; ($079A) ERR-RECVRY DISPATCH VECT (PASS-DEPENDENT)
            .BYTE   $03     ; ($079C) UNUSED

            .IF     NOT-KIM1
BNK_CTL_BT  .BYTE   $00     ; ($079D) 2-BIT BANK SELECTOR FOR BNKCTL
            .ENDIF

FIL_CNT_NG  .WORD   $0000   ; ($079E) NEGATED .FILL COUNT (16-BIT)
MAC_ARG_CN  .BYTE   $00     ; ($07A0) ACTUAL ARGUMENT COUNT IN MACRO CALL
STR_DELIM   .BYTE   $00     ; ($07A1) CURRENT STRING DELIMITER CHAR
PIX_SAVE    .BYTE   $00     ; ($07A2) SAVED PARAMETER INDEX
OPC_TB_PTR  .WORD   $0000   ; ($07A3) PTR TO CURR OPCODE TABLE ENTRY (16-BIT)
NEXT_LOCAL  .BYTE   '000 '  ; ($07A5) 'NEXT' LOCAL LABEL ASCII COUNTER
PREV_LOCAL  .BYTE   '000 '  ; ($07A9) 'PREVIOUS' LOCAL LABEL ASCII COUNTER
   
            .IF     NOT-KIM1
HW_CK_LEN   .BYTE   $0B     ; ($07AD) HARDWARE CHECK DATA LENGTH
            .BYTE   $C9     ; ($07AE) UNUSED
HW_CK_DATA  .BYTE   $00     ; ($07AE) EXPECTED CHECK NIBBLES, BYTE 0
            .BYTE   $00     ;         EXPECTED CHECK NIBBLES, BYTE 1
            .BYTE   $01     ;         EXPECTED CHECK NIBBLES, BYTE 2
            .BYTE   $07     ;         EXPECTED CHECK NIBBLES, BYTE 3
            .BYTE   $05     ;         EXPECTED CHECK NIBBLES, BYTE 4
            .ENDIF

CMY_SAVE    .BYTE   $00     ; ($07B4) SAVED Y DURING COMMAND-LINE PARSING
SYM_NM_OFF  .BYTE   $00     ; ($07B5) BYTE OFFSET TO END OF SYMBOL NAME
LINE_POS    .BYTE   $00     ; ($07B6) CURRENT Y INDEX INTO LINE_BUF
LN_POS_SAV  .BYTE   $00     ; ($07B7)
LN_POS_SV2  .BYTE   $00     ; ($07B8)
UNR_LN_POS  .BYTE   $00     ; ($07B9) LINE POS WHEN UNRESOLVED REF SEEN
UNRES_POS   .BYTE   $00     ; ($07BA) SET WITH POS IN BUFFER IF CURRENT DATA
                            ;           VALUE IS UNRESOLVED
SRC_BUF_OFF .BYTE   $00     ; ($07BB) OFFSET WITHIN LOADED SOURCE BUFFER
            .BYTE   $00     ; ($07BC) UNUSED
IDENT_LEN   .BYTE   $00     ; ($07BD) LENGTH OF CURRENT IDENTIFIER IN IDENT_BUF
SYM_MT_OFF  .BYTE   $00     ; ($07BE) OFFSET OF MATCH IN SYMTBLP
OBJBUF_POS  .BYTE   $00     ; ($07BF) WRITE INDEX INTO OBJCOBUF
FIL_LN_POS  .BYTE   $00     ; ($07C0) LINE POS SAVED AT START OF .FILL
OUT_CHANNEL .BYTE   $00     ; ($07C1) OUTPUT CHANNEL FOR PR_FIN_SUM
            .BYTE   $00     ; ($07C2) UNUSED
SRC_REMA    .WORD   $0000   ; ($07C3) SOURCE BYTES REMAINING (16-BIT)
DIV_TEMP    .WORD   $0000   ; ($07C5) DIVISION SCRATCH (16-BIT)
            .BYTE   $00     ; ($07C7) UNUSED
            .BYTE   $00     ; ($07C8) UNUSED
            .BYTE   $00     ; ($07C9) UNUSED
            .BYTE   $00     ; ($07CA) UNUSED
OPT_START_Y .BYTE   $00     ; ($07CB) OPTION TOKEN START POSITION IN LINE
EVX_SAVE    .BYTE   $00     ; ($07CC) SAVED X IN EVAL_EXPR
EVY_SAVE    .BYTE   $00     ; ($07CD) SAVED Y IN FORMATTING ROUTINES
MCD_Y_SAV   .BYTE   $00     ; ($07CE) SAVED Y IN DEF_MACRO

            .IF     NOT-KIM1
CNC_CHKSM   .WORD   $0000   ; ($07CF) TO CALC. CHCKSUM FOR HW-LOCK TST (16-BIT)
            .ENDIF

RDX_SAVE    .BYTE   $00     ; ($07D1) SAVED X SCRATCH FOR RD_NEXT_BK
RBI_SAVE    .BYTE   $00     ; ($07D2) SAVED X SCRATCH FOR READ_BLOCK_INNER
OEL_Y_SAV   .BYTE   $00     ; ($07D3) SAVED Y SCRATCH FOR OUTPUT_ERROR_LINE
FD1_Y_SAV   .BYTE   $00     ; ($07D4) SAVED Y SCRATCH FOR FORMAT_DEC16
EB2_X_SAV   .BYTE   $00     ; ($07D5) SAVED X SCRATCH FOR EM_B_PAS2
LST_LN_LEN  .BYTE   $00     ; ($07D6) LISTING LINE BYTE COUNT
CMD_END_POS .BYTE   $00     ; ($07D7) END OF FILENAME TOKEN IN COMMAND BUFFER
CMD_CUR_POS .BYTE   $00     ; ($07D8) CURRENT POSITION IN COMMAND BUFFER
LST_DRV_PS  .BYTE   $00     ; ($07D9) DRIVE NUMBER POSITION FOR LISTING
TAB_COL     .BYTE   $00     ; ($07DA) COLUMN BEING EXPANDED TO TAB STOP
RMB_SAVE    .BYTE   $00     ; ($07DB) SAVED X SCRATCH FOR RD_MAC_BB
RWX_SAVE    .BYTE   $00     ; ($07DC) SAVED X SCRATCH FOR WR_ARG_BY / RD_ARG_BY
RWY_SAVE    .BYTE   $00     ; ($07DD) SAVED Y SCRATCH FOR WR_ARG_BY / RD_ARG_BY
PTS_Y_SAV   .BYTE   $00     ; ($07DF) SAVED Y FOR PRTSTR
OPG_Y_SAV   .BYTE   $00     ; ($07DE) SAVED Y FOR OUT_LN_PGB ROUTINE

            .IF     NOT-KIM1
HW_CK_LM1   .BYTE   $0A     ; ($07E0) HW CHECK DATA LEN MINUS 1
                            ;           (FOR CONCEALED CHECK)
CHK_REF     .WORD   $0067   ; ($07E1) CHECKSUM REFERENCE FOR THE
                            ; CONCEALED HW-LOCK CHECK (16-BIT)
            .ENDIF

            .BYTE   $D9     ; ($07E3) UNUSED
SRC_CHANNEL .BYTE   $05     ; ($07E4) CODOS CHANNEL NUMBER FOR SOURCE FILE
LST_CHANNEL .BYTE   $06     ; ($07E5) CODOS CHANNEL FOR LISTING FILE
OBJ_CHANNEL .BYTE   $07     ; ($07E6) CODOS CHANNEL FOR OBJECT FILE
CON_CHANNEL .BYTE   $04     ; ($07E7) CODOS CHANNEL FOR CONSOLE/ERROR
            .BYTE   $05     ; ($07E8) UNUSED
DEF_CHANNEL .BYTE   $08     ; ($07E9) CODOS CHANNEL FOR DEFINITIONS FILE
            .BYTE   $00     ; ($07EA) UNUSED
EXT_OPT_CH  .BYTE   'LOEXD' ; ($07EB) VALID SINGLE-LETTER OPTION CHARS

; DEFAULT DRIVE/DEVICE ASSIGNMENTS FOR EACH FILE (ALL 0 = DEFAULT DRIVE)
SRC_DRIVE   .BYTE   $00     ; ($07F0) DRIVE FOR SOURCE FILE
LST_DRIVE   .BYTE   $00     ; ($07F1) DRIVE FOR LISTING FILE
OBJ_DRIVE   .BYTE   $00     ; ($07F2) DRIVE FOR OBJECT FILE
ERR_DEVICE  .BYTE   'C'     ; ($07F3) ERROR DEVICE: 'C' = CONSOLE, 'N' = NONE
OBJ_DEVICE  .BYTE   'N'     ; ($07F4) OBJECT DEVICE (INITIAL='N') 
DEF_DEVICE  .BYTE   'N'     ; ($07F5) DEFS. DEVICE: 'N' = NO DEFINITIONS FILE

; PER-CHANNEL TABLE INDEX VALUES

SR_FNAM_OFF =  SRC_FN_SL-FNAM_SLOT
LS_FNAM_OFF =  LST_FN_SL-FNAM_SLOT
OB_FNAM_OFF =  OBJ_FN_SL-FNAM_SLOT
ER_FNAM_OFF =  ERR_FN_SL-FNAM_SLOT
EX_FNAM_OFF =  EXT_FN_SL-FNAM_SLOT
DF_FNAM_OFF =  DEF_FN_SL-FNAM_SLOT

CHAN_AS_TB  .BYTE   SR_FNAM_OFF
            .BYTE   LS_FNAM_OFF
            .BYTE   OB_FNAM_OFF    
            .BYTE   ER_FNAM_OFF
            .BYTE   EX_FNAM_OFF
            .BYTE   DF_FNAM_OFF

; DEFAULT FILE EXTS: SOURCE=A, LISTING=L, OBJECT=C, ERRORS=E, EXT=A, DEFS=A
DEF_EXTS    .BYTE   'A'   ; DEFAULT EXTENSION FOR SOURCE FILE ($07FC)
            .BYTE   'L'   ; DEFAULT EXTENSION FOR LISTING FILE ($07FD)
            .BYTE   'C'   ; DEFAULT EXTENSION FOR OBJECT FILE ($07FE)
            .BYTE   'E'   ; DEFAULT EXTENSION FOR ERROR FILE ($07FF)
            .BYTE   'A'   ; DEFAULT EXTENSION FOR EXTERNALS FILE ($0800)
            .BYTE   'A'   ; DEFAULT EXTENSION FOR DEFINITIONS FILE ($0801)

; =============================================================================
; FILE NAME RECORD BUFFERS  ($0802-$086B)
;
; EACH RECORD IS 14 BYTES (13 CHARS + NUL) IN THE CODOS FILENAME FORMAT.
; THE ASSEMBLER KEEPS ONE RECORD PER CHANNEL.  CP_FN_2_SL
; FILLS THESE FROM THE PARSED COMMAND LINE.
;
; LAYOUT OF EACH 14-BYTE SLOT:
;   BYTES 0-12  FILENAME CHARACTERS (A-Z, 0-9, '.', DRIVE DIGIT)
;   BYTE  13    NUL ($00) TERMINATOR
; =============================================================================
FNAM_SLOT
SRC_FN_SL   .BYTE   '            . ' ; CHAN. 0 FNAME RECORD ($0802, 14 BYTES)
LST_FN_SL   .BYTE   '            . ' ; CHAN. 1 FNAME RECORD ($0810)
OBJ_FN_SL   .BYTE   '            . ' ; CHAN. 2 FNAME RECORD ($081E)
ERR_FN_SL   .BYTE   '            . ' ; CHAN. 3 FNAME RECORD ($082C)
EXT_FN_SL   .BYTE   '            . ' ; CHAN. 4 (OBJ. FILE) FNAM RECORD ($083A)
DEF_FN_SL   .BYTE   '            . ' ; CHAN. 5 FNAME RECORD ($0848)
FNAME_BUF   .BYTE   '            . ' ; SCRATCH 14BYTE BUF FOR PRS_FNAME ($0856)

; MISCELLANEOUS LAYOUT BYTES FOLLOWING THE FILENAME RECORDS
EXTN_POS    .BYTE   $00     ; ($0864) FNAME PARSE: INDEX TO EXTEN. POSITION
CURRENT_OPT .BYTE   $20     ; ($0865) CURRENT OPT LETTER BEING PROCESSED
OPT_INDEX   .BYTE   $00     ; ($0866) OPTION INDEX (0-5) INTO EXT_OPT_CH
DEF_EXT_CH  .BYTE   $20     ; ($0867) CURRENT DEFAULT EXTENSION CHARACTER
PRSD_DRV    .BYTE   $00     ; ($0868) CURRENT DRV NUMBER FROM FILENAME PARSE
LN_BUF_LEN  .BYTE   $00     ; ($0869) LEN OF SRC LINE (BYTE COUNT IN LINE_BUF)
LN_BUF_END  .WORD   $0000   ; ($086A) SOURCE BUFFER END OFFSET, LOW BYTE

; =============================================================================
; INCLUDE FILE STACK
;
; 37-ENTRY PUSH-DOWN STACK FOR NESTED .READ (INCLUDE) FILES.
; EACH FRAME IS 18 BYTES:
;   BYTE  0       DRIVE / DEVICE CODE
;   BYTES 1-3     CODOS FILE POSITION (3 BYTES)
;   BYTES 4-17    14-BYTE FILENAME RECORD
;
; INC_ST_TP HOLDS THE BYTE IDX OF THE TOP-OF-STACK (INCREMENTED BY 18 PER PUSH)
; MAXIMUM NESTING DEPTH = $25 / 18 = 2 LEVELS - ERROR IF EXCEEDED.
; =============================================================================
INC_FIL_ST  .BYTE   $FF              ; ($086C) INCLUDE STACK ENTRY 0, DRV BYTE
            .BYTE   $00
            .BYTE   $00
            .BYTE   $00
            .BYTE   '            . ' ; FILENAME
            .BYTE   $FF              ; INCLUDE STACK ENTRY 1
            .BYTE   $00
            .BYTE   $00
            .BYTE   $00
            .BYTE   '            . '
            .BYTE   $FF              ; INCLUDE STACK ENTRY 2
            .BYTE   $00
            .BYTE   $00
            .BYTE   $00
            .BYTE   '            . '
INC_ST_TP   .BYTE   $00              ; ($08A2) INDEX OF TOP-OF-INCLUDE STACK

; =============================================================================
; LISTING LINE OUTPUT BUFFER
;
; THIS IS THE FIXED-FORMAT LISTING LINE TEMPLATE.  FIELDS ARE WRITTEN IN-PLACE
; BY THE ASSEMBLY ENGINE.
; =============================================================================
LIST_BUF    .BYTE   $0D         ; LISTING LINE PREFIX (CR)
ADDR_FILD   .BYTE   '0000 '     ; ADDRESS FIELD: 4 HEX DIGITS + SPACE
VALUE_FIELD .BYTE   '0000 '     ; VALUE FIELD:   4 HEX DIGITS + SPACE

SEP_SP      .BYTE   ' '         ; SEPARATOR SPACE
EQUATE_CHAR .BYTE   ' '         ; EQUATE CHAR 1 (.E.G. '=' FOR EQU)
SEC_EQUAT   .BYTE   ' '         ; SECOND EQUATE CHAR FOR LISTINGS
            .BYTE   ' '         ; SEPARATOR
SEP_DOT_1   .BYTE   ' '         ; SEP. DOT 0 (SET TO '.' BY CERTAIN DIRECTIVES)
SEP_DOT_2   .BYTE   ' '         ; SEPARATOR DOT 1

LINE_BUF0   .BYTE   ' '         ; FILLED WITH CR AT RUNTIME
LINE_BUF    .BYTE   '                                        '
            .BYTE   '                                        ', 0
            ; LINE BUFFER: 80 SPACES + NUL

; =============================================================================
; ERROR LINE BUFFER
; USED BY RPT_LN_ERR TO OUTPUT THE ERROR INDICATOR LINE.
; =============================================================================
ERR_PREFIX  .BYTE   $0D, '*ERROR '  ; ERROR LINE PREFIX
ERR_COUNT   .BYTE   '0000 '         ; ERROR COUNT FIELD
ERR_SEP     .BYTE   '****************************************'
            .BYTE   '****************************************'
            ; 80 ASTERISKS, USED AS VISUAL SEPARATOR AFTER FATAL ERROR

; =============================================================================
; PASS SUMMARY LINE BUFFER
; USED BY FORMAT_PASS_SUMMARY TO FORMAT 'NNNN ERRORS IN PASS N'.
; =============================================================================
SUMMARY_BUF .BYTE   $0D             ; CR
SUM_TEMPL   .BYTE   '0000 ERRORS IN PASS ' ; PASS SUMMARY TEMPLATE
PASS_NUMBER .BYTE   '1 '            ; PASS NUMBER DIGIT ('1' OR '2')
            .BYTE   $0D

; =============================================================================
; PAGE HEADER / LISTING BANNER BUFFER
; EMITTED AT THE TOP OF EACH NEW PAGE IN THE LISTING OUTPUT.
; =============================================================================
PAGE_HEADER .BYTE   $0D             ; CR
PAGE_FF     .BYTE   $0C             ; ASCII FF ($097C; SET TO $00 TO SUPPRESS)
LISTING_BUF .BYTE   '                                              '
            .BYTE   'MTU 6502 MACASM 1.1 ' ; 46 SPACES + TITLE STRING
CURDATE     .BYTE   '          '    ; 10-CHAR DATE FIELD, FILLED BY SVC $1E
PAGE_NUMBER .BYTE   '   '           ; PAGE NUMBER FIELD
            .BYTE   $0D
            .BYTE   'BY BRUCE D. CARBREY'

; =============================================================================
; CROSS-REFERENCE TABLE HEADER STRINGS
; TBL_HDR CONTAINS THE TWO POSSIBLE HEADER STRINGS:
;   'SYMBOL TABLE WITH CROSS REFERENCES' (WITH XREF, 33 CHARS)
;   'SYMBOL TABLE             ' (WITHOUT XREF, SHORTER)
; INDEXED BY X FROM PR_SYMTBL.
; NOTE: LAST THREE CHARS DOUBLE AS THE 3-BYTE ARITHMETIC ACCUMULATOR
; BUFFER USED BY THE EXPRESSION EVALUATOR.
; =============================================================================
TBL_HDR     .BYTE   'SYMBOL TABLE WITH CROSS REFEREN'
ACCUM24     .BYTE   'CES'           ; ALSO: 24-BIT ARITHMETIC ACCUMULATOR

; =============================================================================
; ARITHMETIC OPERATIONS EVALUATION STACKS
; VALUE_STACK:    UP TO EIGHT 24-BIT OPERANDS
; OPR_STACK: UP TO 16 OPERATORS
; =============================================================================

VALUE_STACK .BYTE   '   '
            .BYTE   '   '
            .BYTE   '   '
            .BYTE   '   '
            .BYTE   '   '
            .BYTE   '   '
            .BYTE   '   '
            .BYTE   '   '
OPR_STACK   .BYTE   '                '

; IDENTIFIER BUFFER. THE CURRENT TOKEN IS ASSEMBLED HERE (UP TO 32 CHARS + NUL)
; BEFORE HASH LOOKUP.
;
IDENT_BUF   .BYTE   '                                 '

; =============================================================================
; ERR_CNT_LADDER
; ============================================================================
; FATAL ERROR ENCODER.  EACH LABEL IS AN ENTRY POINT; ENTERING AT AN EARLIER
; LABEL CAUSES MORE INC INSTRUCTIONS TO EXECUTE BEFORE FALLING THROUGH TO THE
; 'ASSEMBLY ABORTED' MESSAGE.  THE NUMBER OF INCREMENTS APPLIED TO
; FAT_ERR_CD ENCODES THE SPECIFIC FATAL ERROR:
;
;   ENTRY          INC COUNT  MEANING
;   FAT_MAC_OV     6          MACROS OVER-NESTED
;   FAT_OUT_EX     5          OUTPUT FILE ALREADY EXISTS
;   FAT_NO_SRC     4          NO SOURCE FILE SPECIFIED
;   FAT_CMD_SY     3          COMMAND SYNTAX ERROR
;   FAT_HSH_FL     2          SYMBOL TABLE OVERFLOWED HASH TABLE
;   FAT_HEP_FL     1          SYMBOL TABLE OVERFLOWED HEAP
; =============================================================================
FAT_MAC_OV  INC     FAT_ERR_CD          ; (ENTRY: MACROS OVER-NESTED)
FAT_OUT_EX  INC     FAT_ERR_CD          ; (ENTRY: OUTPUT FILE EXISTS)
FAT_NO_SRC  INC     FAT_ERR_CD          ; (ENTRY: NO SOURCE)
FAT_CMD_SY  INC     FAT_ERR_CD          ; (ENTRY: COMMAND SYNTAX)
FAT_HSH_FL  INC     FAT_ERR_CD          ; (ENTRY: HASH FULL)
FAT_HEP_FL  INC     FAT_ERR_CD          ; (ENTRY: HEAP FULL)
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02                 ; -> CHANNEL 2 (CONSOLE)
            .BYTE   $0D, 'ASSEMBLY ABORTED: ', 0

            ; DISPATCH ON FAT_ERR_CD TO PRINT THE SPECIFIC REASON
            LDA     FAT_ERR_CD          ; LOAD FATAL ERROR CODE
            CMP     #$01
            BNE     ERR_CODE_2
            ; -- ERROR 1: SYMBOL TABLE HEAP FULL --
            JSR     PR_SYM_FUL ; PRINT 'SYMBOL TABLE FULL ('
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE   'HEAP).', 0
            JMP     ABORT_ASM

; -- ERROR 2: SYMBOL TABLE HASH TABLE FULL --
ERR_CODE_2  CMP     #$02
            BNE     ERR_CODE_3
            JSR     PR_SYM_FUL ; PRINT 'SYMBOL TABLE FULL ('
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE   '(HASH).', 0
            JMP     ABORT_ASM

; -- ERROR 3: COMMAND SYNTAX ERROR --
ERR_CODE_3  CMP     #$03
            BNE     ERR_CODE_4
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE 'COMMAND SYNTAX.', 0
            JMP     ABORT_ASM

; -- ERROR 4: NO SOURCE FILE SPECIFIED --
ERR_CODE_4  CMP     #$04
            BNE     ERR_CODE_5
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE   'NO SOURCE.', 0
            JMP     ABORT_ASM

; -- ERROR 5: OUTPUT FILE ALREADY EXISTS --
ERR_CODE_5  CMP     #$05
            BNE     ERR_CODE_6
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE   'OUTPUT FILE EXISTS.', 0
            JMP     ABORT_ASM

; -- ERROR 6: MACROS NESTED TOO DEEPLY --
; NOTE (BUG-NOTE): IF FAT_ERR_CD IS ANYTHING OTHER THAN 1-6 (SHOULD NOT
; HAPPEN), THE 'BNE ERR_CODE_6' BELOW CREATES AN INFINITE LOOP.
ERR_CODE_6  CMP     #$06
            BNE     ERR_CODE_6          ; SHOULD NOT OCCUR
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE   'MACROS OVERNESTED.', 0
            JMP     ABORT_ASM

; ============================================================================
; ABORT_ASM
; CALLED AFTER ANY FATAL ERROR.  FLUSHES THE LISTING OUTPUT BUFFER, FREES ALL
; I/O CHANNELS, THEN ISSUES SVC #01 TO RETURN CONTROL TO CODOS.
; ============================================================================
ABORT_ASM   JSR     FLSH_OB_B       ; FLUSH ANY PENDING LISTING DATA
            JSR     CLS_ALL_CH      ; CLOSE ALL OPEN CHANNELS
            SVC     1               ; RETURN TO CODOS MONITOR

; ============================================================================
; PR_SYM_FUL
; OUTPUTS THE PARTIAL MESSAGE 'SYMBOL TABLE FULL (' TO CHANNEL 2.
; CALLED BEFORE THE HEAP OR HASH SUFFIX MESSAGES ABOVE.
; ============================================================================
PR_SYM_FUL  SVC     2               ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE   'SYMBOL TABLE FULL (', 0
            RTS

; ============================================================================
; ERR_TYPE_LADDER  (ERR_MAC - ERR_SYN)
; ============================================================================
; ERROR-TYPE ENCODER, ANALOGOUS TO ERR_CNT_LADDER ABOVE.
; EACH LABEL IS AN ENTRY POINT.  THE NUMBER OF INC OPERATIONS APPLIED TO
; ERR_TY_CD ENCODES THE ERROR CLASS
;
; AFTER THE LAST INC, THE LADDER:
;  1. SAVES Y TO LINE_POS.
;  2. PULLS THE TWO JSR RETURN-ADDRESS BYTES OFF THE STACK INTO
;     SAVED_RET - THIS DISCARDS THE INTERMEDIATE RETURN FRAME
;     IMPLEMENTING A NON-LOCAL GOTO.
;  3. RESTORES THE STACK POINTER FROM SAVED_SP - THIS DISCARDS
;     ALL INTERVENING STACK FRAMES, IMPLEMENTING A LONGJMP.
;  4. DISPATCHES THROUGH (ERRFNP) - THE PASS-DEPENDENT ERROR HANDLER.
; ============================================================================
ERR_MAC     INC     ERR_TY_CD       ; (ENTRY: 12 INCREMENTS)
            INC     ERR_TY_CD       ; ERROR 11 IS SET DIRECTLY BY RPT_ERROR
ERR_COND    INC     ERR_TY_CD       ; ENTRY: 10 INCREMENTS
ERROR_RANGE INC     ERR_TY_CD       ; ENTRY:  9 INCREMENTS
ERR_ADDR    INC     ERR_TY_CD       ; ENTRY:  8 INCREMENTS
ERR_TCPLX   INC     ERR_TY_CD       ; ENTRY:  7 INCREMENTS
ERR_UNDEF   INC     ERR_TY_CD       ; ENTRY:  6 INCREMENTS
ERR_DUP     INC     ERR_TY_CD       ; ENTRY:  5 INCREMENTS
ERR_ZP      INC     ERR_TY_CD       ; ENTRY:  4 INCREMENTS
ERR_IDENT   INC     ERR_TY_CD       ; ENTRY:  3 INCREMENTS
ERR_ARITH   INC     ERR_TY_CD       ; ENTRY:  2 INCREMENTS
ERR_SYN     INC     ERR_TY_CD       ; ENTRY:  1 INCREMENT - LEAST-SEVERE ERROR
            STY     LINE_POS        ; SAVE CURRENT LINE POSITION
            PLA                     ; DISCARD JSR RETURN ADDRESS (HIGH BYTE)
            STA     SAVED_RET+1
            PLA                     ; DISCARD JSR RETURN ADDRESS (LOW BYTE)
            STA     SAVED_RET
            LDX     SAVED_SP        ; RESTORE STACK POINTER (LONGJMP)
            TXS
            JMP     (ERRFNP)        ; DISPATCH TO PASS-DEPENDENT ERROR HANDLER

; ============================================================================
; RPT_ERROR
; SETS ERR_TY_CD = 11 (FILE I/O ERROR), CALLS FORMAT_ERR_LINE
; TO EMIT THE ERROR ANNOTATION, THEN JUMPS TO FAT_NO_SRC TO INCREMENT THE
; FATAL ERROR COUNTER (CODE 4 = NO SOURCE -> ABORTS THE RUN).
; CALLED ON INTERNAL / UNRECOVERABLE ERRORS DETECTED OUTSIDE NORMAL ASSEMBLY.
; ============================================================================
RPT_ERROR   LDA     #$0B                ; SET ERROR TYPE TO 11 (FILE I/O ERROR)
            STA     ERR_TY_CD       ; ERR_TY_CD = 11
            JSR     RPT_LN_ERR      ; FORMAT AND EMIT ERROR LINE
            JMP     FAT_NO_SRC

; ============================================================================
; MAIN_ENTRY
; ASSEMBLER START-UP ROUTINE, ENTERED FROM THE CODOS LOADER VIA START ABOVE.
;
; ACTIONS (IN ORDER):
;  1. CLEAR DECIMAL MODE (CLD - PRECAUTION AFTER CODOS ENTRY).
;  2. ENABLE SVC HANDLER (SVCENB = $80).
;  3. PRINT VERSION BANNER VIA SVC #$02 (INLINE MESSAGE ON CHANNEL 2).
;  4. FETCH THE CURRENT DATE FROM CODOS VIA SVC #$1E INTO CURDATE.
;  5. PARSE COMMAND-LINE OPTIONS (PRS_CMD_LN / PARSE_ALL_OPTS / PROBE_MEM).
;  6. DETERMINE PASS-1 BEHAVIOUR:
;       - IF LST_DRIVE = 'N' (NO LISTING), CLEAR LST_F_OPN AND XREF_MODE.
;       - OTHERWISE OPEN THE LISTING CHANNEL.
;  7. RUN PASS 1 (P1_MAIN_LP).
;  8. IF ERRORS EXIST BUT LISTING IS ACTIVE:
;       - SET FLAGS FOR PASS-2 LISTING AND RE-RUN PASS 1 AS A SECOND PASS.
;  9. IF NO ERRORS: RUN PASS 2 (P2_MAIN_LP).
; 10. PRINT CROSS-REFERENCE TABLE IF ENABLED.
; 11. PRINT SUMMARY STATS, FLUSH LISTING, CLOSE CHANNELS, RETURN TO CODOS.
; ============================================================================
MAIN_ENTRY
            CLD                         ; CLEAR DECIMAL MODE
            LDA     #$80
            STA     SVCENB              ; ENABLE SVC (BRK) HANDLER
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02                 ; -> CHANNEL 2 (CONSOLE)
            .BYTE   $0D, 'MTU 6502 MACRO ASSEMBLER VERSION 1.1 (21-OCT-82)'
            .BYTE   $0D, 'COPYRIGHT 1982 MICRO TECHNOLOGY UNLIMITED', 0

            ; FETCH CURRENT DATE INTO CURDATE VIA SVC $1E
            LDA     #<CURDATE
            STA     U6
            LDA     #>CURDATE
            STA     U6+1
            LDY     #$00
            SVC     $1E                 ; OBTAIN CURRENT DATE INTO BUFFER AT U6

            LDA     #$FA
            STA     PG_LIN_CNT          ; INIT = $FA (TRIGGERS PG BREAK)
            LDA     #$00
            JSR     PRS_CMD_LN          ; PARSE SOURCE/OUTPUT FILENAMES
            JSR     OPEN_ERR_CH         ; OPEN ERROR FILE CHANNEL

            .IF     NOT-KIM1
            JSR     PROBE_MEM           ; DETERMINE SYMBOL-TABLE CEILING
            .ENDIF

            ; CHECK FOR NO-LISTING OPTION
            LDA     LST_DRIVE           ; LISTING DRIVE
            CMP     #'N'                ; 'N' = NO LISTING FILE
            BNE     MAEN_NOLIST
            LSR     LST_F_OPN           ; CLEAR LST_F_OPN (SHIFT MSB OUT)
            LSR     XREF_MODE           ; CLEAR CROSS-REFERENCE MODE
            JMP     MAEN_CONT

MAEN_NOLIST LDA     #$10                ; OPEN LISTING CHANNEL WITH MODE $10
            JSR     OPEN_LST_CH         ; ASSIGN LISTING CHANNEL
            LDA     #$80
            STA     LST_F_OPN           ; SET LST_F_OPN

MAEN_CONT   LDA     #$00
            STA     LISTING_ON          ; LISTING OFF INITIALLY
            STA     ERR_LST_R           ; ERROR LISTING OFF INITIALLY
            JSR     P1_MAIN_LP          ; PERFORM PASS 1

            ; CHECK FOR UNDEFINED SYMBOLS (ERR_CNT = ERROR COUNT)
            LDA     ERR_CNT
            ORA     ERR_CNT+1
            BEQ     MAEN_SKIP           ; NO ERRORS: SKIP TO PASS 2 SETUP

            ; ERRORS EXIST: CHECK IF LISTING IS ENABLED
            BIT     LST_F_OPN           ; TEST LST_F_OPN
            BPL     MAEN_DONE           ; NO LISTING: GO STRAIGHT TO CLEANUP

            ; RE-RUN PASS 1 AS A SECOND SCAN TO PRODUCE THE ERROR LISTING
            SEC
            ROR     LISTING_ON          ; ENABLE LISTING
            SEC
            ROR     ERR_LST_R           ; ENABLE ERROR LISTING
            JSR     P1_MAIN_LP          ; SECOND PASS-1 SCAN WITH LISTING
            JMP     MAEN_CONT2

MAEN_SKIP   JSR     PR_PAS_CNS          ; PRINT PASS-1 SUMMARY TO CONSOLE
            JSR     OPEN_OBJ_CH         ; OPEN OBJECT OUTPUT CHANNEL
            JSR     P2_MAIN_LP          ; PERFORM PASS 2 (EMIT OBJECT CODE)

MAEN_CONT2  BIT     LST_F_OPN           ; TEST LST_F_OPN
            BPL     MAEN_DONE
            JSR     PR_SYMTBL           ; PRINT CROSS-REFERENCE TABLE

MAEN_DONE   JSR     PR_PASS_SUM         ; PRINT PASS-1 SUMMARY TO CONS AND FILE
            JSR     FLSH_OB_B           ; FLUSH LISTING BUFFER
            JSR     PR_FIN_SUM          ; PRINT FINAL STATISTICS
            JSR     CLS_ALL_CH          ; CLOSE ALL CHANNELS
            NOP
            NOP
            RTS                         ; RETURN TO CODOS (CALLER FROM LOADER)

; ============================================================================
; CLS_ALL_CH
; FREES CODOS I/O CHANNELS SRC_CHANNEL, LST_CHANNEL, OBJ_CHANNEL, AND
; CON_CHANNEL VIA SVC #$16.  IF DEF_DEVICE <> 'N', ALSO FREES DEF_CHANNEL.
; ============================================================================
CLS_ALL_CH  LDX     SRC_CHANNEL         ; SOURCE CHANNEL
            SVC     $16                 ; FREE (CLOSE) A CHANNEL
            LDX     LST_CHANNEL         ; LIST CHANNEL
            SVC     $16
            LDX     OBJ_CHANNEL         ; OBJECT CHANNEL
            SVC     $16
            LDX     CON_CHANNEL         ; CONSOLE CHANNEL
            SVC     $16
            LDA     DEF_DEVICE          ; DEFINITIONS DEVICE
            CMP     #'N'                ; 'N' = NO DEFINITIONS FILE -> SKIP
            BEQ     CLA_RETRN
            LDX     DEF_CHANNEL         ; DEFINITIONS CHANNEL
            SVC     $16
CLA_RETRN   RTS

            .IF     NOT-KIM1
; ============================================================================
; DIS_IO_PAGE
; DISABLES THE MTU I/O PAGE AT $BE00-$BFFF BY WRITING TO ADDRESS $FFFE
; (HARDWARE BANK-SELECT REGISTER).  SETS THE HIGH BIT OF SEEIO AS A FLAG.
; THE BYTE WRITTEN TO $FFFE IS WHATEVER IS IN A ON ENTRY (CALLER'S CONTEXT).
; ============================================================================
DIS_IO_PAGE SEC
            ROR     SEEIO       ; SET BIT 7 OF SEEIO (I/O PAGE ACTIVE FLAG)
            STA     $FFFE       ; WRITE TO HARDWARE: ENABLE I/O PAGE
            RTS

; ============================================================================
; EN_IO_PAGE
; RE-ENABLES NORMAL RAM AT $BE00-$BFFF BY WRITING TO $FFFF.  CLEARS THE
; SEEIO FLAG IF IT WAS SET BY DIS_IO_PAGE.
; ============================================================================
EN_IO_PAGE  ASL     SEEIO       ; SHIFT OUT BIT 7 (CLEARS SEEIO FLAG)
            BMI     ENI_RETRN   ; IF STILL SET, SKIP WRITE (ALREADY ENABLED)
            STA     $FFFF       ; WRT TO HARDWARE: DISABLE IO PAGE (ENABLE RAM)
ENI_RETRN   RTS
            .ENDIF

; ============================================================================
; PRS_CMD_LN
; READS THE CODOS COMMAND-LINE BUFFER (OBTAINED VIA SVC #$0C) AND EXTRACTS:
;   1. SOURCE FILENAME -> LINE_BUF, THEN PARSED BY PRS_FNAME.
;   2. THREE OUTPUT FILENAME SLOTS (LISTING, OBJECT, DEFINITIONS) FILLED VIA
;      CP_FN_2_SL INTO SRC_FN_SL.
;   3. OPTION FLAGS (=M, =S, =E, =L, =N, ==) EXTRACTED BY PRS_OPTNS.
;
; THE COMMAND-LINE BUFFER POINTER IS AT U5 (OBTAINED FROM SVC $0C).
; SOURCE LINE TEXT IS ALSO COPIED INTO LINE_BUF.
; ============================================================================
PRS_CMD_LN  SVC     $0C             ; GET SYS BUF ADDRESSES -> U5=CMD LINE PTR
            STY     CMY_SAVE        ; CMY_SAVE = Y (START OF COMMAND LINE)
            LDX     CON_CHANNEL     ; CONSOLE CHANNEL
            LDA     #'C'            ; ASSIGN CONSOLE ('C' DEVICE) TO ERROR CHAN
            SVC     $15             ; ASSIGN CHANNEL TO DEVICE OR FILE
            LDY     #$00
            STY     SRC_DRIVE       ; SOURCE DRIVE = 0 (DEFAULT)
            STY     DIR_DEF_AC      ; CLEAR DIR_DEF_AC

            ; COPY COMMAND LINE TO LINE BUFFER UNTIL CR ($0D) OR 256 CHARS
PACMLI_LOOP LDA     (U5),Y
            CMP     #$0D            ; CR = END OF COMMAND LINE
            BEQ     PAC_CONT
            STA     LINE_BUF,Y      ; STORE IN LINE BUFFER
            INY
            BNE     PACMLI_LOOP

PAC_CONT    LDA     #$00
            STA     LINE_BUF,Y      ; NUL-TERMINATE LINE BUFFER
            INY
            STY     LN_BUF_LEN      ; LINE BUFFER LENGTH
            LDY     CMY_SAVE        ; RESTORE Y TO START OF COMMAND LINE
            JSR     SKP_LEAD_SP     ; SKIP SPACES -> Y POINTS TO 1ST NON-SPACE
            BNE     PAC_NONBL
PAC_NOFIL   JSR     RPT_ERROR       ; NO FILENAME FOUND -> FATAL ERROR

PAC_NONBL   JSR     IS_UPPER        ; CHECK: IS FIRST CHAR A-Z?
            BCS     PAC_NOFIL       ; NOT A VALID IDENTIFIER START -> ERROR
            LDA     #'A'
            STA     DEF_EXT_CH      ; SET DEFAULT EXTENSION 'A'
            JSR     PRS_FNAME       ; PARSE SRC FILENAME INTO FNAME_BUF RECORD
            BCC     PAC_GETDR
            JSR     RPT_ERROR       ; PARSE ERROR -> FATAL

PAC_GETDR   STY     CMD_CUR_POS     ; CMD_CUR_POS = Y (AFTER SOURCE FILENAME)
            LDA     PRSD_DRV        ; PARSED DRIVE NUMBER
            STA     SRC_DRIVE       ; SOURCE DRIVE
            STA     LST_DRIVE       ; LISTING DRIVE (SAME BY DEFAULT)
            STA     OBJ_DRIVE       ; OBJECT DRIVE (SAME BY DEFAULT)

            ; COPY PARSED SOURCE FILENAME INTO CHANNEL SLOT 0
            LDX     #SR_FNAM_OFF
            JSR     CP_FN_2_SL

            ; SET UP LISTING FILENAME: CHANGE EXTENSION TO 'L'
            LDX     EXTN_POS        ; EXTENSION POSITION IN FNAME_BUF
            LDA     #'L'            ; LISTING FILE EXTENSION
            STA     FNAME_BUF,X
            LDX     #LS_FNAM_OFF    ; SLOT 1 OFFSET (LST_FN_SL)
            JSR     CP_FN_2_SL

            ; SET UP OBJECT FILENAME: CHANGE EXTENSION TO 'C'
            LDX     EXTN_POS
            LDA     #'C'            ; OBJECT FILE EXTENSION
            STA     FNAME_BUF,X
            LDX     #OB_FNAM_OFF    ; SLOT 2 OFFSET (OBJ_FN_SL)
            JSR     CP_FN_2_SL

            LDY     CMY_SAVE        ; RESTORE Y TO COMMAND-LINE START
            JSR     SKP_LEAD_SP     ; SKIP SPACES
            BNE     PRS_OPTNS       ; MORE TOKENS: PARSE OPTIONS
            RTS                     ; END OF COMMAND LINE

; ============================================================================
; PRS_OPTNS
; SCANS REMAINING COMMAND-LINE TOKENS LOOKING FOR '=OPTION' PAIRS.
; RECOGNISES:
;   =<CHAR><VALUE>   NAMED OPTION: DELEGATES TO APPLY_NAMED_OPTION
;   ==<FILENAME>     LISTING REDIRECT: DELEGATES TO PARSE_LISTING_REDIR
; ============================================================================
PRS_OPTNS
            STY     OPT_START_Y         ; START OF OPTION
            JSR     IS_UPPER            ; IS CURRENT CHAR A-Z?
            BCC     PAOP_NEXT           ; YES: MIGHT BE AN OPTION KEYWORD
PAOP_FATAL  JSR     FAT_SYN_ER          ; NOT A VALID OPTION SYNTAX -> FATAL
            ; NOT REACHED

            .BYTE   $FE                 ; DEAD CODE

PAOP_NEXT   INY                         ; ADVANCE PAST CURRENT CHAR
            LDA     LINE_BUF,Y
            BEQ     PAOP_FATAL          ; EOL WITHOUT '=' -> ERROR
            CMP     COMMENT             ; COMMENT CHAR?
            BEQ     PAOP_FATAL          ; -> ERROR
            CMP     #'='
            BEQ     PAOP_EQUATE         ; FOUND '=' -> PROCESS OPTION
            CMP     #' '
            BNE     PAOP_NEXT           ; NOT SPACE: KEEP SCANNING FOR '='
            JSR     SKP_LEAD_SP         ; SKIP SPACES
            CMP     #'='
            BNE     PAOP_FATAL          ; NO '=' AFTER NAME -> ERROR

PAOP_EQUATE INY                         ; ADVANCE PAST '='
            LDA     LINE_BUF,Y
            CMP     #'='                ; DOUBLE '==' -> LISTING REDIRECT
            BNE     PAOP_SINGLE
            JSR     PRS_LST_RD
            JMP     PAOP_CONT

PAOP_SINGLE JSR     AP_NAMED_OP         ; PROCESS NAMED OPTION

PAOP_CONT   JSR     SKP_LEAD_SP         ; SKIP TO NEXT TOKEN
            BNE     PRS_OPTNS           ; MORE TOKENS: LOOP
            RTS

; ============================================================================
; AP_NAMED_OP
; READS THE OPTION LETTER PRECEDING THE '=' AND DISPATCHES:
;   M  -> MACRO CROSS-REFERENCE FLAG (XREF_MODE / LN_LST_FLG)
;   S  -> SUPPRESS FLAG (LST_SUPR OR ERR_LST_R)
;   L  -> LISTING DRIVE/DEVICE (LST_DRIVE)
;   N  -> 'NO LISTING' FLAG (ERR_DRIVE = ERR_DEVICE)
;   E  -> ERROR LISTING FLAG
;   O/X/D  -> OTHER EXTENSION OPTIONS (INDEXED VIA EXT_OPT_CH)
; ============================================================================
AP_NAMED_OP LDY     OPT_START_Y         ; START OF OPTION
            LDA     LINE_BUF,Y          ; OPTION LETTER
            STA     CURRENT_OPT         ; SAVE AS CURRENT OPTION LETTER
            CMP     #'M'
            BEQ     APNAOP_MOPT
            CMP     #'S'
            BNE     APNAOP_NOTS

APNAOP_MOPT JSR     ADV_SKP_LD ; SKIP TO CHAR AFTER OPTION LETTER
            JSR     ADV_SKP_LD ; SKIP '='
            CMP     #'N'                ; =N MEANS DISABLE THIS OPTION
            BNE     APN_FATAL
            LDX     #$00                ; VALUE = 0 (DISABLE)
            LDA     CURRENT_OPT
            CMP     #'M'                ; WAS IT 'M'?
            BEQ     APNAOP_SKIP
            STX     XREF_ENAB           ; DISABLE XREF FOR 'S'
APNAOP_SKIP STX     XREF_MODE           ; XREF_MODE = 0
            INY
            RTS

APNAOP_NOTS LDX     #$06                ; SEARCH EXT_OPT_CH BACKWARDS FOR
                                        ; VALID OPTION LETTER
APNAOP_LOOP LDA     EXT_OPT_CH-1,X
            CMP     CURRENT_OPT         ; COMPARE WITH OPTION LETTER
            BEQ     APN_FOUND           ; FOUND
            DEX
            BNE     APNAOP_LOOP

APN_FATAL   JSR     FAT_SYN_ER          ; UNKNOWN OPTION -> FATAL

APN_FOUND   STX     OPT_INDEX           ; SAVE OPTION INDEX
            LDA     DEF_EXTS,X          ; GET DEFAULT EXTENSION FOR THIS OPTION
            STA     DEF_EXT_CH          ; STORE AS DEFAULT EXTENSION
            INY
            JSR     ADV_SKP_LD          ; SKIP SPACES TO OPTION VALUE
            BEQ     APN_FATAL           ; EMPTY VALUE -> ERROR
            CMP     #$22                ; ''' = EXPLICIT FILENAME FOLLOWS
            BEQ     APN_FNAME
            JSR     ADV_PEK_BL          ; CHECK NEXT ISN'T BLANK (NULL/SPC/EOL)
            BEQ     APN_NONBL           ; NON BLANK -> USE SINGLE-CHAR VALUE
            DEY

APN_FNAME   JSR     PRS_FNAME           ; PARSE FILENAME VALUE
            BCS     APN_FATAL           ; PARSE ERROR -> FATAL OPTION ERROR
            LDX     OPT_INDEX           ; OPTION INDEX
            CPX     #$04                ; OPTION 4 = LISTING?
            BNE     APN_NOLST
            STY     LST_DRV_PS          ; LST_DRV_PS = Y (LISTING DRV POS)

APN_NOLST   LDA     PRSD_DRV            ; PARSED DRIVE NUMBER
            STA     SRC_DRIVE,X         ; STORE IN APPROPRIATE DRIVE VARIABLE
            LDA     CHAN_AS_TB,X        ; CHANNEL ASSIGNMENT TABLE INDEX
            TAX
            JSR     CP_FN_2_SL          ; COPY TO FILENAME SLOT
            RTS

APN_NONBL   DEY
            LDA     LINE_BUF,Y          ; SINGLE-CHAR VALUE (DEVICE LETTER)
            INY
            CMP     #'N'                ; 'N' = NONE/NULL
            BNE     APN_NSRDR
            LDX     OPT_INDEX
            STA     SRC_DRIVE,X         ; STORE 'N' AS DRIVE = NONE
            RTS

APN_NSRDR   LDX     CURRENT_OPT         ; OPTION LETTER
            CPX     #'L'                ; 'L' OPTION -> LISTING DRIVE
            BNE     APN_NLSTR
            STA     LST_DRIVE           ; LST_DRIVE = VALUE
            RTS

APN_NLSTR   CPX     #'E'                ; 'E' OPTION -> ERROR DRIVE
            BNE     APN_FATAL
            STA     ERR_DEVICE          ; ERR_DEVICE = VALUE
            RTS

; ============================================================================
; PRS_LST_RD
; HANDLES THE '==' DOUBLE-EQUALS SYNTAX FOR REDIRECTING LISTING/DEFINITIONS
; OUTPUT TO AN INLINE FILENAME IN THE COMMAND BUFFER.
; COPIES THE FILENAME TEXT TO THE DDEFSBUF BUFFER AND STORES THE END POINTER
; IN DDEFS_END
; ============================================================================
PRS_LST_RD  BIT     DIR_DEF_AC          ; TEST IF REDIRECT ALREADY ACTIVE
            BMI     PALIRE_SKIP         ; ALREADY ACTIVE: SKIP POINTER INIT
            LDA     #<DDEFSBUF          ; POINT TEMPP AT DIRECT-DEFINITIONS BUF
            STA     TEMPP
            LDA     #>DDEFSBUF          ; POINT TEMPP+1 AT DIRECT-DEFS BUF
            STA     TEMPP+1

PALIRE_SKIP SEC
            ROR     DIR_DEF_AC          ; ENABLE OUTPUT REDIRECT
            JSR     ADV_SKP_LD          ; SKIP PAST '='
            BNE     PALIRE_CONT
            JSR     FAT_SYN_ER          ; NO FILENAME AFTER '==' -> FATAL

PALIRE_CONT JSR     ADV_PEK_BL          ; SKIP NON-BLANKS
            BNE     PALIRE_CONT         ; KEEP SKIPPING UNTIL SPACE/EOL
            STY     CMD_END_POS         ; END OF FILENAME TOKEN
            LDY     OPT_START_Y         ; RESTORE Y TO START OF OPTION
            LDX     #$00

            ; COPY FILENAME TEXT FROM LINE_BUF INTO DDEFSBUF VIA (TEMPP)
PALIRE_COPY LDA     LINE_BUF,Y          ; READ CHAR FROM COMMAND LINE
            STA     (TEMPP,X)           ; STORE VIA (TEMPP+X=TEMPP SINCE X=0)
            INC     TEMPP               ; ADVANCE DESTINATION POINTER
            BNE     PAL_SKIP2
            INC     TEMPP+1
PAL_SKIP2   INY
            CPY     CMD_END_POS         ; PAST END OF FILENAME?
            BCC     PALIRE_COPY         ; NO: KEEP COPYING

            LDA     #$0D                ; APPEND CR TO TERMINATE THE BUF ENTRY
            STA     (TEMPP,X)
            INC     TEMPP
            BNE     PAL_SKIP3
            INC     TEMPP+1
PAL_SKIP3   LDA     TEMPP               ; SAVE END POINTER TO DDEFS_END
            STA     DDEFS_END
            LDA     TEMPP+1
            STA     DDEFS_END+1
            RTS

; ============================================================================
; PRS_FNAME
; PARSES A CODOS FILENAME FROM LINE_BUF AT (LINE_BUF,Y).
; ACCEPTS: [DRIVE_DIGIT ':'] NAME ['.' EXTENSION]
; THE PARSED 14-BYTE RECORD IS WRITTEN TO THE FNAME_BUF SCRATCH BUFFER.
; DRIVE DIGIT (IF PRESENT) IS STORED IN PRSD_DRV.
; RETURNS:  C CLEAR = SUCCESS,  C SET = PARSE ERROR.
; ============================================================================
PRS_FNAME   LDA     SRC_DRIVE           ; SOURCE DRIVE (CURRENT DEFAULT DRIVE)
            STA     PRSD_DRV            ; SET PARSED DRIVE WITH DEFAULT
            STY     LINE_POS            ; SAVE CURRENT LINE POSITION

            LDA     LINE_BUF,Y
            CMP     #$22                ; '''=USE CURRENT DEF FNAME (NO PARSE)
            BNE     PAF_GETFN

            ; COPY CURRENT DEFAULT FILENAME FROM SRC_FN_SL TO FNAME_BUF
            LDX     #$00
PAFI_COPY   LDA     SRC_FN_SL,X
            CMP     #'.'                ; EXTENSION DELIMITER FOUND -> STOP
            BEQ     PAFI_CHKEXT
            STA     FNAME_BUF,X
            INX
            BNE     PAFI_COPY

PAF_GETFN   JSR     IS_UPPER            ; IS FIRST CHAR A-Z?
            BCS     PAFI_RETERR         ; NO -> ERROR
            STA     FNAME_BUF           ; FIRST CHAR INTO NAME RECORD
            LDX     #$01                ; INDEX INTO FNAME_BUF
                                        ; (ALREADY STORED CHAR 0)

PAFI_CHKEXT INY                         ; ADVANCE TO NEXT CHAR
            JSR     PEK_BL_CHR          ; CHECK IF END-OF-NAME CHAR
                                        ; (SPACE/NUL/COMMENT)
            BEQ     PAFI_DEFEXT         ; END: NO EXTENSION -> USE DEFAULT
            CMP     #':'                ; DRIVE SEPARATOR?
            BEQ     PAFI_DEFEXT         ; -> PROCESS DRIVE DIGIT
            CMP     #'.'                ; EXTENSION DELIMITER?
            BEQ     PAF_PAREX           ; -> PARSE EXTENSION
            JSR     IS_LOCAL            ; VALID FILENAME CHAR?
            BCS     PAFI_RETERR         ; NO -> ERROR
            STA     FNAME_BUF,X         ; ACCUMULATE CHAR
            INX
            CPX     #$0D                ; MAX 13 CHARS IN NAME
            BCS     PAFI_RETERR         ; TOO LONG -> ERROR
            BCC     PAFI_CHKEXT         ; CONTINUE

PAF_PAREX   STA     FNAME_BUF,X         ; STORE '.'
            INX
            INY                         ; SKIP TO EXTENSION CHAR
            LDA     LINE_BUF,Y
            JSR     IS_ALNUM            ; MUST BE ALPHANUMERIC
            BCS     PAFI_RETERR         ; NOT VALID -> ERROR
            INY
            BNE     PAFI_CONT           ; CONTINUE WITH EXPLICIT EXTENSION CHAR

PAFI_DEFEXT LDA     #'.'                ; INSERT DEFAULT EXTENSION DELIMITER
            STA     FNAME_BUF,X
            INX
            LDA     DEF_EXT_CH          ; GET DEFAULT EXTENSION CHAR

PAFI_CONT   STA     FNAME_BUF,X         ; STORE EXTENSION CHAR
            CPX     #$03                ; NEED AT LEAST 3 CHAR FOR A VALID NAME
            STX     EXTN_POS            ; SAVE EXTENSION POSITION
            BCC     PAFI_RETERR         ; TOO SHORT -> ERROR

            JSR     SKP_LEAD_SP         ; SKIP SPACES
            BEQ     PAFI_DONE           ; EOL: DONE
            CMP     #':'                ; DRIVE SEPARATOR?
            BNE     PAFI_DONE           ; NO: DONE WITHOUT DRIVE

            ; PARSE DRIVE DIGIT AFTER ':'
            JSR     ADV_SKP_LD          ; SKIP ':'
            BEQ     PAFI_RETERR         ; NOTHING AFTER ':' -> ERROR
            JSR     IS_DIGIT            ; MUST BE DIGIT
            BCS     PAFI_RETERR         ; NOT A DIGIT -> ERROR
            SEC
            SBC     #'0'                ; CONVERT ASCII DIGIT TO DRIVE NUMBER
            STA     PRSD_DRV            ; SET PARSED DRIVE = DIGIT VALUE
            INY

PAFI_DONE   CLC                         ; C CLEAR = SUCCESS
            STY     CMY_SAVE            ; CMY_SAVE = Y (AFTER FILENAME)
            RTS
PAFI_RETERR SEC                         ; C SET = PARSE ERROR
            RTS

; ============================================================================
; CP_FN_2_SL
; COPIES 14 BYTES FROM THE FNAME_BUF SCRATCH BUFFER TO THE FILENAME RECORD AT
; FNAM_SLOT+X (CHANNEL NAME TABLE).  X = BYTE OFFS OF THE SLOT (0, $0E, $1C...)
; PRESERVES Y REGISTER.
; ============================================================================
CP_FN_2_SL  TYA
            PHA                         ; SAVE Y
            LDY     #$00
COFI_COPY   LDA     FNAME_BUF,Y
            STA     FNAM_SLOT,X         ; COPY TO FILENAME SLOT
            INX
            INY
            CPY     #$0E                ; 14 BYTES
            BCC     COFI_COPY
            PLA
            TAY                         ; RESTORE Y
            RTS

; ============================================================================
; FAT_SYN_ER
; OUTPUTS THE CURRENT SOURCE LINE TO CHANNEL 2 (CONSOLE), FOLLOWED BY THE
; 80-ASTERISK SEPARATOR LINE, THEN JUMPS TO FAT_CMD_SY
; TO ABORT WITH FAT_ERR_CD = 3 ('COMMAND SYNTAX').
; ============================================================================
FAT_SYN_ER  STY     LINE_POS            ; SAVE CURRENT LINE POSITION
            LDA     #<LINE_BUF0
            STA     U6
            LDA     #>LINE_BUF0
            STA     U6+1
            LDA     #$0D
            STA     LINE_BUF0           ; PREPEND CR TO SOURCE LINE
            LDY     LN_BUF_LEN          ; LINE_BUF LENGTH
            LDX     #$02                ; CHANNEL 2 (CONSOLE)
            SVC     6                   ; OUTPUT LINE OF TEXT ON CHANNEL
            LDA     #<ERR_SEP           ; ASTERISK SEPARATOR LINE
            STA     U6
            LDA     #>ERR_SEP
            STA     U6+1
            LDY     LINE_POS            ; RESTORE LINE POSITION
            SVC     6                   ; OUTPUT LINE OF TEXT ON CHANNEL
            JMP     FAT_CMD_SY
            ; DOES NOT RETURN

            .IF     NOT-KIM1
; ============================================================================
; PROBE_MEM
; DETERMINES THE TOP OF AVAILABLE RAM BY WRITING AND VERIFYING TEST PATTERNS
; PAGE BY PAGE, STARTING FROM ADDRESS 0 AND WORKING UP TO HEAP2END (THE
; CONFIGURED END OF SECONDARY HEAP).  THE PROBE POINTER IS HEAP2PRP.
;
; ALSO CONFIGURES THE MTU BANK-SELECT REGISTER BNKCTL: LOW 2 BITS ARE SET
; FROM BNK_CTL_BT TO SELECT THE WORKING BANK.
;
; ON EXIT:
;   HEAP2END/HEAP2END+1 = HIGHEST REACHABLE PAGE ADDRESS
;   EXP_BANK BIT 7 SET IF ANY SECONDARY HEAP PAGES RESPOND
;   BNKCTL IS LEFT POINTING TO BANK 3 (THE DATA BANK)
; ============================================================================
PROBE_MEM   LDX     #$00
            STX     EXP_BANK            ; EXP_BANK = 0 INITIALLY
            STX     HEAP2PRP            ; PROBE POINTER LOW = 0
            STX     HEAP2PRP+1          ; PROBE POINTER HIGH = 0
            LDA     BNKCTL              ; READ CURRENT BANK-CONTROL REGISTER
            AND     #$FC                ; BANK 3
            ORA     BNK_CTL_BT          ; APPLY BNK_CTL_BT
            STA     BNKCTL              ; WRITE BANK SELECT

PRME_LOOP   LDA     HEAP2PRP+1          ; CURRENT PAGE NUMBER
            CMP     HEAP2END+1          ; REACHED END OF SECONDARY HEAP?
            BEQ     PRME_BREAK          ; YES: STOP

            ; WRITE-BACK TEST: READ, INCREMENT, WRITE, COMPARE
            LDA     (HEAP2PRP,X)        ; READ BYTE AT CURRENT PAGE
            CLC
            ADC     #$01
            STA     (HEAP2PRP,X)        ; WRITE INCREMENTED VALUE
            CMP     (HEAP2PRP,X)        ; DID IT STICK?
            BNE     PRME_BREAK          ; NO: RAM NOT PRESENT HERE -> STOP
            SEC
            SBC     #$01
            STA     (HEAP2PRP,X)        ; RESTORE ORIGINAL VALUE
            INC     HEAP2PRP+1          ; ADVANCE TO NEXT PAGE
            JMP     PRME_LOOP

PRME_BREAK  ; SAVE PROBE RESULT AS ACTUAL SECONDARY HEAP END
            LDA     HEAP2PRP
            STA     HEAP2END            ; UPDATE SECONDARY HEAP END LOW
            LDA     HEAP2PRP+1
            STA     HEAP2END+1          ; UPDATE SECONDARY HEAP END HIGH
            BEQ     PRME_DONE           ; ZERO HIGH BYTE -> NO PAGES FOUND
            SEC
            ROR     EXP_BANK            ; EXP_BANK BIT 7 = 1 (RAM FOUND)

PRME_DONE   ; SWITCH BACK TO BANK 0 (DATA BANK)
            LDA     BNKCTL
            AND     #$FC                ; MASK OUT OTHER BITS
            ORA     #$03                ; RESTORE BANK 0
            STA     BNKCTL
            RTS
            .ENDIF

; ============================================================================
; CHARACTER CLASSIFICATION ROUTINES
;
; IS_ALNUM   C CLEAR IF A IS '0'-'9' OR 'A'-'Z';  C SET OTHERWISE
; IS_UPPER   C CLEAR IF A IS 'A'-'Z'    ;             C SET OTHERWISE
; SET_CARRY  ALWAYS SETS CARRY (SHARED 'REJECT' RETURN)
; IS_DIGIT   C CLEAR IF A IS '0'-'9'    ;             C SET OTHERWISE
; IS_LOCAL   C CLEAR IF A EQUALS THE LOCAL-LABEL CHAR (UNDERSCORE = '_')
;
; ALL ROUTINES PRESERVE A.
; ============================================================================
IS_ALNUM    JSR     IS_DIGIT
            BCC     RET_ALNUM           ; IT'S A DIGIT -> C CLEAR, RETURN
IS_UPPER    CMP     #'A'
            BCS     CHK_UPPER           ; >= 'A': MIGHT BE UPPERCASE LETTER
SET_CARRY   SEC
            RTS
CHK_UPPER   CMP     #'Z'+1              ; > 'Z'?
RET_ALNUM   RTS                         ; RETS C CLEAR IF IN RANGE,
                                        ; C SET OTHERWISE

IS_DIGIT    CMP     #'0'
            BCC     SET_CARRY           ; < '0': NOT A DIGIT
            CMP     #'9'+1              ; C CLEAR IF <= '9', SET IF > '9'
            RTS

IS_LOCAL    CMP     UNDERSCORE          ; COMPARE WITH LOCAL-LABEL CHAR ('_')
            BNE     IS_ALNUM            ; NOT '_': FALL THROUGH TO IS_ALNUM
            CLC
            RTS

; ============================================================================
; P1_MAIN_LP
; PERFORMS ASSEMBLER PASS 1: READS EVERY SOURCE LINE, PROCESSES LABELS INTO
; THE SYMBOL TABLE, AND ADVANCES THE LOCATION COUNTER TO ESTABLISH ADDRESSES.
; NO OBJECT CODE IS EMITTED TO THE OUTPUT FILE.
;
; ENTRY SEQUENCE:
;  1. INIT_LN_WS CLEARS PER-LINE SCRATCH.
;  2. HARDWARE COPY-PROTECTION CHECK: READS SPECIFIC NIBBLES FROM THE MTU
;     SPECIAL-REGISTER PORT AND COMPARES AGAINST HW_CK_DATA.
;     ABORTS WITH 'SYS. ERROR LEVEL 1' IF THEY DON'T MATCH.
;  3. INITIALISES THE SYMBOL TABLE (INIT_SYMTBL).
;  4. OPENS THE SOURCE CHANNEL VIA OPEN_CHAN / RD_NEXT_BK.
;  5. LOOPS: FOR EACH SOURCE LINE VIA RD_NEXT_LN, PROCESSES
;     LABELS (EVAL_EXPR), LOOKS UP THE OPCODE (LKP_OPCODE),
;     AND ADVANCES LOCCNT BY THE INSTRUCTION SIZE.
;  6. ERRFNP IS SET TO P1_ERR_HN (PASS-1 ERROR RECOVERY VECTOR).
; ============================================================================
P1_MAIN_LP  JSR     INIT_LN_WS          ; CLEAR PER-LINE WORKSPACE
            LDA     #$00
            STA     ENT_DEF             ; CLEAR ENT_DEF
            STA     PASSFLG             ; CLEAR PASSFLG (PASS 1)
            LDA     #$80
            STA     LST_ACT             ; SET LST_ACT
            LDA     LSTST               ; INIT LSTOUTP (LISTING WRITE PTR)
            STA     LSTOUTP
            LDA     LSTST+1
            STA     LSTOUTP+1
            JSR     INIT_SYMTBL         ; ZERO HASH TABLE AND INSTALL BUILT-IN
                                        ; MACROS

            .IF     NOT-KIM1
            ; HARDWARE COPY-PROTECTION CHECK
            JSR     DIS_IO_PAGE         ; ENABLE HARDWARE I/O
            STA     SPREGREN            ; ACTIVATE SPECIAL-REGISTER READ
            LDX     HW_CK_LEN           ; NUMBER OF NIBBLES TO CONSUME
DSC_NIBBL   LDA     SPREGREAD           ; READ AND DISCARD (SYNCHRONISE)
            DEX
            BNE     DSC_NIBBL
READ_NIBBLE LDA     SPREGREAD           ; READ A HARDWARE CHECK NIBBLE
            AND     #$0F                ; KEEP LOW NIBBLE
            CMP     HW_CK_DATA,X        ; COMPARE WITH EXPECTED HW_CK_DATA[X]
            BEQ     CHK_MATCH           ; MATCH: CONTINUE
            ; CHECKSUM FAILED -> PRINT ERROR AND RETURN TO MONITOR
            SVC     2                   ; OUTPUT INLINE MESSAGE ON CHANNEL
            .BYTE   $02
            .BYTE   $0D, 'SYS. ERROR LEVEL 1, PLEASE CALL MTU.', 0
            SVC     1                   ; RETURN TO CODOS MONITOR
            ; NOT REACHED

CHK_MATCH   INX
            CPX     #$05                ; ALL 4 NIBBLES CHECKED?
            BCC     READ_NIBBLE         ; NO: CHECK NEXT NIBBLE
            JSR     EN_IO_PAGE          ; RESTORE RAM
            .ENDIF

            ; INITIALISE SYMBOL VALUE POINTER AND SAVE IT
            LDA     #$00
            STA     SYMVAL
            STA     SYMVAL+1
            STA     SYMVAL+2
            LDA     SYMVALP             ; SAVE SYMVALP FOR PASS-2 RESTORE
            STA     SEGHEADP
            STA     SVP_SAVE
            LDA     SYMVALP+1
            STA     SEGHEADP+1
            STA     SVP_SAVE+1

            JSR     WR_PADDIN           ; WRITE FOUR ZERO BYTES TO OBJECT
                                        ; SEGMENT HEADER

            ; SAVE STACK POINTER FOR ERROR LONGJMP (ERR_TYPE_LADDER)
            TSX
            STX     SAVED_SP

            ; SET PASS-1 ERROR HANDLER
            LDA     #<P1_ERR_HN
            STA     ERRFNP
            LDA     #>P1_ERR_HN
            STA     ERRFNP+1

            ; OPEN SOURCE FILE CHANNEL AND READ FIRST BLOCK
            LDY     CMD_CUR_POS         ; GET CURRENT CURSOR POSITION
            JSR     OPEN_CHAN           ; OPEN SOURCE CHANNEL
            JSR     RD_NEXT_BK          ; READ NEXT BLOCK FROM CHANNEL
            BIT     DIR_DEF_AC          ; OUPUT REDIRECT ACTIVE?
            BPL     CHMA_NEXTB
            JSR     SET_DD_RDM          ; SET UP DIRECT-DEFS READ MODE
            JMP     P1_LINE_LP
CHMA_NEXTB  JSR     RD_BLK_SVC          ; READ NEXT BLOCK FROM CHANNEL
            JMP     P1_LINE_LP

; ============================================================================
; P1_ERR_HN
;
; PASS 1 ERROR HANDLER: PRINTS ERROR ANNOTATION, RESUMES AT NEXT LINE
; ============================================================================
P1_ERR_HN   JSR     RPT_LN_ERR          ; FORMAT ERROR LINE
            JMP     P1_END_CHK

; ============================================================================
; P1_ERR_CN
;
; PER-LINE CONTINUATION POINT FOR PASS 1.  JUMPED TO AT THE END OF EVERY
; SOURCE-LINE HANDLER (INSTRUCTION, DIRECTIVE, MACRO, LABEL-ONLY, EMPTY LINE,
; COMMENT LINE, OR AFTER AN INLINE ERROR RECOVERY).
;
; ACTIONS:
;   1. CLEARS VAL_OUT ($00) SO THE NEXT LINE STARTS WITH NO PENDING
;      OBJECT-BYTE VALUE FOR THE LISTING.
;   2. TESTS LISTING_ON: IF LISTING IS DISABLED (N CLEAR) JUMPS DIRECTLY TO
;      P1_END_CHK WITHOUT EMITTING ANY OUTPUT.
;   3. TESTS MAC_EXP: IF NOT CURRENTLY EXPANDING A MACRO GOES TO
;      @EMITL UNCONDITIONALLY; OTHERWISE ADDITIONALLY GUARDS ON LST_SPR2
;      AND SKIPS TO P1_END_CHK WHEN MACRO-BODY LISTING IS SUPPRESSED.
;   4. CALLS OUT_ERR_LN TO APPEND THE FORMATTED SOURCE / ERROR LINE TO
;      THE LISTING BUFFER.
;   5. FALLS THROUGH TO P1_END_CHK.
; ============================================================================
P1_ERR_CN   LDA     #$00
            STA     VAL_OUT             ; CLEAR VAL_OUT
            BIT     LISTING_ON          ; LISTING_ON?
            BPL     P1_END_CHK          ; NOT LISTING: SKIP OUTPUT
            BIT     MAC_EXP             ; MAC_EXP?
            BPL     PAE_EMITL
            BIT     LST_SPR2            ; LST_SPR2?
            BPL     P1_END_CHK
PAE_EMITL   JSR     OUT_ERR_LN          ; EMIT ERROR INDICATOR LINE

; ============================================================================
; P1_END_CHK
;
; END-OF-LINE CONVERGENCE POINT FOR PASS 1.  REACHED AFTER EVERY SUCCESSFULLY
; PROCESSED OR SKIPPED SOURCE LINE AND AFTER P1_ERR_CN FINISHES ANY
; OPTIONAL LISTING OUTPUT.
;
; CHECKS END_SEEN:
;   - IF CLEAR (.END NOT YET ENCOUNTERED) -> FALL THROUGH TO P1_LINE_LP
;     TO FETCH AND PROCESS THE NEXT SOURCE LINE.
;   - IF SET (.END DIRECTIVE WAS ASSEMBLED) -> JUMP TO END_OF_P1 TO
;     FINALISE THE PASS (FLUSH THE SEGMENT HEADER, CHECK .IF NESTING, RETURN).
; ============================================================================
P1_END_CHK  BIT     END_SEEN            ; .END DIRECTIVE FOUND?
            BPL     P1_LINE_LP          ; NO: PROCESS NEXT LINE
            JMP     END_OF_P1           ; YES: .END SEEN -> FINISH PASS

; ============================================================================
; P1_LINE_LP
;
; MAIN PER-LINE PROCESSING LOOP FOR ASSEMBLER PASS 1.
; ITERATES OVER EVERY SOURCE LINE OF THE CURRENT FILE (OR .READ INCLUDE),
; BUILDING THE SYMBOL TABLE AND ADVANCING THE LOCATION COUNTER WITHOUT
; EMITTING ANY OBJECT CODE.
;
; ON EACH ITERATION:
;   1. CHECKS INCLUDE_POP: IF SET, CALLS POP_INC_FR TO RETURN FROM A
;      .READ-INCLUDED FILE; IF THE INCLUDE STACK IS EMPTY, JUMPS TO
;      END_OF_P1 (SAME EFFECT AS .END).
;   2. CALLS RD_NEXT_LN TO LOAD THE NEXT SOURCE LINE INTO LINE_BUF.
;   3. SNAPSHOTS LOCCNT -> LOCCNT2 AND FORMATS THE ADDRESS DIGITS FOR THE
;      LISTING VIA OUT_AD_DIG.
;   4. DISPATCHES ON THE FIRST CHARACTER OF THE LINE:
;        NUL / COMMENT CHAR    -> P1_ERR_CN  (EMPTY OR COMMENT LINE)
;        SPACE                 -> @CKEQU             (NO LABEL FIELD)
;        ANYTHING ELSE         -> EVAL_EXPR    (DEFINE LABEL SYMBOL)
;   5. AFTER OPTIONAL LABEL PROCESSING, EXAMINES THE MNEMONIC/DIRECTIVE FIELD:
;        '='                   -> PRO_EQU_DI   (EQU ASSIGNMENT)
;        PCSYMBOL ('*')        -> PRO_ORG_DI   (ORIGIN ASSIGNMENT)
;        '.' + .MACRO KEYWORD  -> MACRO DEFINITION PATH
;        OTHER                 -> ASM_ZP_ABS + LKP_OPCODE:
;             OPCODE FOUND     -> ASM_INSTR    (COUNT BYTES, ADVANCE LC)
;             DIRECTIVE        -> HAN_DIREC
;             MACRO REFERENCE  -> DSP_MACRO
;   ALL PATHS END WITH JMP P1_ERR_CN.
; ============================================================================
P1_LINE_LP  BIT     INCLUDE_POP         ; INCLUDE_POP? (.READ RETURN PENDING)
            BPL     PALILO_CONT
            JSR     POP_INC_FR          ; POP INCLUDE FILE STACK
            BCC     PALILO_CONT         ; STACK NOT EMPTY: CONTINUE
            JMP     END_OF_P1           ; STACK EMPTY: SAME AS .END

            ; READ NEXT SOURCE LINE
PALILO_CONT JSR     RD_NEXT_LN
            LDA     LOCCNT
            STA     LOCCNT2             ; SNAPSHOT LOCAT. COUNTER FOR THIS LINE
            LDA     LOCCNT+1
            STA     LOCCNT2+1
            JSR     OUT_AD_DIG          ; FORMAT ADDRESS IN LISTING BUFFER

            LDY     #$00
            LDA     LINE_BUF            ; FIRST CHAR OF SOURCE LINE
            BEQ     P1_ERR_CN           ; EMPTY LINE
            CMP     COMMENT             ; COMMENT CHAR?
            BEQ     P1_ERR_CN
            CMP     #' '                ; SPACE = NO LABEL FIELD
            BEQ     PAL_CKEQU
            JSR     EVAL_EXPR           ; EVALUATE LABEL (DEFINE SYMBOL)

PAL_CKEQU   JSR     SKP_LEAD_SP         ; SKIP TO MNEMONIC/DIRECTIVE FIELD
            CMP     #'='
            BNE     PALILO_CKPC
            JSR     PRO_EQU_DI          ; HANDLE '=' EQU
            JMP     P1_ERR_CN

PALILO_CKPC CMP     PCSYMBOL            ; '*' = PROGRAM-COUNTER ASSIGN?
            BNE     PAL_CKDIR
            JSR     PRO_ORG_DI          ; HANDLE '*=' ORG
            JMP     P1_ERR_CN

PAL_CKDIR   CMP     #'.'                ; DIRECTIVE (STARTS WITH '.')?
            BNE     PALILO_CKOC
            JSR     DTC_MACRO           ; CHECK FOR .MACRO KEYWORD
            BCS     PAL_MACRO           ; YES: HANDLE MACRO DEFINITION

PALILO_CKOC JSR     ASM_ZP_ABS          ; DEFAULT INSTRUCTION FORM
            LDA     LINE_BUF,Y
            BEQ     P1_ERR_CN           ; EOL AFTER LABEL
            CMP     COMMENT
            BEQ     P1_ERR_CN

PAL_MACRO   JSR     LKP_OPCODE          ; LOOK UP MNEMONIC/OPCODE
            BPL     PAL_FOUND           ; FOUND AS REGULAR OPCODE: ASSEMBLE
            JSR     HAN_DIREC           ; HANDLE DIRECTIVE OR MACRO EXPANSION
            JMP     P1_ERR_CN

PAL_FOUND   BVC     PAL_ASSEM           ; V CLEAR: REAL INSTRUCTION
            JSR     DSP_MACRO           ; MACRO INVOCATION
            JMP     P1_ERR_CN

PAL_ASSEM   JSR     ASM_INSTR           ; ASSEMBLE INSTR. (PASS 1: COUNT BYTES)
            JMP     P1_ERR_CN

; ============================================================================
; END_OF_P1  -  END-OF-PASS FINALISATION FOR PASS 1.
; CALLED WHEN END_SEEN OR INCLUDE_POP FINDS THE INCLUDE STACK EMPTY.
; CALLS ADV_LOCCN TO EMIT THE FINAL SEGMENT HEADER, THEN
; PERFORMS SOME ADDRESSING ARITHMETIC ON SCRATCHP AND WRITES TO A COMPUTED
; LOCATION.  THE CONDITIONAL-FLAG CHECK AT THE END HANDLES MISMATCHED
; .IF/.ENDIF NESTING.
; ============================================================================
END_OF_P1   JSR     ADV_LOCCN           ; FLUSH PENDING SEGMENT HEADER

            .IF     NOT-KIM1
            ; SECOND PART OF THE CONCEALED HARDWARE-LOCK CHECK:
            ;
            ; HERE, SCRATCHP WAS PREVIOUSLY INITIZALIZED TO $5F71. AFTER
            ; THE SHIFT LEFT -> $BEE2, PLUS THE $E5 OFFSET -> $BFC7 == SPREGREN
            ; SO, 'STA (SCRATCHP),Y' ENABLES THE SPECIAL REGISTERS READ
            ;
            ASL     SCRATCHP            ; SHIFT SCRATCHP LEFT (SEE NOTE ABOVE)
            ROL     SCRATCHP+1          ; COMPLETE 16-BIT LEFT SHIFT
            BCC     ENOFPA_SKIP
            INC     RUN_EOR_SUM
ENOFPA_SKIP
            LDY     #$E5                ; FIXED OFFSET FOR SPREGREN
            LDA     RUN_EOR_SUM
            STA     (SCRATCHP),Y        ; ENABLE SPECIAL REGISTERS READ
            .ENDIF

            BIT     COND_DEPTH          ; COND_DEPTH: ANY OPEN .IF BLOCKS?
            BPL     ENOFPA_DONE
            ASL     COND_DEPTH          ; SHIFT DEPTH FLAG
            JSR     ERR_COND            ; ERROR: UNCLOSED CONDITIONAL
ENOFPA_DONE RTS

; ============================================================================
; P2_MAIN_LP
; PERFORMS ASSEMBLER PASS 2: RE-READS EVERY SOURCE LINE, RESOLVES ALL SYMBOL
; REFERENCES, EMITS OBJECT CODE TO THE OUTPUT FILE VIA EM_B_PAS2
; /OBJ_WR_B, AND WRITES THE ASSEMBLY LISTING.
;
; BEFORE THE MAIN LOOP, VERIFIES THAT THE SYMBOL TABLE WAS NOT CORRUPTED
; BETWEEN PASSES BY CHECKING CNC_CHKSM AGAINST THE VALUES STORED AT
; THE END OF PASS 1.  IF THEY DIFFER, A CRASH AT HALT IS TRIGGERED.
;
; ERRFNP IS SET TO P2_ERR_HN (PASS-2 ERROR RECOVERY VECTOR).
; ============================================================================
P2_MAIN_LP  JSR     INIT_LN_WS        ; CLEAR PER-LINE WORKSPACE
            LDA     #$00
            STA     OBJBUF_POS          ; EMPTY OBJECT OUTPUT BUFFER
            STA     OBJSEG_OPEN         ; CLEAR OBJSEG_OPEN
            STA     LST_ACT             ; CLEAR LST_ACT
            LDA     #$80
            STA     PASSFLG             ; PASSFLG = $80 (PASS 2)
            STA     SVCENB              ; SVCENB = $80 (SVC HANDLER ENABLED)
            SEC
            BIT     LST_F_OPN           ; LST_F_OPN?
            BMI     PAM_SETFL
            CLC

PAM_SETFL   ROR     LISTING_ON          ; BIT 7 = CARRY (LISTING IF FILE OPEN)

            ; RESTORE SYMVALP SAVE FROM END OF PASS 1
            LDA     SVP_SAVE
            STA     SEGHEADP
            LDA     SVP_SAVE+1
            STA     SEGHEADP+1

            ; REWIND SOURCE CHANNEL TO BEGINNING OF FILE
            LDX     SRC_CHANNEL
            SVC     $11                 ; SET CHANNEL POS. TO BEGINNING OF DATA

            .IF     NOT-KIM1
            ; THIRD PART OF THE CONCEALED HARDWARE-LOCK CHECK
            ;
            ; SCRATCHP HERE CONTAINS $BEE2 AFTER THE SHIFTING DONE IN END_OF_P1
            ; ADDING THE $E1 OFFSET->SPREGREAD, OR SPECIAL REGISTERS READ BYTE.
            ; COMPUTES CHECKSUM FOR HARDWARE-LOCK VERIFICATION
            ; READS HW_CK_LM1+1 BYTES (WHICH IS $0B) FROM SPREGREAD AND
            ; XOR-FOLDS THEM AGAINST RUN_EOR_SUM (RUNNING EOR SUM) AND CUM_XOR
            ; (CUMULATIVE XOR BYTE)
            ;
            LDY     #$E1
            LDX     HW_CK_LM1
            INX
PAMALO_LOOP LDA     (SCRATCHP),Y
            EOR     RUN_EOR_SUM
            STA     CUM_XOR             ; ACCUMULATE XOR INTO CUM_XOR
            DEX
            BNE     PAMALO_LOOP

            ; SECOND CHECKSUM PASS: NIBBLE-BASED SCRAMBLE INTO CNC_CHKSM
            LDA     CNC_CHKSM           ; THIS REALLY DOES NOTHING,
            LDX     #$05                ; AS A IS OVERWRITTEN BELOW
            CLC
PAM_LOOP2   LDA     (SCRATCHP),Y
            AND     #$0F                ; LOW NIBBLE ONLY
            CPX     #$02
            BEQ     PAM_SKIP2
            CPX     #$03
            BNE     PAMALO_SKIP
            ROL     A                   ; ROTATE NIBBLE FOR INDEX 3
            ROL     A
PAMALO_SKIP ROL     A                   ; ROTATE FOR ALL NON-SPECIAL INDICES
            ROL     A
            ROL     A
PAM_SKIP2   CLC
            ADC     CNC_CHKSM
            STA     CNC_CHKSM           ; ACCUMULATE INTO CNC_CHKSM
            BCC     PAM_SKIP3
            EOR     CNC_CHKSM+1
            STA     CNC_CHKSM+1
PAM_SKIP3   DEX
            BNE     PAM_LOOP2
            .ENDIF

            ; IF DEFINITIONS FILE IS NEEDED, ASSIGN THE CHANNEL
            LDA     #<DEF_FN_SL
            STA     U3
            LDA     #>DEF_FN_SL
            STA     U3+1
            LDA     DEF_DEVICE          ; DEFINITIONS DEVICE
            CMP     #'N'                ; 'N' = NO DEFINITIONS FILE
            BEQ     PAM_NODEF
            LDX     DEF_CHANNEL         ; SET DEFINITIONS CHANNEL FOR SVC
            SVC     $15                 ; ASSIGN CHANNEL TO DEVICE OR FILE
            SVC     $12                 ; SET CHANNEL POSITION TO END OF FILE

PAM_NODEF   JSR     RD_NEXT_BK          ; READ NEXT BLOCK FROM CHANNEL

            .IF     NOT-KIM1
            ; FOURTH PART OF THE CONCEALED HARDWARE-LOCK CHECK
            ;
            ; VERIFY MSB OF HARDWARE CHECKSUM AGAINST PASS-1 REFERENCE VALUES
            ;
            LDA     CNC_CHKSM+1
            EOR     CHK_REF+1
            BNE     CRASH               ; MISMATCH -> CRASH
            .ENDIF

            BIT     DIR_DEF_AC          ; REDIRECT ACTIVE?
            BPL     PAM_NORDR
            JSR     SET_DD_RDM
            JMP     PAM_SKIP4

PAM_NORDR   JSR     RD_BLK_SVC          ; READ NEXT BLOCK FROM CHANNEL

PAM_SKIP4   .IF     NOT-KIM1
            ; FIFTH AND LAST PART OF THE CONCEALED HARDWARE-LOCK CHECK
            ;
            ; VERIFY LSB OF HARDWARE CHECKSUM AGAINST PASS-1 REFERENCE VALUES
            ;
            LDA     CNC_CHKSM
            EOR     CHK_REF
            BEQ     PASS2_DONE          ; MATCH: PROCEED

CRASH       JMP     DO_HALT             ; CHECKSUM MISMATCH -> CRASH
            .ENDIF

PASS2_DONE  TSX
            STX     SAVED_SP            ; SAVE SP FOR ERROR LONGJMP
            LDA     #<P2_ERR_HN
            STA     ERRFNP
            LDA     #>P2_ERR_HN
            STA     ERRFNP+1
            JMP     P2_FETCH_L

; ============================================================================
; P2_ERR_HN
;
; PASS 2 ERROR RECOVERY HANDLER.  INSTALLED IN ERRFNP SO THAT ANY ERROR
; ROUTINE THAT PERFORMS A LONGJMP (RESTORING THE STACK POINTER FROM SAVED_SP
; AND JUMPING THROUGH ERRFNP) LANDS HERE INSTEAD OF CRASHING.
;
; ACTIONS:
;   1. CALLS RPT_LN_ERR TO FORMAT AND RECORD THE ERROR ANNOTATION FOR
;      THE CURRENT SOURCE LINE (INCREMENTS ERROR COUNTER, FILLS ERR_COUNT
;      DIGITS IN THE LISTING BUFFER).
;   2. JUMPS UNCONDITIONALLY TO P2_LINE_LP TO RESUME PROCESSING FROM THE
;      NEXT SOURCE LINE, SKIPPING ANY REMAINING WORK FOR THE FAULTING LINE.
;
; NOTE: P2_ERR_HN DOES NOT CALL OUT_ERR_LN ITSELF; THE LISTING
; OUTPUT FOR THE ERRONEOUS LINE IS HANDLED BY P2_ERR_CN AFTER CONTROL
; REACHES P2_LINE_LP.
; ============================================================================
P2_ERR_HN   JSR     RPT_LN_ERR
            JMP     P2_LINE_LP

; ============================================================================
; P2_ERR_CN
;
; PER-LINE CONTINUATION POINT FOR PASS 2.  STRUCTURALLY MIRRORS
; P1_ERR_CN; JUMPED TO AT THE END OF EVERY PASS-2 LINE HANDLER.
;
; ACTIONS:
;   1. CLEARS VAL_OUT ($00).
;   2. TESTS LISTING_ON: IF LISTING IS DISABLED (N CLEAR) JUMPS DIRECTLY TO
;      P2_LINE_LP.
;   3. TESTS MAC_EXP: IF NOT INSIDE A MACRO EXPANSION GOES TO @EMIT
;      UNCONDITIONALLY TO EMIT THE LISTING LINE; OTHERWISE GUARDS ON
;      LST_SPR2 AND JUMPS TO P2_LINE_LP WHEN SUPPRESSED.
;   4. CALLS OUT_ERR_LN TO WRITE THE FORMATTED LINE (WITH ANY ERROR
;      ANNOTATION AND OBJECT BYTES) TO THE LISTING OUTPUT BUFFER.
;   5. FALLS THROUGH TO P2_LINE_LP.
; ============================================================================
P2_ERR_CN   LDA     #$00
            STA     VAL_OUT             ; CLEAR VAL_OUT
            BIT     LISTING_ON          ; LISTING_ON?
            BPL     P2_LINE_LP
            BIT     MAC_EXP             ; MAC_EXP?
            BPL     PAERCO_EMIT
            BIT     LST_SPR2            ; LST_SPR2?
            BPL     P2_LINE_LP
PAERCO_EMIT JSR     OUT_ERR_LN

; ============================================================================
; P2_LINE_LP
;
; TOP-OF-LOOP CONVERGENCE POINT FOR PASS 2.  REACHED FROM P2_ERR_CN
; (AFTER OPTIONAL LISTING OUTPUT) AND FROM P2_ERR_HN (DIRECT JUMP).
;
; CHECKS END_SEEN:
;   - IF CLEAR (.END NOT YET SEEN) -> FALL THROUGH TO P2_FETCH_L TO
;     HANDLE ANY PENDING .READ STACK OPERATION AND READ THE NEXT SOURCE LINE.
;   - IF SET (.END DIRECTIVE ASSEMBLED) -> JUMP TO P2_END_FLS (PASS 2 END SEQ:
;     FLUSHES THE OBJECT OUTPUT BUFFER IF NON-EMPTY, THEN RETURNS).
; ============================================================================
P2_LINE_LP  BIT     END_SEEN            ; .END. DIRECTIVE FOUND??
            BPL     P2_FETCH_L
            JMP     P2_END_FLS          ; PASS 2 END SEQUENCE

; ============================================================================
; P2_FETCH_L
;
; ENTRY POINT FOR READING THE NEXT SOURCE LINE IN PASS 2.  ALSO REACHED FROM
; THE INITIALISATION SEQUENCE IMMEDIATELY AFTER THE STACK POINTER IS
; SAVED AND ERRFNP IS AIMED AT P2_ERR_HN.
;
; CHECKS INCLUDE_POP:
;   - IF CLEAR -> JUMP TO @NEXT TO READ THE NEXT LINE DIRECTLY.
;   - IF SET   -> CALL POP_INC_FR TO CLOSE THE CURRENT .READ-INCLUDED FILE
;     AND RESTORE THE PARENT FILE CONTEXT.
;       * IF THE INCLUDE STACK IS NOW NON-EMPTY (C CLEAR) -> CONTINUE AT @NEXT.
;       * IF THE STACK IS EMPTY (C SET) -> THE OUTERMOST FILE ENDED; JUMP TO
;         P2_END_FLS (PASS 2 END SEQUENCE / FLSH_OBJ + RTS).
; ============================================================================
P2_FETCH_L  BIT     INCLUDE_POP
            BPL     PAFELI_NEXT
            JSR     POP_INC_FR
            BCC     PAFELI_NEXT
            JMP     P2_END_FLS

PAFELI_NEXT JSR     RD_NEXT_LN
            LDA     LOCCNT
            STA     LOCCNT2
            LDA     LOCCNT+1
            STA     LOCCNT2+1
            JSR     OUT_AD_DIG

            LDY     #$00
            LDA     LINE_BUF            ; FIRST CHAR
            BEQ     P2_ERR_CN
            CMP     COMMENT             ; COMMENT?
            BEQ     P2_ERR_CN
            CMP     #' '
            BEQ     PAF_ISSPA
            JSR     EVAL_EXPR

PAF_ISSPA   JSR     SKP_LEAD_SP
            CMP     #'='
            BNE     PAF_CHKOR
            JSR     PRO_EQU_DI
            JMP     P2_ERR_CN

PAF_CHKOR   CMP     PCSYMBOL            ; '*=' ORG?
            BNE     PAF_CHKCM
            JSR     PRO_ORG_DI
            JMP     P2_ERR_CN

PAF_CHKCM   LDA     LINE_BUF,Y
            BEQ     P2_ERR_CN
            CMP     COMMENT
            BEQ     P2_ERR_CN
            JSR     LKP_OPCODE
            BPL     PAF_CHKMA
            JSR     HAN_DIREC
            JMP     P2_ERR_CN

PAF_CHKMA   BVC     PAF_ASSEM
            JSR     DSP_MACRO
            JMP     P2_ERR_CN

PAF_ASSEM   JSR     ASM_INSTR           ; ASSEMBLE AND EMIT INSTRUCTION BYTES
            JMP     P2_ERR_CN

; ============================================================================
; P2_END_FLS
;
; PASS 2 END-OF-ASSEMBLY SEQUENCE.  JUMPED TO FROM P2_LINE_LP WHEN
; END_SEEN IS SET, AND FROM P2_FETCH_L WHEN THE .READ INCLUDE STACK
; IS FOUND EMPTY (OUTERMOST SOURCE FILE EXHAUSTED).
;
; ============================================================================
P2_END_FLS  LDA     OBJBUF_POS          ; BYTES LEFT IN OUTPUT BUFFER?
            BEQ     PAE_RETRN           ; BUFFER ALREADY EMPTY, RETURN
            JSR     FLSH_OBJ            ; FLUSH OBJECT OUTPUT BUFFER

PAE_RETRN   RTS

; ============================================================================
; INIT_LN_WS
; CLEARS AND RESETS ALL PER-LINE ASSEMBLY STATE.  CALLED AT THE START OF
; EVERY SOURCE LINE IN BOTH PASSES AND ALSO ONCE AT THE BEGINNING OF EACH PASS.
;
; ACTIONS:
;  - RESETS DIGIT FIELDS: ERR_COUNT, ADDR_FILD, PREV_LOCAL, NEXT_LOCAL TO '0'.
;  - FILLS THE LISTING LINE BUFFER (LISTING_BUF, 46 BYTES) WITH SPACES.
;    BUG-1: THE STORE USES 'STA LISTING_BUF' (NO INDEX X) INSTEAD OF
;   'STA LISTING_BUF,X', SO ONLY LISTING_BUF[0] IS CLEARED PER ITERATION; THE
;    REST OF THE BUFFER IS NOT ZEROED.  (SEE BUG-1 IN THE FILE HEADER.)
;  - CLEARS MANY PER-LINE FLAG BYTES TO 0.
;  - SETS LN_LST_FLG = $80 (DEFAULT: LISTING ENABLED).
; ============================================================================
INIT_LN_WS  CLD
            LDA     #'0'
            LDX     #$03
INL_RESET1  STA     ERR_COUNT,X     ; RESET ERROR-COUNT DIGITS TO '0'
            DEX
            BPL     INL_RESET1
            LDX     #$03
INL_RESET2  STA     ADDR_FILD,X     ; RESET ADDRESS DIGITS TO '0'
            STA     PREV_LOCAL,X    ; RESET PREV_LOCAL DIGITS
            STA     NEXT_LOCAL,X    ; RESET NEXT_LOCAL DIGITS
            DEX
            BPL     INL_RESET2
            LDX     #$2D            ; 46 ITERATIONS ($2D+1)
            LDA     #' '
; BUG-1: SHOULD BE 'STA LISTING_BUF,X' TO SWEEP THE WHOLE BUFFER.
;        AS WRITTEN, EVERY ITERATION STORES TO LISTING_BUF[0].
;        THE LISTING LINE HEADER IS NOT CLEARED - THE PREVIOUS LINE'S
;        TITLE STRING / FORM-FEED BYTE IS LEFT IN PLACE.
INL_RESET3  STA     LISTING_BUF     ; *** BUG-1: MISSING ',X' INDEX REG. ***
            LDA     #' '
            DEX
            BPL     INL_RESET3
            STA     PAGE_NUMBER     ; CLEAR PAGE-NUMBER CHARS
            STA     PAGE_NUMBER+1
            STA     PAGE_NUMBER+2
            STA     PREV_LOCAL+3    ; CLEAR PREV_LOCAL[3]
            STA     NEXT_LOCAL+3    ; CLEAR NEXT_LOCAL[3]

            ; RESET MACRO ARGUMENT STACK POINTER TO BASE OF MACSTACK
            LDA     MACSST          ; MACSTACK START LOW
            STA     MARGSTRP        ; MACRO READ POINTER = BASE
            STA     MARGWRTP        ; MACRO WRITE POINTER = BASE
            STA     MACSPTR         ; MACSTACK CURRENT POS = BASE
            LDA     MACSST+1
            STA     MARGSTRP+1
            STA     MARGWRTP+1
            STA     MACSPTR+1

            ; CLEAR ALL PER-LINE FLAGS
            LDA     #$00
            STA     VAL_OUT         ; VAL_OUT = 0
            STA     OVL_NUM         ; OVL_NUM = 0
            STA     MAC_EXP         ; MAC_EXP = 0
            STA     BANK_NUM        ; BANK_NUM = 0
            STA     INC_ST_TP       ; INC_ST_TP = 0
            STA     COND_DEPTH      ; COND_DEPTH = 0
            STA     COND_ELSE       ; COND_ELSE = 0
            STA     LOCCNT          ; LOCATION COUNTER = 0
            STA     LOCCNT+1
            STA     ERR_TY_CD       ; ERR_TY_CD = 0
            STA     LINE_NUM        ; LINE_NUM LO = 0
            STA     LINE_NUM+1      ; LINE_NUM HI = 0
            STA     INCLUDE_POP     ; INCLUDE_POP = 0
            STA     END_SEEN        ; END_SEEN = 0
            STA     ERR_CNT         ; ERR_CNT LO = 0
            STA     ERR_CNT+1       ; ERR_CNT HI = 0
            STA     LST_SPR2        ; LST_SPR2 = 0
            STA     VAL_SUPR        ; VAL_SUPR = 0
            NOP
            NOP
            NOP
            LDA     #$80
            STA     LN_LST_FLG      ; LISTING ON BY DEFAULT
            NOP
            NOP
            NOP
            RTS

; ============================================================================
; DSP_MACRO
; DISPATCHES A MACRO INVOCATION THAT WAS MATCHED BY LKP_OPCODE WITH THE
; V FLAG SET.  READS THE MACRO BODY POINTER FROM THE SYMBOL-TABLE ENTRY AT
; (MATCHP,Y) AND JUMPS INDIRECTLY THROUGH MAC_BOD_V.
; ============================================================================
DSP_MACRO   LDY     SYM_MT_OFF          ; OFFSET OF MATCH IN ENTRY
            INY
            LDA     (MATCHP),Y          ; READ MACRO BODY POINTER
            STA     MAC_BOD_V 
            INY
            LDA     (MATCHP),Y
            STA     MAC_BOD_V+1
            LDY     LINE_POS            ; RESTORE LINE POSITION
            JSR     SKP_LEAD_SP         ; SKIP SPACES
            JMP     (MAC_BOD_V)         ; DISPATCH TO MACRO BODY READER

; ============================================================================
; HAN_DIREC
; CALLED WHEN LKP_OPCODE RETURNS WITH N FLAG SET (PSEUDO-OP / DIRECTIVE)
; OR WHEN A MACRO INVOCATION IS TO BE EXPANDED.  CHECKS MACRO_FLAGS
; TO DETERMINE THE DIRECTIVE TYPE:
;
;   BIT 6 (V) OF MACRO_FLAGS SET -> RECURSIVE MACRO CALL
;                                   (FINISH CURRENT EXPANSION)
;   BIT 5 (MACRO_FLAGS & $20) SET -> ALTERNATE ADDRESSING
;   OTHERWISE: PUSH A NEW EXPANSION FRAME AND PROCESS THE DIRECTIVE OPERAND.
; ============================================================================
HAN_DIREC   BIT     MACRO_FLAGS     ; MACRO_FLAGS: TEST V BIT (RECURSIVE CALL)
            BVS     HADI_ENDEXP     ; BIT 6 SET -> END CURRENT EXPANSION
            LDX     #$0B            ; DEFAULT: ERR_TY_CD TARGET = 11
            LDA     MACRO_FLAGS
            AND     #$20            ; TEST BIT 5 (ALTERNATE MODE)
            BEQ     HADI_CONT
            INX                     ; ALTERNATE: TARGET = 12
            LDY     LINE_POS
            JSR     SKP_LEAD_SP     ; SKIP SPACES TO OPERAND
            BEQ     HADI_ERROR      ; NO OPERAND -> ERROR
            JSR     EVAL_FULX       ; EVALUATE EXPRESSION

HADI_CONT   LDY     SYM_MT_OFF
            INY
            INY
            INY
            JMP     HADI_SIZE       ; JUMP TO SIZE-TABLE DISPATCH

; -- RECURSIVE/TAIL CASE --
HADI_ENDEXP LDY     LINE_POS
            JSR     SKP_LEAD_SP     ; SKIP SPACES
            BNE     HADI_CONT2
            
HADI_ERROR  JSR     ERR_SYN
            ; NOT REACHED

HADI_CONT2  JSR     PRS_ADRMD       ; PARSE ADDRESSING-MODE PREFIX
            STY     LINE_POS

HADI_LOOP   TXA
            CLC
            ADC     SYM_MT_OFF      ; COMPUTE ENTRY OFFSET: SYM_MT_OFF + X
            TAY
            INY
            INY
            INY
            LDA     (MATCHP),Y      ; READ SIZE TABLE ENTRY
            CMP     #$FF            ; $FF = NO MORE ENTRIES
            BNE     HADI_SIZE
            CPX     #$02
            BCC     HADI_ERROR2     ; X < 2: RANGE ERROR
            CPX     #$05
            BCS     HADI_ERROR2     ; X >= 5: RANGE ERROR
            TXA
            CLC
            ADC     #$05            ; ADVANCE BY 5 POSITIONS
            STA     ADDR_MODE       ; ADDR_MODE = NEW INDEX
            TAX
            BNE     HADI_LOOP       ; TRY AGAIN WITH NEW INDEX

HADI_SIZE   LDA     INST_SIZE,X     ; SIZE INCREMENT FROM INST_SIZE TABLE
            CLC
            ADC     LOCCNT          ; ADVANCE LOCATION COUNTER BY  INSTR. SIZE
            STA     LOCCNT
            BCC     HADI_SKIP
            INC     LOCCNT+1
HADI_SKIP   BIT     PASSFLG         ; PASS 2?
            BMI     HAD_ASSEM       ; YES: ASSEMBLE AND EMIT
            RTS                     ; PASS 1: JUST ADVANCE LOCCNT, DONE

HADI_ERROR2 JSR     ERR_ADDR        ; ADDRESSING RANGE ERROR
            ; NOT REACHED

HAD_ASSEM   LDA     (MATCHP),Y      ; RE-READ SYMBOL TABLE ENTRY BYTE
            CPX     #$07
            BCS     HAD_ALT_EM      ; X >= 7: DIFFERENT DISPATCH PATH
            CPX     #$00
            BEQ     HAD_EM_AB       ; X = 0: EMIT ABSOLUTE ADDRESS
            JSR     EM_1B_OP        ; EMIT SINGLE-BYTE VALUE
            BIT     URESFLG         ; UNRESOLVED?
            BMI     HADI_ERROR3     ; YES: ERROR
            RTS

HAD_EM_AB   JMP     EM_OPC_LS       ; EMIT 16-BIT ABSOLUTE ADDRESS

HAD_ALT_EM  CPX     #$0B
            BCS     HAD_CHK_AB
            JSR     EM_2B_OP        ; EMIT 16-BIT VALUE (TWO BYTES)
            LDX     ADDR_MODE
            CPX     #$0A
            BNE     HADI_CHKRES
            LDX     SYMVAL
            INX
            BNE     HADI_CHKRES
            LDY     LN_POS_SAV      ; SAVED LINE POSITION
            JSR     ERROR_RANGE     ; ERR_TYPE_LADDER (BRANCH RANGE ERROR)
            ; NOT REACHED

; BUG-3: @UNREACH IS DEAD CODE (UNREACHABLE).
; THE PRECEDING 'JSR ERROR_RANGE' NEVER RETURNS.  POSSIBLY, THE 'BCS @CHK_ABS'
; AT @ALT_EMIT SHOULD INSTEAD BE 'BCS @UNREACH'.
HAD_UNREA   BIT     URESFLG         ; (DEAD CODE) TEST UNRESOLVED FLAG
            BMI     HADI_ERROR3     ; (DEAD CODE) -> ERROR

HAD_CHK_AB  BEQ     HAD_EM_AB       ; X = 0 -> EMIT ABSOLUTE
            BIT     URESFLG
            BPL     HAD_EM_REL
            LDA     LOCCNT          ; UNRESOLVED: USE CURRENT PC AS VALUE
            STA     SYMVAL
            LDA     LOCCNT+1
            STA     SYMVAL+1

HAD_EM_REL  JSR     EM_BR_INS       ; EMIT RELATIVE BYTE (BRANCH OFFSET)

HADI_CHKRES BIT     URESFLG
            BMI     HADI_ERROR3     ; UNRESOLVED -> ERROR
            RTS

HADI_ERROR3 LDY     UNR_LN_POS      ; POSITION OF UNRESOLVED REFERENCE
            JSR     ERR_UNDEF       ; UNDEFINED REFERENCE
            ; NOT REACHED

; ============================================================================
; PRO_EQU_DI
; HANDLES THE '=' (EQU) LABEL ASSIGNMENT.
;   SINGLE '=': EVALUATES THE RIGHT-HAND EXPRESSION AND STORES THE RESULT IN
;     THE CURRENT SYMBOL-TABLE ENTRY    ; OUTPUTS VALUE DIGITS TO LISTING.
;   DOUBLE '==': TWO-PASS EQUATE; VALUE MUST BE KNOWN IN PASS 1.
; ============================================================================
PRO_EQU_DI  INY                     ; SKIP '='
            LDA     LINE_BUF,Y
            CMP     #'='            ; DOUBLE '==' ?
            BEQ     PRQ_DBLEQ
            JSR     EVAL_FULX       ; EVALUATE RHS EXPRESSION
            BPL     PRQ_KNOWN       ; N CLEAR: VALUE KNOWN
            BIT     PASSFLG         ; PASS 2?
            BMI     PRQ_ERR2        ; PASS 2 WITH UNRESOLVED RHS -> ERROR

PRQ_KNOWN   JSR     PEK_BL_CHR      ; CHECK END-OF-NAME CHAR (SPC/NUL/COMMENT)
            BNE     PRQ_ERR1        ; UNEXPECTED CHAR AFTER EXPRESSION -> ERROR
            JSR     EM_IN_REC       ; WRITE INSTRUCTION RECORD
            LDA     ENT_TY_FL
            AND     #$20            ; EXTERNAL SYMBOL?
            BNE     PRQ_EXTER
            JSR     OUT_VA_DIG      ; FORMAT VALUE IN LISTING
            LDA     #'='
            STA     EQUATE_CHAR     ; SHOW '=' IN LISTING ADDRESSING FIELD
            RTS

            ; EXTERNAL SYMBOL: SHOW DASHES INSTEAD OF VALUE
PRQ_EXTER   LDX     #$03
            LDA     #'-'
PREQDI_FILL STA     VALUE_FIELD,X   ; FILL VALUE FIELD WITH '----'
            DEX
            BPL     PREQDI_FILL
            LDA     #'='
            STA     EQUATE_CHAR
            RTS

PRQ_ERR1    JSR     ERR_SYN         ; SYNTAX ERROR
            ; NOT REACHED

            ; DOUBLE '==' EQUATE
PRQ_DBLEQ   BIT     PASSFLG         ; PASS 2?
            BMI     PREQDI_DONE     ; PASS 2: SKIP (== DEFINED IN PASS 1)
            JSR     EVAL_EX_AD      ; ADVANCE PAST SECOND '='
            BMI     PRQ_ERR2        ; EVALUATE: UNRESOLVED -> ERROR
            JSR     PEK_BL_CHR      ; CHECK END-OF-NAME CHAR (SPC/NUL/COMMENT)
            BNE     PRQ_ERR1
            JSR     EM_IN_RC2       ; WRITE INSTRUCTION RECORD (== FORM)
            JSR     OUT_VA_DIG
            LDA     #'='
            STA     EQUATE_CHAR
            STA     SEC_EQUAT       ; SHOW '==' IN LISTING FIELDS
PREQDI_DONE RTS

PRQ_ERR2    JSR     ERR_UNDEF       ; UNDEFINED REFERENCE
            ; NOT REACHED

; ============================================================================
; PRO_ORG_DI
; HANDLES THE '*=' (ORG / ORIGIN) ASSIGNMENT DIRECTIVE.
; EVALUATES THE ADDRESS EXPRESSION AND SETS LOCCNT/LOCCNT+1.
; ALSO CALLS ADV_LOCCN TO CLOSE ANY PENDING SEGMENT HEADER.
; ============================================================================
PRO_ORG_DI  INY
            LDA     LINE_BUF,Y
            CMP     #'='            ; MUST HAVE '=' AFTER '*'
            BNE     ERR_SYNTAX      ; NO '=' -> SYNTAX ERROR
            JSR     EVAL_EX_AD      ; EVALUATE ORG EXPRESSION
            BMI     ERR_UNREF       ; UNRESOLVED -> ERROR
            JSR     PEK_BL_CHR      ; CHECK END-OF-NAME CHAR (SPC/NUL/COMMENT)
            BNE     ERR_SYNTAX      ; UNEXPECTED CHARS -> ERROR
            JSR     ADV_LOCCN       ; CLOSE PENDING SEGMENT
            BIT     PASSFLG
            BMI     PROR_RET        ; PASS 2: DON'T RE-EVALUATE LABEL
            JSR     ASM_ZP_ABS      ; SET LOCCNT FROM SYMVAL
PROR_RET    RTS

ERR_UNREF   JSR     ERR_UNDEF       ; UNDEFINED REFERENCE
            ; NOT REACHED

ERR_SYNTAX  JSR     ERR_SYN         ; SYNTAX ERROR
            ; NOT REACHED

; ============================================================================
; HANDLE_OVL
; HANDLES THE '.OVL' (OVERLAY) DIRECTIVE.
; EVALUATES THE OVERLAY NUMBER EXPRESSION AND STORES IT IN OVL_NUM.
; OVERLAY NUMBERS MUST FIT IN 8 BITS (SYMVAL+1 AND SYMVAL+2 MUST BE ZERO).
; ============================================================================
HANDLE_OVL  JSR     SKP_LEAD_SP     ; SKIP SPACES
            BEQ     ERR_SYNTAX      ; NO OPERAND -> SYNTAX ERROR
            JSR     EVAL_FULX       ; EVALUATE OVERLAY NUMBER EXPRESSION
            BMI     ERR_UNREF       ; UNRESOLVED -> ERROR
            JSR     PEK_BL_CHR      ; CHECK END-OF-NAME CHAR (SPC/NUL/COMMENT)
            BNE     ERR_SYNTAX
            LDA     SYMVAL+1        ; HIGH BYTES MUST BE ZERO (8-BIT VALUE)
            ORA     SYMVAL+2
            BNE     ERR_RANGE       ; > 255 -> RANGE ERROR
            LDA     SYMVAL
            STA     OVL_NUM         ; EVALUATED OVERLAY NUMBER
            RTS

ERR_RANGE   JSR     ERROR_RANGE     ; ERR_TYPE_LADDER (RANGE ERROR)
            ; NOT REACHED

; ============================================================================
; HANDLE_BANK
; HANDLES THE '.BANK' DIRECTIVE.
; EVALUATES THE BANK NUMBER AND STORES IT IN BANK_NUM.
; BANK NUMBERS MUST BE 0-3 (< 4).
; ============================================================================
HANDLE_BANK JSR     SKP_LEAD_SP     ; SKIP SPACES
            BEQ     ERR_SYNTAX      ; NO OPERAND -> SYNTAX ERROR
            JSR     EVAL_FULX       ; EVALUATE BANK NUMBER EXPRESSION
            BMI     ERR_UNREF       ; UNRESOLVED -> ERROR
            JSR     PEK_BL_CHR      ; CHECK END-OF-NAME CHAR (SPC/NUL/COMMENT)
            BNE     ERR_SYNTAX
            LDA     SYMVAL+1        ; HIGH BYTES MUST BE ZERO (8-BIT VALUE)
            ORA     SYMVAL+2
            BNE     ERR_RANGE       ; > 255 -> RANGE ERROR
            LDA     SYMVAL
            CMP     #$04            ; BANK MUST BE 0-3
            BCS     ERR_RANGE       ; >= 4 -> RANGE ERROR
            STA     BANK_NUM        ; EVALUATED BANK NUMBER
            RTS

; ============================================================================
; ADV_LOCCN
; WRITES AN OBJECT-CODE SEGMENT HEADER WHEN THE LOCATION COUNTER HAS ADVANCED
; FROM ITS LAST CHECKPOINT (LOCCNT_BASE).
;
; A SEGMENT HEADER IS 4 BYTES AT (SEGHEADP):
;   WORD   SYMVALP           NEXT FREE HEAP ADDRESS (NEW SEGMENT START PTR)
;   WORD   (LOCCNT - BASE)   SEGMENT BYTE COUNT (SEG_SIZE)
;
; AFTER WRITING THE HEADER, FOUR ZERO BYTES OF PADDING ARE APPENDED VIA
; WR_PRI_HP (ONE CALL PER BYTE VIA WR_PADDIN), AND LOCCNT_BASE IS
; UPDATED.
;
; CALLED BY HANDLE_OVL, PRO_ORG_DI, HAN_ENTRY, END-OF-PASS, ETC.
; ============================================================================
ADV_LOCCN   LDA     LOCCNT
            SEC
            SBC     LOCCNT_BASE     ; SEG_SIZE = LOCCNT - LOCCNT_BASE
            STA     SEG_SIZE
            LDA     LOCCNT+1
            SBC     LOCCNT_BASE+1
            STA     SEG_SIZE+1
            ORA     SEG_SIZE
            BEQ     UPD_LOCCNT      ; SEGMENT SIZE = 0: NOTHING TO WRITE

            LDA     #$00
            STA     OBJSEG_OPEN     ; = 0 (CLOSE ANY PENDING SEGMENT)
            BIT     PASSFLG
            BMI     UPD_LOCCNT      ; PASS 2: SKIP HDR WRITE (DONE IN PASS 1)

            ; WRITE 4-BYTE SEGMENT HEADER INTO HEAP AT (SEGHEADP)
            LDY     #$00
            LDA     SYMVALP         ; SEGMENT START POINTER, LOW
            STA     (SEGHEADP),Y
            INY
            LDA     SYMVALP+1       ; SEGMENT START POINTER, HIGH
            STA     (SEGHEADP),Y
            INY
            LDA     SEG_SIZE
            STA     (SEGHEADP),Y
            INY
            LDA     SEG_SIZE+1
            STA     (SEGHEADP),Y

            ; ADVANCE SEGHEADP TO NEXT HEADER SLOT
            LDA     SYMVALP
            STA     SEGHEADP
            LDA     SYMVALP+1
            STA     SEGHEADP+1

; WRITE FOUR PADDING ZERO BYTES TO HEAP
;
WR_PADDIN   LDA     #$00
            JSR     WR_PRI_HP
            JSR     WR_PRI_HP
            JSR     WR_PRI_HP
            JSR     WR_PRI_HP

; UPDATE LOCATION COUNTER AND CHECKPOINT FROM SYMVAL (ORG VALUE)
;
UPD_LOCCNT  LDA     SYMVAL
            STA     LOCCNT          ; LOCCNT = NEW ORG VALUE
            STA     LOCCNT_BASE     ; LOCCNT_BASE = LOCCNT
            LDA     SYMVAL+1
            STA     LOCCNT+1
            STA     LOCCNT_BASE+1
            RTS

; ============================================================================
; HAN_ENTRY
; HANDLES THE '.ENTRY' DIRECTIVE.
; RECORDS THE CURRENT LOCATION COUNTER AS THE PROGRAM ENTRY POINT ADDRESS IN
; ENTRY_ADDR.  THE ENTRY-POINT ADDRESS IS WRITTEN TO THE OBJECT
; FILE HEADER ONCE (ON FIRST .ENTRY; DUPLICATE .ENTRY -> ERROR).
; ============================================================================
HAN_ENTRY   BIT     PASSFLG             ; PASS 1?
            BMI     HAEN_SKIP           ; PASS 2: ALREADY RECORDED -> SKIP
            BIT     ENT_DEF             ; ALREADY SEEN A .ENTRY?
            BMI     HAEN_ERROR          ; YES -> ERROR (DUPLICATE .ENTRY)
            SEC
            ROR     ENT_DEF             ; MARK AS SEEN
            LDA     LOCCNT
            STA     ENTRY_ADDR          ; ENTRY_ADDR = CURRENT LOCCNT
            LDA     LOCCNT+1
            STA     ENTRY_ADDR+1
HAEN_SKIP   RTS
HAEN_ERROR  JSR     ERR_DUP             ; ERR_TYPE_LADDER (DUPLICATE SYMBOL)
            ; NOT REACHED

; ============================================================================
; HANDLE_DATE
; HANDLES THE '.DATE' DIRECTIVE.
; EMITS 9 BYTES FROM CURDATE (THE DATE STRING FETCHED AT STARTUP) INTO THE
; OBJECT STREAM.  THE LOCATION COUNTER IS ADVANCED BY 9.
; IN PASS 1 ONLY: INCREMENTS LOCCNT BY 9 WITHOUT EMITTING.
; ============================================================================
HANDLE_DATE LDX     #$0B            ; SIZE INDEX (UNUSED AFTER THIS?)
            BIT     PASSFLG
            LDA     LOCCNT          ; ADVANCE LOCCNT BY 9 (DATE STRING LENGTH)
            CLC
            ADC     #$09
            STA     LOCCNT
            LDA     LOCCNT+1
            ADC     #$00
            STA     LOCCNT+1
            BIT     PASSFLG
            BPL     HADA_DONE       ; PASS 1: JUST ADVANCE, DONE
            LDY     #$00
HADA_LOOP   LDA     CURDATE,Y       ; READ ONE BYTE OF THE DATE STRING
            JSR     EM_DB_LST       ; EMIT TO OBJECT STREAM
            INY
            CPY     #$09            ; 9 BYTES EMITTED?
            BNE     HADA_LOOP
HADA_DONE   RTS

; ============================================================================
; HANDLE_FILL
; HANDLES THE '.FILL COUNT, VALUE' DIRECTIVE.
; EMITS 'COUNT' COPIES OF 'VALUE' (A .BYTE-TYPE EXPRESSION) INTO THE OBJECT
; STREAM.  USES THE NEGATED COUNT (FIL_CNT_NG) AND COUNTS UP TO ZERO.
; ============================================================================
HANDLE_FILL LDX     #$00
            STX     UNRES_POS       ; UNRES_POS = 0
            JSR     EVAL_FULX       ; EVALUATE COUNT EXPRESSION
            BIT     URESFLG
            BPL     HAFI_STOR
            JSR     ERR_UNDEF       ; UNRESOLVED COUNT -> ERROR
            ; NOT REACHED

            ; STORE NEGATED COUNT IN FIL_CNT_NG (COUNTS UP FROM NEG TO ZERO)
HAFI_STOR   LDA     #$00
            SEC
            SBC     SYMVAL          ; -COUNT LOW
            STA     FIL_CNT_NG
            LDA     #$00
            SBC     SYMVAL+1        ; -COUNT HIGH
            STA     FIL_CNT_NG+1
            LDA     SYMVAL+2
            BEQ     HAFI_CONT
            JSR     ERR_ARITH       ; COUNT TOO LARGE (> 16-BIT) -> RANGE ERROR
HAFI_CONT   ORA     SYMVAL+1
            ORA     SYMVAL
            BEQ     HAFI_DONE       ; COUNT = 0: NOTHING TO FILL
            JSR     SKP_LEAD_SP     ; SKIP TO ','
            CMP     #','
            BEQ     HAF_ADVAN
            JSR     ERR_SYN         ; NO COMMA -> SYNTAX ERROR
            ; NOT REACHED

HAF_ADVAN   JSR     ADV_SKP_LD      ; SKIP ','
            STY     FIL_LN_POS      ; START OF VALUE EXPRESSION

            ; EMIT 'COUNT' BYTES IN A LOOP (COUNTING UP FROM -COUNT TO 0)
HAFI_LOOP   LDY     FIL_LN_POS      ; RESTORE Y TO VALUE EXPRESSION
            JSR     EM_B_ENT        ; EMIT ONE .BYTE VALUE
            INC     FIL_CNT_NG      ; FIL_CNT_NG++
            BNE     HAFI_CHKLST
            INC     FIL_CNT_NG+1
            BEQ     HAFI_DONE       ; REACHED 0: DONE
HAFI_CHKLST BIT     LISTING_ON      ; LISTING_ON?
            BPL     HAFI_LOOP       ; NOT LISTING: TIGHT LOOP
            JSR     EM_LST_CNT      ; FLUSH LISTING LINE
            JMP     HAFI_LOOP

HAFI_DONE   RTS

            .IF     KIM1 
            *= CODE2
            .ENDIF

; ============================================================================
; EM_B_ENT
; EMITS ONE OR MORE BYTES FROM A COMMA-SEPARATED LIST OF EXPRESSIONS.
; HANDLES:
;   - NUMERIC EXPRESSIONS: EVALUATED AND EMITTED VIA EM_DB_LST
;   - QUOTED STRINGS: EACH CHARACTER EMITTED INDIVIDUALLY
;   - MULTIPLE COMMA-SEPARATED VALUES ON ONE LINE
; UNRES_POS IS SET TO THE LINE POSITION IF AN UNRESOLVED VALUE IS SEEN.
; ============================================================================
EM_B_ENT    LDX     #$00
            STX     UNRES_POS       ; UNRES_POS = 0

EMBYEN_LOOP LDX     #$0B            ; DEFAULT ERROR TYPE = 11
            JSR     SKP_LEAD_SP     ; SKIP SPACES
            CMP     APOSTROPHE      ; QUOTE CHAR?
            BEQ     EMB_STRNG       ; YES: STRING LITERAL

EMB_LOOP2   JSR     EVAL_FULX       ; EVALUATE NUMERIC EXPRESSION
            BIT     PASSFLG
            BPL     EMB_ADVAN       ; PASS 1: JUST ADVANCE LOCCNT
            LDA     SYMVAL
            JSR     EM_DB_LST       ; EMIT LOW BYTE OF VALUE
            BIT     URESFLG
            BPL     EMB_ADVAN
            LDA     UNRES_POS       ; WAS UNRES_POS ALREADY SET?
            BNE     EMB_ADVAN
            LDA     UNR_LN_POS      ; POSITION OF UNRESOLVED REFERENCE
            STA     UNRES_POS       ; UNRES_POS = POSITION FOR ERROR REPORTING

EMB_ADVAN   INC     LOCCNT          ; ADVANCE LOCATION COUNTER BY 1
            BNE     EMB_CHKSE
            INC     LOCCNT+1

EMB_CHKSE   LDA     LINE_BUF,Y      ; CHECK SEPARATOR AFTER VALUE
            BEQ     EMBYEN_DONE     ; EOL -> DONE
            CMP     COMMENT         ; COMMENT?
            BEQ     EMBYEN_DONE
            CMP     #' '
            BEQ     EMBYEN_DONE
            CMP     #','            ; COMMA -> NEXT VALUE IN LIST
            BNE     EMB_ERROR       ; UNEXPECTED CHAR -> ERROR
            JSR     EM_LST_CNT      ; FLUSH/UPDATE LISTING
            INY                     ; SKIP ','
            JMP     EMBYEN_LOOP     ; PROCESS NEXT VALUE

            ; -- STRING LITERAL HANDLING --
EMB_STRNG   INY                     ; SKIP OPENING QUOTE
            LDA     LINE_BUF,Y
            BNE     EMB_NEXTC
            DEY                     ; END OF LINE INSIDE STRING
            JMP     EMB_LOOP2

EMB_NEXTC   INY
            LDA     LINE_BUF,Y
            BEQ     EMB_CLOSE       ; EOL INSIDE STRING
            CMP     APOSTROPHE      ; CLOSING QUOTE?
            BNE     EMB_NOCLS

EMB_CLOSE   DEY                     ; BACK UP BEFORE CLOSING QUOTE / EOL
            DEY
            JMP     EMB_LOOP2       ; RE-EVALUATE (HANDLES EMPTY STRING)

EMB_NOCLS   DEY
EMBYEN_SCAN LDA     LINE_BUF,Y      ; SCAN STRING CHAR BY CHAR
            BEQ     EMB_ERROR       ; EOL WITHOUT CLOSING QUOTE -> ERROR
            INY
            CMP     APOSTROPHE      ; QUOTE?
            BEQ     EMB_CHKSE       ; YES: END OF STRING -> CHECK SEPARATOR
            INC     LOCCNT          ; ADVANCE LOCCNT FOR EACH CHAR
            BNE     EMBYEN_SKIP
            INC     LOCCNT+1
EMBYEN_SKIP BIT     PASSFLG
            BPL     EMBYEN_SCAN     ; PASS 1: ADVANCE ONLY
            JSR     EM_DB_LST       ; EMIT CHARACTER BYTE
            JMP     EMBYEN_SCAN

EMBYEN_DONE BIT     PASSFLG
            BPL     EMB_RETRN
            LDY     UNRES_POS       ; ANY UNRESOLVED BYTE?
            BEQ     EMB_RETRN
            JSR     ERR_UNDEF       ; YES -> UNDEFINED ERROR
            ; NOT REACHED

EMB_RETRN   RTS
EMB_ERROR   JSR     ERR_SYN
            ; NOT REACHED

            .BYTE   $86             ; DEAD CODE / SAFETY PADDING

; ============================================================================
; HANDLE_WORD
; HANDLES THE '.WORD' DIRECTIVE.
; SETS ENDIANNESS TO LITTLE-ENDIAN (LSB FIRST) AND FALLS THROUGH TO THE COMMON
; WORD/DBYTE HANDLER (WRD_DB_COM).
; ============================================================================
HANDLE_WORD LSR     ENDIANNESS      ; CLEAR ENDIANNESS  (0 -> LITTLE-ENDIAN)
            ; FALLTHROUGH TO COMMON HANDLER

; ============================================================================
; WRD_DB_COM
; COMMON HANDLER FOR .WORD (LITTLE-ENDIAN) AND .DBYTE (BIG-ENDIAN).
; PROCESSES A COMMA-SEPARATED LIST OF 16-BIT VALUES, EMITTING EACH AS TWO
; BYTES IN THE ORDER DETERMINED BY BENDIANFLG:
;   BENDIANFLG = 0:   LO, HI  (LITTLE-ENDIAN, FOR .WORD)
;   BENDIANFLG = $80: HI, LO  (BIG-ENDIAN,    FOR .DBYTE)
; THE LOCATION COUNTER IS ADVANCED BY 2 PER VALUE.
; ============================================================================
WRD_DB_COM  LDX     #$00
            STX     UNRES_POS           ; UNRES_POS = 0

WODBCO_NEXT LDX     #$0B                ; DEFAULT ERROR TYPE = 11
            JSR     EVAL_FULX           ; EVALUATE 16-BIT EXPRESSION
            BIT     PASSFLG
            BPL     WOD_ADVAN           ; PASS 1: ADVANCE LOCCNT ONLY
            BIT     ENDIANNESS          ; CHECK ENDIANNESS FLAG
            BMI     WOD_EM_BE           ; $80 = BIG-ENDIAN -> JUMP TO BE EMIT
            ; LITTLE-ENDIAN: EMIT LO THEN HI
            LDA     SYMVAL
            JSR     EM_DB_LST           ; EMIT LOW BYTE
            LDA     SYMVAL+1
            JSR     EM_DB_LST           ; EMIT HIGH BYTE
WOD_COMMO   BIT     URESFLG             ; UNRESOLVED?
            BPL     WOD_ADVAN
            LDA     UNRES_POS
            BNE     WOD_ADVAN
            LDA     UNR_LN_POS          ; POSITION OF UNRESOLVED REFERENCE
            STA     UNRES_POS

WOD_ADVAN   LDA     LOCCNT              ; ADVANCE LOCCNT BY 2
            CLC
            ADC     #$02
            STA     LOCCNT
            BCC     WOD_CHKSE
            INC     LOCCNT+1

WOD_CHKSE   LDA     LINE_BUF,Y          ; CHECK SEPARATOR
            BEQ     WOD_IS_SEP
            CMP     COMMENT
            BEQ     WOD_IS_SEP
            CMP     #' '
            BEQ     WOD_IS_SEP
            CMP     #','
            BNE     WOD_ERROR           ; UNEXPECTED CHAR -> ERROR
            JSR     EM_LST_CNT
            INY
            JMP     WODBCO_NEXT

WOD_IS_SEP  BIT     PASSFLG
            BPL     WODBCO_DONE
            LDY     UNRES_POS
            BEQ     WODBCO_DONE
            JSR     ERR_UNDEF           ; UNRESOLVED -> ERROR
            ; NOT REACHED

WODBCO_DONE RTS

WOD_EM_BE  ; BIG-ENDIAN: EMIT HI THEN LO (FOR .DBYTE)
            LDA     SYMVAL+1
            JSR     EM_DB_LST ; EMIT HIGH BYTE FIRST
            LDA     SYMVAL
            JSR     EM_DB_LST ; EMIT LOW BYTE
            JMP     WOD_COMMO

WOD_ERROR   JSR     ERR_SYN
            ; NOT REACHED

; ============================================================================
; HAN_DBYTE
; HANDLES THE '.DBYTE' DIRECTIVE.
; SETS ENDIANNESS TO BIG-ENDIAN (MSB FIRST) AND FALLS THROUGH TO WRD_DB_COM.
; ============================================================================
HAN_DBYTE   SEC
            ROR     ENDIANNESS          ; SET ENDIANNESS FLAG -> BIG-ENDIAN
            JMP     WRD_DB_COM

; ============================================================================
; HANDLE_END
; HANDLES THE '.END' DIRECTIVE.  SETS END_SEEN OR INCLUDE_POP
; DEPENDING ON WHETHER WE ARE INSIDE AN INCLUDE FILE.
; ============================================================================
HANDLE_END  SEC
            LDA     INC_ST_TP           ; INSIDE .READ?
            BNE     H_POP_INC           ; YES: POP INCLUDE
            ROR     END_SEEN            ; NO, END DETECXTED
RETURN      RTS                         ; <- HANDLER FOR '.OPT' POINTS HERE
H_POP_INC   ROR     INCLUDE_POP         ; SET INCLUDE_POP
            RTS

; ============================================================================
; HANDLE_PAGE
; HANDLES THE '.PAGE ['TITLE']' DIRECTIVE.
; IN PASS 2 ONLY: CLEARS THE LISTING LINE TEMPLATE, OPTIONALLY COPIES A
; TITLE STRING FROM THE SOURCE LINE, AND CALLS OUT_LN_PGB
; TO FORCE A NEW PAGE IN THE LISTING.
; ============================================================================
HANDLE_PAGE BIT     PASSFLG
            BMI     HAPA_CONT           ; PASS 2: PROCESS
            RTS                         ; PASS 1: IGNORE

HAPA_CONT   JSR     SKP_LEAD_SP         ; SKIP SPACES
            BEQ     HAPA_BREAK          ; NO TITLE: JUST BREAK PAGE
            CMP     APOSTROPHE          ; QUOTE?
            BNE     HAPA_ERROR          ; NOT A QUOTE -> SYNTAX ERROR
            ; CLEAR LISTING LINE TITLE AREA
            LDX     #$2D
            LDA     #' '
HAPA_CLEAR  STA     LISTING_BUF,X       ; CLEAR TITLE FIELD
            DEX
            BPL     HAPA_CLEAR
            LDX     #$00
            ; COPY TITLE STRING FROM SOURCE LINE TO LISTING TEMPLATE
HAPA_COPY   INY
            LDA     LINE_BUF,Y
            BEQ     HAPA_BREAK          ; EOL -> DONE
            CMP     APOSTROPHE          ; CLOSING QUOTE -> DONE
            BEQ     HAPA_BREAK
            STA     LISTING_BUF,X       ; STORE TITLE CHAR
            INX
            CPX     #$2D                ; MAX 45 TITLE CHARS
            BNE     HAPA_COPY

HAPA_BREAK  JMP     OUT_LN_PGB          ; FORCE PAGE BREAK IN LISTING

HAPA_ERROR  JSR     ERR_SYN             ; SYNTAX ERROR (NON-QUOTE AFTER .PAGE)
            ; NOT REACHED

; ============================================================================
; HANDLE_IFLT / HANDLE_IFLE / HANDLE_IFEQ / HANDLE_IFNE / HANDLE_IFGE /
; HANDLE_IFGT
; CONDITIONAL ASSEMBLY DIRECTIVES: COMPARE TWO EXPRESSIONS.
;
; ALL HANDLERS CALL CMP_IFXX WHICH EVALUATES BOTH OPERANDS AND
; SETS IFCMP_ZERO AND IFCMP_NEG:
;   IFCMP_ZERO = $FF WHEN OPERAND1 == OPERAND2
;   IFCMP_NEG  = $FF WHEN OPERAND1 < OPERAND2
;
; EACH HANDLER THEN TESTS THESE FLAGS AND, IF THE CONDITION IS FALSE,
; CALLS CND_ASM_SK TO SCAN FORWARD TO .ELSE OR .ENDIF.
; ============================================================================

; .IFLT: SKIP IF NOT (OPERAND1 < OPERAND2)
HANDLE_IFLT JSR     CMP_IFXX        ; EVALUATE AND COMPARE
            LDA     IFCMP_ZERO      ; BOTH OPERATORS WERE EQUAL
            ORA     IFCMP_NEG       ; OPERAND 1 < OPERAND2
            BPL     IFLT_DONE       ; NEITHER ZERO NOR NEG -> SKIP BLOCK
H_CND_SKIP  JMP     CND_ASM_SK      ; CONDITION FALSE -> SKIP
IFLT_DONE   RTS

; .IFLE: SKIP IF NOT (OPERAND1 <= OPERAND2)
HANDLE_IFLE JSR     CMP_IFXX        ; OPERAND1 < OPERAND2
            BIT     IFCMP_NEG       ; OPERAND1 < OPERAND2
            BMI     H_CND_SKIP      ; NEGATIVE -> CONDITION TRUE, SKIP BLOCK
            RTS

; .IFEQ: SKIP IF NOT (OPERAND1 == OPERAND2)
HANDLE_IFEQ JSR     CMP_IFXX        ; BOTH OPERANDS EQUAL?
            BIT     IFCMP_ZERO      ; BOTH OPERANDS EQUAL?
            BPL     H_CND_SKIP
            RTS

; .IFNE: SKIP IF NOT (OPERAND1 != OPERAND2)
HANDLE_IFNE JSR     CMP_IFXX        ; BOTH OPERANDS EQUAL?
            BIT     IFCMP_ZERO
            BMI     H_CND_SKIP
            RTS

; .IFGE: SKIP IF NOT (OPERAND1 >= OPERAND2)
HANDLE_IFGE JSR     CMP_IFXX
            LDA     IFCMP_ZERO
            ORA     IFCMP_NEG
            BPL     H_CND_SKIP
            RTS

; .IFGT: SKIP IF NOT (OPERAND1 > OPERAND2)
HANDLE_IFGT JSR     CMP_IFXX
            BIT     IFCMP_NEG
            BPL     H_CND_SKIP
            RTS

; ============================================================================
; HAN_IFNUL
; HANDLES '.IFNOT ' - SKIP THE BLOCK IF THE IMMEDIATELY FOLLOWING TOKEN IS
; NON-EMPTY (I.E. THE 'NULL' CONDITION IS: NO OPERAND PRESENT).
; ============================================================================
HAN_IFNUL   SEC
            ROR     COND_DEPTH      ; MARK .IF NESTING: COND_DEPTH BIT 7 SET
            LSR     COND_ELSE       ; CLEAR COND_ELSE BIT FOR THIS LEVEL
            JSR     SKP_LEAD_SP     ; SKIP SPACES
            BEQ     HAIF_DONE       ; EOL: OPERAND IS NULL -> CONDITION TRUE
            JMP     CND_ASM_SK      ; NON-EMPTY: CONDITION FALSE -> SKIP
HAIF_DONE   RTS

; ============================================================================
; CMP_IFXX
; COMMON SETUP AND COMPARISON FOR ALL .IFXX DIRECTIVES.
; SETS COND_DEPTH/COND_ELSE FLAGS, EVALUATES THE FIRST EXPRESSION INTO A
; TEMPORARY (IFCMP_VAL), THEN EVALUATES THE OPTIONAL SECOND EXPRESSION
; (SYMVAL).  COMPUTES THE 24-BIT SIGNED COMPARISON RESULT IN IFCMP_ZERO
; AND IFCMP_NEG.
; ============================================================================
CMP_IFXX    SEC
            ROR     COND_DEPTH          ; COND_DEPTH: MARK NEW .IF LEVEL
            LSR     COND_ELSE           ; COND_ELSE: CLEAR FOR THIS LEVEL
            JSR     SKP_LEAD_SP         ; SKIP SPACES
            JSR     EVAL_FULX           ; EVALUATE FIRST OPERAND
            BPL     COIF_CONT           ; N CLEAR (RESOLVED)
COIF_ERROR  JSR     ERR_UNDEF           ; UNRESOLVED -> ERROR
            ; NOT REACHED

COIF_CONT   ; SAVE FIRST OPERAND IN IFCMP_VAL
            LDA     SYMVAL
            STA     IFCMP_VAL
            LDA     SYMVAL+1
            STA     IFCMP_VAL+1
            LDA     SYMVAL+2
            STA     IFCMP_VAL+2
            ; CLEAR SECOND OPERAND (DEFAULT = 0 FOR SINGLE-OPERAND FORMS)
            LDA     #$00
            STA     SYMVAL
            STA     SYMVAL+1
            STA     SYMVAL+2
            JSR     SKP_LEAD_SP         ; CHECK FOR OPTIONAL SECOND OPERAND
            BEQ     COIF_CMP            ; EOL: COMPARE AGAINST 0
            CMP     #','                ; COMMA SEPARATOR?
            BEQ     COIF_ICOM
            JSR     ERR_SYN             ; NOT COMMA -> SYNTAX ERROR
            ; NOT REACHED

COIF_ICOM   JSR     ADV_SKP_LD          ; SKIP ','
            JSR     EVAL_FULX           ; EVALUATE SECOND OPERAND
            BMI     COIF_ERROR          ; UNRESOLVED -> ERROR

            ; PERFORM 24-BIT SIGNED COMPARISON: IFCMP_VAL - SYMVAL
COIF_CMP    LDA     #$00
            STA     IFCMP_ZERO          ; CLEAR IFCMP_ZERO
            STA     IFCMP_NEG           ; CLEAR IFCMP_NEG
            LDA     IFCMP_VAL
            CMP     SYMVAL
            BNE     COIF_LOWB           ; LOW BYTES DIFFER: COMPUTE SIGN
            LDA     IFCMP_VAL+1
            SBC     SYMVAL+1
            BNE     COIF_MIDB           ; MID BYTES DIFFER
            LDA     IFCMP_VAL+2
            SBC     SYMVAL+2
            BNE     COIF_HIGHB          ; HIGH BYTES DIFFER
            DEC     IFCMP_ZERO          ; ALL EQUAL: IFCMP_ZERO = $FF
            RTS

COIF_LOWB   LDA     IFCMP_VAL+1
            SBC     SYMVAL+1
COIF_MIDB   LDA     IFCMP_VAL+2
            SBC     SYMVAL+2
COIF_HIGHB  BMI     COIF_DONE           ; OPERAND2 < OPERAND1
            DEC     IFCMP_NEG           ; OPERAND1 < OPERAND2: IFCMP_NEG = $FF
COIF_DONE   RTS

; ============================================================================
; HANDLE_IF
; HANDLES THE '.IF EXPRESSION' DIRECTIVE.
; EVALUATES THE EXPRESSION; IF IT IS NON-ZERO THE BLOCK IS ASSEMBLED,
; OTHERWISE CND_ASM_SK IS CALLED TO SKIP TO .ELSE OR .ENDIF.
; ============================================================================
HANDLE_IF   JSR     SKP_LEAD_SP         ; SKIP TO EXPRESSION
            JSR     EVAL_FULX           ; EVALUATE
            BPL     HAIF_CONT
            JSR     ERR_UNDEF           ; UNRESOLVED -> ERROR
            ; NOT REACHED

HAIF_CONT   SEC
            ROR     COND_DEPTH          ; COND_DEPTH: MARK .IF LEVEL
            LSR     COND_ELSE           ; COND_ELSE = 0 FOR THIS LEVEL
            LDA     SYMVAL
            ORA     SYMVAL+1
            ORA     SYMVAL+2
            BEQ     CND_ASM_SK          ; EXPRESSION = 0: SKIP BLOCK
            RTS                         ; EXPRESSION != 0: ASSEMBLE BLOCK

; ============================================================================
; CND_ASM_SK
; IMPLEMENTS THE 'CONDITION IS FALSE' PATH FOR .IF* DIRECTIVES.
; SCANS SOURCE LINES (VIA RD_NEXT_LN) UNTIL A MATCHING .ELSE OR .ENDIF
; KEYWORD IS FOUND AT THE SAME NESTING DEPTH.
; HANDLES NESTED .IF/.ENDIF BY TRACKING DEPTH THROUGH COND_DEPTH / COND_ELSE.
; ============================================================================
CND_ASM_SK  BIT     LISTING_ON  ; LISTING_ON?
            BPL     COAS_NOLS
            BIT     MAC_EXP     ; MAC_EXP?
            BPL     COAS_OUTE
            BIT     LST_SPR2    ; LST_SPR2?
            BPL     COAS_NOLS
COAS_OUTE   JSR     OUT_ERR_LN  ; EMIT LISTING LINE WHILE SKIPPING

COAS_NOLS   BIT     END_SEEN    ; .END DIRECTIVE SEEN?
            BMI     CND_ERROR   ; YES -> ERROR (PREMATURE END)
            BIT     INCLUDE_POP ; INCLUDE_POP?
            BMI     CND_ERROR
            JSR     RD_NEXT_LN  ; READ NEXT SOURCE LINE WHILE SKIPPING
            LDY     #$00
            JSR     SKP_LEAD_SP ; SKIP SPACES
            CMP     #'.'        ; POTENTIAL DIRECTIVE?
            BNE     COAS_NOLS

            ; CHECK FOR .ELSE
            INY
            LDA     LINE_BUF,Y
            CMP     #'E'
            BNE     COAS_NOLS
            INY
            LDA     LINE_BUF,Y
            CMP     #'L'
            BNE     COAS_CHKND  ; NOT .ELSE: CHECK FOR .ENDIF
            INY
            LDA     LINE_BUF,Y
            CMP     #'S'
            BNE     COAS_NOLS
            INY
            LDA     LINE_BUF,Y
            CMP     #'E'
            BNE     COAS_NOLS
            ; FOUND .ELSE AT THIS LEVEL
            ASL     COND_ELSE   ; SHIFT COND_ELSE: CHECK IF ALREADY IN ELSE
            BCS     CND_ERROR   ; WAS ALREADY IN .ELSE -> ERROR (TWO .ELSES)
            SEC
            ROR     COND_ELSE   ; COND_ELSE = $80 (ENTERED .ELSE)
            RTS                 ; RESUME ASSEMBLY AT .ELSE BODY

            ; CHECK FOR .ENDIF
COAS_CHKND  CMP     #'N'
            BNE     COAS_NOLS
            INY
            LDA     LINE_BUF,Y
            CMP     #'D'
            BNE     COAS_NOLS
            INY
            LDA     LINE_BUF,Y
            CMP     #'I'
            BNE     COAS_NOLS
            INY
            LDA     LINE_BUF,Y
            CMP     #'F'
            BNE     COAS_NOLS
            ; FOUND .ENDIF AT THIS LEVEL
            ASL     COND_DEPTH  ; COND_DEPTH: POP ONE LEVEL
            ASL     COND_ELSE
            RTS                 ; RESUME ASSEMBLY AFTER .ENDIF

CND_ERROR   JSR     ERR_COND    ; CONDITIONAL NESTING ERROR

; ============================================================================
; HANDLE_ELSE
; HANDLES THE '.ELSE' DIRECTIVE WHEN ENCOUNTERED DURING NORMAL ASSEMBLY
; (I.E. THE CORRESPONDING .IF WAS TRUE AND WE NOW NEED TO SKIP THE ELSE BLOCK).
; ============================================================================
HANDLE_ELSE BIT     COND_DEPTH      ; COND_DEPTH: INSIDE .IF?
            BPL     CND_ERROR       ; NOT INSIDE .IF -> ERROR
            ASL     COND_ELSE       ; WERE WE IN .ELSE ALREADY?
            BCS     CND_ERROR       ; YES -> DUPLICATE .ELSE -> ERROR
            SEC
            ROR     COND_ELSE       ; COND_ELSE = $80 (NOW IN ELSE BLOCK)
            JMP     CND_ASM_SK      ; SKIP THE ELSE BODY

; ============================================================================
; HAN_ENDIF
; HANDLES '.ENDIF': POPS ONE CONDITIONAL NESTING LEVEL.
; ============================================================================
HAN_ENDIF   ASL     COND_DEPTH          ; COND_DEPTH: POP LEVEL
            BCC     CND_ERROR           ; WAS NOT INSIDE .IF -> ERROR
            ASL     COND_ELSE           ; POP COND_ELSE LEVEL
            RTS

; ============================================================================
; HANDLE_READ
; HANDLES THE '.READ FILENAME' INCLUDE DIRECTIVE.
; SAVES THE CURRENT FILE POSITION ONTO THE INCLUDE STACK (PUSH_INCL_FRAME),
; ASSIGNS A NEW SOURCE CHANNEL TO THE SPECIFIED FILE, AND STARTS READING
; FROM IT.
; ============================================================================
HANDLE_READ LDA     #'A'                ; SET DEFAULT EXTENSION FOR .READ FILES
            STA     DEF_EXT_CH
            JSR     SKP_LEAD_SP         ; SKIP SPACES
            BEQ     HARE_ERROR          ; NO FILENAME -> ERROR
            JSR     PRS_FNAME           ; PARSE INCLUDE FILENAME
            BCS     HARE_ERROR          ; PARSE ERROR
            JSR     SAV_FIL_PS          ; SAVE CURRENT POSITION
            LDX     #SR_FNAM_OFF
            JSR     CP_FN_2_SL          ; SET UP NEW FILENAME SLOT
            LDA     PRSD_DRV            ; PARSED DRIVE
            STA     SRC_DRIVE
            JSR     OPEN_CHAN           ; OPEN INCLUDE FILE
            JSR     RD_BLK_SVC          ; READ BLOCK FROM CHANNEL
            RTS
HARE_ERROR  JSR     RPT_ERROR

; ============================================================================
; RD_NEXT_BK
;
; IF OBJ_DEVICE CONTAINS A VALID DRIVE NUMBER (< 4, I.E., A REAL DISK
; DRIVE), INITIALIZES THE OBJECT CODE OUTPUT CHANNEL:
;   1. CLEARS THE FILE POSITION ACCUMULATOR U7/U7+1/U7+2.
;   2. PUSHES A FRAME ONTO THE INCLUDE STACK (PSH_INC_FR) TO BE
;      ABLE TO RESTORE THE ACTIVE CHANNEL STATE.
;   3. COPIES THE OBJECT FILENAME REGISTER (EXT_FN_SL, 14 BYTES) INTO THE
;      ACTIVE REGISTER FNAM_SLOT.
;   4. SAVES THE OBJECT DRIVE NUMBER IN SRC_DRIVE (CURRENT DRIVE).
;   5. CALLS OPEN_CHAN TO ASSIGN THE CHANNEL TO THE OBJECT FILE.
;
; IF OBJ_DEVICE >= 4 (E.G. 'N' = $4E = NO FILE OUTPUT), RETURNS WITHOUT DOING
; ANYTHING.
; ============================================================================
RD_NEXT_BK  LDA     OBJ_DEVICE          ; OBJECT FILE DEVICE
            CMP     #$04
            BCS     OBJ_OP_DN           ; >= 4 -> NO OBJECT FILE: EXIT
            LDA     #$00
            STA     U7                  ; CLEAR THE 24-BIT FILE POSITION
            STA     U7+1                ;  ACCUMULATOR (FOR PUSH_INCL_FRAME)
            STA     U7+2
            JSR     PSH_INC_FR          ; SAVE CURRENT STATE
            LDX     #$0D                ; 14 BYTES (INDICES 13..0)
OBJ_FN_CP   LDA     EXT_FN_SL,X         ; SOURCE: OBJECT FILENAME REGISTER
            STA     FNAM_SLOT,X         ; DESTINATION: ACTIVE FILENAME REGISTER
            DEX
            BPL     OBJ_FN_CP
            LDA     OBJ_DEVICE          ; RETRIEVE OBJECT DRIVE NUMBER
            STA     SRC_DRIVE           ; SET AS ACTIVE SOURCE DRIVE
            LDY     LST_DRV_PS          ; LST_DRV_PS (FOR OPEN_CHAN)
            JSR     OPEN_CHAN           ; ASSIGN CHANNEL TO OBJECT FILE
OBJ_OP_DN   RTS

            .BYTE   $7E                 ; DEAD BYTES (UNREACHABLE CODE)
            .BYTE   $7C

; ============================================================================
; HANDLE_DEF
;
; IMPLEMENTS THE '.DEF LABEL[,LABEL...]' DIRECTIVE.
; ONLY ACTIVE IN PASS 2 (RETURNS IMMEDIATELY IN PASS 1).
; FOR EACH SYMBOL IN THE LIST:
;   1. EVALUATES THE EXPRESSION (SYMBOL NAME).
;   2. IF THE VALUE IS RESOLVED, WRITES IT TO THE DEF CHANNEL (DEF_CHANNEL) AS
;      A TEXT LINE OF THE FORM:  'NAME== $XXXX'
;      USING SVC $06 (OUTPUT LINE) AND SVC $0A (HEX ENCODE).
;   3. IF THE DEF DEVICE IS 'N' (NONE), TERMINATES SILENTLY.
;   4. CONTINUES WITH THE NEXT COMMA-SEPARATED SYMBOL.
; ============================================================================
HANDLE_DEF  BIT     PASSFLG
            BPL     HDEF_DONE       ; PASS 1: DO NOTHING
HDE_NX_SY   JSR     SKP_LEAD_SP     ; SKIP SPACES; IS THERE AN OPERAND?
            BEQ     HDE_SY_ER       ; EMPTY LINE -> SYNTAX ERROR
            LDA     #$00
            STA     URESFLG         ; CLEAR UNRESOLVED REFERENCE FLAG
            JSR     EVAL_SYM_R      ; EVAL_SYMBOL_REF: EVALUATE NAME/EXPRESSION
            BIT     URESFLG
            BMI     HDE_UN_ER       ; UNRESOLVED VALUE -> ERROR
            LDA     DEF_DEVICE      ; DEFINITIONS DEVICE
            CMP     #'N'
            BEQ     HDEF_DONE       ; 'N' = NO OUTPUT -> TERMINATE
            SVC     $0C             ; SVC: GET SYSTEM BUFFER ADDRESSES
            LDY     #$00
HDE_NM_CP   LDA     IDENT_BUF,Y     ; NAME CHARACTER
            BEQ     HDE_WR_VA       ; END OF NAME (NUL) -> WRITE VALUE
            STA     (U6),Y          ; COPY TO SYSTEM OUTPUT BUFFER
            INY
            BNE     HDE_NM_CP
HDE_WR_VA   LDA     #'='
            STA     (U6),Y          ; FIRST '='
            INY
            STA     (U6),Y          ; SECOND '='
            INY
            LDA     #'$'
            STA     (U6),Y          ; HEXADECIMAL PREFIX
            INY
            LDA     SYMVAL
            STA     U0              ; VALUE TO ENCODE (16 BITS)
            LDA     SYMVAL+1
            STA     U0+1
            SVC     $0A             ; SVC: ENCODE U0 AS ASCII HEX IN THE BUFFER
            LDX     DEF_CHANNEL     ; DEFINITIONS CHANNEL FOR SVC
            SVC     6               ; SVC: EMIT LINE TO CHANNEL
            LDY     LINE_POS
            JSR     PEK_BL_CHR      ; ANY MORE SIGNIFICANT CHARS?
            BEQ     HDEF_DONE       ; END OF LINE -> TERMINATE
            CMP     #','
            BNE     HDE_SY_ER       ; NOT A COMMA -> ERROR
            INY                         ; SKIP THE COMMA
            BNE     HDE_NX_SY       ; PROCESS NEXT SYMBOL
HDEF_DONE   RTS
HDE_SY_ER   JSR     ERR_SYN         ; SYNTAX ERROR
            ; DOES NOT RETURN
HDE_UN_ER   LDY     LINE_POS
            JSR     ERR_UNDEF       ; UNRESOLVED REFERENCE
            ; DOES NOT RETURN

; ============================================================================
; HANDLE_LIST
;
; IMPLEMENTS THE '.LIST [EXPRESSION]' DIRECTIVE.
; CONTROLS THE SOURCE CODE LISTING OUTPUT.
; THE OPERAND IS A 3-BIT MASK ENCODED IN SYMVAL:
;   BIT 0 (LSB): ENABLE/DISABLE LISTING IN LN_LST_FLG
;   BIT 1:       ENABLE/DISABLE VAL_SUPR
;   BIT 2:       ENABLE/DISABLE LST_SPR2
; IF THERE IS NO OPERAND, USES THE DEFAULT VALUE 1 (ENABLE LISTING).
; ============================================================================
HANDLE_LIST LDA     #$01
            STA     SYMVAL          ; DEFAULT VALUE: 1 (ENABLE LISTING)
            JSR     SKP_LEAD_SP     ; SKIP SPACES; IS THERE AN OPERAND?
            BEQ     HLI_AP_VAL      ; NO OPERAND: USE DEFAULT VALUE
            JSR     EVAL_FULX       ; EVALUATE CONTROL EXPRESSION
            BPL     HLI_AP_VAL      ; N=0 -> OK
            JSR     ERR_UNDEF       ; N=1 -> UNRESOLVED REFERENCE: ERROR
            ; DOES NOT RETURN
HLI_AP_VAL  LDA     SYMVAL
            LSR     A               ; BIT 0 -> CARRY, TO ROTATE INTO LN_LST_FLG
            PHP                     ; SAVE CARRY
            ROR     LN_LST_FLG      ; LN_LST_FLG: BIT 7 = LISTING STATE
            PLP
            BIT     LST_F_OPN       ; LST_F_OPN?
            BPL     HLI_SET_FL      ; LIST CHANNEL CLOSED -> UPDATE FLAGS ONLY
            BIT     PASSFLG
            BMI     HLI_CK_ST       ; PASS 2: APPLY IMMEDIATELY
            BIT     ERR_LST_R       ; CHECK IF WE ARE ON ERROR LISTING PASS
            BPL     HLI_SET_FL      ; LISTING NOT ENABLED IN PASS 1: FLAGS ONLY
HLI_CK_ST   BIT     LISTING_ON      ; LISTING_ON CURRENTLY ACTIVE?
            BPL     HLI_ENABL       ; NOT ACTIVE -> ENABLE
            ROR     LISTING_ON      ; DISABLE LISTING (ROTATE BIT 7 FROM CARRY)
            BIT     LISTING_ON      ; DID IT STAY ACTIVE?
            BMI     HLI_SET_FL      ; YES -> DO NOT EMIT TRANSITION LINE
            JSR     OUT_ERR_LN      ; EMIT LAST LINE BEFORE DISABLING
            JMP     HLI_SET_FL
HLI_ENABL   ROR     LISTING_ON      ; ENABLE LISTING
HLI_SET_FL  LDA     SYMVAL
            LSR     A
            LSR     A               ; BIT 1 OF ORIGINAL VALUE -> CARRY
            ROR     VAL_SUPR        ; VAL_SUPR: BIT 7 = SUPPRESS VALUES
            LSR     A               ; BIT 2 OF ORIGINAL VALUE -> CARRY
            ROR     LST_SPR2        ; LST_SPR2
            RTS

; STUB: EMPTY RETURN
;
EMP_RET_ST  RTS
            NOP
            NOP

; ============================================================================
; HAN_MACRO
;
; IMPLEMENTS THE '.MACRO NAME [PARAM,...]' DIRECTIVE.
; PASS 1: CALLS DEF_MACRO TO REGISTER THE NAME IN THE SYMBOL TABLE
;         AND WRITE THE BODY HEADER TO THE HEAP. THEN READS AND STORES THE
;         MACRO BODY LINE BY LINE (VIA STR_MAC_LN) UNTIL .ENDMAC
;         IS FOUND.
; PASS 2: ONLY READS LINES UNTIL .ENDMAC WITHOUT STORING THEM (THEY ARE
;         ALREADY IN PASS 1 MEMORY); OPTIONALLY EMITS EACH LINE TO THE LISTING.
; IN BOTH PASSES: IF INCLUDE_POP IS DETECTED BEFORE .ENDMAC, IT'S AN ERROR
; (PREMATURE END OF MACRO).
; ============================================================================
HAN_MACRO   BIT     PASSFLG
            BMI     HM2_SC_LP       ; PASS 2: GO TO PASS 2 LOOP
            JSR     DEF_MACRO       ; REGISTER NAME AND HEADER
HM1_SC_LP   BIT     LISTING_ON      ; LISTING_ON?
            BPL     HM1_CHK_IN
            JSR     OUT_ERR_LN      ; EMIT LINE TO LISTING
HM1_CHK_IN  BIT     INCLUDE_POP     ; INCLUDE_POP: REQUESTED RETURN FROM .READ?
            BPL     HM1_RD_LN       ; NO -> READ NEXT LINE
HMAC_ABORT  JSR     ERR_MAC         ; SYNTAX ERROR (PREMATURE)
            ; DOES NOT RETURN
HM1_RD_LN   JSR     RD_NEXT_LN      ; READ THE NEXT SOURCE LINE
            JSR     DTC_ENDMAC      ; IS IT .ENDMAC?
            BCS     HM1_WR_TR       ; YES -> WRITE TERMINATOR AND EXIT
            JSR     STR_MAC_LN      ; STORE LINE IN THE MACRO BODY
            JMP     HM1_SC_LP
HM1_WR_TR   LDA     #$00
            JSR     WR_2_HEAP       ; WRITE $00 AS FINAL BODY TERMINATOR
            RTS
HM2_SC_LP   BIT     LISTING_ON      ; LISTING_ON?
            BPL     HM2_CHK_IN
            JSR     OUT_ERR_LN      ; EMIT LINE TO LISTING
HM2_CHK_IN  BIT     INCLUDE_POP     ; INCLUDE_POP?
            BMI     HMAC_ABORT      ; YES -> ERROR (PREMATURE END)
            JSR     RD_NEXT_LN      ; READ NEXT LINE
            JSR     DTC_ENDMAC      ; IS IT .ENDMAC?
            BCC     HM2_SC_LP       ; NO -> CONTINUE READING
            RTS                     ; YES -> END

; ============================================================================
; HAN_ENDMAC
;
; HANDLER FOR THE '.ENDMAC' DIRECTIVE WHEN FOUND OUTSIDE AN ACTIVE
; .MACRO BLOCK. THIS IS ALWAYS AN ERROR (REACHED ONLY IF .ENDMAC
; APPEARS WITHOUT ITS CORRESPONDING .MACRO).
; ============================================================================
HAN_ENDMAC  JSR     ERR_MAC             ; SYNTAX ERROR
            ; DOES NOT RETURN

; ============================================================================
; INIT_SYMTBL
;
; SYMBOL TABLE INITIALIZATION BEFORE EACH PASS.
; STEPS:
;   1. CALCULATES THE POINTER TO THE LAST HASH BUCKET (HASH_LAST =
;      HASHTEND - 2) FOR WRAP-AROUND SEARCHES.
;   2. COPIES HASHTST/HASHTST+1 INTO MACTBLP (MACRO TABLE BASE).
;   3. SWEEPS THE ENTIRE HASH AREA (HASHTST..HASHTEND) WITH ZEROS.
;   4. ACTIVATES THE SYMTBL_INIT FLAG TO INHIBIT NORMAL NAME WRITING
;      DURING PREDEFINED MACRO REGISTRATION.
;   5. INITIALIZES MACTBLP AND THE SECONDARY HEAP POINTERS (HEAP2PRP/HEAP2WRP)
;      WITH THE INTERNAL MACRO BASE (HEAP2ST).
;   6. TRAVERSES THE LINKED LIST OF PREDEFINED MACROS (AT HEAPST):
;      COPIES EACH MACRO NAME TO IDENT_BUF AND CALLS STB_HSH_LK (HASH INSERT).
;   7. CONFIGURES THE SYMTBLP[12]/[13] POINTERS WITH THE VALUES $71/$5F
;      (POINTING TO THE OPCODE OPERAND TABLE).
;   8. ADVANCES SYMVALP ONE BYTE PAST MACTBLP (START OF FREE HEAP).
;   9. CLEARS SYMTBL_INIT.
; ============================================================================
INIT_SYMTBL LDA     HASHTEND    ; END OF HASH TABLE, LOW BYTE
            SEC
            SBC     #$02
            STA     HASH_LAST   ; HASH_LAST = END - 2 (LAST BUCKET)
            LDA     HASHTEND+1
            SBC     #$00
            STA     HASH_LAST+1
            LDA     HASHTST     ; HASH TABLE BASE = MACRO BASE
            STA     MACTBLP
            LDA     HASHTST+1
            STA     MACTBLP+1
            LDY     #$00
            STY     SYM_COUNT   ; SYM_COUNT = 0
            STY     SYM_COUNT+1
            ; SWEEP THE HASH TABLE WITH ZEROS (PAGE BY PAGE)
ISM_CLR_PG  TYA
ISM_ZR_LP   STA     (MACTBLP),Y ; CLEAR EACH BYTE TO ZERO
            INY
            BNE     ISM_ZR_LP
            INC     MACTBLP+1   ; ADVANCE TO THE NEXT 256-BYTE BLOCK
            LDA     MACTBLP+1
            CMP     HASHTEND+1  ; DID WE REACH THE END?
            BNE     ISM_CLR_PG
            ; ACTIVATE INITIALIZATION FLAG (INHIBIT NAME WRITING)
            LDA     #$80
            STA     SYMTBL_INIT ; SYMTBL_INIT = ACTIVE
            ; POINT MACTBLP TO THE INTERNAL MACRO BASE (HEAPST)
            LDA     HEAPST
            STA     MACTBLP
            LDA     HEAPST+1
            STA     MACTBLP+1

            .IF     NOT-KIM1
            ; INITIALIZE SECONDARY HEAP POINTERS WITH HEAP2ST
            LDA     HEAP2ST
            STA     HEAP2WRP
            STA     HEAP2PRP
            LDA     HEAP2ST+1
            STA     HEAP2WRP+1
            STA     HEAP2PRP+1
            .ENDIF

            ; PREDEFINED MACRO REGISTRATION LOOP
ISM_MP_PRL  LDA     MACTBLP
            STA     SYMVALP     ; SYMVALP POINTS TO CURRENT ENTRY
            LDA     MACTBLP+1
            STA     SYMVALP+1
            LDX     #$00
            LDY     #$01        ; Y=1: SKIP THE LENGTH BYTE AT THE START
ISM_CP_NM   LDA     (MACTBLP),Y ; READ CHARACTER FROM NAME
            STA     IDENT_BUF,X ; COPY TO IDENT_BUF
            BMI     ISM_RG_MC   ; BIT 7 = 1 -> LAST CHAR OF NAME
            INX
            INY
            BNE     ISM_CP_NM
ISM_RG_MC   LDA     #$00
            STA     IDENT_BUF,X ; ADD NUL TERMINATOR TO NAME
            INC     SYMVALP     ; POINT SYMVALP TO BYTE FOLLOWING NAME
            BNE     ISM_HSH_IN
            INC     SYMVALP+1
ISM_HSH_IN  JSR     STB_HSH_LK  ; INSERT INTO HASH TABLE
            LDY     #$00
            LDA     (MACTBLP),Y ; READ ENTRY LENGTH BYTE
            CLC
            ADC     MACTBLP     ; ADVANCE MACTBLP TO THE NEXT MACRO
            STA     MACTBLP
            BCC     ISM_NX_MC
            INC     MACTBLP+1
ISM_NX_MC   LDA     (MACTBLP),Y ; ANY MORE ENTRIES? (0 = END OF LIST)
            BNE     ISM_MP_PRL

            .IF     NOT-KIM1
            ; FIRST PART OF THE CONCEALED HARDWARE-LOCK CHECK
            ;
            ; SYMTBLP,$0C IS ACTUALLY SCRATCHP
            ; SCRATCHP IS INITIALIZAED WITH $5F71, WHICH IS THEN MANIPULATED
            ; IN PARTS 2 AND 3 TO POINT TO SPREGREN Y SPREGREAD
            ;
            LDX     #$0C
            LDA     #$71
            STA     SYMTBLP,X   ; SYMTBLP[12] = $71 (LOW ADDRESS)
            INX
            LDA     #$5F
            STA     SYMTBLP,X   ; SYMTBLP[13] = $5F (HIGH ADDRESS)
            LDA     #$00
            STA     CNC_CHKSM
            STA     CNC_CHKSM+1
            .ENDIF

            ; SYMVALP = MACTBLP + 1 (START OF FREE HEAP)
            LDA     MACTBLP
            CLC
            ADC     #$01
            STA     SYMVALP
            LDA     MACTBLP+1
            ADC     #$00
            STA     SYMVALP+1
            ASL     SYMTBL_INIT ; SYMTBL_INIT = $00 (DISABLE INIT FLAG)
            RTS

; ============================================================================
; LKP_OPCODE
;
; LOOKS UP THE CURRENT TOKEN (FROM IDENT_BUF) IN THE MNEMONICS TABLE.
; FIRST APPENDS THE TERMINATOR CHARACTER '*' ($2A) TO THE NAME TO MATCH
; THE TABLE FORMAT, THEN CALLS STB_HSH_LK (HASH LOOKUP).
; SAVES THE POINTER TO THE FOUND ENTRY IN MATCHP/MATCHP+1.
;
; RETURN CODES (IN PROCESSOR FLAGS):
;   C CLR          -> NOT FOUND (UNKNOWN SYMBOL)
;   C SET, N=1     -> ASSEMBLER DIRECTIVE (PSEUDO-OP)
;   C SET, V=1     -> MACRO INVOCATION
;   C SET, N=0,V=0 -> NORMAL 6502 INSTRUCTION
; ============================================================================
LKP_OPCODE  STY     LN_POS_SV2  ; SAVE LINE POSITION (NEVER RECOVERED)
            JSR     EVAL_COLID  ; TOKENIZE THE CURRENT MNEMONIC
            LDX     IDENT_LEN   ; TOKEN LENGTH
            LDA     #'*'        ; ADD '*' TERMINATOR (TABLE FORMAT)
            STA     IDENT_BUF,X
            INX
            LDA     #$00
            STA     IDENT_BUF,X ; NUL AFTER '*'
            STX     IDENT_LEN   ; UPDATE LENGTH
            JSR     STB_HSH_LK  ; LOOK UP IN TABLE
            STY     SYM_MT_OFF  ; OFFSET OF FOUND FIELD
            LDA     SYMTBLP
            STA     MATCHP      ; SAVE POINTER TO FOUND BUCKET
            LDA     SYMTBLP+1
            STA     MATCHP+1
            BCC     LOP_NOT_FD  ; C=0 -> NOT FOUND
            BIT     ENT_TY_FL   ; ENT_TY_FL: V=1 -> MACRO
            BVC     LOP_IS_OP   ; V=0 -> NORMAL INSTRUCTION OR DIRECTIVE
            LDA     ENT_TY_FL
            ASL     A
            ASL     A
            STA     MACRO_FLAGS ; MACRO_FLAGS: COPY TYPE BITS
            JSR     EMP_RET_ST  ; EMPTY RETURN (STUB)
            BIT     MACRO_FLAGS ; RETURN MACRO TYPE FLAGS IN N/V
            RTS
            ; NOT FOUND: WRITE EMPTY ENTRY TO HEAP (XREF)
LOP_NOT_FD  LDA     #$C0
            JSR     WR_PRI_HP   ; WRITE $C0 ('NOT FOUND' FLAG)
            LDA     #$00
            JSR     WR_PRI_HP
            JSR     WR_PRI_HP
            JSR     WR_PRI_HP
            BIT     XREF_MODE   ; XREF_MODE ACTIVE?
            BPL     LOP_UND_ER  ; NO -> GO TO ERROR
            JSR     WR_PRI_HP   ; YES -> WRITE 4 ADDITIONAL XREF BYTES
            JSR     WR_PRI_HP
            LDA     LINE_NUM
            JSR     WR_PRI_HP
            LDA     LINE_NUM+1
            JSR     WR_PRI_HP
            JMP     LOP_UND_ER
LOP_IS_OP   JSR     RECORD_XREF ; REGISTER CROSS REFERENCE
LOP_UND_ER  LDY     LINE_POS
            JSR     ERR_UNDEF
            ; DOES NOT RETURN

; ============================================================================
; ASM_INSTR
;
; CORE OF INSTRUCTION ASSEMBLY IN PASS 2.
; STEPS:
;   1. RECORD_XREF: REGISTER MNEMONIC XREF.
;   2. READ THE POINTER TO THE OPCODES SUBTABLE FROM THE MNEMONICS TABLE
;      ENTRY (OFFSET SYM_MT_OFF+1,+2) -> OPC_TB_PTR.
;   3. CALL RSLV_OP_MD TO PARSE THE OPERAND AND
;      DETERMINE THE ADDRESSING MODE.
;   4. EMIT THE LISTING LINE IF APPLICABLE.
;   5. IF ASSEMBLY PRODUCED AN ERROR (BIT 7 OF MAC_EXP SET), INCREMENT
;      THE ERROR COUNTER (FAT_MAC_OV).
;   6. COPY OPC_TB_PTR -> OPCTBLP (OPCODE TABLE READ POINTER).
;   7. CALL INC_LOC_LB TO ADVANCE THE LOCAL LABEL
;      COUNTER.
; ============================================================================
ASM_INSTR   JSR     RECORD_XREF     ; REGISTER XREF
            LDY     SYM_MT_OFF      ; OFFSET OF FOUND FIELD
            INY
            LDA     (SYMTBLP),Y     ; READ POINTER TO OPCODES TABLE, LOW BYTE
            STA     OPC_TB_PTR
            INY
            LDA     (SYMTBLP),Y     ; HIGH BYTE
            STA     OPC_TB_PTR+1
            JSR     RSLV_OP_MD      ; PARSE OPERAND AND MODE
            BIT     LISTING_ON      ; LISTING_ON?
            BPL     AIN_LST_DN
            BIT     MAC_EXP         ; MAC_EXP?
            BMI     AIN_LST_DN      ; INSIDE MACRO: DO NOT EMIT LISTING HERE
            BIT     LST_SPR2        ; LST_SPR2?
            BMI     AIN_LST_DN
            JSR     OUT_ERR_LN      ; EMIT LISTING LINE
AIN_LST_DN  SEC
            ROR     MAC_EXP         ; MAC_EXP: READ ERROR BIT AND CLEAR
            BCC     AIN_SET_PT      ; NO ERROR -> CONTINUE
            JSR     FAT_MAC_OV
            ; DOES NOT RETURN
AIN_SET_PT  LDA     OPC_TB_PTR      ; POINTER TO OPCODES TABLE
            STA     OPCTBLP
            LDA     OPC_TB_PTR+1
            STA     OPCTBLP+1
            JSR     INC_LOC_LB      ; ADVANCE LOCAL LABEL
            RTS

; ============================================================================
; INC_LOC_LB
;
; INCREMENTS THE LOCAL LABEL ASCII COUNTER STORED AT PREV_LOCAL (4 CHARS,
; FORMAT '000 ' OR '0001' .. '9999'). CARRY PROPAGATES FROM DIGIT TO DIGIT
; (BCD IN ASCII). AFTER INCREMENTING, COPIES THE UPDATED COUNTER TO NEXT_LOCAL
; (USED IN LOCAL LABEL SUBSTITUTION).
; ============================================================================
INC_LOC_LB  LDX     #$03
            LDA     PREV_LOCAL,X    ; IS THE LAST DIGIT A SPACE?
            CMP     #' '
            BNE     ILL_IN_EN
            DEX                     ; YES -> SKIP SPACE; START AT PREVIOUS ONE
ILL_IN_EN   CLC
ILL_IN_LP   LDA     PREV_LOCAL,X
            CLC
            ADC     #$01            ; INCREMENT ASCII DIGIT
            STA     PREV_LOCAL,X
            CMP     #'9'+1
            BCC     ILL_CP_NXT      ; NO OVERFLOW -> COPY AND EXIT
            LDA     #'0'            ; OVERFLOW: RESET TO '0'
            STA     PREV_LOCAL,X
            DEX
            BPL     ILL_IN_LP       ; PROPAGATE CARRY TO PREVIOUS DIGIT
            LDA     #'1'
            STA     PREV_LOCAL      ; PREPEND '1' (TOTAL OVERFLOW)
            LDA     #'0'
            STA     PREV_LOCAL+3
ILL_CP_NXT  LDX     #$03
ILL_CP_LP   LDA     PREV_LOCAL,X    ; COPY PREV_LOCAL -> NEXT_LOCAL
            STA     NEXT_LOCAL,X
            DEX
            BPL     ILL_CP_LP
            RTS

; ============================================================================
; RSLV_OP_MD
;
; PARSES THE ARGUMENT LIST OF A MACRO INVOCATION OR INSTRUCTION.
; READS THE COMMA-SEPARATED TOKENS FROM THE OPERAND FIELD (LINE_BUF,Y) AND
; WRITES THEM SEQUENTIALLY TO THE ARGUMENT BUFFER (VIA WR_ARG_BY),
; SEPARATED BY NUL BYTES. COUNTS THE NUMBER OF ARGUMENTS IN MAC_ARG_CN.
; HANDLES STRINGS DELIMITED BY SINGLE QUOTES OR CURLY BRACES {}.
; UPON COMPLETION, WRITES AN EXTRA NUL AS A SENTINEL AND RETURNS THE CURRENT
; CHAR IN A AND UPDATED Y.
; ============================================================================
RSLV_OP_MD  JSR     PSH_MAC_FR          ; SAVE CALL FRAME
            LDA     #$00
            STA     MAC_ARG_CN          ; MAC_ARG_CN = 0
            LDY     LINE_POS
ROM_SC_LP   JSR     SKP_LEAD_SP         ; SKIP SPACES
            BEQ     ROM_DONE            ; END OF LINE -> TERMINATE
            CMP     COMMENT             ; COMMENT CHARACTER?
            BEQ     ROM_DONE
ROM_CK_COM  CMP     #','
            BNE     ROM_CK_STR          ; NOT A COMMA -> CHECK STRING
            LDA     #$00
            JSR     WR_ARG_BY           ; WRITE NUL AS ARGUMENT SEPARATOR
            INC     MAC_ARG_CN          ; INCREMENT ARGUMENT COUNTER
            INY
            JMP     ROM_SC_LP           ; PROCESS NEXT ARGUMENT
ROM_CK_STR  CMP     APOSTROPHE          ; SINGLE QUOTE (CHAR LITERAL)?
            BEQ     ROM_PRS_ST
            CMP     ARGLEFT             ; STRING DELIMITER '{'?
            BNE     ROM_CK_CMC
ROM_PRS_ST  JSR     SCN_STR_TO          ; SCAN AND COPY THE STRING
            JSR     SKP_LEAD_SP         ; SKIP SPACES AFTER THE STRING
            BEQ     ROM_CLS_AR          ; END OF LINE -> CLOSE ARGUMENT
            JMP     ROM_CK_COM          ; CHECK IF COMMA COMES NEXT
ROM_CK_CMC  CMP     COMMENT             ; COMMENT CHARACTER?
            BEQ     ROM_CLS_AR
            JSR     WR_ARG_BY           ; COPY CHAR TO ARGS BUFFER
            INY
            LDA     LINE_BUF,Y          ; READ NEXT CHAR
            BEQ     ROM_CLS_AR          ; END OF LINE
            CMP     #' '
            BNE     ROM_CK_COM          ; NOT SPACE -> CHECK AGAIN
ROM_CLS_AR  INC     MAC_ARG_CN          ; CLOSE ARGUMENT: INCREMENT COUNTER
ROM_DONE    LDA     #$00
            JSR     WR_ARG_BY           ; WRITE FINAL SENTINEL NUL
            LDA     LINE_BUF,Y          ; RETURN THE CURRENT CHARACTER
            RTS

; ============================================================================
; SCN_STR_TO
;
; SCANS AND COPIES THE CONTENT OF A DELIMITED STRING TO THE ARGUMENTS BUFFER.
; IF THE OPENING DELIMITER IS THE SINGLE QUOTE (APOSTROPHE), COPIES UNTIL THE
; NEXT SINGLE QUOTE. IF IT IS '{' (ARGLEFT), THE CLOSING DELIMITER IS
; '}' (ARGRIGHT). IT IS WRITTEN BYTE BY BYTE VIA WR_ARG_BY.
; ============================================================================
SCN_STR_TO  STA     STR_DELIM       ; SAVE OPEN DELIMITER
            CMP     APOSTROPHE      ; SINGLE QUOTE?
            BEQ     SST_CP_CH       ; YES: CLOSING DELIMITER IS THE SAME QUOTE
            LDA     ARGRIGHT        ; NO: CLOSING DELIMITER IS '}'
            STA     STR_DELIM
SST_SC_LP   INY
            LDA     LINE_BUF,Y      ; READ NEXT CHARACTER OF THE TOKEN
            BEQ     SST_FN_CH       ; END OF LINE -> RETURN
            CMP     STR_DELIM       ; IS IT THE CLOSING DELIMITER?
            BEQ     SST_CLS_DL
SST_CP_CH   JSR     WR_ARG_BY       ; COPY CHARACTER TO BUFFER
            JMP     SST_SC_LP
SST_CLS_DL  CMP     ARGRIGHT        ; IS THE CLOSING DELIMITER '}'?
            BEQ     SST_PA_DL       ; YES: CONSUME WITHOUT COPYING
            JSR     WR_ARG_BY       ; NO (SINGLE QUOTE): COPY THE CLOSING
SST_PA_DL   INY                     ; ADVANCE Y PAST THE CLOSING DELIMITER
SST_FN_CH   LDA     LINE_BUF,Y      ; RETURN NEXT CHARACTER AFTER THE STRING
            RTS

; ============================================================================
; RD_MAC_BB
;
; READS A BYTE OF THE MACRO BODY FROM THE POSITION INDICATED BY OPCTBLP
; (OPCODES TABLE READ POINTER / MACRO BODY) AND INCREMENTS THE POINTER.
; MANAGES ACCESS TO EXPANSION RAM (BANK 3) IF ACTIVE (BIT 7 OF EXP_BANK).
; RETURNS: A = READ BYTE, Z FLAGS = (BYTE == 0) (TO DETECT END OF LINE
; OR END OF BODY).
; ============================================================================
RD_MAC_BB   STX     RMB_SAVE            ; SAVE X
            LDX     #$00

            .IF     NOT-KIM1
            BIT     EXP_BANK            ; EXP_BANK: SECONDARY RAM ACTIVE?
            BPL     RMB_PR_RD           ; NO -> READ FROM PRIMARY HEAP
            ; READ FROM EXPANSION RAM (BANK BNK_CTL_BT)
            LDA     BNKCTL
            AND     #$FC                ; BANK 3
            ORA     BNK_CTL_BT          ; SELECT EXPANSION BANK
            STA     BNKCTL
            LDA     (OPCTBLP,X)         ; READ BODY BYTE
            PHA
            LDA     BNKCTL
            AND     #$FC                ; MASK OUT OTHER BITS
            ORA     #$03                ; RESTORE DATA BANK
            STA     BNKCTL
            PLA
            JMP     RMB_INC_PT
            .ENDIF

RMB_PR_RD   LDA     (OPCTBLP,X)         ; READ BYTE FROM PRIMARY HEAP
RMB_INC_PT  INC     OPCTBLP             ; ADVANCE READ POINTER
            BNE     RMBB_DONE
            INC     OPCTBLP+1
RMBB_DONE   LDX     RMB_SAVE            ; RESTORE X
            CMP     #$00                ; UPDATE Z FLAG (0 = END OF BLOCK)
            RTS

; ============================================================================
; WR_ARG_BY
;
; WRITES THE BYTE IN A TO THE MACRO ARGUMENT BUFFER (POINTER MARGWRTP)
; AND INCREMENTS MARGWRTP. CHECKS THAT THE BUFFER LIMIT (MACSEND) IS NOT
; EXCEEDED; IF IT OVERFLOWS, CALLS FAT_MAC_OV (COMPLEXITY ERROR).
; ============================================================================
WR_ARG_BY   STX     RWX_SAVE            ; SAVE X
            LDX     #$00
            STA     (MARGWRTP,X)        ; WRITE BYTE TO THE ARGUMENT BUFFER
            INC     MARGWRTP            ; ADVANCE WRITE POINTER
            BNE     WAB_CK_LIM
            INC     MARGWRTP+1
WAB_CK_LIM  LDA     MARGWRTP            ; BUFFER LIMIT EXCEEDED?
            CMP     MACSEND
            LDA     MARGWRTP+1
            SBC     MACSEND+1
            BCC     WAB_DONE            ; NO -> OK
            JSR     FAT_MAC_OV          ; YES -> COMPLEXITY ERROR
            ; DOES NOT RETURN
WAB_DONE    LDX     RWX_SAVE            ; RESTORE X
            RTS

; ============================================================================
; RD_ARG_BY
;
; READS A BYTE FROM THE ARGUMENT STRINGS BUFFER AT POSITION MARGSTRP
; AND INCREMENTS MARGSTRP. RETURNS: A = READ BYTE, Z FLAGS = (BYTE == 0).
; ============================================================================
RD_ARG_BY   STX     RWX_SAVE            ; SAVE X
            LDX     #$00
            LDA     (MARGSTRP,X)        ; READ BYTE FROM THE ARGUMENT BUFFER
            INC     MARGSTRP            ; ADVANCE READ POINTER
            BNE     RAB_DONE
            INC     MARGSTRP+1
RAB_DONE    LDX     RWX_SAVE            ; RESTORE X
            CMP     #$00                ; UPDATE Z FLAG
            RTS

; ============================================================================
; PSH_MAC_FR
;
; SAVES THE STATE OF THE CURRENT MACRO INVOCATION IN THE ARGUMENT BUFFER
; BEFORE PROCESSING A NEW EXPANSION LEVEL. WRITES 9 BYTES WITH THE
; CURRENT FRAME: {MACSPTR LO, MACSPTR HI, MAC_ARG_CN (ARG COUNT), OPCTBLP LO,
; OPCTBLP HI, NEXT_LOCAL[4]}. UPDATES MACSPTR TO THE CURRENT WRITE POINTER
;MARGWRTP.
; THIS ALLOWS NESTING MACRO EXPANSIONS.
; ============================================================================
PSH_MAC_FR  LDA     MACSPTR         ; PREVIOUS FRAME POINTER (LO)
            JSR     WR_ARG_BY
            LDA     MACSPTR+1       ; PREVIOUS FRAME POINTER (HI)
            JSR     WR_ARG_BY
            LDA     MAC_ARG_CN      ; CURRENT NUMBER OF ARGUMENTS
            JSR     WR_ARG_BY
            LDA     OPCTBLP         ; MACRO BODY READ POINTER (LO)
            JSR     WR_ARG_BY
            LDA     OPCTBLP+1
            JSR     WR_ARG_BY
            LDA     NEXT_LOCAL      ; NEXT_LOCAL[0]
            JSR     WR_ARG_BY
            LDA     NEXT_LOCAL+1    ; NEXT_LOCAL[1]
            JSR     WR_ARG_BY
            LDA     NEXT_LOCAL+2    ; NEXT_LOCAL[2]
            JSR     WR_ARG_BY
            LDA     NEXT_LOCAL+3    ; NEXT_LOCAL[3]
            JSR     WR_ARG_BY
            LDA     MARGWRTP        ; UPDATE FRAME PTR WITH CURRENT POSITION
            STA     MACSPTR
            LDA     MARGWRTP+1
            STA     MACSPTR+1
            RTS

; ============================================================================
; POP_MAC_FR
;
; RESTORES THE MACRO INVOCATION STATE FROM THE PREVIOUS LEVEL (UNDOES
; WHAT PSH_MAC_FR DID).
; IF MACSPTR == MACSST (ARGUMENT STACK BASE), THE STACK IS EMPTY:
; RETURNS C SET (NO MORE FRAMES TO RESTORE -> END OF EXPANSION).
; IF THERE IS A PREVIOUS FRAME: RESTORES MACSPTR, MAC_ARG_CN, OPCTBLP,
; NEXT_LOCAL FROM THE9 SAVED BYTES AND RETURNS C CLEAR.
; ============================================================================
POP_MAC_FR  LDA     MACSPTR         ; ARE WE AT THE BASE OF THE STACK?
            CMP     MACSST
            BNE     PMC_RSTOR
            LDA     MACSPTR+1
            CMP     MACSST+1
            BNE     PMC_RSTOR
            SEC                     ; EMPTY STACK -> RETURN C SET
            RTS
PMC_RSTOR   ; CALCULATE SAVED FRAME ADDRESS: MARGWRTP = MACSPTR - 9
            LDA     MACSPTR
            SEC
            SBC     #$09
            STA     MARGWRTP
            LDA     MACSPTR+1
            SBC     #$00
            STA     MARGWRTP+1
            STY     RWY_SAVE        ; SAVE Y
            ; READ THE 9 FRAME FIELDS (REVERSE ORDER OF SAVING)
            LDY     #$08
            LDA     (MARGWRTP),Y    ; NEXT_LOCAL[3]
            STA     NEXT_LOCAL+3
            DEY
            LDA     (MARGWRTP),Y    ; NEXT_LOCAL[2]
            STA     NEXT_LOCAL+2
            DEY
            LDA     (MARGWRTP),Y    ; NEXT_LOCAL[1]
            STA     NEXT_LOCAL+1
            DEY
            LDA     (MARGWRTP),Y    ; NEXT_LOCAL[0]
            STA     NEXT_LOCAL
            DEY
            LDA     (MARGWRTP),Y    ; MACRO BODY POINTER (HI)
            STA     OPCTBLP+1
            DEY
            LDA     (MARGWRTP),Y    ; MACRO BODY POINTER (LO)
            STA     OPCTBLP
            DEY
            LDA     (MARGWRTP),Y    ; MACRO ARGUMENT COUNT
            STA     MAC_ARG_CN
            DEY
            LDA     (MARGWRTP),Y    ; PREVIOUS FRAME POINTER (HI)
            STA     MACSPTR+1
            DEY
            LDA     (MARGWRTP),Y    ; PREVIOUS FRAME POINTER (LO)
            STA     MACSPTR
            LDY     RWY_SAVE        ; RESTORE Y
            CLC                     ; RETURN C CLEAR (PREVIOUS FRAME EXISTS)
            RTS

; ============================================================================
; LKP_MAC_PA
;
; RETURNS A POINTER TO THE NTH ARGUMENT OF THE CURRENT MACRO (1-BASED).
; THE INDEX IS PASSED IN A. READS THE ARGUMENT LIST FROM THE CURRENT FRAME
; (MACSPTR -> ARGUMENT BUFFER) AND ADVANCES POINTER MARGSTRP TO THE NTH ARG.
; IF THE INDEX EXCEEDS THE NUMBER OF ARGUMENTS (MAC_ARG_CN), POINTS TO THE
; FINAL NUL (EMPTY ARGUMENT) AND RETURNS A=0 (Z SET).
; IF A=0 -> SVC 0 (UNRECOVERABLE ERROR: INVALID INDEX).
; ============================================================================
LKP_MAC_PA  STA     PIX_SAVE        ; SAVE REQUESTED INDEX
            ;                       ; (SEEMS THAT IT IS NEVER RECOVERED)
            STX     RWX_SAVE
            TAX                     ; X = INDEX (1-BASED)
            BNE     LMP_CHK_CN      ; INDEX 0 -> FATAL ERROR
            SVC     0               ; SVC $00: SHOW REGS / RETURN TO MONITOR
            ; DOES NOT RETURN
LMP_CHK_CN  CMP     MAC_ARG_CN      ; INDEX > NUMBER OF ARGUMENTS?
            BEQ     LMP_FD_PA       ; =  -> WITHIN RANGE
            BCC     LMP_FD_PA       ; <  -> WITHIN RANGE
            ; INDEX OUT OF RANGE: POINT TO NUL AT THE END OF THE LAST ARG
            LDA     MARGWRTP
            SEC
            SBC     #$01
            STA     MARGSTRP
            LDA     MARGWRTP+1
            SBC     #$00
            STA     MARGSTRP+1
            LDX     RWX_SAVE
            LDA     #$00            ; RETURN NUL (EMPTY ARGUMENT)
            RTS
LMP_FD_PA   STY     RWY_SAVE        ; SAVE Y
            LDA     MACSPTR         ; START OF THE FRAME ARGUMENTS AREA
            STA     MARGSTRP
            LDA     MACSPTR+1
            STA     MARGSTRP+1
LMP_SC_NTH  DEX
            BEQ     LMP_RT_PT       ; X=0 -> REACHED THE DESIRED ARGUMENT
            LDY     #$FF
LMP_SK_AR   INY
            LDA     (MARGSTRP),Y
            BNE     LMP_SK_AR       ; CONTINUE UNTIL NUL IS FOUND
            TYA                     ; ADVANCE MARGSTRP PAST THE NUL
            SEC
            ADC     MARGSTRP
            STA     MARGSTRP
            LDA     MARGSTRP+1
            ADC     #$00
            STA     MARGSTRP+1
            JMP     LMP_SC_NTH
LMP_RT_PT   LDY     #$00
            LDA     (MARGSTRP),Y    ; FIRST BYTE OF THE ARGUMENT
            LDY     RWY_SAVE        ; RESTORE Y
            LDX     RWX_SAVE        ; RESTORE X
            CMP     #$00            ; UPDATE Z (0 = EMPTY ARGUMENT)
            RTS

; ============================================================================
; DTC_MACRO
;
; CHECKS IF THE TOKEN AT (LINE_BUF,Y) IS '.MACRO' (FOLLOWED BY SPACE, NUL, OR
; COMMENT). RETURNS C SET IF IT IS '.MACRO', C CLEAR OTHERWISE.
; IN BOTH CASES, RETURNS A = LINE_BUF[Y] (FIRST CHARACTER OF THE TOKEN).
; ============================================================================
DTC_MACRO   CMP     #'.'
            BNE     DM_NOT_MAC
            LDA     LINE_BUF+1,Y
            CMP     #'M'
            BNE     DM_NOT_MAC
            LDA     LINE_BUF+2,Y
            CMP     #'A'
            BNE     DM_NOT_MAC
            LDA     LINE_BUF+3,Y
            CMP     #'C'
            BNE     DM_NOT_MAC
            LDA     LINE_BUF+4,Y
            CMP     #'R'
            BNE     DM_NOT_MAC
            LDA     LINE_BUF+5,Y
            CMP     #'O'
            BNE     DM_NOT_MAC
            LDA     LINE_BUF+6,Y        ; CHARACTER AFTER '.MACRO': DELIMITER?
            BEQ     DM_IS_MACRO         ; NUL
            CMP     COMMENT             ; COMMENT
            BEQ     DM_IS_MACRO
            CMP     #' '                ; SPACE
            BEQ     DM_IS_MACRO
DM_NOT_MAC  CLC
            LDA     LINE_BUF,Y
            RTS
DM_IS_MACRO SEC
            LDA     LINE_BUF,Y
            RTS

; ============================================================================
; DTC_ENDMAC
;
; SCANS THE CURRENT LINE (LINE_BUF) FOR THE '.ENDMAC' DIRECTIVE.
; ALLOWS '.ENDMAC' TO APPEAR AFTER A LABEL OR LEADING SPACE.
; RETURNS C SET IF '.ENDMAC' IS DETECTED (FOLLOWED BY SPACE, NUL, OR COMMENT),
; C CLEAR OTHERWISE. A = LINE_BUF[Y] (CHAR AT START POSITION).
; ============================================================================
DTC_ENDMAC  LDY     #$00
            LDA     LINE_BUF            ; FIRST CHARACTER OF THE LINE
            BEQ     DEM_NOT_EM          ; EMPTY LINE
            CMP     COMMENT             ; COMMENT?
            BEQ     DEM_NOT_EM
            CMP     #' '                ; SPACE (MNEMONIC FIELD)?
            BEQ     DEM_CHK_KW
DEM_SK_LAB  INY
            LDA     LINE_BUF,Y
            BEQ     DEM_NOT_EM
            CMP     COMMENT
            BEQ     DEM_NOT_EM
            CMP     #' '
            BNE     DEM_SK_LAB          ; CONTINUE UNTIL FIRST SPACE
DEM_CHK_KW  JSR     SKP_LEAD_SP         ; SKIP SPACES: GET FIRST WORD
            CMP     #'.'
            BNE     DEM_NOT_EM
            LDA     LINE_BUF+1,Y
            CMP     #'E'
            BNE     DEM_NOT_EM
            LDA     LINE_BUF+2,Y
            CMP     #'N'
            BNE     DEM_NOT_EM
            LDA     LINE_BUF+3,Y
            CMP     #'D'
            BNE     DEM_NOT_EM
            LDA     LINE_BUF+4,Y
            CMP     #'M'
            BNE     DEM_NOT_EM
            LDA     LINE_BUF+5,Y
            CMP     #'A'
            BNE     DEM_NOT_EM
            LDA     LINE_BUF+6,Y
            CMP     #'C'
            BNE     DEM_NOT_EM
            LDA     LINE_BUF+7,Y        ; CHARACTER AFTER '.ENDMAC'
            BEQ     DEM_IS_END          ; NUL
            CMP     COMMENT             ; COMMENT
            BEQ     DEM_IS_END
            CMP     #' '
            BEQ     DEM_IS_END
DEM_NOT_EM  CLC
            LDA     LINE_BUF,Y
            RTS
DEM_IS_END  SEC
            LDA     LINE_BUF,Y
            RTS

; ============================================================================
; DEF_MACRO
;
; PROCESSES THE HEADER OF A '.MACRO NAME' DEFINITION IN PASS 1.
; STEPS:
;   1. PARSES THE MACRO NAME (EVAL_EXPR -> IDENT_BUF).
;   2. APPENDS '*' AS TERMINATOR AND CALLS STB_HSH_LK.
;   3. IF NEW (C CLEAR): WRITES THE TYPE BYTE $E0 TO THE HEAP,
;      CALCULATES AND SAVES THE BODY START ADDRESS (MACBODYP),
;      WRITES THE BODY POINTER (2 BYTES) AND INITIAL COUNT (0).
;   4. IF IT ALREADY EXISTS AS A MACRO (C SET, N=1, V=1): UPDATES ONLY THE
;      BODY POINTER IN THE EXISTING ENTRY (REDEFINITION).
;   5. IF IT ALREADY EXISTS AS A NORMAL SYMBOL (C SET, N=0): DUPLICATE ERROR.
;   6. IF XREF_MODE ACTIVE: WRITES 4 ADDITIONAL XREF BYTES.
;   7. INCREMENTS SYM_COUNT.
; ============================================================================
DEF_MACRO   STY     MCD_Y_SAV       ; SAVE Y
            JSR     EVAL_EXPR       ; TOKENIZE MACRO NAME -> IDENT_BUF
            STX     SAVEX
            LDX     IDENT_LEN
            LDA     #'*'
            STA     IDENT_BUF,X     ; ADD TERMINATOR '*'
            INX
            LDA     #$00
            STA     IDENT_BUF,X     ; NUL
            STX     IDENT_LEN
            LDX     SAVEX
            JSR     STB_HSH_LK      ; LOOK UP / INSERT
            BCC     DMA_NW_MC       ; C=0 -> NEW SYMBOL
            BPL     DMA_DUP_ER      ; C=1, N=0 -> ALREADY EXISTS AS SYMBOL: ERR
            BVC     DMA_RD_MC       ; C=1, N=1, V=0 -> EXISTING MACRO: UPDATE
DMA_DUP_ER  LDY     #$00
            JSR     ERR_DUP         ; ERR_TYPE_LADDER: DUPLICATE ERROR
            ; DOES NOT RETURN
DMA_NW_MC   LDA     #$E0
            JSR     WR_PRI_HP       ; WRITE TYPE $E0 (MACRO)
            ASL     A
            STA     ENT_TY_FL       ; ENT_TY_FL = $C0

            .IF     NOT-KIM1
            BIT     EXP_BANK        ; EXP_BANK AVAILABLE?
            BPL     DMA_BAD_PR
            ; BODY IN EXPANSION RAM
            LDA     HEAP2WRP
            STA     MACBODYP
            LDA     HEAP2WRP+1
            STA     MACBODYP+1
            JMP     DMA_WR_BP
            .ENDIF

DMA_BAD_PR  LDA     #$03            ; DEFAULT OFFSET (NO XREF)
            BIT     XREF_MODE       ; XREF_MODE ACTIVE?
            BPL     DMA_BC_OF
            LDA     #$07            ; LARGER OFFSET WITH XREF FIELDS
DMA_BC_OF   CLC
            ADC     SYMVALP         ; MACBODYP = SYMVALP+OFF (SPACE FOR HEADER)
            STA     MACBODYP
            LDA     SYMVALP+1
            ADC     #$00
            STA     MACBODYP+1
DMA_WR_BP   LDA     MACBODYP        ; WRITE BODY START ADDRESS
            JSR     WR_PRI_HP
            LDA     MACBODYP+1
            JSR     WR_PRI_HP
            LDA     #$00            ; INITIAL REFERENCE COUNT = 0
            JSR     WR_PRI_HP
            INC     REF_COUNT
            BNE     DMA_WR_XR
            INC     REF_COUNT+1
DMA_WR_XR   BIT     XREF_MODE       ; XREF_MODE?
            BPL     DMAC_DONE       ; NO -> SKIP XREF FIELDS
            LDA     #$00            ; XREF PTR LO = 0
            JSR     WR_PRI_HP
            LDA     #$00            ; XREF PTR HI = 0
            JSR     WR_PRI_HP
            LDA     LINE_NUM        ; LINE_NUM (DEFINITION ON CURRENT LINE)
            JSR     WR_PRI_HP
            LDA     LINE_NUM+1
            JSR     WR_PRI_HP
            JMP     DMAC_DONE
DMA_RD_MC   LDA     #$E0
            STA     (SYMTBLP),Y     ; UPDATE TYPE BYTE IN PLACE
            INY

            .IF     NOT-KIM1
            BIT     EXP_BANK        ; EXP_BANK AVAILABLE?
            BPL     DMA_RBAD_P
            LDA     HEAP2WRP
            STA     MACBODYP
            LDA     HEAP2WRP+1
            STA     MACBODYP+1
            JMP     DMA_WR_RP
            .ENDIF

DMA_RBAD_P  LDA     SYMVALP
            STA     MACBODYP
            LDA     SYMVALP+1
            STA     MACBODYP+1
DMA_WR_RP   LDA     MACBODYP
            STA     (SYMTBLP),Y     ; WRITE NEW BODY POINTER (LO)
            INY
            LDA     MACBODYP+1
            STA     (SYMTBLP),Y     ; BODY POINTER (HI)
            INY
            LDA     #$00
            STA     (SYMTBLP),Y     ; REFERENCE COUNT = 0
            JSR     RECORD_XREF     ; REGISTER XREF
DMAC_DONE   LDY     MCD_Y_SAV       ; RESTORE Y
            RTS

; ============================================================================
; ASM_ZP_ABS
;
; ENTRY POINT FOR INSTRUCTIONS THAT USE THE CURRENT LOCATION COUNTER
; VALUE AS AN IMPLICIT OPERAND (FIRST BYTE OF A .BYTE/.WORD LIST).
; IF THE LINE STARTS WITH SPACE (EMPTY MNEMONIC FIELD), RETURNS.
; OTHERWISE, LOADS LOCCNT2 INTO SYMVAL AND FALLS THROUGH TO EM_IN_REC
; WITH OPCODE $A0 (ZERO-PAGE/ABSOLUTE MODE).
; ============================================================================
ASM_ZP_ABS  LDA     LINE_BUF            ; FIRST CHARACTER OF THE LINE
            CMP     #' '
            BNE     AZP_OPE
            RTS
AZP_OPE     LDA     LOCCNT2             ; CURRENT PC VALUE AT START OF LINE
            STA     SYMVAL
            LDA     LOCCNT2+1
            STA     SYMVAL+1
            LDA     #$00
            STA     SYMVAL+2
            CLC
            LDA     #$A0                ; OPCODE FLAGS: ABSOLUTE/ZP MODE
            JMP     EIN_WR_OP           ; FALL THROUGH TO EM_IN_REC

; ============================================================================
; EM_IN_REC
;
; WRITES A 4-BYTE INSTRUCTION RECORD TO THE SYMBOL HEAP:
;   { FLAGS_OPCODE, SYMVAL_LO, SYMVAL_MID, SYMVAL_HI }
; WHERE FLAGS_OPCODE IS THE ADDRESSING MODE CONTROL BYTE.
; THERE ARE THREE ENTRY POINTS:
;   EM_IN_REC: OPCODE = $A0, C SET  (RELATIVE/BRANCH MODE)
;   EM_IN_RC2: OPCODE = $B0, C CLEAR
;   EIN_WR_OP: OPCODE IN A, C ACCORDING TO CALLER
; IF THE SYMBOL ALREADY EXISTS IN THE TABLE (HASH LOOKUP RETURNS C SET),
; UPDATES THE CORRESPONDING FIELDS IN PLACE (IN THE EXISTING ENTRY).
; ============================================================================
EM_IN_REC   LDA     #$A0
            SEC
            JMP     EIN_WR_OP
EM_IN_RC2   LDA     #$B0
            CLC
EIN_WR_OP   STA     INSTR_FLAGS     ; INSTR_FLAGS: SAVE OPCODE/MODE BYTE
            ROR     RELAD_FLG       ; RELAD_FLG: ABSORB CARRY (REL MODE)
            STY     MCD_Y_SAV       ; SAVE Y
            JSR     EVAL_EXPR       ; PARSE OPERAND EXPRESSION
            JSR     STB_HSH_LK      ; LOOK UP SYMBOL
            BCS     EIN_EX_SY       ; ALREADY EXISTS -> UPDATE IN PLACE
            ; NEW SYMBOL: CHECK IF 16-BIT MODE NEEDED
EIN_NW_SYM  LDA     SYMVAL+1        ; HAS UPPER BYTES?
            ORA     SYMVAL+2
            BEQ     EIN_BD_OP       ; ONLY 8 BITS -> DO NOT MARK 16-BIT MODE
            LDA     #$08
EIN_BD_OP   ORA     INSTR_FLAGS     ; COMBINE WITH MODE FLAGS
            JSR     WR_PRI_HP       ; WRITE CONTROL BYTE
            ASL     A
            STA     ENT_TY_FL
            LDA     SYMVAL
            JSR     WR_PRI_HP       ; WRITE VALUE LO
            LDA     SYMVAL+1
            JSR     WR_PRI_HP       ; VALUE MID
            LDA     SYMVAL+2
            JSR     WR_PRI_HP       ; VALUE HI
            INC     REF_COUNT       ; REF_COUNT++
            BNE     EIN_WR_XR
            INC     REF_COUNT+1
EIN_WR_XR   BIT     XREF_MODE       ; XREF_MODE?
            BPL     EINR_DONE
            LDA     #$00
            JSR     WR_PRI_HP       ; XREF PTR LO
            JSR     WR_PRI_HP       ; XREF PTR HI
            LDA     LINE_NUM
            JSR     WR_PRI_HP
            LDA     LINE_NUM+1
            JSR     WR_PRI_HP
            JMP     EINR_DONE
EIN_EX_SY   BMI     EIN_TY_ERR      ; N=1 -> INCOMPATIBLE TYPE -> ERROR
            BVS     EIN_MC_REF      ; V=1 -> IS MACRO -> SPECIAL TREATMENT
            JSR     RECORD_XREF     ; REGISTER SYMBOL XREF
            LDA     INSTR_FLAGS
            ORA     #$08            ; SET '16-BIT' BIT IN FLAGS
            STA     (SYMTBLP),Y     ; UPDATE CONTROL BYTE IN PLACE
EIN_WR_VA   INY
            LDA     SYMVAL
            STA     (SYMTBLP),Y     ; UPDATE VALUE LO
            INY
            LDA     SYMVAL+1
            STA     (SYMTBLP),Y     ; VALUE MID
            INY
            LDA     SYMVAL+2
            STA     (SYMTBLP),Y     ; VALUE HI
EINR_DONE   LDY     MCD_Y_SAV       ; RESTORE Y
            RTS
EIN_MC_REF  JSR     RECORD_XREF     ; REGISTER XREF
            BIT     RELAD_FLG       ; RELAD_FLG?
            BPL     EIN_TY_ERR      ; NOT RELATIVE -> TYPE ERROR
            LDA     ENT_TY_FL
            AND     #$20            ; 'ALREADY RESOLVED' BIT?
            BNE     EINR_DONE       ; YES -> OK
            BIT     PASSFLG
            BMI     EIN_WR_VA       ; PASS 2 -> WRITE VALUE
EIN_TY_ERR  LDY     #$00
            JSR     ERR_DUP
            ; DOES NOT RETURN

; ============================================================================
; PRS_ADRMD
;
; READS THE TOKEN AT (LINE_BUF,Y) AND DETERMINES THE 6502 ADDRESSING MODE,
; STORING THE INDEX IN ADDR_MODE. CALLS EVAL_FULX TO EVALUATE
; THE OPERAND WHEN NECESSARY.
;
; DETECTED MODES AND THEIR INDICES:
;   $00  ACCUMULATOR/IMPLIED     (A ONLY)
;   $01  IMMEDIATE               (#EXPR)
;   $02  ZERO-PAGE / ABSOLUTE    (EXPR)
;   $05  INDEXED INDIRECT X      ((EXPR,X))
;   $06  INDIRECT INDEXED Y      ((EXPR),Y)
;   $07  ABSOLUTE,X
;   $08  ABSOLUTE,Y
;   $0A  INDIRECT PURE           ((EXPR))
; ============================================================================
PRS_ADRMD   CMP     #'#'        ; IMMEDIATE (#EXPR)?
            BNE     PAD_CHK_AC
            LDX     #$01        ; MODE 1 = IMMEDIATE
            JSR     EVAL_EX_AD  ; ADVANCE Y AND EVALUATE EXPRESSION
            JMP     PAD_CHK_ND
PAD_SY_ERR  JSR     ERR_SYN     ; ERROR: SYNTAX ERROR
            ; DOES NOT RETURN
PAD_CHK_AC  CMP     #'A'        ; ACCUMULATOR (A)?
            BNE     PAD_CHK_PA
            JSR     ADV_PEK_BL  ; ADVANCE Y AND CHECK IF BLANK
            BNE     PAD_CK_OPR  ; NOT END -> MIGHT BE IDENTIFIER, NOT A MODE
            LDX     #$00        ; YES END -> MODE 0 (ACCUMULATOR)
            BEQ     PAD_STR_MD
PAD_CHK_PA  CMP     #'('        ; OPEN PARENTHESIS (INDIRECT MODE)?
            BNE     PAD_EV_EXP
            JSR     EVAL_EX_AD  ; EVALUATE EXPRESSION INSIDE ()
            CMP     #')'        ; IMMEDIATE CLOSE -> (EXPR)?
            BNE     PAD_CK_INX
            JSR     ADV_PEK_BL  ; CHECK WHAT FOLLOWS ')' 
            BNE     PAD_CHK_IY  ; IS THERE ',Y'?
            LDX     #$0A        ; NO -> MODE $0A (PURE INDIRECT)
            BNE     PAD_STR_MD
PAD_CK_INX  CMP     #','
            BNE     PAD_SY_ERR
            INY
            LDA     LINE_BUF,Y
            CMP     #'X'
            BNE     PAD_SY_ERR
            INY
            LDA     LINE_BUF,Y
            CMP     #')'
            BNE     PAD_SY_ERR
            LDX     #$05        ; MODE $05 = (ZP,X)
PAD_IN_SET  BIT     URESFLG     ; UNRESOLVED REFERENCE?
            BVC     PAD_AD_CHR
            JSR     ERR_ZP      ; ERROR: REFERENCE IN INDIRECT MODE
PAD_AD_CHR  INY                 ; ADVANCE PAST ')'
PAD_CHK_ND  JSR     PEK_BL_CHR  ; CHECK THAT NOTHING IS LEFT
            BNE     PAD_SY_ERR  ; MORE TEXT EXISTS -> ERROR
PAD_STR_MD  STX     ADDR_MODE   ; ADDR_MODE = DETECTED MODE
            RTS
PAD_CHK_IY  CMP     #','
            BNE     PAD_SY_ERR
            INY
            LDA     LINE_BUF,Y
            LDX     #$06        ; MODE $06 = (ZP),Y
            CMP     #'Y'
            BEQ     PAD_IN_SET  
            BNE     PAD_SY_ERR
PAD_CK_OPR  DEY                 ; REWIND: 'A' BELONGS TO AN IDENTIFIER
PAD_EV_EXP  JSR     EVAL_FULX   ; EVALUATE OPERAND EXPRESSION
            LDX     #$02        ; ASSUME ZERO-PAGE/ABSOLUTE MODE
            BIT     URESFLG     ; UNRESOLVED (EXTERNAL REFERENCE)?
            BVC     PAD_CHK_IN  ; V=0 -> RESOLVED: KEEP MODE 2
            LDX     #$07        ; V=1 -> FORCE ABSOLUTE MODE ($07)
PAD_CHK_IN  JSR     PEK_BL_CHR  ; IS THERE MORE?
            BEQ     PAD_STR_MD  ; NO -> DIRECT MODE WITHOUT INDEX
            INX                 ; X: 2->3 (ZPX) OR 7->8 (ABSX)
            CMP     #','
            BNE     PAD_SY_ERR
            INY
            LDA     LINE_BUF,Y
            CMP     #'X'        ; ',X'?
            BEQ     PAD_AD_CHR
            INX                 ; X: 3->4 (ZPY) OR 8->9 (ABSY)
            CMP     #'Y'        ; ',Y'?
            BEQ     PAD_AD_CHR
            JMP     PAD_SY_ERR

; ============================================================================
; RD_NEXT_LN
;
; MAIN SOURCE LINE READER. IN NORMAL MODE, READS BYTES FROM THE CHANNEL
; BUFFER LOADED IN TEMPP (VIA RD_BLK_SVC) AND COPIES THEM INTO THE
; LINE BUFFER LINE_BUF. WHEN INSIDE A MACRO EXPANSION (BIT 7 OF
; MAC_EXP SET), DELEGATES TO THE MACRO BODY READER.
; HANDLES:
;   - LINE CONTINUATION (TAB CHARACTER = TABCHAR) VIA EXPAND_TAB.
;   - OVERLY LONG LINES (> $50 CHARS): ACTIVATES LINE_CONT.
;   - LINE NUMBER INCREMENT AND LISTING HEADER CLEARING.
;   - UPDATING THE BUFFER POINTER SRC_BUF_OFF.
; ============================================================================
RD_NEXT_LN  BIT     MAC_EXP         ; MAC_EXP?
            BPL     RNL_NORM_R      ; NO -> READ FROM SOURCE FILE
            JMP     RD_MAC_BL       ; READ FROM MACRO BODY IN MEMORY
RNL_NORM_R  LDY     SRC_BUF_OFF     ; CURRENT BUFFER POSITION
            BIT     LINE_CONT       ; ARE WE PART OF A CONTINUED LINE?
            BPL     RNL_NW_LN       ; NO -> NEW NORMAL LINE
            ; CONTINUATION: PREPEND COMMENT CHARACTER AS HEADER
            LDA     COMMENT         ; COMMENT CHARACTER (';')
            STA     LINE_BUF        ; FIRST CHAR = CONTINUATION MARK
            JSR     CLR_LST_HD      ; CLEAR LISTING HEADER
            LDX     #$01            ; START FILLING LINE_BUF FROM INDEX 1
            JMP     RNL_CH_LP
RNL_NW_LN   JSR     INC_LN_CNT      ; INCREMENT LINE NUMBER IN LISTING
            LDX     #$00            ; START FILLING LINE_BUF FROM INDEX 0
RNL_CH_LP   LDA     (TEMPP),Y       ; READ BYTE FROM SOURCE BUFFER
            CMP     #' '            ; CONTROL CHAR (< SPACE)?
            BCC     RNL_CHK_CR      ; YES -> CHECK IF IT IS CR
            STA     LINE_BUF,X      ; STORE IN LINE_BUF
            INX
            CPX     #$51            ; LINE TOO LONG (> 80 CHARS)?
            BCS     RNL_LN_2LG
RNL_CH_AD   INY
            BNE     RNL_CK_BEN
            INC     TEMPP+1         ; CROSS PAGE BOUNDARY
RNL_CK_BEN  CPY     LN_BUF_END      ; REACHED END OF LOADED BUFFER (LOW BYTE)?
            BNE     RNL_CH_LP
            LDA     TEMPP+1
            CMP     LN_BUF_END+1    ; END OF BUFFER (HIGH BYTE)?
            BNE     RNL_CH_LP
            JSR     RD_BLK_SVC      ; LOAD NEXT BLOCK FROM CHANNEL
            BIT     INCLUDE_POP     ; INCLUDE_POP: RETURN SIGNAL FROM INCLUDE?
            BPL     RNL_CH_LP       ; NO -> CONTINUE
            BMI     RNL_TERM_L      ; YES -> TERMINATE LINE
RNL_CHK_CR  CMP     #$0D            ; CARRIAGE RETURN?
            BNE     RNL_CHK_TAB     ; NO -> CHECK TAB
            LDA     #$00
            STA     LINE_CONT       ; END OF CONTINUATION
RNL_AD_CR   INY                     ; ADVANCE PAST CR
            STY     SRC_BUF_OFF     ; UPDATE SRC_BUF_OFF WITH CURRENT POSITION
            BNE     RNL_CK_ACR
            INC     TEMPP+1
RNL_CK_ACR  CPY     LN_BUF_END      ; BUFFER DEPLETED AFTER CR?
            BNE     RNL_TERM_L
            LDA     TEMPP+1
            CMP     LN_BUF_END+1    ; END OF BUFFER (HIGH BYTE)?
            BNE     RNL_TERM_L      ; NO -> TERMINATE LINE
            JSR     RD_BLK_SVC      ; LOAD MORE DATA FROM CHANNEL
RNL_TERM_L  LDA     #$00            ; NUL AT END OF LINE IN LINE_BUF
            STA     LINE_BUF,X      ; NUL AT END OF LINE IN LINE_BUF
            STX     LN_BUF_LEN      ; LN_BUF_LEN = NUMBER OF COPIED CHARS
            RTS
RNL_CHK_TAB CMP     TABCHAR         ; TAB CHARACTER (LINE CONTINUATION)?
            BNE     RNL_CH_AD       ; NO -> ADVANCE NORMALLY
            JSR     EXPAND_TAB      ; EXPAND TAB TO SPACES IN LINE_BUF
            JMP     RNL_CH_AD       ; CONTINUE
RNL_LN_2LG  SEC
            ROR     LINE_CONT       ; LINE TOO LONG
            JMP     RNL_AD_CR       ; TERMINATE AS IF THERE WAS A CR

; ============================================================================
; RD_MAC_BL
;
; LINE READER FOR MACRO EXPANSION. READS MACRO BODY BYTES VIA
; RD_MAC_BB AND COPIES THEM TO LINE_BUF.
; WHEN IT FINDS THE BODY CR ($0D) TERMINATOR, TERMINATES THE LINE.
; THE PARAMETER ESCAPE CHARACTER (ARGLEADIN, USUALLY '!') INVOKES
; SUB_MAC_PA TO SUBSTITUTE THE ARGUMENT.
; IF RD_MAC_BB RETURNS 0 (END OF BLOCK), CALLS
; POP_MAC_FR TO RESTORE THE PREVIOUS FRAME:
;   - IF C SET (EMPTY STACK): RETURN TO FILE READING MODE.
;   - IF C CLEAR: PARENT FRAME EXISTS -> CONTINUE READING PARENT MACRO.
; ============================================================================
RD_MAC_BL   JSR     CLR_LST_HD  ; CLEAR LISTING HEADER
            LDX     #$00
RMB_CH_LP   JSR     RD_MAC_BB   ; READ BODY BYTE
            BNE     RMBL_CHK_CR ; NOT NUL -> PROCESS CHAR
            JSR     POP_MAC_FR  ; END OF BLOCK -> RESTORE FRAME
            ASL     MAC_EXP     ; MAC_EXP: ROTATE TO CLEAR/DETECT
            BMI     RMB_CH_LP   ; C=1 (MORE FRAMES EXIST) -> CONTINUE
            JMP     RNL_NORM_R  ; C=0 (EMPTY STACK) -> RETURN TO NORMAL READ
RMBL_CHK_CR CMP     #$0D        ; CR (END OF LINE IN BODY)?
            BEQ     RMB_END_LN
            CMP     ARGLEADIN   ; PARAMETER ESCAPE ('!')?
            BNE     RMB_CK_PR
            JSR     SUB_MAC_PA  ; SUBSTITUTE ARGUMENT
            JMP     RMB_NX_CH
RMB_CK_PR   CMP     #' '        ; PRINTABLE CHAR?
            BCS     RMB_ST_CH   ; YES -> STORE
            CMP     TABCHAR     ; TAB?
            BNE     RMB_NX_CH
            JSR     EXPAND_TAB  ; EXPAND TAB
            JMP     RMB_NX_CH
RMB_ST_CH   STA     LINE_BUF,X  ; STORE CHAR IN LINE_BUF
            INX
            CPX     #$51        ; LINE TOO LONG?
            BCS     RMB_SK_OV
RMB_NX_CH   JSR     RD_MAC_BB   ; READ NEXT BYTE
            JMP     RMBL_CHK_CR
RMB_END_LN  STX     LN_BUF_LEN  ; LN_BUF_LEN = COPIED CHARS
            LDA     #$00
            STA     LINE_BUF,X  ; NUL AT END
            RTS
RMB_SK_OV   JSR     RD_MAC_BB   ; KEEP READING UNTIL CR
            CMP     #$0D
            BNE     RMB_SK_OV
            JMP     RMB_END_LN

; ============================================================================
; SUB_MAC_PA
;
; CALLED WHEN THE PARAMETER ESCAPE CHARACTER (ARGLEADIN, '!') IS FOUND
; WHILE READING A MACRO BODY.
; THE FOLLOWING CHARACTER DETERMINES THE SUBSTITUTION TYPE:
;   '1'..'9' : ARGUMENT 1..9 -> LKP_MAC_PA + COPY
;   'A'..'Z' : ARGUMENT 10..35 (A=10, B=11, ...)
;   '!!'     : A SINGLE LITERAL '!'
;   '!#'     : NUMBER OF ARGUMENTS OF CURRENT CALL (ASCII DECIMAL)
;   '!@'     : CURRENT LOCAL LABEL COUNTER (NEXT_LOCAL, 4 CHARS)
; IF THE CHARACTER IS NONE OF THE ABOVE, EMITS LITERAL '!'.
; ============================================================================
SUB_MAC_PA  JSR     RD_MAC_BB       ; READ THE CHARACTER AFTER '!'
            BEQ     SMP_LT_ES       ; NUL -> EMIT LITERAL '!'
            CMP     #'1'
            BCC     SMP_CK_SP       ; < '1' -> MIGHT BE '!' OR OTHER SPECIALS
            CMP     #'9'+1
            BCS     SMP_CK_AL       ; > '9' -> CHECK IF IT IS A-Z
            SEC
            SBC     #'0'            ; CONVERT '1'..'9' TO INDEX 1..9
            JMP     SMP_FN_IDX
SMP_CK_AL   CMP     #'A'
            BCC     SMP_LT_ES       ; < 'A' -> LITERAL
            CMP     #'Z'+1
            BCS     SMP_LT_ES       ; > 'Z' -> LITERAL
            SEC
            SBC     #$37            ; CONVERT 'A'=10, 'B'=11, ..., 'Z'=35
SMP_FN_IDX  JSR     LKP_MAC_PA      ; GET POINTER TO NTH ARGUMENT
            BEQ     SMP_DONE        ; EMPTY ARGUMENT -> DO NOT COPY ANYTHING
            JSR     RD_ARG_BY       ; READ FIRST BYTE OF ARGUMENT
SMP_CP_LP   STA     LINE_BUF,X      ; COPY BYTE TO LINE_BUF
            INX
            CPX     #$51            ; LINE_BUF FULL?
            BCS     SMP_DONE
            JSR     RD_ARG_BY       ; READ NEXT BYTE
            BNE     SMP_CP_LP       ; NOT NUL -> CONTINUE COPYING
SMP_DONE    RTS
SMP_LT_ES   LDA     ARGLEADIN       ; ESCAPE CHARACTER ('!')
            STA     LINE_BUF,X
            INX
            RTS
SMP_CK_SP   CMP     ARGLEADIN       ; SECOND '!'?
            BNE     SMP_CK_ARC
            JSR     RD_MAC_BB       ; READ CHAR AFTER '!!'
            CMP     ARGLEADIN       ; '!!@' -> RETRACT CURSOR?
            BEQ     SMP_EM_LO       ; YES -> EMIT LOCAL LABEL COUNTER
            ; '!!' -> RETRACT POINTER BY 1 (READ LESS)
            LDA     OPCTBLP
            BNE     SMP_RT_PT
            DEC     OPCTBLP+1
SMP_RT_PT   DEC     OPCTBLP         ; DECREMENT BODY READ POINTER
            JMP     SMP_LT_ES       ; EMIT LITERAL '!'
SMP_EM_LO   LDA     NEXT_LOCAL      ; NEXT_LOCAL[0]
            STA     LINE_BUF,X
            INX
            LDA     NEXT_LOCAL+1    ; NEXT_LOCAL[1]
SMP_EM_LM   STA     LINE_BUF,X
SMP_EM_L3   INX
            LDA     NEXT_LOCAL+2    ; NEXT_LOCAL[2]
            STA     LINE_BUF,X
            INX
            LDA     NEXT_LOCAL+3    ; NEXT_LOCAL[3]
            CMP     #' '            ; SPACE? (PADDING FIELD, DO NOT EMIT)
            BEQ     SMP_EM_DN
            STA     LINE_BUF,X
            INX
SMP_EM_DN   RTS
SMP_CK_ARC  CMP     ARGCOUNT        ; '#?'
            BNE     SMP_LT_ES       ; NO -> LITERAL '!'
            LDA     MAC_ARG_CN
            CMP     #$0A            ; >= 10?
            BCC     SMP_UN_DG       ; NO -> A SINGLE DIGIT
            LDA     #'1'            ; TENS: START WITH '1'
            STA     LINE_BUF,X
            LDA     MAC_ARG_CN
SMP_TN_LP   SEC
            SBC     #$0A            ; SUBTRACT 10 UNTIL NEGATIVE
            BCC     SMP_UN_D2
            INC     LINE_BUF,X      ; INCREMENT TENS DIGIT
            JMP     SMP_TN_LP
SMP_UN_D2   INX                     ; ADVANCE TO UNITS DIGIT
SMP_UN_DG   CLC
            ADC     #'0'            ; CONVERT REMAINDER TO ASCII
            STA     LINE_BUF,X
            INX
            RTS

; ============================================================================
; INC_LN_CNT
;
; INCREMENTS THE 4-DIGIT ASCII LINE NUMBER COUNTER AT ADDR_FILD
; (LISTING FIELD). EACH DIGIT IS INCREMENTED WITH CARRY PROPAGATION.
; ALSO INCREMENTS THE BINARY COUNTER LINE_NUM/LINE_NUM+1.
; IF THE LST_SUPR FLAG IS ACTIVE, SKIPS THE INCREMENT BUT
; STILL EXECUTES THE LISTING HEADER CLEARING.
; AFTER INCREMENTING, FALLS THROUGH TO CLR_LST_HD TO INITIALIZE
; THE VALUE/BYTES FIELDS OF THE LISTING LINE.
; ============================================================================
INC_LN_CNT  BIT     LST_SUPR            ; LST_SUPR: DO NOT INC LINE NUMBER?
            BMI     CLR_LST_HD          ; YES -> SKIP INCREMENT, CLEAR ONLY
            LDX     #$03
ILC_DIG_LP  LDA     #'9'
            INC     ADDR_FILD,X         ; INCREMENT ASCII DIGIT
            CMP     ADDR_FILD,X         ; OVERFLOW (>'9')?
            BCS     ILC_LN_DN           ; NO -> READY
            LDA     #'0'
            STA     ADDR_FILD,X         ; RESET DIGIT AND PROPAGATE CARRY
            DEX
            BPL     ILC_DIG_LP
ILC_LN_DN   INC     LINE_NUM
            BNE     CLR_LST_HD
            INC     LINE_NUM+1

; ============================================================================
; CLR_LST_HD
;
; INITIALIZES WITH SPACES THE 7 BYTES OF THE ADDRESS/VALUE FIELD IN THE
; LISTING LINE HEADER (VALUE_FIELD+4 .. VALUE_FIELD+4+6). THIS CLEARS THE HEX
; DIGITS FROM THE PREVIOUS LINE BEFORE ASSEMBLING THE NEW ONE.
; ============================================================================
CLR_LST_HD  LDA     #' '
            LDX     #$06
CLH_CLR_LP  STA     VALUE_FIELD+4,X     ; FILL WITH SPACES
            DEX
            BPL     CLH_CLR_LP
            RTS

; ============================================================================
; EXPAND_TAB
;
; EXPANDS THE TAB CHARACTER IN LINE_BUF. USES THE GLOBAL TABULATION
; TABLE (TABTBL) TO DETERMINE THE NEXT TAB STOP.
; SUBSTITUTES THE TAB WITH SPACES FROM THE CURRENT COLUMN (X) TO THE
; NEXT STOP. IF THERE IS NO VALID ENTRY IN THE TABLE, ADDS ONE SPACE.
; ============================================================================
EXPAND_TAB  INX                         ; ADVANCE COLUMN (DISCARD THE TAB)
            STX     TAB_COL             ; TAB_COL = CURRENT COLUMN
            LDX     #$00
TAB_SC_TB   LDA     TABTBL,X            ; READ ENTRY FROM TABULATION TABLE
            BEQ     TAB_FALBK           ; 0 = END OF TABLE -> USE ONE SPACE
            CMP     TAB_COL             ; STOP <= CURRENT COLUMN?
            BEQ     TAB_ADV_ST          ; YES (EQUAL) -> SEARCH NEXT
            BCC     TAB_ADV_ST          ; YES (LESS)
            CMP     #$50                ; STOP > MAX COLUMN ($50)?
            BCS     TAB_FALBK
            TAX                         ; X = NEXT STOP
            DEX
            LDA     TAB_COL
            STX     TAB_COL             ; TAB_COL = NEXT STOP - 1
            TAX
            DEX
TAB_FIL_SP  LDA     #' '
            STA     LINE_BUF,X          ; FILL WITH SPACES UP TO THE STOP
            INX
            CPX     TAB_COL
            BNE     TAB_FIL_SP
            BEQ     TAB_DONE
TAB_ADV_ST  INX
            CPX     #$20                ; TABLE LIMIT EXCEEDED?
            BNE     TAB_SC_TB
TAB_FALBK   LDX     TAB_COL             ; CURRENT COLUMN
            DEX
            LDA     #' '
            STA     LINE_BUF,X          ; AT LEAST ONE SPACE
            INX
TAB_DONE    RTS

; ============================================================================
; OPEN_CHAN
;
; ASSIGNS A CODOS CHANNEL TO THE FILE DESCRIBED BY THE NAME REGISTER AT
; SRC_FN_SL (14 BYTES) VIA SVC #$15. IF ASSIGNMENT FAILS (BIT 7 SET),
; CALLS THE ERROR HANDLER RPT_ERROR.
; AFTER ASSIGNMENT, PRINTS THE MESSAGE 'SOURCE FILE IS ' FOLLOWED BY THE
; FILENAME (UP TO AND INCLUDING THE EXTENSION DOT) ON CHANNEL 2.
; ============================================================================
OPEN_CHAN   LDA     #<SRC_FN_SL
            STA     U3                  ; U3 = POINTER TO NAME REGISTER
            STA     U6
            LDA     #>SRC_FN_SL
            STA     U3+1
            STA     U6+1
            LDA     SRC_DRIVE           ; SOURCE DRIVE NUMBER
            LDX     SRC_CHANNEL         ; SOURCE CHANNEL NUMBER
            SVC     $15                 ; SVC: ASSIGN CHANNEL TO FILE
            BMI     OCH_PR_MS           ; ERROR (BIT 7) -> PRINT ERROR MESSAGE
            JSR     RPT_ERROR           ; CHANNEL ERROR HANDLER
OCH_PR_MS   SVC     2                   ; SVC: INLINE MESSAGE ON CHANNEL 2
            .BYTE   $02                 ; CHANNEL 2
            .BYTE   $0D, 'SOURCE FILE IS ', 0
            LDY     #$00
OCH_FIN_EX  LDA     SRC_FN_SL,Y
            INY
            CMP     #'.'
            BNE     OCH_FIN_EX
            INY                         ; ADVANCE PAST THE EXTENSION AS WELL
            LDX     #$02                ; CHANNEL 2
            SVC     7                   ; SVC: EMIT STRING ON CHANNEL
            RTS

; ============================================================================
; OPEN_OBJ_CH
;
; ASSIGNS THE OBJECT CODE OUTPUT CHANNEL (OBJ_CHANNEL) TO THE
; OBJECT FILE WHOSE NAME IS AT OBJ_FN_SL (CHANNEL 2 REGISTER),
; USING THE DRIVE OBJ_DRIVE.
; FALLS THROUGH TO ASSIGN_CH TO EXECUTE SVC $15.
; ============================================================================
OPEN_OBJ_CH LDA     #<OBJ_FN_SL ; OBJECT FILENAME REGISTER
            STA     U3
            LDA     #>OBJ_FN_SL
            STA     U3+1
            LDX     OBJ_CHANNEL ; OBJ CHANNEL FOR SVC (USE IN ASSIGN_CH)
            LDA     OBJ_DRIVE   ; OBJECT DRIVE FOR SVC
            JMP     ASSIGN_CH   ; EXECUTE ASSIGNMENT

; ============================================================================
; OPEN_LST_CH
;
; ASSIGNS THE LISTING CHANNEL (LST_CHANNEL) TO THE LISTING FILE
; WHOSE NAME IS AT LST_FN_SL (CHANNEL 1 REGISTER), USING LST_DRIVE.
; ============================================================================
OPEN_LST_CH LDA     #<LST_FN_SL ; LISTING FILENAME REGISTER
            STA     U3
            LDA     #>LST_FN_SL
            STA     U3+1
            LDX     LST_CHANNEL ; LISTING CHANNEL FOR SVC
            LDA     LST_DRIVE   ; LISTING DRIVE FOR SVC
ASSIGN_CH   SVC     $15         ; SVC: ASSIGN CHANNEL TO FILE
            BPL     ASSIGN_DONE ; SUCCESS
            JSR     FAT_OUT_EX
            ; DOES NOT RETURN
ASSIGN_DONE RTS

; ============================================================================
; OPEN_ERR_CH
;
; ASSIGNS THE ERROR/CONSOLE CHANNEL (CON_CHANNEL) TO THE ERROR
; FILE WHOSE NAME IS AT ERR_FN_SL (CHANNEL 3 REGISTER), WITH DRIVE ERR_DEVICE.
; ONLY DOES SO IF ERR_DEVICE < 4 (IS A DISK DRIVE, NOT A DEVICE).
; IF ERR_DEVICE >= 4, RETURNS WITHOUT ASSIGNING (ERRORS WILL GO TO THE DEFAULT
; DEVICE).
; ============================================================================
OPEN_ERR_CH LDA     #<ERR_FN_SL         ; ERROR FILENAME REGISTER
            STA     U3
            LDA     #>ERR_FN_SL
            STA     U3+1
            LDX     CON_CHANNEL         ; CONSOLE CHANNEL
            LDA     ERR_DEVICE          ; ERROR DEVICE
            CMP     #$04                ; IS IT A DISK DRIVE (< 4)?
            BCS     ASSIGN_DONE         ; NO (DEVICE) -> DO NOT ASSIGN CHANNEL
            SVC     $15                 ; SVC: ASSIGN CHANNEL TO FILE
            BPL     ASSIGN_DONE
            JSR     FAT_OUT_EX
            ; DOES NOT RETURN

; ============================================================================
; RD_BLK_SVC
;
; FILLS THE SOURCE BUFFER (SRCPRBUF) WITH THE NEXT BLOCK OF DATA FROM THE
; SOURCE INPUT CHANNEL (SRC_CHANNEL) VIA SVC $0F.
;
; ENTRY:  X = PRESERVED (SAVED AND RESTORED INTERNALLY)
; EXIT:   TEMPP         -> START OF SOURCE BUFFER (= SRCST)
;         LN_BUF_END  -> ONE-PAST-LAST BYTE ACTUALLY READ INTO BUFFER
;         SRC_BUF_OFF   = 0 (RESET TO START OF NEW BLOCK)
;         LST_SUPR = 0 (RESET)
;         INCLUDE_POP BIT 7: SET IF END-OF-FILE WAS SIGNALLED BY SVC (CARRY IN)
; ============================================================================
RD_BLK_SVC  STX     RDX_SAVE    ; SAVE X (WILL BE RESTORED AT EXIT)
            LDA     SRCST       ; SOURCE BUFFER BASE ADDRESS (LOW)
            STA     TEMPP       ; TEMPP -> START OF SOURCE BUFFER
            STA     U1          ; U1 ALSO -> START (SVC $0F IN-PARAMETER)
            LDA     SRCST+1
            STA     TEMPP+1
            STA     U1+1
            CLD                 ; ENSURE BINARY ARITHMETIC MODE
            LDA     SRCEND      ; COMPUTE AVAILABLE BUFFER SIZE:
            SEC                 ;   SRCEND - SRCST = MAX BYTES TO READ
            SBC     SRCST
            STA     U2          ; U2 (LO) = BUFFER SIZE IN BYTES
            LDA     SRCEND+1
            SBC     SRCST+1
            STA     U2+1        ; U2 (HI)
            JSR     DO_SVC_RD   ; PERFORM THE ACTUAL SVC $0F READ;
        ;   ON RETURN U1 POINTS PAST LAST BYTE READ
                                ;   CARRY SET = END OF FILE REACHED
            ROR     INCLUDE_POP ; SHIFT CARRY INTO BIT 7 OF INCLUDE_POP:
                                ; $80 = EOF REACHED -> CALLER MUST POP
                                ; INCLUDE FRAME
            LDA     U1          ; SVC UPDATES U1 TO ONE-PAST-END OF
                                ; DATA READ
            STA     LN_BUF_END  ; STORE AS THE SOURCE BUFFER END POINTER
            LDA     U1+1
            STA     LN_BUF_END+1
            LDY     #$00
            STY     LST_SUPR    ; CLEAR LISTING-SUPPRESS FLAG FOR NEW BLOCK
            STY     SRC_BUF_OFF ; RESET SRC_BUF_OFF (BYTE OFFS WITHIN BLOCK)
            LDX     RDX_SAVE    ; RESTORE X
            RTS

; ============================================================================
; DO_SVC_RD
;
; WRAPPER AROUND SVC $0F ('READ A RECORD FROM A CHANNEL') THAT PRESERVES THE
; X REGISTER.  LOADS THE SOURCE CHANNEL NUMBER FROM SRC_CHANNEL INTO
; X FOR THE SVC CALL, THEN RESTORES THE CALLER'S X AND RELAYS THE PROCESSOR
; STATUS FLAGS (IN PARTICULAR CARRY = EOF) BACK TO THE CALLER.
;
; ENTRY:  X = CALLER'S X (SAVED)
;         U1 = DESTINATION BUFFER BASE
;         U2 = BUFFER SIZE
; EXIT:   U1 = ONE-PAST-LAST BYTE READ
;         CARRY SET IF END-OF-FILE
; ============================================================================
DO_SVC_RD   STX     RBI_SAVE        ; SAVE CALLER'S X
            LDX     SRC_CHANNEL     ; LOAD SOURCE CHANNEL NUMBER FOR SVC
            SVC     $0F             ; SVC $0F: READ RECORD FROM CHAN INTO (U1),
                                    ;        SIZE U2
            PHP                     ; PRESERVE FLAGS (CARRY = EOF INDICATOR)
            LDX     RBI_SAVE        ; RESTORE CALLER'S X
            PLP                     ; RESTORE FLAGS
            RTS

; ============================================================================
; SET_DD_RDM
;
; REDIRECTS THE SOURCE-LINE READ POINTERS SO THAT THE ASSEMBLER'S INNER LOOP
; READS FROM THE DIRECT-DEFINITIONS BUFFER (DDEFSBUF) INSTEAD OF THE NORMAL
; SOURCE PROGRAM BUFFER (SRCPRBUF).
;
; THIS IS CALLED WHEN THE COMMAND-LINE '==' DIRECT-DEFINITION OPTION IS ACTIVE
; (DIR_DEF_AC = $80), SO THE DIRECTLY-DEFINED SYMBOLS ARE PROCESSED AS
; IF THEY WERE THE FIRST LINES OF THE SOURCE FILE.
;
; ENTRY: DDEFS_END = ONE-PAST-LAST BYTE IN DDEFSBUF
; EXIT:  LN_BUF_END  -> DDEFSBUF END POINTER
;        TEMPP         -> START OF DDEFSBUF
;        SRC_BUF_OFF   = 0
;        LST_SUPR = $80 (SUPPRESS LISTING OUTPUT FOR THESE SYNTHETIC LINES)
; ============================================================================
SET_DD_RDM  LDA     DDEFS_END       ; END OF DIRECT-DEFINITIONS BUFFER
            STA     LN_BUF_END      ; SET SOURCE END PTR (LO) TO DDEFSBUF END
            LDA     DDEFS_END+1     ; SET SOURCE END PTR (HI)
            STA     LN_BUF_END+1
            LDA     #<DDEFSBUF      ; POINT TEMPP AT THE START OF DDEFSBUF
            STA     TEMPP
            LDA     #>DDEFSBUF
            STA     TEMPP+1
            LDA     #$00
            STA     SRC_BUF_OFF     ; RESET SRC_BUF_OFF TO BEGINNING OF BUFFER
            SEC
            ROR     LST_SUPR        ; SET ($80): SUPPRESS LIST FOR DEFS
            RTS

; ============================================================================
; EM_LST_PGC
;
; ENTRY POINT FOR LISTING-LINE OUTPUT THAT FIRST CHECKS WHETHER THE CURRENT
; LISTING PAGE IS FULL.  IF PG_LIN_CNT HAS REACHED LISTLINESPP (LINES PER
; PAGE), CALLS OUT_LN_PGB TO EMIT A PAGE BREAK AND HEADER BEFORE
; FALLING THROUGH TO OUT_LST_LN.
;
; PASSING THROUGH TO OUT_LST_LN WHEN LISTLINESPP = 0 DISABLES
; AUTOMATIC PAGINATION ENTIRELY.
;
; ENTRY:  Y = LINE LENGTH (NUMBER OF BYTES TO OUTPUT FROM (U6))
;         U6 = POINTER TO THE LISTING LINE BUFFER
; ============================================================================
EM_LST_PGC  LDA     LISTLINESPP     ; LINES-PER-PAGE LIMIT (0 = UNLIMITED)
            BEQ     OUT_LST_LN      ; 0 -> NO PAGINATION; GO TO OUTPUT
            LDA     PG_LIN_CNT      ; CURRENT LINE COUNT ON THIS PAGE
            CMP     LISTLINESPP     ; FULL?
            BCC     OUT_LST_LN      ; NO: OUTPUT LINE DIRECTLY
            JSR     OUT_LN_PGB      ; YES: EMIT PAGE BREAK + NEW PAGE HEADER
            ; FALL THROUGH TO OUT_LST_LN

; ============================================================================
; OUT_LST_LN
;
; EMITS Y BYTES STARTING AT (U6) AS ONE LISTING LINE.
;
; TWO OUTPUT PATHS DEPENDING ON THE LISTING DEVICE TYPE (LST_DRIVE):
;   DISK-BASED LISTING (LST_DRIVE < 4):
;     BYTES ARE COPIED ONE BY ONE INTO THE IN-MEMORY LISTING BUFFER
;     (LSTOUTP..LSTEND).  WHEN THE BUFFER IS FULL, FLSH_OB_B IS CALLED
;     TO DRAIN IT TO THE LISTING CHANNEL VIA SVC $10.
;   DEVICE-BASED LISTING (LST_DRIVE >= 4):
;     THE ENTIRE LINE IS SENT DIRECTLY VIA SVC #7 ON CHANNEL LST_CHANNEL.
;
; AFTER OUTPUT, PG_LIN_CNT IS INCREMENTED BY ONE.
; IF Y = 0 ON ENTRY THE ROUTINE RETURNS IMMEDIATELY (NOTHING TO OUTPUT).
;
; ENTRY:  Y = BYTE COUNT TO WRITE
;         U6 = POINTER TO DATA TO WRITE
;         LST_CHANNEL = LISTING CHANNEL NUMBER
;         LST_DRIVE = LISTING DRIVE/DEVICE CODE
; ============================================================================
OUT_LST_LN  CPY     #$00            ; NOTHING TO OUTPUT?
            BEQ     OULI_DONE       ; YES: RETURN IMMEDIATELY
            LDA     LST_DRIVE       ; LISTING DRIVE NUMBER
            CMP     #$04            ; IS IT A DISK DRIVE (< 4)?
            BCC     OULI_ISDR       ; YES: USE IN-MEMORY BUFFER PATH
            LDX     LST_CHANNEL     ; NO: USE DIRECT SVC OUTPUT
            SVC     7               ; OUTPUT Y BYTES FROM (U6) ON CHAN X
            JMP     OULI_INCL       ; SKIP IN-MEMORY PATH; GO INC LINE COUNTER
OULI_ISDR   LDX     #$00            ; USED AS INDEX-REGISTER ZERO FOR INDIRECT
            STY     LST_LN_LEN      ; SAVE BYTE COUNT
            LDY     #$00
OULI_READ   LDA     (U6),Y          ; READ BYTE FROM SOURCE LISTING LINE
            STA     (LSTOUTP,X)     ; STORE INTO LISTING OUTPUT BUF AT LSTOUTP
            INC     LSTOUTP         ; ADVANCE BUFFER WRITE POINTER
            BNE     OULI_CONT       ; NO PAGE BOUNDARY: CONTINUE
            INC     LSTOUTP+1       ; CROSSED PAGE BOUNDARY: INC HIGH BYTE
            LDA     LSTOUTP+1
            CMP     LSTEND+1        ; HAS LSTOUTP REACHED LSTEND?
            BNE     OULI_CONT       ; NO: CONTINUE FILLING
            JSR     FLSH_OB_B       ; BUFFER FULL: FLUSH LSTST..LSTOUTP TO DISK
            LDX     #$00            ; RE-INITIALISE X AFTER CALL
OULI_CONT   INY                     ; ADVANCE SOURCE POINTER
            CPY     LST_LN_LEN      ; REACHED BYTE COUNT?
            BNE     OULI_READ       ; NO: CONTINUE
OULI_INCL   INC     PG_LIN_CNT      ; ONE MORE LINE ON THIS PAGE
OULI_DONE   RTS

; ============================================================================
; OUT_LN_PGB
;
; ISSUES A PAGE BREAK BEFORE STARTING A NEW LISTING PAGE.  CALLED BY
; EM_LST_PGC WHEN PG_LIN_CNT >= LISTLINESPP.
;
; ACTIONS:
;   1. SAVES U6 AND Y (VIA OPG_Y_SAV) SO THE CALLER'S STATE IS PRESERVED.
;   2. CALLS INC_PG_CNT TO ADVANCE THE 3-DIGIT PAGE NUMBER
;      IN THE PAGE HEADER AT PAGE_NUMBER.
;   3. RESETS PG_LIN_CNT TO 1.
;   4. POINTS U6 AT THE PAGE HEADER BUFFER PAGE_HEADER (LENGTH $52 = 82 BYTES).
;   5. IF LISTING_ON IS SET, EMITS THE HEADER VIA OUT_LST_LN:
;       - ON THE VERY FIRST PAGE (FST_FF_FLG = 0) THE FORM-FEED BYTE AT
;         PAGE_FF IS TEMPORARILY CLEARED SO NO FF IS EMITTED BEFORE THE HEADER.
;       - FOR SUBSEQUENT PAGES, PAGE_FF HOLDS $0C (FORM-FEED) WHICH GOES OUT
;         AS PART OF THE HEADER AND IS RESTORED FOR NEXT TIME.
;   6. RESTORES U6 AND Y AND RETURNS.
; ============================================================================
OUT_LN_PGB  STY     OPG_Y_SAV       ; SAVE Y (LISTING LINE LENGTH)
            LDA     U6              ; SAVE CURRENT LISTING LINE POINTER (LO)
            PHA
            LDA     U6+1
            PHA
            JSR     INC_PG_CNT      ; INC THE 3-DIGIT PAGE COUNTER AT
                                    ; PAGE_NUMBER
            LDA     #$01
            STA     PG_LIN_CNT      ; RESET LINE COUNTER TO 1 FOR NEW PAGE
            LDA     #<PAGE_HEADER   ; POINT U6 AT THE PAGE HEADER BUFFER
            STA     U6
            LDA     #>PAGE_HEADER
            STA     U6+1
            LDY     #$52            ; PAGE HEADER IS $52 (82) BYTES LONG
            BIT     LISTING_ON      ; LISTING ACTIVE?
            BPL     OUP_DONE        ; NO: SKIP OUTPUT; JUST RESTORE REGS
            BIT     FST_FF_FLG      ; FIRST PAGE FLAG: $00 = SUPPRESS
                                    ; INITIAL FF
            BPL     OUP_OUT_LN      ; $00 -> NOT FIRST PAGE: SKIP
            LDA     #$00            ; FIRST PAGE: CLEAR THE FF BYTE
            STA     PAGE_FF         ; SUPPRESS FORM-FEED FOR THE FIRST PAGE
OUP_OUT_LN  JSR     OUT_LST_LN      ; OUTPUT THE PAGE HEADER LINE
            BIT     FST_FF_FLG      ; RE-CHECK: WERE WE ON THE FIRST PAGE?
            BPL     OUP_DONE        ; YES: DONE (FF ALREADY SUPPRESSED)
            LDA     #$0C            ; RESTORE FORM-FEED ($0C) AT PAGE_FF
            STA     PAGE_FF         ; FOR NEXT PAGE
            LDA     #$00
            STA     FST_FF_FLG      ; MARK: FIRST PAGE HAS BEEN EMITTED;
                                    ;   FUTURE PAGES GET FF
OUP_DONE    PLA                     ; RESTORE U6 (HI)
            STA     U6+1
            PLA                     ; RESTORE U6 (LO)
            STA     U6
            LDY     OPG_Y_SAV       ; RESTORE Y
            RTS

; ============================================================================
; INC_PG_CNT
;
; INCREMENTS THE 3-CHARACTER DECIMAL PAGE NUMBER STORED AT PAGE_NUMBER
; (3 CHARS, LEAST-SIGNIFICANT DIGIT AT HIGHEST ADDRESS).  TREATS SPACE ($20)
; AS '0' SO BLANK PLACEHOLDERS ARE PROMOTED ON THE FIRST INCREMENT.
; HANDLES CARRY PROPAGATION ACROSS ALL THREE DIGITS.
;
; ENTRY: PAGE_NUMBER[0..2] = ASCII PAGE NUMBER CHARACTERS
; EXIT:  PAGE_NUMBER[0..2] UPDATED IN PLACE
; ============================================================================
INC_PG_CNT  LDX     #$02            ; START FROM THE UNITS DIGIT (INDEX 2)
INPACO_LOOP LDA     PAGE_NUMBER,X   ; LOAD CURRENT DIGIT
            CMP     #' '            ; BLANK PLACEHOLDER?
            BNE     INPACO_CONT
            LDA     #'0'            ; TREAT SPACE AS '0' BEFORE INCREMENTING
INPACO_CONT CLC
            ADC     #$01            ; INCREMENT DIGIT
            STA     PAGE_NUMBER,X
            CMP     #'9'+1          ; DID IT OVERFLOW PAST '9'?
            BCC     INPACO_DONE     ; NO: DONE
            LDA     #'0'            ; YES: WRAP DIGIT BACK TO '0'
            STA     PAGE_NUMBER,X
            CLC
            DEX                     ; MOVE TO NEXT MORE-SIGNIFICANT DIGIT
            BPL     INPACO_LOOP     ; LOOP WHILE DIGITS REMAIN
INPACO_DONE RTS

; ============================================================================
; FLSH_OB_B
;
; FLUSHES THE IN-MEMORY LISTING LINE ACCUMULATION BUFFER (LSTST..LSTOUTP-1)
; TO THE LISTING OUTPUT CHANNEL (LST_CHANNEL) VIA SVC $10, THEN RESETS
; LSTOUTP BACK TO LSTST READY FOR THE NEXT BATCH.
;
; THE FLUSH IS SKIPPED IF:
;   - SRC_DRIVE >= 4  (NO DISK-BASED SOURCE, SO LISTING IS NOT FILE-BASED)
;   - THE LISTING CHAN (LST_CHANNEL) IS NOT CURRENTLY ASSIGNED TO A FILE
;     (SVC $0E RETURNS CARRY CLEAR)
;   - THE CHANNEL'S DEVICE CODE IS >= 4  (IT IS A NON-DISK DEVICE)
;
; CALLED FROM OUT_LST_LN WHEN THE IN-MEMORY BUFFER IS FULL, AND
; DURING SHUTDOWN TO DRAIN ANY REMAINING BYTES.
; ============================================================================
FLSH_OB_B   LDA     SRC_DRIVE       ; SOURCE DRIVE: CURRENT ACTIVE DRIVE NUMBER
            CMP     #$04            ; IS IT A DISK DRIVE (< 4)?
            BCS     FLB_RET         ; NO: SKIP FLUSH (NOT FILE-BASED LISTING)
            LDX     LST_CHANNEL     ; LISTING CHANNEL FOR SVC
            SVC     $0E             ; SVC $0E: QUERY CHANNEL ASSIGNMENT;
                                    ; CARRY SET = CHANNEL ASSIGNED TO A FILE,
                                    ; A = DEVICE/DRIVE CODE OF THAT FILE
            BCC     FLB_RET         ; NOT ASSIGNED: SKIP
            CMP     #$04            ; IS THE LISTING CHANNEL ON A DISK DRIVE?
            BCS     FLB_RET         ; NO: SKIP
            LDA     LSTST           ; SET U1 = START OF LISTING BUFFER
            STA     U1
            LDA     LSTST+1
            STA     U1+1
            LDA     LSTOUTP         ; COMPUTE BYTE COUNT = LSTOUTP - LSTST
            SEC
            SBC     LSTST
            STA     U2              ; U2 (LO) = NUMBER OF BYTES TO WRITE
            LDA     LSTOUTP+1
            SBC     LSTST+1
            STA     U2+1            ; U2 (HI)
            LDX     LST_CHANNEL     ; LISTING CHANNEL FOR SVC
            SVC     $10             ; WRITE U2 BYTES FROM (U1) TO CHAN X
            LDA     LSTST           ; RESET LSTOUTP TO START OF BUFFER
            STA     LSTOUTP
            LDA     LSTST+1
            STA     LSTOUTP+1
FLB_RET     RTS

; ============================================================================
; SAV_FIL_PS
;
; COMPUTES THE LOGICAL FILE POSITION CORRESPONDING TO THE FIRST UNREAD BYTE
; IN THE CURRENT SOURCE BUFFER AND STORES IT IN U7 (3 BYTES).  THE RESULT
; IS THE PHYSICAL CHANNEL POSITION (FROM SVC $14) MINUS THE NUMBER OF BYTES
; STILL BUFFERED BUT NOT YET CONSUMED.
;
; THE ADJUSTED POSITION IS THE POSITION TO WHICH THE CHANNEL MUST BE SEEKED
; (VIA SVC $13) TO RESUME READING FROM THE CURRENT POINT WHEN THE INCLUDE
; FRAME IS LATER POPPED.
;
; AFTER COMPUTING THE ADJUSTED POSITION IN U7, EXECUTION FALLS THROUGH INTO
; PSH_INC_FR TO SAVE U7, THE CURRENT FILENAME, AND THE DRIVE
; CODE ONTO THE INCLUDE STACK.
;
; USES:  SRC_REMA = SCRATCH FOR 'BYTES REMAINING IN BUFFER' COMPUTATION
; ============================================================================
SAV_FIL_PS  LDX     SRC_CHANNEL     ; LOS SOURCE CHANNEL NUMBER FOR SVC
            SVC     $14             ; QUERY CURRENT FILE POSITION -> U7
            LDA     LN_BUF_END      ; ONE-PAST-END OF LOADED BUFFER DATA
            SEC
            SBC     TEMPP           ; SUBTRACT TEMPP (= START OF BUFFER)
            STA     SRC_REMA        ; TOTAL BYTES LOADED IN BUFFER
            LDA     LN_BUF_END+1
            SBC     TEMPP+1
            STA     SRC_REMA+1
            LDA     SRC_REMA        ; NOW SUBTRACT SRC_BUF_OFF
                                    ; BYTES ALREADY CONSUMED
            SEC
            SBC     SRC_BUF_OFF     ; -> BYTES REMAINING UNREAD IN BUFFER
            STA     SRC_REMA
            BCS     SAFIPO_SKIP
            DEC     SRC_REMA+1
SAFIPO_SKIP LDA     U7              ; SUBTRACT BYTES_REMAINING FROM PHYSICAL 
            SEC                     ; FILE POSITION
            SBC     SRC_REMA        ; -> LOGICAL 'RESUME' POSITION
            STA     U7
            LDA     U7+1
            SBC     SRC_REMA+1
            STA     U7+1
            LDA     U7+2
            SBC     #$00            ; PROPAGATE BORROW INTO HIGH BYTE
            STA     U7+2
            ; FALL THROUGH INTO PSH_INC_FR

; ============================================================================
; PSH_INC_FR
;
; PUSHES AN 18-BYTE INCLUDE-FILE FRAME ONTO THE STACK AT INC_FIL_ST.
; FRAME LAYOUT:
;   BYTE  0     DRIVE/DEVICE CODE (SRC_DRIVE)
;   BYTES 1-3   3-BYTE LOGICAL FILE POSITION (U7, U7+1, U7+2)
;   BYTES 4-17  14-BYTE FILENAME RECORD (SRC_FN_SL)
;
; INC_ST_TP (INC_ST_TP) HOLDS THE BYTE INDEX OF THE NEXT FREE SLOT.
; MAXIMUM DEPTH: $25 BYTES / 18 = 2 FRAMES; CALLS RPT_ERROR (FATAL ERROR)
; IF THE STACK OVERFLOWS.
;
; ENTRY: U7[0..2] = FILE POSITION TO SAVE; SRC_FN_SL[0..13] = CURRENT FILENAME
; ============================================================================
PSH_INC_FR  LDX     INC_ST_TP       ; CURRENT STACK WRITE INDEX
            CPX     #$25            ; STACK FULL (MAXIMUM 2 FRAMES X 18 BYTES)?
            BCC     PUI_CONT        ; NO: THERE IS ROOM
            JSR     RPT_ERROR       ; YES: FATAL ERR (INCLUDE NESTING TOO DEEP)
PUI_CONT    LDA     SRC_DRIVE       ; CURRENT SOURCE DRIVE CODE
            STA     INC_FIL_ST,X    ; FRAME BYTE 0: DRIVE
            INX
            LDY     #$00
PUI_CP_PS   LDA     U7,Y            ; COPY 3-BYTE FILE POSITION (BYTES 1-3)
            STA     INC_FIL_ST,X
            INX
            INY
            CPY     #$03
            BNE     PUI_CP_PS
            LDY     #$00
PUI_CP_RC   LDA     SRC_FN_SL,Y     ; COPY 14-BYTE FILENAME RECORD (BYTES 4-17)
            STA     INC_FIL_ST,X
            INX
            INY
            CPY     #$0E
            BNE     PUI_CP_RC
            STX     INC_ST_TP       ; UPDATE STACK TOP INDEX
            RTS

; ============================================================================
; POP_INC_FR
;
; POPS THE TOPMOST INCLUDE-FILE FRAME FROM THE STACK (INC_FIL_ST) AND RESUMES
; READING FROM THE SAVED FILE POSITION.
;
; STEPS:
;   1. CHECKS WHETHER THE STACK IS EMPTY (INC_ST_TP = 0); IF SO RETURNS C SET.
;   2. READS THE FRAME IN REVERSE ORDER (TOP-DOWN), RESTORING:
;       - SRC_FN_SL (14-BYTE FILENAME)
;       - U7[0..2]       (3-BYTE FILE POSITION)
;       - SRC_DRIVE      (DRIVE CODE)
;   3. DECREMENTS INC_ST_TP (STACK TOP POINTER) BY THE FRAME SIZE.
;   4. CALLS OPEN_CHAN TO RE-OPEN THE PARENT FILE.
;   5. CALLS SVC $13 ON SRC_CHANNEL TO SEEK TO THE SAVED POSITION.
;   6. CALLS RD_BLK_SVC TO FILL THE SOURCE BUFFER FROM THAT POSITION.
;   7. CHECKS INCLUDE_POP (BIT 7): IF SET (EOF REACHED), RETURNS C SET.
;      OTHERWISE RETURNS C CLEAR TO SIGNAL 'CONTINUE WITH PARENT FILE'.
; ============================================================================
POP_INC_FR  LDX     INC_ST_TP       ; GET STACK TOP POINTER
            BEQ     POINFR_RETC     ; STACK EMPTY: RETURN C SET
            DEX
            LDY     #$0D
POI_RFNAM   LDA     INC_FIL_ST,X    ; RSTOR 14-BYTE FNAM (BYTES 4-17, REVERSED)
            STA     SRC_FN_SL,Y
            DEX
            DEY
            BPL     POI_RFNAM
            LDY     #$02
POI_RFPOS   LDA     INC_FIL_ST,X    ; RESTORE 3-BYTE FILE POS INTO U7[0..2]
            STA     U7,Y
            DEX
            DEY
            BPL     POI_RFPOS
            LDA     INC_FIL_ST,X    ; RESTORE DRIVE CODE INTO SRC_DRIVE
            STA     SRC_DRIVE
            STX     INC_ST_TP       ; UPDATE STACK TOP POINTER (DECREMENTED)
            JSR     OPEN_CHAN       ; RE-OPEN THE PARENT SOURCE CHANNEL
            LDX     SRC_CHANNEL     ; LOAD SOURCE CHANNEL NUMBER FOR SVC
            SVC     $13             ; SEEK CHANNEL TO POSITION IN U7[0..2]
            JSR     RD_BLK_SVC      ; REFILL SRC BUFFER FROM RESUMED POSITION
            BIT     INCLUDE_POP     ; DID RD_BLK_SVC SIGNAL EOF?
            BMI     POINFR_RETC     ; YES: RETURN C SET (STACK EMPTY / EOF)
            CLC                     ; NO: PARENT FILE SUCCESSFULLY RESUMED
            RTS
POINFR_RETC SEC                     ; SIGNAL: STACK EMPTY OR EOF IN PARENT
            RTS

; ============================================================================
; OUT_AD_DIG
;
; CONVERTS THE 16-BIT LOCATION COUNTER (LOCCNT2 / LOCCNT2+1) TO FOUR
; UPPERCASE HEXADECIMAL ASCII DIGITS AND WRITES THEM INTO THE LISTING
; OUTPUT BUFFER AT LIST_BUF+X, ADVANCING X BY 4.
;
; CALLS HEX_B_2_AS TWICE: FIRST FOR THE HIGH BYTE (PRODUCING
; THE TWO MOST-SIGNIFICANT HEX DIGITS), THEN FOR THE LOW BYTE.
;
; ENTRY:  LOCCNT2/LOCCNT2+1 = 16-BIT ADDRESS TO CONVERT
;         X = CURRENT WRITE INDEX INTO LIST_BUF[]
; EXIT:   X ADVANCED BY 4 (TWO HEX DIGITS PER BYTE X 2 BYTES)
; ============================================================================
OUT_AD_DIG  LDX     #$06        ; X = 6: WRT START AT LIST_BUF[6] (ADDR FIELD)
            LDA     LOCCNT2+1   ; HIGH BYTE OF ADDRESS
            JSR     HEX_B_2_AS  ; CONV TO 2 HEX DIGITS AT LIST_BUF+X, X += 2
            LDA     LOCCNT2     ; LOW BYTE OF ADDRESS
            JMP     HEX_B_2_AS  ; CONV TO 2 HEX DIGITS AT LIST_BUF+X, X += 2

; ============================================================================
; OUT_VA_DIG
;
; CONVERTS THE 24-BIT ASSEMBLED VALUE IN SYMVAL[0..2] TO UP TO SIX UPPERCASE
; HEXADECIMAL ASCII DIGITS AND WRITES THEM INTO THE LISTING OUTPUT BUFFER AT
; LIST_BUF+X.  LEADING ZERO BYTES ARE SUPPRESSED: IF SYMVAL+2 IS $00 OR $FF
; (SIGN EXTENSION) THE TOP BYTE IS NOT OUTPUT; THE MIDDLE AND LOW BYTES ARE
; ALWAYS OUTPUT.
;
; ENTRY:  SYMVAL[0..2] = 24-BIT VALUE (LO, MID, HI)
;         X = CURRENT WRITE INDEX INTO LIST_BUF[]
; EXIT:   X ADVANCED BY 2, 4, OR 6 DEPENDING ON VALUE MAGNITUDE
; ============================================================================
OUT_VA_DIG  LDX     #$06        ; RESET X: VALUE FIELD STARTS AT LIST_BUF[6]
OUT_VA_DI2  LDA     SYMVAL+2    ; HIGH BYTE
            BEQ     OUVADI_SKIP ; $00 -> SUPPRESS HIGH BYTE OUTPUT
            CMP     #$FF
            BEQ     OUVADI_SKIP ; $FF -> SUPPRESS (SIGN EXTENSION)
            JSR     HEX_B_2_AS  ; NON-TRIVIAL HIGH BYTE: EMIT 2 HEX DIGITS
OUVADI_SKIP LDA     SYMVAL+1    ; MIDDLE BYTE: ALWAYS EMIT
            JSR     HEX_B_2_AS
            LDA     SYMVAL      ; LOW BYTE: FALL THROUGH TO HEX_B_2_AS

; ============================================================================
; HEX_B_2_AS
;
; CONVERTS THE BYTE IN A TO TWO UPPERCASE HEXADECIMAL ASCII DIGITS ('0'..'9',
; 'A'..'F') AND STORES THEM AT LIST_BUF[X] AND LIST_BUF[X+1], THEN INCREMENTS X
; BY 2.
;
; THE VAL_OUT AND VAL_SUPR FLAGS GATE THE OUTPUT:
;   IF VAL_OUT IS CLEAR ($00): OUTPUT IS ALWAYS WRITTEN.
;   IF VAL_OUT IS SET ($80) AND VAL_SUPR IS SET ($80): SKIP OUTPUT.
;
; ENTRY:  A = BYTE TO CONVERT
;         X = WRITE INDEX INTO LIST_BUF[]
; EXIT:   LIST_BUF[X], LIST_BUF[X+1] = TWO HEX DIGIT CHARACTERS
;         X += 2
; ============================================================================
HEX_B_2_AS  BIT     VAL_OUT     ; HAS ANY VAL ALREADY BEEN OUTPUT ON THIS LINE?
            BPL     HEB_CONT    ; NO (CLEAR): ALWAYS WRITE
            BIT     VAL_SUPR    ; IS VALUE OUTPUT SUPPRESSED?
            BMI     HEB_CONT    ; SET: FALL THROUGH TO WRITE ANYWAY (SEE NOTE)
            RTS                 ; UNSET: SKIP THIS BYTE
HEB_CONT    PHA                 ; SAVE ORIGINAL BYTE
            LSR     A           ; SHIFT HIGH NIBBLE TO LOW POSITION
            LSR     A
            LSR     A
            LSR     A
            JSR     HEB_EMIT    ; EMIT HIGH NIBBLE AS HEX DIGIT
            PLA                 ; RESTORE ORIG BYTE (LOW NIBBLE IN BITS 3..0)
HEB_EMIT    AND     #$0F        ; ISOLATE LOW NIBBLE
            CLC
            ADC     #'0'        ; MAP 0-9 -> '0'-'9'
            CMP     #'9'+1      ; IS IT > '9' (I.E., A-F)?
            BMI     HEB_STOR
            ADC     #$06        ; YES: ADD 7 (CARRY ALREADY 0, SO +6 EFFECTIVE)
                                ;   MAPS $3A->'A', $3B->'B', ..., $3F->'F'
HEB_STOR    STA     LIST_BUF,X  ; STORE ASCII DIGIT IN LISTING BUFFER
            INX                 ; ADVANCE WRITE INDEX
            RTS

; ============================================================================
; OUT_ERR_LN
;
; EMITS THE FORMATTED LISTING LINE CURRENTLY IN THE LISTING OUTPUT BUFFER
; (STARTING AT LIST_BUF) TO THE LISTING FILE CHANNEL (LST_CHANNEL).
;
; THE LINE LENGTH IS COMPUTED AS LN_BUF_LEN (SOURCE LINE LENGTH) + $12
; (18 BYTES FOR THE FIXED-WIDTH HEADER: CR + ADDRESS + VALUE + FLAGS +
; SEPARATORS + LEADING SPACE).
;
; CALLS EM_LST_PGC WHICH HANDLES AUTOMATIC PAGE BREAKS
; BEFORE DELEGATING TO OUT_LST_LN.
;
; ENTRY:  LN_BUF_LEN = NUMBER OF SOURCE TEXT BYTES IN THE LISTING LINE
; ============================================================================
OUT_ERR_LN  LDA     LN_BUF_LEN  ; SOURCE LINE BYTE COUNT
            CLC
            ADC     #$12        ; ADD 18 BYTES FOR FIXED LISTING HEADER
            TAY                 ; Y = TOTAL LINE LENGTH
FLUSH_LINE  LDX     LST_CHANNEL ; SET CHANNEL FOR SVC USE INSIDE EM_LST_PGC
            LDA     #<LIST_BUF  ; POINT U6 AT LISTING BUFFER (STARTS WITH CR)
            STA     U6
            LDA     #>LIST_BUF
            STA     U6+1
            JMP     EM_LST_PGC ; EMIT WITH PAGE-BREAK CHECK

; ============================================================================
; EM_LST_CNS
;
; SENDS THE FORMATTED LISTING LINE FROM LIST_BUF TO THE CONSOLE OUTPUT CHANNEL
; (CON_CHANNEL) VIA SVC $7.  IF ERR_LST_R IS SET ($80), THE
; LINE IS ALSO EMITTED TO THE LISTING FILE VIA EM_LST_PGC.
; CALLED BY RPT_LN_ERR TO DISPLAY ERROR ANNOTATIONS ON THE
; CONSOLE DURING ASSEMBLY.
;
; ENTRY:  LN_BUF_LEN = SRC LINE BYTE COUNT (USED TO COMPUTE TOTAL LINE LENGTH)
; ============================================================================
EM_LST_CNS  LDA     LN_BUF_LEN  ; SRC LINE BYTE COUNT
            CLC
            ADC     #$12        ; ADD 18-BYTE HEADER
            TAY                 ; Y = TOTAL LINE LENGTH
            LDX     CON_CHANNEL ; CONSOLE/ERROR OUTPUT CHANNEL
            BIT     ERR_LST_R   ; ARE WE IN AN ERROR LISTING PASS?
            BMI     EMLI_COND   ; YES: SKIP CONSOLE DIRECT OUTPUT
                                ;   (LISTING FILE OUTPUT BELOW COVERS IT)
            LDA     #<LIST_BUF  ; POINT U6 AT LISTING BUFFER
            STA     U6
            LDA     #>LIST_BUF
            STA     U6+1
            SVC     7           ; OUTPUT Y BYTES FROM (U6) ON CHANNEL X
EMLI_COND   RTS

; ============================================================================
; EM_LST_CNT
;
; CALLED AFTER EACH BYTE EMITTED BY .FILL OR .BYTE TO UPDATE THE LISTING
; OUTPUT FOR MULTI-BYTE DIRECTIVES.
;
; BEHAVIOUR:
;   - ALWAYS SETS VAL_OUT ($80) TO RECORD THAT AT LEAST ONE BYTE HAS
;     BEEN WRITTEN TO THE LISTING ADDRESS/VALUE FIELD.
;   - IF LISTING_ON IS CLEAR: RETURNS IMMEDIATELY (NO LISTING OUTPUT).
;   - IF VAL_SUPR IS CLEAR: PLACES '.' MARKERS IN THE SEPARATOR FIELD
;     (SEP_DOT_1/SEP_DOT_2) AND RETURNS.  THE CURRENT LINE WILL
;     BE FINISHED LATER.
;   - IF VAL_SUPR IS SET ($80): FLUSHES THE CURRENT LISTING LINE VIA
;     OUT_ERR_LN, THEN CLEARS THE ADDRESSING-MODE AND FLAG FIELDS
;     (SEP_SP..SEP_DOT_2), WRITES THE UPDATED LOCCNT AS THE NEW ADDRESS IN
;     THE LISTING HEADER, AND RESETS LN_BUF_LEN TO 0 SO THE
;     NEXT BYTE STARTS A FRESH LISTING LINE.
;
; ENTRY:  Y = CURRENT LINE POSITION (PRESERVED ACROSS THE CALL)
; ============================================================================
EM_LST_CNT  SEC
            ROR     VAL_OUT     ; SET BIT 7 OF VAL_OUT ($80)
            BIT     LISTING_ON  ; LISTING ACTIVE?
            BPL     EMLI_DONE   ; NO: NOTHING TO UPDATE
            BIT     VAL_SUPR    ; OUTPUT NEW ADDRESS LINE PER BYTE?
            BMI     EMLI_FLUS   ; YES: FULL LINE FLUSH
            LDA     #'.'
            STA     SEP_DOT_1   ; MARK SEPARATOR FIELD BYTE 0 WITH '.'
            STA     SEP_DOT_2   ; MARK SEPARATOR FIELD BYTE 1 WITH '.'
            JMP     EMLI_DONE   ; DONE: DOTS PLACED, LINE NOT YET FLUSHED
EMLI_FLUS   STY     OEL_Y_SAV   ; SAVE Y
            JSR     OUT_ERR_LN  ; FLUSH CURRENT LINE TO LISTING CHANNEL
            LDX     #$05
            LDA     #' '
EMLI_CLEA   STA     SEP_SP,X    ; CLEAR 6 BYTES: SEP_SP..SEP_DOT_2
            DEX                 ;   (MODE, FLAGS, SEP)
            BPL     EMLI_CLEA
            LDX     #$06        ; START HEX-DIGIT OUTPUT AT LISTING POSITION 6
            LDA     LOCCNT+1    ; WRITE UPDATED LOC COUNTER (HIGH BYTE FIRST)
            JSR     HEX_B_2_AS
            LDA     LOCCNT      ; THEN LOW BYTE
            JSR     HEX_B_2_AS
            LDA     #$00
            STA     LN_BUF_LEN  ; RESET SOURCE-LINE BYTE COUNT FOR NEXT CONT
            LDY     OEL_Y_SAV   ; RESTORE Y
EMLI_DONE   RTS

; ============================================================================
; RPT_LN_ERR
;
; RECORDS ONE ASSEMBLY ERROR AND OUTPUTS ERROR ANNOTATION LINES.
;
; STEPS:
;   1. INCREMENTS ERR_CNT (16-BIT ERROR COUNTER).
;   2. CALLS EM_LST_CNS TO SEND THE FAULTY SOURCE
;      LINE TO THE CONSOLE (AND OPTIONALLY TO THE LISTING FILE).
;   3. IF LISTING_ON IS SET, ADDITIONALLY SENDS THE LINE VIA OUT_ERR_LN.
;   4. INCREMENTS THE 4-DIGIT ERROR COUNT FIELD AT ERR_COUNT IN BCD-STYLE
;      ASCII, ROLLING FROM '9' BACK TO '0' WITH CARRY PROPAGATION.
;   5. COMPUTES THE CARET-INDICATOR LINE LENGTH (LINE_POS + 18) AND OUTPUTS
;      IT FROM ERR_PREFIX (THE '*ERROR NNNN' PREFIX BUFFER) TO BOTH THE CONSOLE
;      CHANNEL AND THE LISTING CHANNEL (WHEN ENABLED).
;   6. LOOKS UP THE ERROR-TYPE MESSAGE POINTER FROM THE DISPATCH TABLE
;      ERR_DSP_TB USING ERR_TY_CD X 2, OUTPUTS THE MESSAGE STRING
;      TO THE CONSOLE, AND OPTIONALLY TO THE LISTING CHANNEL.
;   7. CLEARS ERR_TY_CD TO 0 READY FOR THE NEXT LINE.
; ============================================================================
RPT_LN_ERR  INC     ERR_CNT     ; INCREMENT 16-BIT ERROR COUNTER (LO)
            BNE     RELI_SKIP
            INC     ERR_CNT+1   ; CARRY INTO HIGH BYTE
RELI_SKIP   JSR     EM_LST_CNS  ; EMIT FAULTY SOURCE LINE TO CONSOLE/LISTING
            BIT     LISTING_ON
            BPL     RELI_NOLS
            JSR     OUT_ERR_LN  ; ALSO EMIT TO LISTING FILE
RELI_NOLS   LDX     #$03        ; INCREMENT 4-DIGIT ASCII ERR COUNT
RELI_ISDI   LDA     #'9'        ; LOAD '9' TO TEST IF DIGIT WRAPPED
            INC     ERR_COUNT,X ; INCREMENT DIGIT
            CMP     ERR_COUNT,X ; DID IT EXCEED '9'?
            BCS     RELI_GETP   ; NO: DONE (DIGIT IN RANGE)
            LDA     #'0'        ; YES: WRAP BACK TO '0'
            STA     ERR_COUNT,X
            DEX                 ; CARRY TO NEXT MORE-SIGNIFICANT DIGIT
            BPL     RELI_ISDI
RELI_GETP   LDA     LINE_POS    ; CURRENT POSITION IN SOURCE LINE
            CLC
            ADC     #$12        ; ADD 18-BYTE HEADER TO GET CARET LINE LENGTH
            TAY
            LDA     #<ERR_PREFIX ; POINT U6 AT ERR PREFIX BUFF ('*ERROR NNNN ')
            STA     U6
            LDA     #>ERR_PREFIX
            STA     U6+1
            BIT     ERR_LST_R   ; ARE WE IN AN ERROR LISTING PASS?
            BMI     RELI_NOCN   ; YES: SKIP DIRECT CONSOLE OUT
            LDX     CON_CHANNEL ; CONSOLE CHANNEL
            SVC     7           ; SVC $07: OUTPUT CARET LINE TO CONSOLE
RELI_NOCN   BIT     LISTING_ON
            BPL     RELI_NOL2
            JSR     EM_LST_PGC  ; ALSO EMIT CARET LINE TO LISTING FILE
RELI_NOL2   LDA     ERR_TY_CD   ; ERROR TYPE (0-12)
            ASL     A           ; X 2 TO INDEX THE POINTER TABLE
            TAX
            LDA     ERR_DSP_TB,X ; LOAD ERROR MESSAGE POINTER
            STA     U6
            LDA     ERR_DSP_TB+1,X
            STA     U6+1
            LDX     CON_CHANNEL ; CONSOLE CHANNEL
            LDY     #$00
RELIER_SCAN INY                 ; SCAN FOR NULL TERMINATOR TO DETERMINE LENGTH
            LDA     (U6),Y
            BNE     RELIER_SCAN
            BIT     ERR_LST_R   ; ARE WE IN AN ERROR LISTING PASS?
            BMI     RELI_CHKL   ; YES: SKIP CONSOLE DIRECT OUTPUT
            SVC     7           ; OUTPUT ERROR TYPE STRING TO CONSOLE
RELI_CHKL   BIT     LISTING_ON
            BPL     RELI_NOL3
            JSR     EM_LST_PGC  ; OUTPUT ERROR TYPE STRING TO LISTING
RELI_NOL3   LDA     #$00
            STA     ERR_TY_CD   ; RESET ERROR TYPE FOR NEXT LINE
            RTS

; ============================================================================
; ERROR TYPE MESSAGE DISPATCH TABLE
;
; 13 TWO-BYTE ADDRESS ENTRIES (INDEXED BY ERR_TY_CD X 2).
; ENTRY 0 ($0000) IS A SENTINEL USED WHEN THERE IS NO TYPE-SPECIFIC MESSAGE.
; ENTRIES 1-12 POINT TO NULL-TERMINATED ERROR STRINGS PRINTED AFTER THE
; '^' CARET INDICATOR LINE.
;
;   INDEX  CONSTANT  STRING
;     0    (NONE)    $0000  - NO MESSAGE
;     1    SYNTAX    '^ SYNTAX.'
;     2    ARITH     '^ ARITHMETIC.'
;     3    IDENT     '^ IDENTIFIER.'
;     4    ZPPAGE    '^ 0-PAGE.'
;     5    DUPL      '^ DUPLICATE.'
;     6    UNDEF     '^ UNDEFINED.'
;     7    COMPLEX   '^ COMPLEXITY.'
;     8    ADDR      '^ ADDRESSING.'
;     9    RANGE     '^ RANGE.'
;    10    COND      '^ CONDITIONAL.'
;    11    FILE      '^ FILE.'
;    12    MACRO     '^ MACRO.'
; ============================================================================
ERR_DSP_TB  .WORD   $0000               ;  0: NO ERROR-TYPE ANNOTATION
            .WORD   SYN_ERR_ST          ;  1: SYNTAX ERROR
            .WORD   ARI_ERR_ST          ;  2: ARITHMETIC ERROR
            .WORD   IDE_ERR_ST          ;  3: IDENTIFIER ERROR
            .WORD   ZP_ERR_ST           ;  4: ZERO-PAGE ERROR
            .WORD   DUP_ERR_ST          ;  5: DUPLICATE DEFINITION
            .WORD   UND_ERR_ST          ;  6: UNDEFINED SYMBOL
            .WORD   TCP_ERR_ST          ;  7: EXPRESSION TOO COMPLEX
            .WORD   ADR_ERR_ST          ;  8: ADDRESSING MODE ERROR
            .WORD   RNG_ERR_ST          ;  9: VALUE OUT OF RANGE
            .WORD   CND_ERR_ST          ; 10: CONDITIONAL ASSEMBLY ERROR
            .WORD   FIO_ERR_ST          ; 11: FILE I/O ERROR
            .WORD   MAC_ERR_ST          ; 12: MACRO ERROR

; ============================================================================
; ERROR TYPE MESSAGE STRINGS
; EACH STRING BEGINS WITH '^ ' (CARET + SPACE), WHICH VISUALLY POINTS UP AT
; THE OFFENDING TOKEN IN THE SOURCE LINE ABOVE, FOLLOWED BY A CATEGORY LABEL
; AND A PERIOD.  ALL STRINGS ARE NULL-TERMINATED.
; ============================================================================
SYN_ERR_ST  .BYTE   '^ SYNTAX.', 0
ARI_ERR_ST  .BYTE   '^ ARITHMETIC.', 0
IDE_ERR_ST  .BYTE   '^ IDENTIFIER.', 0
ZP_ERR_ST   .BYTE   '^ 0-PAGE.', 0
DUP_ERR_ST  .BYTE   '^ DUPLICATE.', 0
UND_ERR_ST  .BYTE   '^ UNDEFINED.', 0
TCP_ERR_ST  .BYTE   '^ COMPLEXITY.', 0
ADR_ERR_ST  .BYTE   '^ ADDRESSING.', 0
RNG_ERR_ST  .BYTE   '^ RANGE.', 0
CND_ERR_ST  .BYTE   '^ CONDITIONAL.', 0
FIO_ERR_ST  .BYTE   '^ FILE.', 0
MAC_ERR_ST  .BYTE   '^ MACRO.', 0

; ============================================================================
; PR_PASS_SUM
;
; SENDS THE PASS SUMMARY TO THE CONSOLE (VIA PR_PAS_CNS)
; AND, IF A LISTING FILE IS OPEN (LST_F_OPN = $80), ALSO SENDS
; IT TO THE LISTING CHANNEL VIA EM_LST_PGC.
;
; THE SUMMARY LINE FORMAT IS: '<NNNN> ERRORS IN PASS <N> ' (24 BYTES),
; WHERE NNNN IS THE CURRENT PASS ERROR COUNT AND N IS '1' OR '2'.
; ============================================================================
PR_PASS_SUM JSR     PR_PAS_CNS  ; OUTPUT PASS SUMMARY TO CONSOLE
PR_PAS_FIL  BIT     LST_F_OPN   ; IS A LISTING FILE OPEN?
            BPL     PRPA_DONE   ; NO: SKIP LISTING OUTPUT
            JSR     FMT_PASS_SM ; RE-FORMAT SUMMARY (U6 SETUP)
            JSR     EM_LST_PGC  ; OUTPUT TO LISTING WITH PAGE-BREAK CHECK
PRPA_DONE   RTS

; ============================================================================
; PR_PAS_CNS
;
; SENDS THE PASS SUMMARY ONLY TO THE CONSOLE CHANNEL (CON_CHANNEL)
; VIA SVC $7.  THE SUMMARY IS FORMATTED BY FMT_PASS_SM
; INTO U6 BEFORE THE SVC CALL.
;
; THE SUMMARY LINE FORMAT IS: '<NNNN> ERRORS IN PASS <N> ' (24 BYTES),
; WHERE NNNN IS THE CURRENT PASS ERROR COUNT AND N IS '1' OR '2'.
; ============================================================================
PR_PAS_CNS  JSR     FMT_PASS_SM ; FORMAT PASS SUMMARY LINE INTO U6
            LDX     CON_CHANNEL ; SET CONSOLE CHGANNEL FOR SVC
            SVC     7           ; SVC $07: OUTPUT Y BYTES FROM (U6) TO CONSOLE
            RTS

; ============================================================================
; FMT_PASS_SM
;
; FILLS IN THE PASS-SUMMARY TEMPLATE AT SUMMARY_BUF AND POINTS U6 AT IT.
;
; ACTIONS:
;   1. COPIES THE 4 ASCII ERROR-COUNT DIGITS FROM ERR_COUNT[0..3] INTO
;      SUM_TEMPL[0..3], SUPPRESSING LEADING ZEROS (REPLACING '0' WITH ' '
;      FOR DIGITS BEFORE THE LAST NON-ZERO OR THE TENS POSITION).
;   2. SETS PASS_NUMBER TO '1' OR '2' BASED ON BIT 7 OF PASSFLG.
;   3. SETS U6 = SUMMARY_BUF, Y = $18 (24 BYTES) FOR THE SUBSEQUENT SVC/OUTPUT.
;
; ENTRY: ERR_COUNT = 4-DIGIT ASCII ERR COUNT; PASSFLG BIT 7 = PASS (0=1, 1=2)
; EXIT:  U6 -> SUMMARY_BUF (PASS SUMMARY BUFFER); Y = $18 (LINE LENGTH)
; ============================================================================
FMT_PASS_SM LDX     #$03
FOPA_COPY   LDA     ERR_COUNT,X     ; COPY RAW ERROR COUNT DIGITS
            STA     SUM_TEMPL,X
            DEX
            BPL     FOPA_COPY
FOPA_SUPR   INX                     ; SUPPRESS LEADING '0' (LEFT-TO-RIGHT SCAN)
            LDA     SUM_TEMPL,X
            CMP     #'0'            ; IS THIS DIGIT '0'?
            BNE     FOPA_SETPS      ; NO: STOP SUPPRESSING
            LDA     #' '
            STA     SUM_TEMPL,X     ; REPLACE LEADING '0' WITH SPACE
            CPX     #$02            ; STOP AT 10'S DIGIT (KEEP AT LEAST UNITS)
            BCC     FOPA_SUPR
FOPA_SETPS  LDA     #'1'            ; DEFAULT: PASS 1
            BIT     PASSFLG         ; BIT 7 SET -> PASS 2
            BPL     FOPA_SKIP
            LDA     #'2'
FOPA_SKIP   STA     PASS_NUMBER     ; SET PASS NUMBER CHARACTER
            LDA     #<SUMMARY_BUF   ; POINT U6 AT SUMMARY BUFFER
            STA     U6
            LDA     #>SUMMARY_BUF
            STA     U6+1
            LDY     #$18            ; LINE LENGTH = 24 BYTES
            RTS

; ============================================================================
; PR_FIN_SUM
;
; OUTPUTS THE END-OF-ASSEMBLY STATISTICS TO THE OUTPUT CHANNEL STORED IN
; OUT_CHANNEL (SET TO LST_CHANNEL OR CON_CHANNEL DEPENDING ON WHETHER LISTING
; IS ACTIVE).  USES SVC $0B (DECIMAL ENCODE) AND SVC $0A (HEX ENCODE) TO
; FORMAT NUMBERS, AND SVC $7 TO OUTPUT EACH STRING.
;
; LINES PRODUCED:
;   '<LINES> LINES, <SYMBOLS> SYMBOLS, <REFERENCES> REFERENCES.'
;   'SYMBOL TABLE USED $XXXX BYTES OF $XXXX BYTES AVAILABLE (BANK 0)'
;   'AND $XXXX OF $XXXX IN EXPANSION RAM BANK.' (ONLY IF EXP_BANK SET)
;   '* END OF ASSEMBLY. *'
;
; THE SYMBOL COUNT OUTPUT IS (SYMVALP - HEAPST) BYTES USED OUT OF
; (HEAPEND - HEAPST) AVAILABLE.  EXP_BANK FLAG ($80) INDICATES THAT
; AN ADDITIONAL SECONDARY HEAP IN BANK 3 IS PRESENT; IF SO, HEAP2WRP AND
; HEAP2END ARE ALSO REPORTED.
; ============================================================================
PR_FIN_SUM  BIT     LISTING_ON  ; LISTING ACTIVE?
            BPL     PRF_COUT    ; NO: GO STRAIGHT TO CONSOLE OUTPUT
            LDX     LST_CHANNEL ; LISTING CHANNEL (FOR USE IN PRTRSTR)
            JSR     PRTSTR      ; OUTPUT 'SUMMARY:\R' HEADER TO LISTING
            .BYTE   $0D, 'SUMMARY:', $0D, 0
            JSR     PRF_STATS   ; NOW OUTPUT STATS TO LISTING CHANNEL
PRF_COUT    LDX     #$02        ; CHANNEL 2 = CONSOLE
PRF_STATS   STX     OUT_CHANNEL ; SAVE OUTPUT CHANNEL NUMBER
            SVC     $0C         ; OBTAIN SYSTEM STRING BUFFER ADDRESSES -> U0
            LDY     #$00
            LDA     LINE_NUM    ; 16-BIT SOURCE LINE COUNT
            STA     U0
            LDA     LINE_NUM+1
            STA     U0+1
            SVC     $0B         ; SVC $0B: ENCODE U0 AS DECIMAL ASCII STRING
            LDX     OUT_CHANNEL
            SVC     7           ; OUTPUT '<LINES>'
            JSR     PRTSTR
            .BYTE   ' LINES, ', 0
            LDY     #$00
            LDA     SYM_COUNT
            SEC                 ; SUBTRACT $55 = 85: FIRST $55 HASH SLOTS
            SBC     #$55        ; ARE RESERVED
            STA     U0
            LDA     SYM_COUNT+1
            SBC     #$00
            STA     U0+1
            SVC     $0B         ; ENCODE SYMBOL COUNT AS DECIMAL
            LDX     OUT_CHANNEL
            SVC     7           ; OUTPUT '<SYMBOLS>'
            JSR     PRTSTR
            .BYTE   ' SYMBOLS, ', 0
            LDA     REF_COUNT
            STA     U0
            LDA     REF_COUNT+1
            STA     U0+1
            LDX     OUT_CHANNEL
            LDY     #$00
            SVC     $0B         ; ENCODE REFERENCE COUNT AS DECIMAL
            SVC     7           ; OUTPUT '<REFERENCES>'
            JSR     PRTSTR
            .BYTE   ' REFERENCES.', $0D
            .BYTE   'SYMBOL TABLE USED $', 0
            LDA     SYMVALP     ; HEAP BYTES USED = SYMVALP - HEAPST
            SEC
            SBC     HEAPST
            STA     U0
            LDA     SYMVALP+1
            SBC     HEAPST+1
            STA     U0+1
            LDY     #$00
            SVC     $0A         ; SVC $0A: ENCODE U0 AS HEX ASCII
            LDX     OUT_CHANNEL
            SVC     7           ; OUTPUT '$XXXX' USED BYTES
            JSR     PRTSTR
            .BYTE   ' OF $', 0
            LDA     HEAPEND     ; TOTAL HEAP = HEAPEND - HEAPST
            SEC
            SBC     HEAPST
            STA     U0
            LDA     HEAPEND+1
            SBC     HEAPST+1
            STA     U0+1
            LDX     OUT_CHANNEL
            LDY     #$00
            SVC     $0A         ; ENCODE TOTAL HEAP SIZE AS HEX ASCII
            SVC     7           ; OUTPUT '$XXXX' TOTAL
            JSR     PRTSTR
            .IF     NOT-KIM1
            .BYTE   ' BYTES AVAILABLE (BANK 0)', 0
            BIT     EXP_BANK    ; EXPANSION RAM BANK PRESENT?
            BPL     PRFISU_DONE ; NO: SKIP SECONDARY HEAP REPORT
            JSR     PRTSTR      ; YES: OUTPUT EXPANSION RAM STATS
            .BYTE   $0D, 'AND $', 0
            LDA     HEAP2WRP    ; SECONDARY HEAP BYTES USED
            STA     U0
            LDA     HEAP2WRP+1
            STA     U0+1
            LDY     #$00
            SVC     $0A
            LDX     OUT_CHANNEL
            SVC     7
            JSR     PRTSTR
            .BYTE   ' OF $', 0
            LDA     HEAP2END    ; SECONDARY HEAP TOTAL
            STA     U0
            LDA     HEAP2END+1
            STA     U0+1
            LDY     #$00
            SVC     $0A
            SVC     7
            JSR     PRTSTR
            .BYTE   ' IN EXPANSION RAM BANK.', 0
            .ELSE
            .BYTE   ' BYTES AVAILABLE', 0
            .ENDIF

PRFISU_DONE JSR     PRTSTR
            .BYTE   $0D, '* END OF ASSEMBLY. *', $0D, 0
            RTS

; ============================================================================
; PRTSTR
;
; OUTPUTS A NULL-TERMINATED STRING THAT IMMEDIATELY FOLLOWS THE JSR PRTSTR
; INSTRUCTION IN THE CALLER'S CODE STREAM, THEN RETURNS TO THE INSTRUCTION
; AFTER THE STRING'S NULL TERMINATOR.
;
; MECHANISM:
;   1. POPS THE 16-BIT RETURN ADDRESS FROM THE STACK INTO RETADDRP; THIS
;      POINTS TO THE BYTE IMMEDIATELY AFTER THE JSR INSTRUCTION (I.E., THE
;      FIRST BYTE OF THE INLINE STRING).
;   2. READS BYTES FROM (RETADDRP), ADVANCING RETADDRP AFTER EACH ONE,
;      AND OUTPUTS EACH VIA SVC $4 UNTIL A NUL BYTE ($00) IS FOUND.
;   3. PUSHES THE UPDATED RETADDRP (NOW POINTING AT THE BYTE AFTER THE NUL)
;      BACK ONTO THE STACK AS THE NEW RETURN ADDRESS.
;   4. RESTORES Y AND RETURNS.
;
; PTS_Y_SAV IS USED TO PRESERVE Y ACROSS THE CALL.
; ============================================================================
PRTSTR      STY     PTS_Y_SAV
            PLA                 ; POP RETURN ADDRESS LOW BYTE
            STA     RETADDRP
            PLA                 ; POP RETURN ADDRESS HIGH BYTE
            STA     RETADDRP+1
PR_NEXT     INC     RETADDRP    ; ADVANCE TO NEXT STRING BYTE
            BNE     PR_SKIP
            INC     RETADDRP+1
PR_SKIP     LDY     #$00
            LDA     (RETADDRP),Y ; READ ONE STRING CHARACTER
            BEQ     PR_DONE      ; NUL TERMINATOR: DONE
            SVC     4           ; OUTPUT BYTE A TO CURRENT CHANNEL
            JMP     PR_NEXT
PR_DONE     LDA     RETADDRP+1  ; PUSH UPDATED RETURN ADDRESS (PAST NUL)
            PHA
            LDA     RETADDRP
            PHA
            LDY     PTS_Y_SAV   ; RESTORE Y
            RTS

; ============================================================================
; EM_OPC_LS
;
; EMITS THE OPCODE BYTE ACCUMULATED IN THE CURRENT INSTRUCTION RECORD TO THE
; OBJECT-CODE OUTPUT STREAM VIA EM_B_PAS2, THEN SETS X TO $0B (11)
; AND FALLS INTO HEX_B_2_AS TO WRITE THE OPCODE'S HEX
; REPRESENTATION AT LISTING BUFFER POSITION LIST_BUF[$0B] (THE VALUE FIELD).
;
; CALLED AS THE FIRST STEP OF ALL INSTRUCTION-EMISSION HELPERS BELOW.
; ============================================================================
EM_OPC_LS   JSR     EM_B_PAS2   ; WRITE OPCODE BYTE TO OBJECT-CODE STREAM
            LDX     #$0B        ; X = 11: START WRITING HEX VALUE DIGITS AT
                                ; LIST_BUF[11]
            JMP     HEX_B_2_AS  ; CONVERT OPCODE BYTE TO HEX IN LISTING BUFFER

; ============================================================================
; EM_BR_INS
;
; EMITS A BRANCH INSTRUCTION (OPCODE + 1-BYTE PC-RELATIVE OFFSET) DURING
; PASS 2.
;
; STEPS:
;   1. CALLS EM_OPC_LS TO WRITE THE OPCODE AND ITS HEX
;      LISTING DIGITS.
;   2. COMPUTES THE SIGNED 8-BIT BRANCH OFFSET:
;        OFFSET = SYMVAL[0..1] - LOCCNT
;      WHERE LOCCNT IS THE ADDRESS OF THE BYTE THAT FOLLOWS THE BRANCH
;      INSTRUCTION.
;   3. VALIDATES THE OFFSET: THE HIGH BYTE MUST BE $00 (POSITIVE OFFSET,
;      BRANCH FORWARD) OR $FF (NEGATIVE OFFSET, BRANCH BACKWARD); OTHERWISE
;      CALLS ERROR_RANGE (RANGE ERROR).
;   4. EMITS THE OFFSET BYTE VIA EM_B_PAS2 AND WRITES ITS HEX
;      REPRESENTATION TO THE LISTING BUFFER.
; ============================================================================
EM_BR_INS   JSR     EM_OPC_LS   ; EMIT OPCODE; X = $0B AFTER RETURN
            LDA     SYMVAL      ; SUBTRACT LOCCNT FROM TARGET ADDRESS:
            SEC                 ; FFSET = SYMVAL - LOCCNT
            SBC     LOCCNT
            STA     SYMVAL
            LDA     SYMVAL+1
            SBC     LOCCNT+1
            STA     SYMVAL+1
            BEQ     EMB_FORWD   ; HIGH BYTE = $00 -> FORWARD BRANCH, CHECK SIGN
            CMP     #$FF
            BEQ     EMB_BACKW   ; HIGH BYTE=$FF -> BACKWARD BRANCH, CHECK SIGN
EMBI_ERROR  JSR     ERROR_RANGE ; NEITHER: OUT-OF-RANGE BRANCH OFFSET -> ERROR
            ; NOT REACHED
EMB_FORWD   LDA     SYMVAL      ; FORWARD BRANCH: OFFSET BYTE MUST BE 0..$7F
            BMI     EMBI_ERROR  ; NEGATIVE -> OUT OF RANGE
            BPL     EMBRIN_EMIT ; NON-NEGATIVE -> VALID
EMB_BACKW   LDA     SYMVAL      ; BACKWARD BRANCH: OFFSET BYTE MUST BE $80..$FF
            BPL     EMBI_ERROR  ; POSITIVE -> OUT OF RANGE
EMBRIN_EMIT JSR     EM_B_PAS2   ; EMIT THE VALIDATED 8-BIT OFFSET BYTE
            JMP     HEX_B_2_AS  ; WRITE OFFSET HEX DIGITS TO LISTING;
                                ; X STILL = $0D

; ============================================================================
; EM_1B_OP
;
; EMITS A SINGLE-BYTE (ZERO-PAGE OR IMMEDIATE) OPERAND INSTRUCTION DURING
; PASS 2: OPCODE FOLLOWED BY ONE OPERAND BYTE.
;
; STEPS:
;   1. EM_OPC_LS: EMIT OPCODE, SET X = $0B.
;   2. EMIT SYMVAL[0] (LOW BYTE OF OPERAND) VIA EM_B_PAS2.
;   3. WRITE OPERAND HEX DIGITS TO LISTING AT LIST_BUF[X].
; ============================================================================
EM_1B_OP    JSR     EM_OPC_LS   ; EMIT OPCODE; X = $0B
            LDA     SYMVAL      ; LOW BYTE OF OPERAND
            JSR     EM_B_PAS2   ; EMIT TO OBJECT STREAM
            JMP     HEX_B_2_AS  ; WRITE HEX DIGITS TO LISTING; RETURN

; ============================================================================
; EM_2B_OP
;
; EMITS A TWO-BYTE (ABSOLUTE) OPERAND INSTRUCTION DURING PASS 2: OPCODE
; FOLLOWED BY TWO OPERAND BYTES IN LITTLE-ENDIAN ORDER (LOW BYTE FIRST).
;
; STEPS:
;   1. EM_OPC_LS: EMIT OPCODE, SET X = $0B.
;   2. EMIT SYMVAL[0] (LOW BYTE) THEN SYMVAL[1] (HIGH BYTE) VIA EM_B_PAS2.
;   3. WRITE BOTH OPERAND BYTES' HEX DIGITS TO LISTING.
; ============================================================================
EM_2B_OP    JSR     EM_OPC_LS   ; EMIT OPCODE; X = $0B
            LDA     SYMVAL      ; LOW BYTE OF 16-BIT ABSOLUTE ADDRESS
            JSR     EM_B_PAS2
            JSR     HEX_B_2_AS  ; HEX DIGITS FOR LOW BYTE AT LIST_BUF[X], X+=2
            LDA     SYMVAL+1    ; HIGH BYTE
            JSR     EM_B_PAS2
            JMP     HEX_B_2_AS  ; HEX DIGITS FOR HIGH BYTE AT LIST_BUF[X]

; ============================================================================
; EM_DB_LST
;
; EMITS ONE DATA BYTE (FROM .BYTE / .FILL DIRECTIVES) TO THE OBJECT-CODE
; STREAM AND WRITES ITS HEX REPRESENTATION TO THE LISTING BUFFER.
;
; DIFFERS FROM THE INSTRUCTION-EMISSION HELPERS IN THAT NO OPCODE IS
; EMITTED FIRST: THE BYTE IN A (PASSED VIA EM_B_PAS2'S CONTEXT) IS
; A RAW DATA VALUE.
;
; LISTING OUTPUT BEHAVIOUR BASED ON X (LISTING COLUMN POSITION):
;   X < $0F ($15): WRITE HEX DIGITS NORMALLY VIA HEX_B_2_AS.
;   $0F <= X < $11 ($17): THE VALUE FIELD IS FULL; WRITE '..' AS A PLACEHOLDER
;     TO SHOW THAT MORE BYTES FOLLOW ON THIS LINE.
;   X >= $11: SILENTLY SKIP (ALREADY PAST THE LISTING VALUE AREA).
; ============================================================================
EM_DB_LST   JSR     EM_B_PAS2   ; EMIT BYTE TO OBJECT-CODE STREAM
            CPX     #$11        ; X >= $11: PAST LISTING VALUE AREA?
            BCS     EMD_DONE    ; YES: SKIP HEX OUTPUT
            CPX     #$0F        ; X >= $0F: VALUE FIELD IS FULL?
            BCC     EMD_EMIT    ; NO: EMIT HEX DIGITS NORMALLY
            LDA     #'.'        ; YES: WRITE '..' OVERFLOW INDICATOR
            STA     LIST_BUF,X
            INX
            STA     LIST_BUF,X
            INX
            RTS
EMD_EMIT    JMP     HEX_B_2_AS  ; WRITE HEX DIGITS AT LIST_BUF[X], X += 2
EMD_DONE    RTS

; ============================================================================
; EM_B_PAS2
;
; CORE ROUTINE THAT WRITES ONE BYTE FROM THE ACCUMULATED INSTRUCTION/DATA
; CONTEXT TO THE OBJECT-CODE OUTPUT BUFFER (OBJCOBUF).  ONLY ACTIVE DURING
; PASS 2 (PASSFLG BIT 7 SET); A CALL DURING PASS 1 TRIGGERS A BRK (BUG-2).
;
; IF OBJSEG_OPEN IS CLEAR (NO SEGMENT HEADER YET WRITTEN), A NEW SEGMENT
; HEADER RECORD IS AUTOMATICALLY OPENED FIRST.  THE HEADER FORMAT IS:
;   BYTE 0: $58 ('X') - SEGMENT MARKER
;   BYTE 1: OVL_NUM - OVERLAY NUMBER
;   BYTE 2: BANK_NUM - MEMORY BANK
;   BYTE 3: $00 - RESERVED
;   BYTES 4-5: LOAD ADDRESS (LOCCNT2 OR ENTRY_ADDR IF .ENTRY WAS SEEN)
;   BYTES 6-7: LOAD ADDRESS AGAIN (BASE ADDRESS FOR THIS SEGMENT)
;   BYTES 8-9: SEGMENT SIZE FROM OLD HEADER (SEG_SIZE)
; AFTER WRITING THE HEADER, OBJSEG_OPEN IS SET ($80).
;
; THE ACTUAL BYTE IS THEN WRITTEN TO OBJCOBUF VIA OBJ_WR_B.
;
; ENTRY: A = BYTE TO EMIT
; ============================================================================
EM_B_PAS2   BIT     PASSFLG     ; PASS 2 ACTIVE?
            BMI     EMBYPA_CONT ; YES: PROCEED
            BRK                 ; PASS 1: SHOULD NOT BE CALLED (BUG-2)
            RTS
EMBYPA_CONT BIT     OBJSEG_OPEN ; IS A SEGMENT HEADER ALREADY OPEN?
            BMI     OBJ_WR_B    ; YES: WRITE BYTE DIRECTLY
            PHA                 ; SAVE BYTE TO EMIT
            TYA                 ; SAVE Y
            PHA
            LDY     #$03        ; READ 4-BYTE PREV SEGMENT HEADER FROM SEGHEADP
            LDA     (SEGHEADP),Y
            STA     SEG_SIZE+1  ; PREVIOUS SEGMENT SIZE
            DEY
            LDA     (SEGHEADP),Y
            STA     SEG_SIZE
            DEY
            LDA     (SEGHEADP),Y ; SEGHEADP+1 = NEW SEGMENT HEADER ADDRESS HIGH
            PHA
            DEY
            LDA     (SEGHEADP),Y ; SEGHEADP+0 = NEW SEGMENT HEADER ADDRESS LOW
            STA     SEGHEADP
            PLA
            STA     SEGHEADP+1
            PLA                 ; RESTORE Y
            TAY
            LDA     #$58        ; SEGMENT MARKER BYTE 'X'
            JSR     OBJ_WR_B    ; WRITE TO OBJCOBUF
            LDA     OVL_NUM     ; OVERLAY NUMBER
            JSR     OBJ_WR_B
            LDA     BANK_NUM    ; BANK NUMBER
            JSR     OBJ_WR_B
            LDA     #$00        ; RESERVED BYTE
            JSR     OBJ_WR_B
            BIT     ENT_DEF     ; WAS .ENTRY SEEN?
            BMI     EMB_US_EN   ; YES: USE ENTRY_ADDR AS LOAD ADDRESS
            LDA     LOCCNT2     ; NO: USE CURRENT LOCATION COUNTER
            JSR     OBJ_WR_B
            LDA     LOCCNT2+1
            JSR     OBJ_WR_B
            JMP     EMBYPA_SKIP
EMB_US_EN   LDA     ENTRY_ADDR
            JSR     OBJ_WR_B
            LDA     ENTRY_ADDR+1
            JSR     OBJ_WR_B
EMBYPA_SKIP LDA     LOCCNT2     ; BASE ADDRESS OF THIS SEGMENT (LO)
            JSR     OBJ_WR_B
            LDA     LOCCNT2+1   ; (HI)
            JSR     OBJ_WR_B
            LDA     SEG_SIZE    ; PREVIOUS SEGMENT SIZE - CLOSES OLD SEGMENT
            JSR     OBJ_WR_B
            LDA     SEG_SIZE+1
            JSR     OBJ_WR_B
            SEC
            ROR     OBJSEG_OPEN ; SET ($80): SEGMENT HEADER NOW OPEN
            PLA                 ; RESTORE DATA BYTE TO EMIT
            ; FALL THROUGH

; ============================================================================
; OBJ_WR_B
;
; LOW-LEVEL PRIMITIVE THAT APPENDS ONE BYTE TO THE OBJECT-CODE OUTPUT BUFFER
; (OBJCOBUF) AND FLUSHES THE BUFFER TO DISK WHEN IT IS FULL.
;
; CALLED DIRECTLY BY EM_B_PAS2 (BOTH FOR THE SEGMENT-HEADER BYTES IT
; SYNTHESISES AND FOR THE FINAL PAYLOAD BYTE), SO IT MUST PRESERVE X ACROSS
; THE CALL BECAUSE EM_B_PAS2 USES X FOR ITS OWN BOOKKEEPING.
;
; ALGORITHM:
;   1. SAVE X IN EB2_X_SAV.
;   2. WRITE A TO OBJCOBUF[OBJBUF_POS] AND INCREMENT OBJBUF_POS.
;   3. IF OBJBUF_POS DID NOT WRAP TO $00, THE BUFFER IS NOT FULL - RESTORE
;      X AND RETURN.
;   4. IF OBJBUF_POS WRAPPED TO $00 THE 256-BYTE BUFFER IS FULL: FLUSH IT
;      TO THE OBJECT-CODE FILE CHANNEL (OBJ_CHANNEL) VIA SVC $10, WRITING
;      EXACTLY 256 BYTES FROM OBJCOBUF.
;
; ENTRY:  A = BYTE TO STORE
;         X = CALLER'S VALUE (PRESERVED ACROSS THE CALL)
; EXIT:   A CLOBBERED; X RESTORED; Y UNCHANGED
; ============================================================================
OBJ_WR_B    STX     EB2_X_SAV   ; SAVE X
            LDX     OBJBUF_POS  ; CURRENT WRITE INDEX IN OBJCOBUF
            STA     OBJCOBUF,X  ; STORE BYTE IN OBJECT-CODE BUFFER
            INC     OBJBUF_POS  ; ADVANCE WRITE INDEX
            BNE     OBJ_WB_DN   ; NO OVERFLOW: DONE
FLSH_OBJ    PHA                 ; BUFFER FULL ($100 BYTES): FLUSH TO DISK
            LDA     #<OBJCOBUF  ; U1 = START OF OBJECT-CODE BUFFER
            STA     U1
            LDA     #>OBJCOBUF
            STA     U1+1
            LDA     OBJBUF_POS  ; BYTE COUNT (0 AFTER OVERFLOW = 256)
            STA     U2
            BEQ     FLOB_WR256  ; ZERO: WRITE 256 BYTES
            LDA     #$00
            BEQ     FLOB_SKIP   ; ALWAYS JUMP
FLOB_WR256  LDA     #$01        ; U2+1 = 1 WHEN COUNT == 0 (FULL 256-BYTE BUF)
FLOB_SKIP   STA     U2+1
            LDX     OBJ_CHANNEL ; OBJECT CHANNEL FOR SVC
            SVC     $10         ; SVC $10: WRITE U2 BYTES FROM (U1) TO CHAN X
            PLA                 ; RESTORE BYTE
OBJ_WB_DN   LDX     EB2_X_SAV   ; RESTORE X
            RTS

; ============================================================================
; ADV_PEK_BL
;
; ADVANCES Y BY 1 (SKIPPING ONE CHARACTER IN THE SOURCE LINE BUFFER LINE_BUF),
; THEN FALLS THROUGH INTO PEK_BL_CHR TO TEST THE NEW CHARACTER.
; ============================================================================
ADV_PEK_BL  INY
            ; FALL THROUGH

; ============================================================================
; PEK_BL_CHR
;
; TESTS THE CHARACTER AT LINE_BUF[Y] WITHOUT CONSUMING IT (Y IS NOT MODIFIED).
; SETS THE CPU FLAGS SO THE CALLER CAN BRANCH ON WHETHER THE CHARACTER IS A
; 'BLANK' (TERMINATES AN OPERAND):
;   Z SET  (BEQ BRANCHES)  IF THE CHARACTER IS NUL ($00), SPACE ($20), OR
;          THE COMMENT DELIMITER (COMMENT = ';').
;   Z CLEAR OTHERWISE.
;
; ENTRY:  Y = INDEX INTO SOURCE LINE BUFFER LINE_BUF
; EXIT:   Z FLAG SET <-> CHARACTER IS BLANK/END-OF-FIELD; A = CHARACTER; Y
;         UNCHANGED
; ============================================================================
PEK_BL_CHR  LDA     LINE_BUF,Y  ; READ CHARACTER AT CURRENT LINE POSITION
            BEQ     PEB_RETRN   ; NUL: BLANK
            CMP     #' '        ; SPACE: BLANK
            BEQ     PEB_RETRN
            CMP     COMMENT     ; COMMENT START: BLANK
PEB_RETRN   RTS                 ; Z FLAG REFLECTS COMPARISON RESULT

ADV_SKP_LD  INY                 ; ADVANCE BEFORE SCANNING

; ============================================================================
; SKP_LEAD_SP
;
; SKIPS SPACE CHARACTERS IN LINE_BUF FROM THE CURRENT Y POSITION FORWARD,
; STOPPING AT THE FIRST NON-SPACE CHARACTER, NUL, OR COMMENT DELIMITER.
; SETS Z FLAG TO INDICATE THE STOPPING CHARACTER WAS BLANK/END-OF-FIELD.
;
; ENTRY:  Y = STARTING INDEX INTO LINE_BUF
; EXIT:   Y = INDEX OF FIRST NON-SPACE (OR NUL/COMMENT) CHARACTER
;         A = STOPPING CHARACTER; Z SET <-> STOPPING AT NUL OR COMMENT
;             DELIMITER
; ============================================================================
SKP_LEAD_SP LDA     LINE_BUF,Y  ; READ CHARACTER
            CMP     #' '        ; SPACE?
            BEQ     ADV_SKP_LD  ; YES: SKIP AND CONTINUE
            CMP     #$00        ; NUL?
            BEQ     SKLESP_DONE ; YES: STOP (Z SET)
            CMP     COMMENT     ; COMMENT DELIMITER?
SKLESP_DONE RTS                 ; RETURN; Z SET <-> END-OF-FIELD REACHED

; ============================================================================
; STR_MAC_LN
;
; COPIES ONE SOURCE LINE FROM LINE_BUF INTO THE HEAP (VIA WR_2_HEAP),
; RESPECTING STRING LITERALS.
;
; BEHAVIOUR:
;   - SCANS LINE_BUF STARTING AT Y = 0, CHARACTER BY CHARACTER.
;   - TRACKS WHETHER THE SCAN IS INSIDE A SINGLE-QUOTED STRING USING
;     IN_STRING (BIT 7 SET = INSIDE STRING).
;   - A COMMENT CHARACTER (';') FOUND OUTSIDE A STRING TERMINATES THE COPY
;     (THE COMMENT IS NOT STORED).
;   - SINGLE-QUOTE CHARACTERS (' = $27) TOGGLE THE IN_STRING FLAG.
;   - NUL ($00) TERMINATES THE SCAN.
;   - EACH NON-TERMINATING CHARACTER IS WRITTEN TO THE HEAP.
;   - A CARRIAGE RETURN ($0D) IS WRITTEN AS THE LINE TERMINATOR.
;
; THIS IS CALLED DURING MACRO BODY RECORDING (.MACRO ... .ENDMAC) TO STORE
; EACH SOURCE LINE VERBATIM (MINUS COMMENTS) IN THE HEAP FOR LATER EXPANSION.
; ============================================================================
STR_MAC_LN  LDY     #$00
            STY     IN_STRING   ; CLEAR 'INSIDE STRING' FLAG
            DEY                 ; Y = $FF (WILL BE INCREMENTED TO 0 ON FIRST
                                ;      LOOP)
STMALI_NEXT INY
            LDA     LINE_BUF,Y  ; READ NEXT CHARACTER
            BEQ     STMALI_TERM ; NUL: END OF LINE
            CMP     COMMENT     ; COMMENT DELIMITER?
            BNE     STM_CHKQU   ; NO: CHECK FOR QUOTE
            BIT     IN_STRING   ; ARE WE INSIDE A STRING?
            BPL     STMALI_TERM ; NO: TREAT ';' AS COMMENT TERMINATOR, STOP
            BMI     STM_STORE   ; YES: STORE IT AS A LITERAL CHARACTER
STM_CHKQU   CMP     #$27        ; SINGLE-QUOTE (')?
            BNE     STM_STORE   ; NO: STORE CHARACTER AS-IS
            ASL     IN_STRING   ; TOGGLE IN_STRING FLAG:
            BCS     STM_STORE   ;   WAS SET -> NOW CLEAR (CLOSING QUOTE)
            SEC
            ROR     IN_STRING   ;   WAS CLEAR -> NOW SET (OPENING QUOTE)
STM_STORE   JSR     WR_2_HEAP   ; STORE CHARACTER IN HEAP
            JMP     STMALI_NEXT ; NEXT CHARACTER
STMALI_TERM LDA     #$0D        ; STORE CARRIAGE RETURN AS LINE TERMINATOR
            JSR     WR_2_HEAP
            RTS

; ============================================================================
; RECORD_XREF
;
; RECORDS ONE CROSS-REFERENCE ENTRY FOR THE CURRENT SYMBOL.
;
; STEPS:
;   1. RETURNS IMMEDIATELY IF LST_ACT IS CLEAR (THE CURRENT LINE IS NOT
;      BEING LISTED), SINCE CROSS-REFERENCES ONLY APPLY TO LISTED LINES.
;   2. INCREMENTS THE GLOBAL REFERENCE COUNTER (REF_COUNT, 16-BIT).
;   3. IF XREF_MODE IS CLEAR, RETURNS (NO CROSS-REFERENCE RECORDS NEEDED).
;   4. OTHERWISE WRITES A 4-BYTE CROSS-REFERENCE RECORD TO THE HEAP:
;        BYTES 0-1: POINTER TO THE NEXT XREF RECORD FOR THIS SYMBOL (CHAINED
;                   LINKED LIST; INITIALLY $0000 FOR THE FIRST REFERENCE)
;        BYTES 2-3: CURRENT LINE_NUM (THE LINE NUMBER WHERE THIS REFERENCE
;                   APPEARS)
;      UPDATES THE 'PREVIOUS XREF POINTER' FIELD IN THE SYMBOL TABLE ENTRY
;      (VIA SYMTBLP+Y) TO POINT TO THE NEWLY WRITTEN RECORD, BUILDING A
;      BACKWARDS-LINKED CHAIN.
;
; ENTRY:  SYMTBLP -> CURRENT SYMBOL TABLE ENTRY
;         LINE_NUM = CURRENT SOURCE LINE NUMBER (16-BIT)
;         SYM_NM_OFF = BYTE OFFSET TO THE END OF THE NAME IN ENTRY
; ============================================================================
RECORD_XREF BIT     LST_ACT     ; ONLY CROSS-REFERENCE LISTED LINES
            BMI     REXR_CONT
            RTS
REXR_CONT   INC     REF_COUNT   ; REF_COUNT++
            BNE     REXR_SKIP
            INC     REF_COUNT+1
REXR_SKIP   BIT     XREF_MODE   ; XREF MODE ACTIVE?
            BMI     REXR_XREF
            RTS                 ; NO: JUST COUNT, DON'T RECORD LOCATION
REXR_XREF   STY     EVY_SAVE    ; SAVE Y (CALLER'S LINE POSITION)
            LDY     SYM_NM_OFF  ; OFFSET OF TYPE BYTE IN SYMBOL ENTRY
            INY                 ; SKIP TO BYTE AFTER NAME TERMINUS
            INY
            INY                 ; NOW Y POINTS TO THE XREF-CHAIN
            INY                 ;   LINK FIELD (2 BYTES)
            LDA     (SYMTBLP),Y ; READ CURRENT CHAIN-LINK POINTER (LO)
            JSR     WR_2_HEAP   ; WRITE AS FIRST 2 BYTES OF NEW XREF RECORD
            INY
            LDA     (SYMTBLP),Y ; CHAIN-LINK HI BYTE
            JSR     WR_2_HEAP
            LDA     LINE_NUM    ; CURRENT LINE NUMBER (LO)
            JSR     WR_2_HEAP   ; WRITE AS BYTES 2-3 OF XREF RECORD
            LDA     LINE_NUM+1
            JSR     WR_2_HEAP
            LDA     SYMVALP+1   ; SYMVALP = NEXT WRITE POSITION IN PRIMARY HEAP

            .IF     NOT-KIM1
            BIT     EXP_BANK    ; IS EXPANSION RAM BANK AVAILABLE?
            BPL     REXR_NOEXP  ; NO: USE SYMVALP
            LDA     HEAP2WRP+1  ; YES: USE SECONDARY HEAP WRITE POINTER (HI)
            .ENDIF
REXR_NOEXP  STA     (SYMTBLP),Y ; UPDT SYMBOL ENTRY CHAIN-LINK HI -> NEW RECORD
            DEY
            LDA     SYMVALP     ; PRIMARY HEAP (LO)

            .IF     NOT-KIM1
            BIT     EXP_BANK
            BPL     REXR_NOEXP2
            LDA     HEAP2WRP    ; SECONDARY HEAP WRITE POINTER (LO)
            .ENDIF
REXR_NOEXP2 STA     (SYMTBLP),Y ; UPDT SYMBOL ENTRY CHAIN-LINK LO -> NEW RECORD
            LDY     EVY_SAVE    ; RESTORE Y
            RTS

; ============================================================================
; WR_2_HEAP
;
; WRITES THE BYTE IN A TO THE HEAP, CHOOSING THE SECONDARY HEAP (EXPANSION
; RAM BANK 3) IF EXP_BANK IS SET ($80), OR THE PRIMARY HEAP OTHERWISE.
;
; SECONDARY HEAP PATH:
;   1. SAVES X.
;   2. SAVES THE CURRENT BANK-CONTROL REGISTER (BNKCTL).
;   3. SWITCHES BNKCTL TO THE WORKING BANK (LOW 2 BITS = BNK_CTL_BT).
;   4. WRITES A AT (HEAP2WRP,X) (X=0 -> WRITE VIA ZERO-PAGE INDIRECT).
;   5. ADVANCES HEAP2WRP; CALLS FAT_HEP_FL IF IT REACHES HEAP2END.
;   6. RESTORES BNKCTL TO BANK 0
;   7. RESTORES X AND RETURNS.
;
; FALLS THROUGH TO WR_PRI_HP IF EXP_BANK IS CLEAR.
; ============================================================================
WR_2_HEAP   .IF     NOT-KIM1
            BIT     EXP_BANK    ; USE SECONDARY HEAP (EXPANSION RAM)?
            BPL     WR_PRI_HP
            STX     SAVEX       ; SAVE X
            PHA                 ; SAVE BYTE
            LDA     BNKCTL      ; SAVE BANK-CONTROL REGISTER
            AND     #$FC        ; CLEAR BANK-SELECT BITS (SELECT BANK 3)
            ORA     BNK_CTL_BT  ; SET WORKING BANK
            STA     BNKCTL      ; SWITCH TO WORKING BANK
            PLA                 ; RESTORE BYTE
            LDX     #$00
            STA     (HEAP2WRP,X) ; WRITE BYTE AT SECONDARY HEAP POINTER
            INC     HEAP2WRP    ; ADVANCE POINTER (LO)
            BNE     WRTOHE_SKIP
            INC     HEAP2WRP+1  ; CARRY INTO HI BYTE
WRTOHE_SKIP LDX     HEAP2END+1  ; CHECK IF HEAP2WRP == HEAP2END
            CPX     HEAP2WRP+1
            BNE     WRTOHE_DONE
            LDX     HEAP2END
            CPX     HEAP2WRP
            BNE     WRTOHE_DONE
            JSR     FAT_HEP_FL  ; FATAL: SECONDARY HEAP FULL
            ; DOES NOT RETURN
WRTOHE_DONE PHA
            LDA     BNKCTL      ; SWITCH BACK TO BANK 0
            AND     #$FC
            ORA     #$03
            STA     BNKCTL
            PLA
            LDX     SAVEX       ; RESTORE X
            RTS
            .ENDIF

; ============================================================================
; WR_PRI_HP
;
; WRITES THE BYTE IN A AT THE CURRENT PRIMARY HEAP WRITE POSITION (SYMVALP),
; ADVANCES SYMVALP, AND CHECKS FOR HEAP OVERFLOW (SYMVALP == HEAPEND -> FATAL
; ERROR VIA FAT_HEP_FL).  USES X = 0 FOR THE ZERO-PAGE INDIRECT WRITE.
; ============================================================================
WR_PRI_HP   STX     SAVEX       ; SAVE X
            LDX     #$00
            STA     (SYMVALP,X) ; WRITE BYTE AT SYMVALP USING ZP INDIRECT
            INC     SYMVALP     ; ADVANCE HEAP POINTER (LO)
            BNE     WRP_SKIP
            INC     SYMVALP+1   ; CARRY INTO HI BYTE
WRP_SKIP    LDX     HEAPEND+1   ; CHECK SYMVALP == HEAPEND
            CPX     SYMVALP+1
            BNE     WRP_RETRN
            LDX     HEAPEND
            CPX     SYMVALP
            BNE     WRP_RETRN
            JSR     FAT_HEP_FL  ; FATAL: PRIMARY HEAP FULL
            ; DOES NOT RETURN
WRP_RETRN   LDX     SAVEX
            RTS

; ============================================================================
; EVAL_EX_AD
;
; ADVANCES Y BY 1 THEN FALLS THROUGH INTO EVAL_FULX TO PARSE AND
; EVALUATE A COMPLETE ARITHMETIC EXPRESSION STARTING AT THE NEW Y POSITION.
; ============================================================================
EVAL_EX_AD  INY
            ; FALL THROUGH

; ============================================================================
; EVAL_FULX
;
; PARSES AND EVALUATES A FULL ARITHMETIC EXPRESSION FROM THE SOURCE LINE
; BUFFER LINE_BUF, STARTING AT THE CURRENT Y POSITION (AFTER SKIPPING LEADING
; SPACES VIA SKP_LEAD_SP).
;
; EXPRESSION GRAMMAR (SIMPLIFIED):
;   EXPR  ::= ['<' | '>'] TERM { OP TERM }
;   TERM  ::= SYMBOL | DECIMAL | '$' HEX | '@' OCTAL | '%' BINARY
;             | '\'' CHAR | '*' | '[' EXPR ']'
;   OP    ::= '+' | '-' | '*' | '/' | '\' | '&' | '|' | '~'
;
; ALL ARITHMETIC IS 24-BIT.  OPERATORS ARE DISPATCHED THROUGH A PRECEDENCE
; STACK: EVAL_FULX PUSHES OPERANDS AND OPERATORS ONTO THE EVALUATION
; STACKS AT OPR_STACK (OPERATOR) AND ACCUM24, THEN RESOLVES THEM
; LEFT-TO-RIGHT.  BRACKET GROUPS '[' ']' ARE HANDLED RECURSIVELY.
;
; RESULTS:
;   SYMVAL[0..2]  = 24-BIT EVALUATED RESULT
;   URESFLG       = $00 IF FULLY RESOLVED; $C0 IF A SYMBOL WAS UNDEFINED;
;                   $40 IF RESULT NEEDS FURTHER RESOLUTION (E.G., FORWARD REF)
;
; ENTRY:  Y = POSITION IN LINE_BUF (BEFORE SKIPPING SPACES)
;         X = CALLER'S X (PRESERVED VIA EVX_SAVE)
; EXIT:   SYMVAL[0..2] = RESULT; Y = FIRST UNCONSUMED CHARACTER POSITION
;         A = CHARACTER AT Y; FLAGS REFLECT URESFLG
; ============================================================================
EVAL_FULX   STX     EVX_SAVE    ; SAVE CALLER'S X
            JSR     SKP_LEAD_SP ; SKIP LEADING SPACES; Y -> FIRST NON-SPACE
            STY     LN_POS_SAV  ; SAVE STARTING POSITION (EXPRESSION START)
            LDA     LINE_BUF,Y  ; READ FIRST CHARACTER
            BEQ     EVFUEX_ERR  ; NUL: EMPTY EXPRESSION -> ERROR
            LDX     #$00
            STX     URESFLG     ; CLEAR UNRESOLVED FLAG
            STX     VAL_ST_TP   ; CLEAR VALUE-STACK DEPTH
            STX     OPR_ST_TP   ; CLEAR OPERATOR-STACK DEPTH
EVFUEX_LOOP CMP     LOBYTE      ; '<' -> LOW-BYTE EXTRACT PREFIX
            BEQ     EVFUEX_PUSH
            CMP     HIBYTE      ; '>' -> HIGH-BYTE EXTRACT PREFIX
            BEQ     EVFUEX_PUSH
            DEY                 ; NO PRFX: BACK UP ONE AND PUSH IMPLICIT '=' OP
            LDA     #$3D        ; '=' = 'LOAD AS-IS'
EVFUEX_PUSH JSR     PSH_OPR     ; PUSH OPERATOR CHARACTER ONTO OPERATOR STACK
            LDA     #$00        ; PUSH A ZERO 24-BIT VALUE ONTO VALUE STACK
            LDX     VAL_ST_TP
            STA     VALUE_STACK,X
            STA     VALUE_STACK+1,X
            STA     VALUE_STACK+2,X
            INX
            INX
            INX
            STX     VAL_ST_TP   ; UPDATE VALUE-STACK DEPTH
            CPX     #$18        ; STACK OVERFLOW (8 ENTRIES X 3 BYTES)?
            BCC     EVFUEX_CONT ; NO: CONTINUE
            JSR     ERR_TCPLX   ; YES: COMPLEXITY ERROR
EVFUEX_ERR  JSR     ERR_SYN     ; SYNTAX ERROR (EMPTY EXPRESSION)
            ; NOT REACHED
EVFUEX_CONT INY                 ; ADVANCE TO NEXT CHARACTER
            LDA     LINE_BUF,Y
            CMP     ADDOP       ; '+' AS UNARY PREFIX?
            BEQ     EVF_PUSH2   ; YES: PUSH IT AS INITIAL OPERATOR
            CMP     SUBSOP      ; '-' AS UNARY PREFIX?
            BEQ     EVF_PUSH2
            DEY                 ; NO UNARY PREFIX: BACK UP
            LDA     ADDOP       ; USE '+' AS IMPLICIT INITIAL OPERATOR
EVF_PUSH2   JSR     PSH_OPR     ; PUSH THIS UNARY-PREFIX OPERATOR
            JSR     ADV_SKP_LD  ; SKIP ONE CHAR AND THEN SPACES
            CMP     LBRACKET    ; '[' -> START GROUPED SUB-EXPRESSION?
            BNE     EVFUEX_EVAL ; NO: EVALUATE PRIMARY TERM
            JSR     PSH_OPR     ; PUSH '[' AS OPERATOR (BRACKET NESTING)
            INY
            LDA     LINE_BUF,Y
            JMP     EVFUEX_LOOP ; RECURSE INTO GROUPED SUB-EXPRESSION
EVFUEX_EVAL JSR     DSP_PR_TR   ; EVALUATE PRIMARY TERM (SYMBOL, LITERAL, ETC.)
EVF_RESOL
            JSR     POP_OPR     ; POP ONE OPERATOR FROM OPERATOR STACK
            LDX     #$08
EVF_SEARC   DEX                 ; SEARCH OPERATOR TABLE ARITHOPS FOR MATCH
            CMP     ARITHOPS,X
            BNE     EVF_SEARC
            TXA                 ; X = INDEX OF MATCHED OPERATOR
            ASL     A           ; X 2 FOR WORD-SIZE DISPATCH TABLE
            TAX
            LDA     OP_DISPATCH,X ; LOAD HANDLER ADDRESS
            STA     OP_HANDLER
            LDA     OP_DISPATCH+1,X
            STA     OP_HANDLER+1
            LDX     VAL_ST_TP
            JSR     EVF_DISPA   ; DISPATCH: JMP (OP_HANDLER) TO EXECUTE
                                ; THE OPERATOR
            JSR     PEK_BL_CHR  ; WHAT FOLLOWS THE RESULT?
            BEQ     EVFUEX_DONE ; BLANK/NUL: EXPRESSION DONE
            CMP     RBRACKET    ; ']' CLOSING BRACKET?
            BEQ     EVF_CLOSE   ; YES: CLOSE GROUPED SUB-EXPRESSION
            LDX     #$07
EVF_INFIX   CMP     ARITHOPS,X  ; ANOTHER INFIX OPERATOR?
            BEQ     EVF_PUSH2   ; YES: PUSH IT AND GET NEXT OPERAND
            DEX
            BPL     EVF_INFIX
EVFUEX_DONE JSR     LOD_OP_RS   ; FINALISE: APPLY LO/HI-BYTE EXTRACTION
                                ; IF NEEDED
            LDX     OPR_ST_TP   ; OPERATOR STACK EMPTY?
            BNE     EVF_SYNTA   ; NO -> SYNTAX ERROR (UNMATCHED BRACKET?)
            LDA     SYMVAL+1    ; CHECK IF RESULT FITS IN 8 BITS
            ORA     SYMVAL+2
            BEQ     EVF_IS8BT   ; ZERO HIGH BYTES: 8-BIT VALUE; OK
            LDA     #$40
            ORA     URESFLG     ; SET 'NEEDS WIDER VALUE' HINT BIT
            STA     URESFLG
EVF_IS8BT   BIT     URESFLG     ; ANY UNRESOLVED REFERENCE?
            BPL     EVF_RETVA   ; NO: RETURN VALUE AS-IS
            LDX     #$02
EVF_SUBST   LDA     UNDEFSUBST,X ; SUBSTITUTE THE UNDEFINED-OP
            STA     SYMVAL,X     ; PLACEHOLDER VALUE
            DEX
            BPL     EVF_SUBST
EVF_RETVA   LDX     EVX_SAVE    ; RESTORE CALLER'S X
            LDA     LINE_BUF,Y  ; A = CURRENT (STOPPING) CHARACTER
            BIT     URESFLG     ; FLAGS REFLECT URESFLG BIT 7
            RTS
EVF_CLOSE   JSR     LOD_OP_RS   ; FINALISE SUB-EXPRESSION RESULT
            INY                         ; SKIP ']'
            JSR     POP_OPR     ; POP THE MATCHING '[' OPERATOR
            CMP     LBRACKET    ; WAS IT INDEED '['?
            BNE     EVF_SYNTA   ; NO: STRAY ']'
            DEC     VAL_ST_TP   ; REMOVE THE BRACKETED OPERAND'S STACK ENTRY
            DEC     VAL_ST_TP
            DEC     VAL_ST_TP
            JMP     EVF_RESOL   ; CONTINUE RESOLVING OPERATORS
EVF_SYNTA   JSR     ERR_SYN     ; SYNTAX ERROR (UNBALANCED BRACKETS)
            ; NOT REACHED
EVF_DISPA   JMP     (OP_HANDLER) ; INDIRECT DISPATCH TO CURRENT
                                 ; OPERATOR HANDLER

; ============================================================================
; INFIX OPERATOR DISPATCH TABLE
;
; EIGHT TWO-BYTE ENTRIES, INDEXED BY OPERATOR ORDER WITHIN ARITHOPS STRING:
;   INDEX  CHAR  HANDLER   OPERATION
;     0     '~'  XOR24     EXCLUSIVE OR (24-BIT)
;     1     '|'  OR24      BITWISE OR (24-BIT)
;     2     '&'  AND24     BITWISE AND (24-BIT)
;     3     '\'  REM24     REMAINDER (MODULO), 24-BIT SIGNED
;     4     '/'  DIV24     DIVISION, 24-BIT SIGNED
;     5     '*'  MUL24     MULTIPLICATION, 24-BIT SIGNED
;     6     '-'  SUB24     SUBTRACTION (24-BIT)
;     7     '+'  ADD24     ADDITION (24-BIT)
; ============================================================================
OP_DISPATCH .WORD   XOR24               ; '~' - XOR
            .WORD   OR24                ; '|' - OR
            .WORD   AND24               ; '&' - AND
            .WORD   REM24               ; '\' - REMAINDER
            .WORD   DIV24               ; '/' - DIVISION
            .WORD   MUL24               ; '*' - MULTIPLICATION
            .WORD   SUB24               ; '-' - SUBTRACTION
            .WORD   ADD24               ; '+' - ADDITION

; ============================================================================
; EVAL_SYM_R
;
; LOOKS UP THE IDENTIFIER IN IDENT_BUF (COLLECTED BY EVAL_EXPR) IN THE
; SYMBOL TABLE VIA STB_HSH_LK.
;
; RESULTS:
;   - SYMBOL FOUND WITH KNOWN VALUE (C SET, N CLEAR):
;       CALLS RECORD_XREF TO COUNT/LOG THIS REFERENCE.
;       LOADS SYMVAL[0..2] FROM THE SYMBOL TABLE ENTRY.
;       IF THE SYMBOL IS FLAGGED AS FORWARD-RELATIVE (V BIT SET IN
;       ENT_TY_FL), SETS BIT $40 IN URESFLG.
;   - SYMBOL FOUND BUT VALUE UNKNOWN (C SET, N SET, I.E. BYTE $80+):
;       CALLS ERR_DUP (TYPE-MISMATCH ERROR).
;   - SYMBOL NOT FOUND (C CLEAR):
;       SETS SYMVAL = $FFFF/$FF (UNDEFINED PLACEHOLDER).
;       SETS BIT 7 OF INSTR_FLAGS ($80) TO FLAG 'NEW UNDEFINED SYMBOL'.
;       CALLS EIN_NW_SYM TO ADD THE SYMBOL TO THE TABLE.
;       RECORDS THE LINE POSITION IN UNR_LN_POS.
;       SETS URESFLG = $C0 (UNRESOLVED + NEEDS RETRY IN PASS 2).
;
; ENTRY:  IDENT_BUF = NULL-TERMINATED IDENTIFIER STRING
; EXIT:   SYMVAL[0..2] = SYMBOL VALUE (OR $FFFFFF IF UNDEFINED)
;         URESFLG UPDATED AS DESCRIBED
; ============================================================================
EVAL_SYM_R  JSR     EVAL_EXP2   ; PRE-SCAN: COLLECT IDENTIFIER CHARACTERS
            JSR     STB_HSH_LK  ; HASH-TABLE LOOKUP
            BCC     EVS_NOTFD   ; C CLEAR: NOT FOUND
            BMI     EVS_ERROR   ; N SET: TYPE ERROR (MACRO USED AS VALUE?)
            JSR     RECORD_XREF ; RECORD THIS USAGE IN THE CROSS-REFERENCE
            INY
            LDA     (SYMTBLP),Y ; LOAD VALUE FROM SYMBOL TABLE (LO BYTE)
            STA     SYMVAL
            INY
            LDA     (SYMTBLP),Y ; (MID BYTE)
            STA     SYMVAL+1
            INY
            LDA     (SYMTBLP),Y ; (HI BYTE)
            STA     SYMVAL+2
            BIT     ENT_TY_FL   ; V FLAG IN TYPE BYTE: FORWARD-REFERENCE?
            BVC     EVS_UNRES   ; NO: UNRESOLVED
            LDA     ENT_TY_FL
            AND     #$10        ; BIT $10: NEEDS SECOND-PASS RE-EVALUATION?
            BEQ     EVS_RETUR
            LDA     URESFLG
            ORA     #$40        ; SET 'SOFT-UNRESOLVED' BIT
            STA     URESFLG
EVS_RETUR   RTS
EVS_UNRES   LDA     #$FF        ; UNDEFINED: LOAD PLACEHOLDER VALUE $FFFF
            STA     SYMVAL
            STA     SYMVAL+1
            LDA     #$00
            STA     SYMVAL+2
            LDA     LINE_POS
            STA     UNR_LN_POS  ; RECORD POSITION OF UNRESOLVED REFERENCE
            LDA     #$C0
            ORA     URESFLG     ; SET URESFLG = $C0 (HARD-UNRESOLVED)
            STA     URESFLG
            RTS

EVS_ERROR   LDY     LINE_POS
            JSR     ERR_DUP
            ; NOT REACHED

EVS_NOTFD   LDA     #$FF        ; NOT FOUND: PLACEHOLDER VALUE
            STA     SYMVAL
            STA     SYMVAL+1
            LDA     #$00
            STA     SYMVAL+2
            LDA     #$80
            STA     INSTR_FLAGS ; FLAG: NEW SYMBOL (AUTO-ADD)
            JSR     EIN_NW_SYM  ; ADD SYMBOL TO TABLE
            JMP     EVS_UNRES   ; RECORD AS UNRESOLVED

; ============================================================================
; PSH_OPR
;
; PUSHES THE OPERATOR CHARACTER IN A ONTO THE OPERATOR STACK AT
; OPR_STACK[OPR_ST_TP], THEN INCREMENTS OPR_ST_TP
; (OPERATOR STACK DEPTH).  CALLS ERR_TCPLX (COMPLEXITY ERROR) IF THE STACK IS
; FULL (DEPTH >= $10 = 16 OPERATORS).
; ============================================================================
PSH_OPR     STX     SAVEX
            LDX     OPR_ST_TP       ; OPERATOR STACK DEPTH
            STA     OPR_STACK,X     ; PUSH OPERATOR AT STACK TOP
            INX
            CPX     #$10            ; STACK FULL?
            BCS     PUOP_ERROR      ; YES: COMPLEXITY ERROR
            STX     OPR_ST_TP       ; UPDATE DEPTH
            LDX     SAVEX
            RTS
PUOP_ERROR  JSR     ERR_TCPLX       ; COMPLEXITY ERROR (EXPRESSION TOO DEEP)

; ============================================================================
; POP_OPR
;
; POPS THE TOP OPERATOR CHARACTER FROM THE OPERATOR STACK
; OPR_STACK[OPR_ST_TP-1] INTO A, DECREMENTS OPR_ST_TP.
; CALLS ERR_SYN (SYNTAX ERROR) IF THE STACK IS EMPTY.
; ============================================================================
POP_OPR     STX     SAVEX
            LDX     OPR_ST_TP           ; OPERATOR STACK DEPTH
            BMI     POOP_ERROR          ; DEPTH NEGATIVE? -> ERROR
            BEQ     POOP_ERROR          ; DEPTH ZERO? -> ERROR (STACK EMPTY)
            LDA     OPR_STACK-1,X       ; READ TOP ENTRY (OPR_STACK-1+DEPTH)
            DEC     OPR_ST_TP           ; DECREMENT DEPTH
            LDX     SAVEX
            RTS
POOP_ERROR  JSR     ERR_SYN             ; SYNTAX ERROR (UNBALANCED OPERATORS)
            ; NOT REACHED

; ============================================================================
; DSP_PR_TR
;
; DISPATCHES EVALUATION OF A SINGLE PRIMARY EXPRESSION TERM BASED ON THE
; LEADING CHARACTER IN A (ALREADY READ FROM LINE_BUF[Y]):
;
;   'A'..'Z'   -> EVAL_SYM_R: LOOK UP SYMBOL IN HASH TABLE
;   '0'..'9'   -> PRS_DEC_LT
;   '$'        -> PRS_HEX_LT
;   '\'' (')   -> CHARACTER LITERAL: NEXT CHAR VALUE STORED IN SYMVAL
;   '@'        -> PRS_OCT_LT
;   '%'        -> PRS_BIN_LT
;   '*'        -> CURRENT PROGRAM COUNTER (LOCCNT2) -> SYMVAL
;   ANYTHING ELSE -> SYNTAX ERROR
; ============================================================================
DSP_PR_TR   CMP     #'A'                ; BELOW 'A'?
            BCC     DIP_CHKDG           ; YES: NOT A LETTER
            CMP     #'Z'+1              ; ABOVE 'Z'?
            BCS     DIP_CHKHX           ; YES: NOT A LETTER
            JSR     EVAL_SYM_R          ; IDENTIFIER: LOOK UP SYMBOL
            LDY     LINE_POS            ; RESTORE Y FROM SYMBOL LOOKUP
            LDA     LINE_BUF,Y          ; A = CHAR AFTER IDENTIFIER
            RTS
DIP_CHKDG   CMP     #'0'                ; BELOW '0'?
            BCC     DIP_CHKHX           ; YES: NOT A DIGIT
            CMP     #'9'+1
            BCS     DIP_CHKHX           ; ABOVE '9': NOT A DIGIT
            JMP     PRS_DEC_LT          ; DECIMAL LITERAL
DIP_CHKHX   CMP     HEXPREFIX           ; '$'?
            BNE     DIP_CHKQU
            JMP     PRS_HEX_LT          ; HEX LITERAL
DIP_CHKQU   CMP     APOSTROPHE          ; '\'' (APOSTROPHE)?
            BNE     DIP_CHKOC
            INY                         ; ADVANCE PAST THE QUOTE
            LDA     LINE_BUF,Y          ; READ THE CHARACTER
            BNE     DIP_STORE
            LDA     #' '                ; NUL AFTER QUOTE -> TREAT AS SPACE
            DEY
DIP_STORE   STA     SYMVAL              ; STORE CHARACTER CODE IN SYMVAL[0]
            LDA     #$00
            STA     SYMVAL+1            ; HIGH BYTES = 0
            STA     SYMVAL+2
            INY                         ; ADVANCE PAST CHARACTER
            LDA     LINE_BUF,Y
            CMP     APOSTROPHE          ; CLOSING QUOTE?
            BNE     DIPRTE_DONE         ; NO: SINGLE-CHAR FORM
            INY                         ; YES: SKIP CLOSING QUOTE TOO
            LDA     LINE_BUF,Y
DIPRTE_DONE RTS
DIP_CHKOC   CMP     OCTPREFIX           ; '@'?
            BNE     DIP_CHKBN
            JMP     PRS_OCT_LT          ; OCTAL LITERAL
DIP_CHKBN   CMP     BINPREFIX           ; '%'?
            BNE     DIP_CHKPC
            JMP     PRS_BIN_LT          ; BINARY LITERAL
DIP_CHKPC   CMP     PCSYMBOL            ; '*' (CURRENT PC)?
            BNE     DIP_ERROR
            LDA     LOCCNT2             ; LOAD CURRENT LOCATION COUNTER
            STA     SYMVAL
            LDA     LOCCNT2+1
            STA     SYMVAL+1
            LDA     #$00
            STA     SYMVAL+2
            INY                         ; ADVANCE PAST '*'
            LDA     LINE_BUF,Y
            RTS
DIP_ERROR   JSR     ERR_SYN             ; SYNTAX ERROR: UNRECOGNISED TERM
            ; NOT REACHED

; ============================================================================
; EVAL_EXPR / EVAL_EXP2
;
; TOP-LEVEL IDENTIFIER SCANNER CALLED FROM EVAL_SYM_R.
;
; EVAL_EXPR: RESETS Y TO 0 BEFORE SCANNING.
; EVAL_EXP2: SCANS FROM THE CURRENT Y POSITION.
;
; READS CONSECUTIVE VALID IDENTIFIER CHARACTERS (LETTERS 'A'..'Z', DIGITS
; '0'..'9', '_', '?', '.') FROM LINE_BUF[Y] INTO IDENT_BUF, NULL-TERMINATES THE
; STRING, SAVES ITS LENGTH IN IDENT_LEN AND ADVANCES LINE_POS TO
; THE CHARACTER FOLLOWING THE IDENTIFIER.
;
; ON RETURN A = CHARACTER THAT TERMINATED THE SCAN (NOT PART OF IDENTIFIER).
; CALLS IDE_ERROR (IDENTIFIER ERROR) IF THE FIRST CHARACTER IS NOT A LETTER.
; ============================================================================
EVAL_EXPR   LDY     #$00            ; START FROM BEGINNING OF LINE BUFFER
EVAL_EXP2   LDA     LINE_BUF,Y      ; FIRST CHARACTER
            CMP     #'A'
            BCC     IDE_ERROR       ; BELOW 'A': NOT A VALID IDENTIFIER START
            CMP     #'Z'+1
            BCS     IDE_ERROR       ; ABOVE 'Z': NOT VALID

; ============================================================================
; EVAL_COLID
;
; TOKENISES (COLLECTS) AN IDENTIFIER FROM LINE_BUF STARTING AT THE CHARACTER
; ALREADY LOADED IN A (FIRST CHARACTER, ALREADY VALIDATED AS 'A'..'Z') AND
; AT THE OFFSET IN Y.
;
; CALLED FROM EVAL_EXPR / EVAL_EXP2 IMMEDIATELY AFTER THE FIRST
; CHARACTER PASSES THE 'A'..'Z' RANGE CHECK.  ALSO CALLED DIRECTLY BY
; ASM_ZP_ABS AND SIMILAR SITES THAT NEED TO TOKENISE A MNEMONIC.
;
; ALGORITHM:
;   APPENDS CHARACTERS TO IDENT_BUF[0..X] WHILE EACH SUCCESSIVE CHARACTER IS:
;     'A'..'Z'   UPPER-CASE LETTER
;     '0'..'9'   DECIMAL DIGIT
;     '_'        UNDERSCORE  (UNDERSCORE)
;     '?'        QUESTION-MARK (QMARK)
;     '.'        PERIOD (DOT)
;   STOPS ON NUL OR ANY OTHER CHARACTER.
;   IF THE ACCUMULATED LENGTH REACHES 32 (IDENT_BUF FULL), CALLS
;   ERR_IDENT AND DOES NOT RETURN NORMALLY.
;
; ON RETURN:
;   IDENT_BUF[0..IDENT_LEN-1]  NULL-TERMINATED IDENTIFIER STRING
;   IDENT_LEN                  NUMBER OF CHARACTERS STORED
;   LINE_POS                   INDEX OF THE FIRST CHAR AFTER THE IDENTIFIER
;   X                          RESTORED FROM SAVEX
;   Y                          POINTS ONE PAST THE LAST IDENTIFIER CHARACTER
;   A                          FIRST CHAR THAT DID NOT BELONG TO THE IDENTIFIER
; ============================================================================
EVAL_COLID  STX     SAVEX
            LDX     #$00
EVC_STORE   STA     IDENT_BUF,X     ; STORE CHARACTER IN IDENTIFIER BUFFER
            INX
            CPX     #$20            ; BUFFER FULL (32 CHARS)?
            BCC     EVCOID_NEXT
            JSR     ERR_IDENT       ; IDENTIFIER TOO LONG: ERROR
EVCOID_NEXT INY
            LDA     LINE_BUF,Y      ; NEXT CHARACTER
            BEQ     EVC_ISNUL       ; NUL: END OF IDENTIFIER
            CMP     #'A'
            BCC     EVC_CHKDEC      ; BELOW 'A': MIGHT BE DIGIT OR EMBED CHAR
            CMP     #'Z'+1
            BCC     EVC_STORE       ; 'A'..'Z': CONTINUE IDENTIFIER
EVC_CHKEM   CMP     UNDERSCORE      ; '_'?
            BEQ     EVC_STORE
            CMP     QMARK           ; '?'?
            BEQ     EVC_STORE
            CMP     DOT             ; '.'?
            BEQ     EVC_STORE
EVC_ISNUL   LDA     #$00
            STA     IDENT_BUF,X     ; NULL-TERMINATE IDENTIFIER
            STY     LINE_POS        ; SAVE POSITION AFTER IDENTIFIER
            STX     IDENT_LEN       ; SAVE IDENTIFIER LENGTH
            LDX     SAVEX
            RTS
EVC_CHKDEC  CMP     #'0'            ; '0'..'9'?
            BCC     EVC_CHKEM       ; NO: CHECK EMBEDDED CHARS
            CMP     #'9'+1
            BCC     EVC_STORE       ; YES: VALID WITHIN IDENTIFIER
            BCS     EVC_CHKEM       ; ABOVE '9': CHECK EMBEDDED CHARS
IDE_ERROR   JSR     ERR_IDENT       ; IDENTIFIER ERROR (INVALID START CHAR)

; ============================================================================
; ARITHMETIC OPERATIONS  (ADD24 - PRS_HEX_LT)
;
; EACH HANDLER IS CALLED VIA THE DISPATCH TABLE AT OP_DISPATCH WITH X POINTING
; TO THE CURRENT VALUE-STACK FRAME ACCUM24[0..2] AND SYMVAL[0..2] HOLDING THE
; SECOND OPERAND.  THE RESULT IS WRITTEN BACK TO ACCUM24,X.
;
; OVERFLOW CALLS ARI_OVER (ARITHMETIC ERROR).
;
; ADD24  ACCUM24,X[24] += SYMVAL[24]
; SUB24  ACCUM24,X[24] -= SYMVAL[24]
; MUL24  ACCUM24,X[24] *= SYMVAL[24]  (SIGNED 24-BIT VIA PREP_SIGN + UMUL24)
; DIV24  ACCUM24,X[24] /= SYMVAL[24]  (SIGNED 24-BIT VIA PREP_SIGN + UDIV24)
; REM24  ACCUM24,X[24] %= SYMVAL[24]  (SIGNED 24-BIT, REMAINDER)
; AND24  ACCUM24,X[24] &= SYMVAL[24]
; OR24   ACCUM24,X[24] |= SYMVAL[24]
; XOR24  ACCUM24,X[24] ^= SYMVAL[24]
; ============================================================================

; ADDITION HANDLER
;
ADD24       LDA     ACCUM24,X       ; ACCUMULATOR LO
            CLC
            ADC     SYMVAL          ; + OPERAND LO
            STA     ACCUM24,X
            LDA     ACCUM24+1,X     ; ACCUMULATOR MID
            ADC     SYMVAL+1        ; + OPERAND MID (WITH CARRY)
            STA     ACCUM24+1,X
            LDA     ACCUM24+2,X     ; ACCUMULATOR HI
            ADC     SYMVAL+2        ; + OPERAND HI (WITH CARRY)
            STA     ACCUM24+2,X
            BVC     AD_RETURN       ; SIGNED OVERFLOW?
            JMP     ARI_OVER       ; YES: ARITHMETIC ERROR
AD_RETURN   RTS

; SUBTRACTION HANDLER
;
SUB24       LDA     ACCUM24,X       ; ACCUMULATOR LO
            SEC
            SBC     SYMVAL          ; - OPERAND LO
            STA     ACCUM24,X
            LDA     ACCUM24+1,X     ; ACCUMULATOR MID
            SBC     SYMVAL+1        ; - OPERAND MID
            STA     ACCUM24+1,X
            LDA     ACCUM24+2,X     ; ACCUMULATOR HI
            SBC     SYMVAL+2        ; - OPERAND HI
            STA     ACCUM24+2,X
            BVC     SU_RETURN       ; SIGNED OVERFLOW?
            JMP     ARI_OVER       ; YES: ARITHMETIC ERROR
SU_RETURN   RTS

; MULTIPLICATION HANDLER
;
MUL24       JSR     PREP_SIGN       ; PREPARE: MAKE BOTH POSITIVE, RECORD SIGN
            JSR     UMUL24          ; UNSIGNED 24X24-BIT MULTIPLY -> SYMVAL[24]
            ; FALL THROUGH TO APPLY_SIGN (NEG RESULT IF OPERAND SIGNS DIFFERED)

; ============================================================================
; APPLY_SIGN
;
; IF BIT 7 OF SIGN_FLAG (THE SIGN FLAG SET BY PREP_MULTIPLY) IS SET, THE RESULT
; IN SYMVAL[0..2] IS NEGATED (TWO'S COMPLEMENT) AND STORED BACK TO ACCUM24,X.
; IF CLEAR, THE RESULT IS STORED AS-IS.  OVERFLOW DETECTION INCLUDED.
; ============================================================================
APPLY_SIGN  BIT     SIGN_FLAG   ; BIT 7 SET: RESULT SHOULD BE NEGATIVE?
            BPL     APSI_POS    ; NO: STORE RESULT POSITIVE
            LDA     #$00        ; NEGATE: 0 - SYMVAL
            SEC
            SBC     SYMVAL
            STA     ACCUM24,X
            LDA     #$00
            SBC     SYMVAL+1
            STA     ACCUM24+1,X
            LDA     #$00
            SBC     SYMVAL+2
            STA     ACCUM24+2,X
            BVC     APSI_RETURN
            JMP     ARI_OVER   ; OVERFLOW: ARITHMETIC ERROR
APSI_RETURN RTS
APSI_POS    LDA     SYMVAL      ; STORE POSITIVE RESULT
            STA     ACCUM24,X
            LDA     SYMVAL+1
            STA     ACCUM24+1,X
            LDA     SYMVAL+2
            STA     ACCUM24+2,X
            RTS

; DIVISION HANDLER
;
DIV24       JSR     PREP_SIGN   ; PREPARE SIGN, MAKE OPERANDS ABSOLUTE
            JSR     UDIV24      ; UNSIGND 24/24-BIT DIVIDE -> TMPVAL (QUOTIENT)
            LDA     TMPVAL      ; QUOTIENT -> SYMVAL
            STA     SYMVAL
            LDA     TMPVAL+1
            STA     SYMVAL+1
            LDA     TMPVAL+2
            STA     SYMVAL+2
            JMP     APPLY_SIGN  ; APPLY SIGN TO RESULT

; REMAINDER HANDLER
;
REM24       JSR     PREP_SIGN   ; PREPARE SIGN, MAKE OPERANDS ABSOLUTE
            JSR     UDIV24      ; DIVIDE -> TMPVAL2 = REMAINDER
            LDA     TMPVAL2     ; REMAINDER -> SYMVAL
            STA     SYMVAL
            LDA     TMPVAL2+1
            STA     SYMVAL+1
            LDA     TMPVAL2+2
            STA     SYMVAL+2
            JMP     APPLY_SIGN  ; APPLY SIGN TO RESULT

; ============================================================================
; PREP_SIGN
;
; PREPARES BOTH OPERANDS FOR SIGNED MULTIPLICATION OR DIVISION:
;   1. XORS THE SIGN BITS (BIT 7 OF HI BYTES) OF ACCUMULATOR (ACCUM24+2,X) AND
;      SYMVAL+2 AND STORES THE RESULT IN SIGN_FLAG:
;      SIGN_FLAG BIT 7 SET -> RESULT SHOULD BE NEGATIVE.
;   2. IF THE ACCUMULATOR IS NEGATIVE (BIT 7 OF ACCUM24+2,X SET), COMPUTES ITS
;      TWO'S COMPLEMENT AND STORES IN TMPVAL[0..2].
;      OTHERWISE COPIES THE ACCUMULATOR TO TMPVAL.
;   3. IF SYMVAL+2 IS NEGATIVE, NEGATES SYMVAL IN PLACE.
;
; ENTRY:  ACCUM24[0..2] = LEFT OPERAND (24-BIT SIGNED)
;         SYMVAL[0..2]  = RIGHT OPERAND (24-BIT SIGNED)
; EXIT:   TMPVAL[0..2]  = |LEFT OPERAND|
;         SYMVAL[0..2]  = |RIGHT OPERAND|
;         SIGN_FLAG = RESULT SIGN FLAG (BIT 7 SET -> NEGATE RESULT)
; ============================================================================
PREP_SIGN   LDA     ACCUM24+2,X ; HIGH BYTE OF ACCUMULATOR
            PHP                 ; SAVE FLAGS (N BIT = SIGN OF ACCUMULATOR)
            EOR     SYMVAL+2    ; XOR WITH HIGH BYTE OF RIGHT OPERAND
            STA     SIGN_FLAG   ; SIGN_FLAG BIT 7 = RESULT SIGN
            PLP                 ; RESTORE ACCUMULATOR FLAGS
            BPL     PRSI_COPY   ; ACCUMULATOR NON-NEGATIVE: COPY AS-IS
            LDA     #$00        ; ACCUMULATOR NEGATIVE: NEGATE IT -> TMPVAL
            SEC
            SBC     ACCUM24,X
            STA     TMPVAL
            LDA     #$00
            SBC     ACCUM24+1,X
            STA     TMPVAL+1
            LDA     #$00
            SBC     ACCUM24+2,X
            STA     TMPVAL+2
            JMP     PRSI_CONT
PRSI_COPY   LDA     ACCUM24,X   ; COPY ACCUMULATOR TO TMPVAL (ABSOLUTE VALUE)
            STA     TMPVAL
            LDA     ACCUM24+1,X
            STA     TMPVAL+1
            LDA     ACCUM24+2,X
            STA     TMPVAL+2
PRSI_CONT   LDA     SYMVAL+2    ; HIGH BYTE OF RIGHT OPERAND
            BPL     PRSI_DONE   ; NON-NEGATIVE: ALREADY ABSOLUTE
            LDA     #$00        ; NEGATIVE: NEGATE IN PLACE
            SEC
            SBC     SYMVAL
            STA     SYMVAL
            LDA     #$00
            SBC     SYMVAL+1
            STA     SYMVAL+1
            LDA     #$00
            SBC     SYMVAL+2
            STA     SYMVAL+2
PRSI_DONE   RTS

; ============================================================================
; UMUL24
;
; UNSIGNED 24X24-BIT MULTIPLICATION USING THE SHIFT-AND-ADD ALGORITHM.
; COMPUTES TMPVAL X SYMVAL -> SYMVAL (LOW 24 BITS OF PRODUCT).
; TMPVAL2 IS USED AS THE PARTIAL-PRODUCT ACCUMULATOR.
; CALLS ERR_ARITH (OVERFLOW ERROR) IF THE 24-BIT PRODUCT OVERFLOWS.
;
; ENTRY:  TMPVAL[0..2] = MULTIPLICAND
;         SYMVAL[0..2] = MULTIPLIER (SHIFTED OUT DURING COMPUTATION)
; EXIT:   SYMVAL[0..2] = PRODUCT (LOW 24 BITS)
; ============================================================================
UMUL24      STX     SAVEX
            LDA     #$00        ; INITIALISE ACCUMULATOR TO ZERO
            STA     TMPVAL2
            STA     TMPVAL2+1
            STA     TMPVAL2+2
            LDX     #$19        ; 25 ITERATIONS (24 BITS + SENTINEL)
            CLC
UM_SHIFT    ROR     TMPVAL2+2   ; RIGHT-SHIFT ACCUMULATOR (ABSORB CARRY)
            ROR     TMPVAL2+1
            ROR     TMPVAL2
            ROR     SYMVAL+2    ; SHIFT MULTIPLIER RIGHT (LSB -> CARRY)
            ROR     SYMVAL+1
            ROR     SYMVAL
            DEX
            BEQ     UM_RETVAL   ; ALL BITS PROCESSED: DONE
            BCC     UM_SHIFT    ; CY CLEAR: CURR MULTIPLIER BIT = 0, SKIP ADD
            LDA     TMPVAL2     ; CARRY SET: CURRENT BIT = 1; ADD MULTIPLICAND
            CLC
            ADC     TMPVAL
            STA     TMPVAL2
            LDA     TMPVAL2+1
            ADC     TMPVAL+1
            STA     TMPVAL2+1
            LDA     TMPVAL2+2
            ADC     TMPVAL+2
            STA     TMPVAL2+2
            JMP     UM_SHIFT
UM_RETVAL   LDX     SAVEX
            LDA     TMPVAL2     ; MOVE PARTIAL PRODUCT INTO SYMVAL
            ORA     TMPVAL2+1
            ORA     TMPVAL2+2
            BNE     ARI_OVER    ; NON-ZERO OVERFLOW PORTION: ERROR
            RTS

ARI_OVER    JSR     ERR_ARITH   ; ARITHMETIC OVERFLOW ERROR

; ============================================================================
; UDIV24
;
; UNSIGNED 24/24-BIT LONG DIVISION USING THE SUBTRACT-AND-SHIFT ALGORITHM.
; COMPUTES TMPVAL / SYMVAL -> TMPVAL (QUOTIENT), REMAINDER -> TMPVAL2.
; CALLS ARI_OVER -> ERR_ARITH (ERROR) IF SYMVAL (DIVISOR) IS ZERO.
;
; ENTRY:  TMPVAL[0..2] = DIVIDEND
;         SYMVAL[0..2] = DIVISOR
; EXIT:   TMPVAL[0..2] = QUOTIENT
;         TMPVAL2[0..2] = REMAINDER
; ============================================================================
UDIV24      STX     SAVEX
            LDA     SYMVAL      ; CHECK DIVISOR <> 0
            ORA     SYMVAL+1
            ORA     SYMVAL+2
            BEQ     ARI_OVER    ; ZERO DIVISOR: ERROR
            LDA     #$00        ; INITIALISE REMAINDER TO ZERO
            STA     TMPVAL2
            STA     TMPVAL2+1
            STA     TMPVAL2+2
            LDX     #$19        ; 25 ITERATIONS
            CLC
            BCC     UD_RESULT   ; (ALWAYS BRANCH TO AVOID ENTERING MID-LOOP)
UD_SHIFT    ROL     TMPVAL2     ; SHIFT REMAINDER LEFT, SHIFT IN DIVIDEND MSB
            ROL     TMPVAL2+1
            ROL     TMPVAL2+2
            LDA     TMPVAL2     ; TENTATIVE SUBTRACT: REMAINDER - DIVISOR
            SEC
            SBC     SYMVAL
            STA     DIV_TEMP    ; SCRATCH FOR TENTATIVE RESULT
            LDA     TMPVAL2+1
            SBC     SYMVAL+1
            STA     DIV_TEMP+1
            LDA     TMPVAL2+2
            SBC     SYMVAL+2
            BCC     UD_RESULT   ; BORROW: DIVISOR > REMAINDER; DON'T SUBTRACT
            STA     TMPVAL2+2   ; ACCEPT SUBTRACTION: UPDATE REMAINDER
            LDA     DIV_TEMP+1
            STA     TMPVAL2+1
            LDA     DIV_TEMP
            STA     TMPVAL2
UD_RESULT   ROL     TMPVAL      ; SHIFT QUOTIENT LEFT, BRING IN RESULT BIT
            ROL     TMPVAL+1
            ROL     TMPVAL+2
            DEX
            BNE     UD_SHIFT    ; REPEAT FOR ALL BITS
            LDX     SAVEX
            RTS

; ============================================================================
; LOD_OP_RS
;
; POPS THE TOP OPERATOR FROM THE OPERATOR STACK (VIA POP_OPR) AND APPLIES
; IT AS AN EXTRACTION/ASSIGNMENT OPERATION ON THE VALUE STACK:
;
;   '='  -> COPY ACCUMULATOR VALUE ACCUM24,X -> SYMVAL (NO-OP ASSIGN)
;   '<'  -> LOW-BYTE EXTRACT: SYMVAL = ACCUM24[0], HIGH BYTES ZEROED
;   '>'  -> HIGH-BYTE EXTRACT: SYMVAL = ACCUM24[1], HIGH BYTES ZEROED
;   OTHER -> SYNTAX ERROR
;
; CALLED AFTER EVALUATING EACH PRIMARY TERM TO FINALISE THE PENDING PREFIX
; OPERATOR ('=', '<', OR '>') THAT WAS PUSHED AT THE START OF THE OPERAND.
; ============================================================================
LOD_OP_RS   JSR     POP_OPR             ; POP TOP OPERATOR -> A
            STX     SAVEX
            LDX     VAL_ST_TP           ; VALUE-STACK DEPTH
            CMP     #'='                ; '=' ASSIGN?
            BNE     LOP_CHKLO
LOP_CP_RES  LDA     ACCUM24,X           ; COPY ACCUMULATOR -> SYMVAL
            STA     SYMVAL
            LDA     ACCUM24+1,X
            STA     SYMVAL+1
            LDA     ACCUM24+2,X
            STA     SYMVAL+2
            LDX     SAVEX
            RTS
LOP_CHKLO   CMP     LOBYTE              ; '<' LOW-BYTE EXTRACT?
            BNE     LOP_CHKHI
LOOPRE_ZERO LDA     #$00                ; ZERO THE UPPER BYTES
            STA     ACCUM24+1,X
            STA     ACCUM24+2,X
            BEQ     LOP_CP_RES          ; COPY RESULT (ONLY LO BYTE MATTERS)
LOP_CHKHI   CMP     HIBYTE              ; '>' HIGH-BYTE EXTRACT?
            BNE     LOP_ERROR
            LDA     ACCUM24+1,X         ; SHIFT MID BYTE INTO LO POSITION
            STA     ACCUM24,X
            JMP     LOOPRE_ZERO         ; ZERO UPPER BYTES AND COPY
LOP_ERROR   JSR     ERR_SYN             ; SYNTAX ERROR: UNEXPECTED OPERATOR

; ============================================================================
; SYMBOL-TABLE INTEGRITY CHECKSUM
; ============================================================================
CUM_XOR     .BYTE   $00
RUN_EOR_SUM .BYTE   $00

; AND HANDLER
;
AND24       LDA     ACCUM24,X           ; ACCUMULATOR LO
            AND     SYMVAL              ; AND OPERAND LO
            STA     ACCUM24,X
            LDA     ACCUM24+1,X         ; ACCUMULATOR MID
            AND     SYMVAL+1
            STA     ACCUM24+1,X
            LDA     ACCUM24+2,X         ; ACCUMULATOR HI
            AND     SYMVAL+2
            STA     ACCUM24+2,X
            RTS

; OR HANDLER
;
OR24        LDA     ACCUM24,X           ; ACCUMULATOR LO
            ORA     SYMVAL              ; OR OPERAND LO
            STA     ACCUM24,X
            LDA     ACCUM24+1,X         ; ACCUMULATOR MID
            ORA     SYMVAL+1
            STA     ACCUM24+1,X
            LDA     ACCUM24+2,X         ; ACCUMULATOR HI
            ORA     SYMVAL+2
            STA     ACCUM24+2,X
            RTS

; XOR HANDLER
;
XOR24       LDA     ACCUM24,X           ; ACCUMULATOR LO
            EOR     SYMVAL              ; XOR OPERAND LO
            STA     ACCUM24,X
            LDA     ACCUM24+1,X         ; ACCUMULATOR MID
            EOR     SYMVAL+1
            STA     ACCUM24+1,X
            LDA     ACCUM24+2,X         ; ACCUMULATOR HI
            EOR     SYMVAL+2
            STA     ACCUM24+2,X
            RTS

; ============================================================================
; PRS_HEX_LT
;
; PARSES A HEXADECIMAL INTEGER LITERAL FROM LINE_BUF[Y+1..] (THE LEADING '$'
; IS ALREADY CONSUMED, Y POINTS PAST IT BEFORE THE CALL).
;
; READS SUCCESSIVE HEX DIGITS ('0'..'9', 'A'..'F') INTO SYMVAL[0..2] BY
; CALLING SHF_LFT_HX FOR EACH VALID DIGIT.  STOPS AT THE FIRST
; NON-HEX CHARACTER AND RETURNS IT IN A.
;
; SETS HEX_DG_FL ($FF) AS EACH DIGIT IS PROCESSED; CALLS ERR_SYN (SYNTAX
; ERROR) IF NO VALID DIGIT IS FOUND AT ALL.
; ============================================================================
PRS_HEX_LT  JSR     CLEAR_VALUE ; CLEAR SYMVAL AND HEX_DG_FL
PAH_PARSE   INY                 ; ADVANCE TO NEXT CHARACTER
            LDA     LINE_BUF,Y
            SEC
            SBC     #'0'        ; NORMALISE: '0'=0, '9'=9, 'A'->10 ETC.
            BCC     RET_VAL     ; < '0': NOT HEX -> DONE
            CMP     #$0A
            BCC     PAH_DECIM   ; 0..9: VALID DECIMAL DIGIT
            SBC     #$07        ; A..F: SUBTRACT 7 MORE ($41 - $30 - 7 = 10)
            CMP     #$0A
            BCC     RET_VAL     ; < 10 AFTER CORRECTION: GAP CHARACTER, DONE
            CMP     #$10
            BCS     RET_VAL     ; >= 16: NOT A HEX DIGIT
PAH_DECIM   JSR     SHF_LFT_4   ; SHIFT SYMVAL LEFT BY 4 BITS (X16)
                                ; VIA SHF_LFT_2
            JSR     SHF_LFT_HX  ; ADD CURRENT NIBBLE INTO SYMVAL, SET FLAG
            JMP     PAH_PARSE   ; CONTINUE WITH NEXT CHARACTER

; ============================================================================
; RET_VAL
;
; COMMON RETURN FOR VALUE PARSE ROUTINES
; ============================================================================
RET_VAL     BIT     HEX_DG_FL   ; AT LEAST ONE VALID DIGIT SEEN?
            BMI     REV_RETCH   ; YES: RETURN STOPPING CHARACTER
            JSR     ERR_SYN     ; NO: SYNTAX ERROR (BARE '$')
            ; NOT REACHED
REV_RETCH   LDA     LINE_BUF,Y  ; RETURN STOPPING CHARACTER IN A
            RTS

; ============================================================================
; CLEAR_VALUE
;
; ZEROES SYMVAL[0..2] AND HEX_DG_FL, READY FOR ACCUMULATION OF A NEW
; NUMERIC LITERAL.
; ============================================================================
CLEAR_VALUE LDA     #$00
            STA     HEX_DG_FL   ; NO DIGITS SEEN YET
            LDA     #$00        ; ZERO THE 24-BIT ACCUMULATOR
            STA     SYMVAL
            STA     SYMVAL+1
            STA     SYMVAL+2
            RTS

; ============================================================================
; SHF_LFT_HX
;
; SHIFTS SYMVAL[0..2] LEFT BY 4 BITS (EQUIVALENT TO X16 FOR A NEW HEX DIGIT)
; USING SHF_LFT_4 (FOUR SUCCESSIVE LEFT-SHIFTS), THEN ADDS THE LOW NIBBLE IN A
; TO SYMVAL[0].  SETS HEX_DG_FL TO $FF (AT LEAST ONE NIBBLE SEEN).
; CALLS ERR_ARITH (OVERFLOW) IF THE CARRY BIT IS SET AFTER SHIFTING.
; ============================================================================
SHF_LFT_HX  DEC     HEX_DG_FL   ; $00 -> $FF: MARK 'DIGIT SEEN'
            CLC
            ADC     SYMVAL      ; SYMVAL[0] += NIBBLE VALUE
            STA     SYMVAL
            LDA     SYMVAL+1
            ADC     #$00        ; PROPAGATE CARRY
            STA     SYMVAL+1
            LDA     SYMVAL+2
            ADC     #$00
            STA     SYMVAL+2
            BCC     SHE_RETRN
            JSR     ERR_ARITH   ; OVERFLOW: HEX LITERAL TOO LARGE
SHE_RETRN   RTS

; ============================================================================
; PRS_DEC_LT
;
; PARSES AN UNSIGNED DECIMAL INTEGER FROM LINE_BUF[Y].
; CLEARS SYMVAL VIA CLEAR_VALUE, THEN FOR EACH '0'..'9' DIGIT:
;   SYMVAL = SYMVAL * 10 + DIGIT  (VIA MULT_BY_10 + SHF_LFT_HX ADD)
; STOPS AT THE FIRST NON-DIGIT
; ============================================================================
PRS_DEC_LT  JSR     CLEAR_VALUE ; CLEAR SYMVAL AND HEX_DG_FL
            BEQ     PAD_PARSE   ; (ALWAYS; ZERO SET BY JSR CLEAR_VALUE)
PADELI_NEXT INY                 ; ADVANCE TO NEXT CHARACTER
PAD_PARSE   LDA     LINE_BUF,Y
            SEC
            SBC     #'0'        ; SUBTRACT '0' TO GET DIGIT VALUE
            BCC     PAD_RETCH   ; < 0: NOT A DIGIT
            CMP     #$0A
            BCS     PAD_RETCH   ; >= 10: NOT A DECIMAL DIGIT
            PHA                 ; SAVE DIGIT
            JSR     MULT_BY_10  ; MULTIPLY CURRENT SYMVAL BY 10
            PLA                 ; RESTORE DIGIT
            JSR     SHF_LFT_HX  ; ADD DIGIT INTO SYMVAL (LOW NIBBLE PATH)
            JMP     PADELI_NEXT ; NEXT DIGIT
PAD_RETCH   LDA     LINE_BUF,Y  ; RETURN STOPPING CHARACTER
            RTS

; ============================================================================
; PRS_OCT_LT
;
; PARSES AN OCTAL INTEGER FROM LINE_BUF[Y+1..] (THE LEADING '@' IS ALREADY
; CONSUMED).  FOR EACH '0'..'7' DIGIT, SHIFTS SYMVAL LEFT BY 3 BITS
; (VIA SHF_LFT_1 THREE TIMES) AND ADDS THE DIGIT.
; ============================================================================
PRS_OCT_LT  JSR     CLEAR_VALUE ; CLEAR SYMVAL
PAO_PARSE   INY
            LDA     LINE_BUF,Y
            SEC
            SBC     #'0'
            BCC     RET_VAL     ; < '0': DONE
            CMP     #$08
            BCS     RET_VAL     ; >= 8: NOT OCTAL
            JSR     SHF_LFT_3   ; SHIFT SYMVAL LEFT 3 BITS (X8)
            JSR     SHF_LFT_HX  ; ADD OCTAL DIGIT
            JMP     PAO_PARSE

; ============================================================================
; PRS_BIN_LT
;
; PARSES A BINARY INTEGER FROM LINE_BUF[Y+1..] (THE LEADING '%' IS ALREADY
; CONSUMED).  FOR EACH '0' OR '1' DIGIT, SHIFTS SYMVAL LEFT BY 1 BIT VIA
; ROL AND ORS IN THE NEW BIT.  USES HEX_DG_FL TO TRACK DIGIT COUNT.
; ============================================================================
PRS_BIN_LT  JSR     CLEAR_VALUE ; CLEAR SYMVAL
PAB_PARSE   INY
            LDA     LINE_BUF,Y
            CMP     #'1'        ; '1'?
            BNE     PAB_CHK_ZE
PABILI_SEEN DEC     HEX_DG_FL   ; MARK DIGIT SEEN ($FF)
            ROL     SYMVAL      ; SHIFT '1' BIT INTO SYMVAL (CARRY WAS 1)
            ROL     SYMVAL+1
            ROL     SYMVAL+2
            BCC     PAB_PARSE   ; NO OVERFLOW: CONTINUE
            JSR     ERR_ARITH   ; CARRY: BINARY LITERAL TOO WIDE
PAB_CHK_ZE  CMP     #'0'        ; '0'?
            BEQ     PABILI_ZERO ; YES: SHIFT IN A 0 BIT (CARRY = 0)
            JMP     RET_VAL     ; NEITHER '0' NOR '1': DONE
PABILI_ZERO CLC                 ; CARRY = 0 FOR A ZERO BIT
            BCC     PABILI_SEEN ; SHIFT 0 BIT INTO SYMVAL

; ============================================================================
; MULT_BY_10
;
; MULTIPLIES THE 24-BIT VALUE IN SYMVAL[0..2] BY 10 IN PLACE.
;
; ALGORITHM  (SHIFT-AND-ADD, AVOIDS A GENERAL MULTIPLY):
;   1. COPY SYMVAL -> TMPVAL                  (SAVE ORIGINAL VALUE X)
;   2. SHIFT SYMVAL LEFT 2 BITS VIA SHF_LFT_2    (SYMVAL = X X 4)
;   3. ADD TMPVAL BACK TO SYMVAL             (SYMVAL = XX4 + X = X X 5)
;   4. IF THE 24-BIT ADDITION OVERFLOWED: CALL ERR_ARITH (ARITHMETIC ERROR,
;      DOES NOT RETURN)
;   5. SHIFT SYMVAL LEFT 1 BIT VIA SHF_LFT_1     (SYMVAL = XX5 X 2 = X X 10)
;
; ENTRY:  SYMVAL[0..2] = 24-BIT MULTIPLICAND
; EXIT:   SYMVAL[0..2] = SYMVAL X 10
; USES:   TMPVAL[0..2] (SCRATCH)
; ERRORS: ERR_ARITH (ARITHMETIC OVERFLOW) - DOES NOT RETURN
;
; CALLED FROM: PRS_DEC_LT ONCE PER DECIMAL DIGIT.
; ============================================================================
MULT_BY_10  LDA     SYMVAL      ; SAVE A COPY OF SYMVAL (= ORIGINAL X)
            STA     TMPVAL
            LDA     SYMVAL+1
            STA     TMPVAL+1
            LDA     SYMVAL+2
            STA     TMPVAL+2
            JSR     SHF_LFT_2   ; SYMVAL = SYMVAL X 4 (TWO LEFT SHIFTS)
            CLC
            LDA     SYMVAL      ; SYMVAL = SYMVALX4 + ORIGINAL (= ORIGINAL X 5)
            ADC     TMPVAL
            STA     SYMVAL
            LDA     SYMVAL+1
            ADC     TMPVAL+1
            STA     SYMVAL+1
            LDA     SYMVAL+2
            ADC     TMPVAL+2
            STA     SYMVAL+2
            BCC     SHF_LFT_1   ; NO CARRY -> SAFELY SHIFT X2 -> X10 AND RETURN
            JSR     ERR_ARITH   ; CARRY: 24-BIT OVERFLOW -> ARITHMETIC ERROR

; ============================================================================
; SHF_LFT_3
;
; SHIFTS SYMVAL[0..2] LEFT BY 3 BITS (MULTIPLIES BY 8) WITH OVERFLOW CHECK.
; USED BY PRS_OCT_LT TO SHIFT THE ACCUMULATOR BY ONE OCTAL DIGIT
; POSITION BEFORE ADDING THE NEW DIGIT.
;
; IMPLEMENTATION: CALLS SHF_LFT_1 ONCE, THEN JUMPS INTO SHF_LFT_2
; WHICH PERFORMS TWO MORE SHIFTS, FOR A TOTAL OF 3.
; ============================================================================
SHF_LFT_3   JSR     SHF_LFT_1   ; SHIFT X2 (1 LEFT SHIFT, OVERFLOW CHECKED)
            JMP     SHF_LFT_2   ; SHIFT X4 MORE (2 LEFT SHIFTS) -> TOTAL X8

; ============================================================================
; SHF_LFT_4
;
; SHIFTS SYMVAL[0..2] LEFT BY 4 BITS (MULTIPLIES BY 16) WITH OVERFLOW CHECK.
; USED BY PRS_HEX_LT TO SHIFT THE ACCUMULATOR BY ONE HEX DIGIT
; POSITION BEFORE ADDING THE NEW NIBBLE.
;
; IMPLEMENTATION: CALLS SHF_LFT_2 FOR 2 SHIFTS, THEN FALLS
; THROUGH INTO SHF_LFT_2 AGAIN FOR 2 MORE SHIFTS, TOTALLING 4 SHIFTS.
; ============================================================================
SHF_LFT_4   JSR     SHF_LFT_2   ; SHIFT X4 (2 LEFT SHIFTS), RETURNS HERE
            ; FALLS THROUGH INTO SHF_LFT_2 FOR 2 MORE SHIFTS -> TOTAL X16

; ============================================================================
; SHF_LFT_2
;
; SHIFTS SYMVAL[0..2] LEFT BY 2 BITS (MULTIPLIES BY 4) WITH OVERFLOW CHECK.
; USED DIRECTLY BY MULT_BY_10 (FIRST STEP OF THE X10 ALGORITHM).
;
; IMPLEMENTATION: CALLS SHF_LFT_1 FOR 1 SHIFT, THEN FALLS THROUGH INTO
; SHF_LFT_1 FOR 1 MORE SHIFT, TOTALLING 2 SHIFTS.
; ============================================================================
SHF_LFT_2   JSR     SHF_LFT_1   ; SHIFT X2 (1 LEFT SHIFT), RETURNS HERE
            ; FALLS THROUGH INTO SHF_LFT_1 FOR 1 MORE SHIFT -> TOTAL X4

; ============================================================================
; SHF_LFT_1
;
; SHIFTS SYMVAL[0..2] LEFT BY 1 BIT (MULTIPLIES BY 2) WITH OVERFLOW CHECK.
; THIS IS THE ATOMIC LEFT-SHIFT PRIMITIVE CALLED BY ALL THE HELPERS ABOVE
; AND BY THE X10 FINAL STEP.
;
; ENTRY:  SYMVAL[0..2] = 24-BIT VALUE TO SHIFT
; EXIT:   SYMVAL[0..2] = SYMVAL X 2
; ERRORS: ERR_ARITH IF CARRY IS SET AFTER THE SHIFT (OVERFLOW)
; ============================================================================
SHF_LFT_1   ASL     SYMVAL      ; SHIFT SYMVAL LEFT 1 BIT (LO BYTE)
            ROL     SYMVAL+1    ; ROTATE CARRY INTO MID BYTE
            ROL     SYMVAL+2    ; ROTATE CARRY INTO HI BYTE
            BCC     SHL_RETRN   ; NO OVERFLOW: DONE
            JSR     ERR_ARITH   ; CY SET: 24-BIT OVERFLOW -> ARITHMETIC ERROR
SHL_RETRN   RTS

; COPYRIGHT NOTICE STRING
;
COPYRIGHT   .BYTE   $0D, '*COPYRIGHT 1981, M.T.U.'
            .BYTE   $0D, 'BY B. CARBREY'
            .BYTE   $0D

; ============================================================================
; STB_HSH_LK
;
; OPEN-ADDRESS HASH TABLE LOOKUP AND INSERT FOR THE SYMBOL TABLE.
; SEARCHES FOR THE NULL-TERMINATED NAME IN IDENT_BUF AMONG THE 2-BYTE BUCKET
; ENTRIES IN THE HASH TABLE (HASHTST..HASHTEND).  EACH BUCKET HOLDS A
; 2-BYTE POINTER INTO THE PRIMARY HEAP (SYMVALP) WHERE THE CORRESPONDING
; SYMBOL RECORD IS STORED.  THE NAME IS STORED VERBATIM IN THE HEAP STARTING
; AT THE POINTED-TO ADDRESS, WITH THE LAST CHARACTER'S BIT 7 SET AS THE
; END-OF-NAME MARKER.
;
; HASH COMPUTATION:
;   - INITIALISE WITH THE FIRST CHARACTER OF THE NAME (SHIFTED LEFT 3 BITS
;     INTO HASHTBLP LO, AND THE RAW CHARACTER INTO HASHTBLP HI).
;   - FOLD REMAINING CHARACTERS IN PAIRS:
;       ODD  CHARS -> ADD TO HASHTBLP LO
;       EVEN CHARS -> XOR INTO HASHTBLP HI, THEN SHIFT-XOR INTO HASHTBLP LO
;   - FINAL STEP: ADD THE LAST CHARACTER TO HASHTBLP HI, MASK WITH HASHSIZEC,
;     AND MULTIPLY BY 2 (SINCE EACH BUCKET IS 2 BYTES) TO GET THE BUCKET OFFSET
;
; COLLISION RESOLUTION: LINEAR PROBING BACKWARD (SUBTRACT 2 PER STEP),
; WRAPPING FROM HASHTST TO HASH_LAST AT MOST ONCE.  A FULL
; WRAP-AROUND WITHOUT A FREE SLOT IS A FATAL ERROR (FAT_HSH_FL).
;
; RETURN CODES (IN PROCESSOR FLAGS, ON RETURN):
;   C CLEAR                 NEW ENTRY WAS CREATED; SYMTBLP -> NEW HEAP RECORD.
;   C SET, N CLEAR, V CLEAR SYMBOL FOUND; SYMTBLP -> EXISTING HEAP RECORD.
;   C SET, N SET            ENTRY TYPE MISMATCH (E.G., MACRO USED AS VALUE).
;   C SET, V SET            ENTRY IS A MACRO DEFINITION.
;
; SIDE EFFECTS ON MATCH:
;   ENT_TY_FL <- TYPE BYTE (FROM THE MSB-TERMINATED LAST-NAME CHARACTER,
;                       SHIFTED LEFT TWICE TO EXPOSE N AND V BITS).
;   SYM_NM_OFF <- Y OFFSET TO THE END-OF-NAME BYTE WITHIN THE ENTRY.
;   SYMTBLP <- POINTER TO THE MATCHED HEAP ENTRY.
;
; SIDE EFFECTS ON NEW ENTRY:
;   SYM_COUNT INCREMENTED.
;   IF SYMTBL_INIT IS CLEAR: NAME BYTES WRITTEN TO PRIMARY HEAP VIA
;     WR_PRI_HP; SYM_NM_OFF SET TO NAME LENGTH.
;   BUCKET AT (HASHTBLP) FILLED WITH SYMVALP (HEAP WRITE POINTER).
; ============================================================================
STB_HSH_LK  CLD
            LDA     #$00
            STA     HASH_PB_WR  ; CLEAR COLLISION-WRAP SENTINEL

            ; INITIALISE HASH STATE FROM FIRST CHARACTER OF NAME
            LDA     IDENT_BUF   ; FIRST CHARACTER OF NAME IN IDENT_BUF
            STA     HASHTBLP+1  ; HASH HI COMPONENT = FIRST CHAR
            ASL     A           ; SHIFT LEFT 3 TIMES -> FIRST_CHAR X 8
            ASL     A
            ASL     A
            STA     HASHTBLP    ; HASH LO COMPONENT = FIRST_CHAR X 8

            LDY     #$01        ; START SCANNING FROM SECOND CHARACTER
            LDY     #$01        ; (DUPLICATE LDY - REDUNDANT, NO EFFECT)

            ; FOLD REMAINING CHARACTERS INTO HASH IN PAIRS
SYHALK_FOLD LDA     IDENT_BUF,Y ; READ NEXT CHARACTER
            BEQ     SYHALK_LAST ; NUL: END OF NAME
            ADC     HASHTBLP    ; ODD CHAR: ADD TO HASH LO
            STA     HASHTBLP
            INY
            LDA     IDENT_BUF,Y ; READ NEXT CHARACTER
            BEQ     SYHALK_LAST ; NUL: END OF NAME
            EOR     HASHTBLP+1  ; EVEN CHAR: XOR INTO HASH HI
            STA     HASHTBLP+1
            ASL     A           ; SHIFT THE EVEN CHAR
            EOR     HASHTBLP    ; XOR SHIFTED CHAR INTO HASH LO
            STA     HASHTBLP
            JMP     SYHALK_FOLD ; CONTINUE WITH NEXT PAIR

            ; FINALISE HASH: FOLD LAST CHARACTER INTO HI, MASK, AND SCALE
SYHALK_LAST DEY                 ; BACK TO THE LAST PROCESSED CHARACTER
            LDA     IDENT_BUF,Y
            ADC     HASHTBLP+1  ; ADD LAST CHAR TO HASH HI
            AND     HASHSIZEC   ; MASK TO TABLE SIZE (E.G. $0F FOR 4 K BUCKETS)

            ; COMPUTE BUCKET ADDRESS: HASHTBLP = HASHTST + HASH_INDEX X 2
            STA     HASHTBLP+1  ; HASHTBLP+1 = MASKED HASH (BUCKET INDEX)
            LDA     HASHTBLP    ; HASHTBLP LO: HASH ACCUMULATOR (USED AS TEMP)
            ASL     A           ; X 2 (EACH BUCKET IS 2 BYTES)
            CLC
            ADC     HASHTST     ; ADD HASH TABLE BASE ADDRESS (LO)
            STA     HASHTBLP
            LDA     HASHTBLP+1
            ADC     HASHTST+1   ; ADD HASH TABLE BASE ADDRESS (HI)
            STA     HASHTBLP+1  ; HASHTBLP -> COMPUTED BUCKET IN HASH TABLE

            ; PROBE THE BUCKET: CHECK IF EMPTY OR OCCUPIED
HAL_PROBE   LDY     #$00
            LDA     (HASHTBLP),Y ; READ BUCKET LO BYTE
            STA     SYMTBLP     ; SYMTBLP LO <- LO BYTE OF STORED POINTER
            BNE     HAL_OCCUP   ; NON-ZERO LO -> SLOT OCCUPIED; COMPARE NAME
            INY
            LDA     (HASHTBLP),Y ; READ BUCKET HI BYTE
            STA     SYMTBLP+1
            BNE     HAL_COMPR   ; NON-ZERO HI ONLY -> OCCUPIED; COMPARE NAME

            ; BUCKET IS EMPTY (00 00): CREATE A NEW ENTRY
            INC     SYM_COUNT   ; SYM_COUNT++
            BNE     HALKPR_SKIP
            INC     SYM_COUNT+1

HALKPR_SKIP LDA     SYMVALP+1   ; WRITE SYMVALP HI BYTE INTO BUCKET HI SLOT
            STA     (HASHTBLP),Y ;   (Y=1 HERE)
            STA     SYMTBLP+1   ; SYMTBLP HI <- SYMVALP HI
            DEY                 ; Y = 0
            LDA     SYMVALP     ; WRITE SYMVALP LO BYTE INTO BUCKET LO SLOT
            STA     (HASHTBLP),Y
            STA     SYMTBLP     ; SYMTBLP LO <- SYMVALP LO

            BIT     SYMTBL_INIT ; SYMTBL_INIT ACTIVE? (INHIBIT NAME WRITE)
            BMI     HALKPR_DONE ; YES: SKIP NAME COPY (PREDEFINED MACRO
                                ; REGISTRATION)

            ; COPY NAME FROM IDENT_BUF TO PRIMARY HEAP
HALKPR_COPY LDA     IDENT_BUF,Y ; READ NAME CHARACTER (Y STARTS AT 0)
            BEQ     HAL_EONAM   ; NUL: END OF NAME
            JSR     WR_PRI_HP   ; WRITE CHARACTER TO HEAP
            INY
            JMP     HALKPR_COPY

HAL_EONAM   CLC                 ; C CLEAR: NEW ENTRY CREATED
            STY     SYM_NM_OFF  ; SYM_NM_OFF = NAME LENGTH
HALKPR_DONE RTS

            ; BUCKET OCCUPIED (LO BYTE NON-ZERO): READ HI BYTE AND FALL THROUGH
HAL_OCCUP   INY
            LDA     (HASHTBLP),Y ; READ HI BYTE OF STORED POINTER
            STA     SYMTBLP+1

            ; COMPARE STORED NAME (SYMTBLP) AGAINST SEARCH KEY (IDENT_BUF)
HAL_COMPR   LDY     #$FF        ; Y = $FF; FIRST INY MAKES Y=0
HAL_CMP_LP  INY
            LDA     IDENT_BUF,Y ; SEARCH KEY CHARACTER AT POSITION Y
            BEQ     HAL_CHKEND  ; NUL IN SEARCH KEY: CHECK TABLE END
            CMP     (SYMTBLP),Y ; COMPARE WITH STORED NAME CHARACTER
            BEQ     HAL_CMP_LP  ; MATCH: CONTINUE COMPARING

            ; MISMATCH: PROBE THE PREVIOUS BUCKET (LINEAR PROBING BACKWARD)
HAL_MISMA   LDA     HASHTBLP    ; IS HASHTBLP AT THE LO LIMIT OF THE TABLE?
            CMP     HASHTST
            BEQ     HAL_CHKHI   ; AT THE LO BOUNDARY; CHECK HI BYTE
HAL_PRB_LP  SEC
            SBC     #$02        ; BACK UP ONE BUCKET (2 BYTES)
            STA     HASHTBLP
            BCS     HAL_PROBE   ; NO BORROW: PROBE PREVIOUS BUCKET
            DEC     HASHTBLP+1  ; BORROW: DECREMENT HI BYTE
            JMP     HAL_PROBE   ; PROBE PREVIOUS BUCKET

HAL_CHKHI   LDA     HASHTBLP+1  ; AT LO BOUNDARY: CHECK HI BYTE
            CMP     HASHTST+1
            BEQ     HAL_WRAP    ; BOTH LO AND HI AT BASE: WRAP AROUND TO TOP
            LDA     HASHTBLP    ; HI BYTE DIFFERS: CONTINUE STEPPING LO
            JMP     HAL_PRB_LP

            .IF     NOT-KIM1
            ; CRASH POINT FOR THE CONCEALED HARDWARE-LOCK TEST FAIL.
            ; JUMPED TO FROM P2_MAIN_LP
DO_HALT     PHP                 ; SAVE FLAGS (Z ALMOST CERTAINLY CLEAR)
            BNE     HALT        ; Z CLEAR -> ALWAYS TAKEN -> HALT THE CPU
            .ENDIF

            ; WRAP-AROUND: RESTART PROBING FROM THE END OF THE HASH TABLE
HAL_WRAP    BIT     HASH_PB_WR  ; HAVE WE ALREADY WRAPPED ONCE?
            BPL     HAL_WRAPP   ; NO: PROCEED TO TABLE-FULL CHECK
            JSR     FAT_HSH_FL  ; WRAPPED TWICE: HASH TABLE FULL -> FATAL ERROR
            ; DOES NOT RETURN
HAL_WRAPP   DEC     HASH_PB_WR  ; MARK AS WRAPPED ($00 -> $FF)
            LDA     HASH_LAST   ; ADDRESS OF THE LAST BUCKET
            STA     HASHTBLP
            LDA     HASH_LAST+1
            STA     HASHTBLP+1
            JMP     HAL_PROBE   ; CONTINUE PROBING FROM END OF TABLE

            ; SEARCH KEY NUL REACHED: CHECK THAT THE STORED NAME ALSO ENDS HERE
HAL_CHKEND  LDA     (SYMTBLP),Y ; READ STORED NAME BYTE AT SAME POSITION
            BPL     HAL_MISMA   ; BIT 7 CLEAR: STORED NAME HAS NOT ENDED
                                ;   -> MISMATCH
            ; BIT 7 SET: END-OF-NAME MARKER IN STORED NAME -> NAMES MATCH
            ASL     A           ; SHIFT OUT BIT 7: BITS 6 AND 5 MOVE TO N AND V
            STA     ENT_TY_FL   ; STORE EXTRACTED TYPE FLAGS (FOR CALLER
                                ;   INSPECTION)
            STY     SYM_NM_OFF  ; SYM_NM_OFF = Y (OFFSET TO END-OF-NAME BYTE)
            BIT     ENT_TY_FL   ; SET N AND V FLAGS FROM TYPE BYTE FOR CALLER
            RTS                 ; RETURN C SET (ENTRY FOUND)

            .IF     NOT-KIM1
HALT        HLT                 ; UNOFF JAM/HLT - FREEZES CPU; RESET REQUIRED
            .ENDIF

; ============================================================================
; SORT_SYMTBL
;
; SORTS THE OCCUPIED (NON-NULL) HASH-TABLE BUCKET ENTRIES INTO ASCENDING
; ALPHABETICAL ORDER BY SYMBOL NAME.  THE SORT OPERATES ENTIRELY ON THE
; 2-BYTE BUCKET POINTER PAIRS IN THE HASH TABLE (HASHTST..HASHTEND); THE
; HEAP RECORDS THEMSELVES ARE NOT MOVED.
;
; PHASE 1 - COMPACTION:
;   WALKS THROUGH THE HASH TABLE FROM HASHTST.  WHENEVER AN EMPTY (00 00)
;   BUCKET IS FOUND AT HASHTBLP, A FORWARD SCAN WITH SCRATCHP FINDS THE NEXT
;   NON-EMPTY BUCKET AND THE TWO ENTRIES ARE SWAPPED.  THIS MOVES ALL FILLED
;   BUCKETS TO THE LOW END OF THE TABLE AND ALL EMPTY BUCKETS TO THE HIGH END.
;   AT THE END OF COMPACTION, SORTED_END/SORTED_END+1 IS SET TO THE ADDRESS OF
;   THE FIRST EMPTY BUCKET (= ONE PAST THE LAST FILLED ENTRY).
;
; PHASE 2 - SHELL SORT:
;   PERFORMS A SHELL SORT ON THE COMPACTED RANGE HASHTST..SORTED_END USING THE
;   GAP SEQUENCE {FILLED_COUNT/2, GAP/2, ...} WITH THE GAP HALVED AND
;   ROUNDED DOWN TO AN EVEN (2-BYTE ALIGNED) VALUE EACH PASS.  WHEN THE
;   GAP REACHES ZERO THE SORT IS COMPLETE AND THE ROUTINE RETURNS.
;   COMPARISON AND SWAPPING IS DELEGATED TO CMP_SY_EN.
;
; CALLED BY PR_SYMTBL BEFORE ITERATING OVER THE SORTED ENTRIES.
; ============================================================================
SORT_SYMTBL CLD
            LDA     HASHTST      ; START AT THE BEGINNING OF THE HASH TABLE
            STA     HASHTBLP
            LDA     HASHTST+1
            STA     HASHTBLP+1

            ; PHASE 1: COMPACT NON-NULL ENTRIES TOWARD THE START OF THE TABLE
SOS_COMPA   LDY     #$00
            LDA     (HASHTBLP),Y ; CHECK CURRENT BUCKET LO BYTE
            BNE     SOS_ADVAN    ; NON-EMPTY: ADVANCE HASHTBLP,NO ACTION NEEDED
            INY
            LDA     (HASHTBLP),Y ; CHECK CURRENT BUCKET HI BYTE
            BNE     SOS_ADVAN    ; NON-EMPTY: ADVANCE

            ; FOUND AN EMPTY BUCKET AT HASHTBLP; SCAN FORWARD WITH SCRATCHP FOR
            ; A FILLED ONE
            LDA     HASHTBLP
            STA     SCRATCHP
            LDA     HASHTBLP+1
            STA     SCRATCHP+1

SOSY_SCAN   LDA     SCRATCHP     ; ADVANCE SCRATCHP BY ONE BUCKET (2 BYTES)
            CLC
            ADC     #$02
            STA     SCRATCHP
            BCC     SOSY_ISEOT
            INC     SCRATCHP+1

SOSY_ISEOT  CMP     HASHTEND     ; HAS SCRATCHP REACHED THE END OF THE TABLE?
            BNE     SOSY_CONT
            LDA     SCRATCHP+1
            CMP     HASHTEND+1
            BEQ     SOS_PH_CP    ; YES: COMPACTION COMPLETE
            LDA     SCRATCHP

SOSY_CONT   LDY     #$00
            LDA     (SCRATCHP),Y ; CHECK SCRATCHP BUCKET LO BYTE
            BNE     SOSY_SWAP    ; NON-EMPTY: SWAP WITH THE EMPTY SLOT AT
                                 ; HASHTBLP
            INY
            LDA     (SCRATCHP),Y
            BEQ     SOSY_SCAN    ; SCRATCHP ALSO EMPTY: KEEP SCANNING FORWARD

            ; SWAP THE FILLED BUCKET AT SCRATCHP WITH THE EMPTY BUCKET AT
SOSY_SWAP   LDY     #$01
SOS_XCHAN   LDA     (HASHTBLP),Y ; XCHANGE 2 BYTES: HASHTBLP[Y] <-> SCRATCHP[Y]
            TAX
            LDA     (SCRATCHP),Y
            STA     (HASHTBLP),Y
            TXA
            STA     (SCRATCHP),Y
            DEY
            BPL     SOS_XCHAN    ; REPEAT FOR LO BYTE (Y: 1 -> 0)

            ; ADVANCE HASHTBLP PAST THIS NOW-FILLED SLOT
SOS_ADVAN   LDA     HASHTBLP
            CLC
            ADC     #$02         ; NEXT BUCKET
            STA     HASHTBLP
            BCC     SOSY_SKIP
            INC     HASHTBLP+1

SOSY_SKIP   CMP     HASHTEND     ; REACHED END OF TABLE?
            BNE     SOS_COMPA
            LDA     HASHTBLP+1
            CMP     HASHTEND+1
            BNE     SOS_COMPA    ; NO: KEEP SCANNING

            ; PHASE 1 COMPLETE: RECORD THE END OF THE FILLED REGION
SOS_PH_CP   LDA     HASHTBLP
            STA     SORTED_END   ; FIRST EMPTY BUCKET ADDRESS
            LDA     HASHTBLP+1
            STA     SORTED_END+1

            ; COMPUTE INITIAL SHELL SORT GAP=(FILLED_COUNT/2), ROUNDED TO EVEN
            LDA     SORTED_END
            SEC
            SBC     HASHTST      ; LENGTH OF FILLED REGION (LO) = END - START
            STA     SORT_GAP
            LDA     SORTED_END+1
            SBC     HASHTST+1
            STA     SORT_GAP+1

            ; PHASE 2: SHELL SORT - HALVE GAP EACH PASS UNTIL GAP == 0
SOSY_SORT   LSR     SORT_GAP+1   ; GAP >>= 1 (HI BYTE)
            LDA     SORT_GAP
            ROR     A            ; GAP >>= 1 (LO BYTE, WITH HI CARRY)
            AND     #$FE         ; ROUND DOWN TO EVEN (2-BYTE ALIGNMENT)
            STA     SORT_GAP
            BNE     SOSY_INIT    ; GAP NON-ZERO: CONTINUE SORTING
            ORA     SORT_GAP+1
            BNE     SOSY_INIT    ; GAP (HI) NON-ZERO: CONTINUE
            RTS                  ; GAP == 0: SORT COMPLETE

            ; INITIALISE ONE SHELL SORT PASS WITH THE CURRENT GAP
SOSY_INIT   LDA     HASHTST      ; COMPUTE SORT LIMIT = HASHTST + GAP
            CLC
            ADC     SORT_GAP
            STA     SORT_LIMIT
            LDA     HASHTST+1
            ADC     SORT_GAP+1
            STA     SORT_LIMIT+1
            LDA     HASHTST      ; OUTER LOOP POINTER STARTS AT HASHTST
            STA     HASHTBLP
            LDA     HASHTST+1
            STA     HASHTBLP+1

            ; OUTER LOOP: ITERATE HASHTBLP FROM HASHTST TO SORT_LIMIT - 1
SOSY_OUTER  LDA     HASHTBLP
            STA     SCRATCHP     ; SCRATCHP = CURRENT OUTER-LOOP ELEMENT
            LDA     HASHTBLP+1
            STA     SCRATCHP+1

            ; INNER (INSERTION-SORT) LOOP: COMPARE ELEMENT AT SCRATCHP WITH
            ; THE ELEMENT GAP POSITIONS AHEAD OF IT (AT SYMNAMP)
SOSY_INNER  LDA     SCRATCHP
            CLC
            ADC     SORT_GAP     ; SYMNAMP = SCRATCHP + GAP
            STA     SYMNAMP
            LDA     SCRATCHP+1
            ADC     SORT_GAP+1
            STA     SYMNAMP+1

            LDA     SYMNAMP      ; CHECK SYMNAMP < SORTED_END (STILL WITHIN
                                 ; RANGE)?
            CMP     SORTED_END
            LDA     SYMNAMP+1
            SBC     SORTED_END+1 ; SYMNAMP+1 - SORTED_END+1 (WITH BORROW)
            BCS     SOS_AD_OU    ; SYMNAMP >= SORTED_END: INNER LOOP DONE

            LDA     SCRATCHP     ; SYMNAMP2 = SCRATCHP (THE ELEMENT TO INSERT)
            STA     SYMNAMP2
            LDA     SCRATCHP+1
            STA     SYMNAMP2+1

            ; COMPARE ELEMENTS AT SYMNAMP2 AND SYMNAMP; SWAP IF OUT OF ORDER
SOSY_COMP   JSR     CMP_SY_EN    ; COMPARE AND SWAP IF NEEDED
            BCC     SOS_IN_DN    ; C CLEAR: ALREADY IN ORDR; ADVANCE OUTER LOOP

            ; SWAP HAPPENED: STEP SYMNAMP2 BACK BY ONE GAP AND COMPARE AGAIN
            LDA     SYMNAMP2
            SEC
            SBC     SORT_GAP     ; SYMNAMP2 -= GAP
            STA     SYMNAMP2
            LDA     SYMNAMP2+1
            SBC     SORT_GAP+1
            STA     SYMNAMP2+1
            LDA     SYMNAMP2
            CMP     HASHTST      ; SYMNAMP2 < HASHTST (BEFORE START)?
            LDA     SYMNAMP2+1
            SBC     HASHTST+1
            BCS     SOS_BAK_SC   ; STILL WITHIN RANGE: CONTINUE BACKWARD SCAN

            ; INNER LOOP DONE: ADVANCE SCRATCHP BY GAP FOR NEXT OUTER STEP
SOS_IN_DN   LDA     SCRATCHP
            CLC
            ADC     SORT_GAP     ; SCRATCHP += GAP
            STA     SCRATCHP
            LDA     SCRATCHP+1
            ADC     SORT_GAP+1
            STA     SCRATCHP+1
            JMP     SOSY_INNER   ; CONTINUE INNER LOOP

            ; SYMNAMP >= SORTED_END: ADVANCE OUTER HASHTBLP BY 2 AND
            ; CHECK LIMIT
SOS_AD_OU   LDA     HASHTBLP
            CLC
            ADC     #$02
            STA     HASHTBLP
            BCC     SOSY_SKIP2
            INC     HASHTBLP+1

SOSY_SKIP2  LDA     HASHTBLP
            CMP     SORT_LIMIT   ; HASHTBLP < SORT_LIMIT?
            LDA     HASHTBLP+1
            SBC     SORT_LIMIT+1
            BCC     SOSY_OUTER   ; YES: KEEP ITERATING OUTER LOOP
            JMP     SOSY_SORT    ; PASS DONE: HALVE GAP AND START NEXT PASS

            ; BACKWARD SCAN: UPDATE SYMNAMP = SYMNAMP2 + GAP AND RETRY COMPARE
SOS_BAK_SC  LDA     SYMNAMP2
            CLC
            ADC     SORT_GAP     ; SYMNAMP = SYMNAMP2 + GAP
            STA     SYMNAMP
            LDA     SYMNAMP2+1
            ADC     SORT_GAP+1
            STA     SYMNAMP+1
            JMP     SOSY_COMP    ; COMPARE THE NEW PAIR

; ============================================================================
; CMP_SY_EN
;
; READS THE 2-BYTE SYMBOL-ENTRY POINTERS STORED AT (SYMNAMP2) AND (SYMNAMP)
; (EACH BUCKET PAIR HOLDS A POINTER INTO THE PRIMARY HEAP), THEN COMPARES THE
; NULL-MSB-TERMINATED NAME STRINGS OF THE TWO ENTRIES LEXICOGRAPHICALLY.
;
; IF THE ENTRY AT SYMNAMP2 SORTS AFTER THE ENTRY AT SYMNAMP (I.E. SYMNAMP2
; COMES ALPHABETICALLY LATER AND SHOULD BE MOVED RIGHTWARD), THE TWO 2-BYTE
; POINTERS IN THE HASH TABLE ARE SWAPPED IN PLACE AND THE ROUTINE RETURNS WITH
; C SET.
;
; IF THE ENTRY AT SYMNAMP2 SORTS BEFORE OR EQUAL TO SYMNAMP (ALREADY IN
; ORDER), NO SWAP IS PERFORMED AND THE ROUTINE RETURNS WITH C CLEAR.
;
; THE END-OF-NAME MARKER IS BIT 7 OF THE LAST CHARACTER BYTE (AS STORED IN
; THE HEAP BY STB_HSH_LK).
;
; ENTRY:  SYMNAMP2 -> ONE HASH-TABLE BUCKET (2-BYTE ENTRY POINTER)
;         SYMNAMP  -> ANOTHER HASH-TABLE BUCKET (GAP POSITIONS AHEAD)
; EXIT:   C SET   -> ENTRIES WERE OUT OF ORDER AND HAVE BEEN SWAPPED
;         C CLEAR -> ENTRIES WERE ALREADY IN ORDER; NO CHANGE
; ============================================================================
CMP_SY_EN   LDY     #$01
            LDA     (SYMNAMP2),Y    ; READ SYMNAMP2'S HEAP POINTER (HI BYTE)
            STA     SEGHEADP+1
            LDA     (SYMNAMP),Y     ; READ SYMNAMP'S HEAP POINTER (HI BYTE)
            STA     MATCHP+1
            DEY                     ; Y = 0
            LDA     (SYMNAMP2),Y    ; SYMNAMP2'S HEAP POINTER (LO BYTE)
            STA     SEGHEADP
            LDA     (SYMNAMP),Y     ; SYMNAMP'S HEAP POINTER (LO BYTE)
            STA     MATCHP
            ; SEGHEADP -> SYMNAMP2'S SYMBOL RECORD; MATCHP -> SYMNAMP'S
            ; SYMBOL RECORD

            LDA     (SEGHEADP),Y    ; FIRST CHARACTER OF SYMNAMP2'S NAME (Y=0)
            CMP     (MATCHP),Y      ; COMPARE WITH FIRST CHAR OF SYMNAMP'S NAME
            BCS     COSYEN_CONT     ; SYMNAMP2[0]>=SYMNAMP[0]: CHECK FURTHER
            RTS                     ; SYMNAMP2[0]<SYMNAMP[0]: ALREADY IN ORDER

COSYEN_CONT BNE     COSYEN_SWAP     ; SYMNAMP2[0]>SYMNAMP[0]: OUT OF ORDER
                                    ;  -> SWAP

            ; FIRST CHARS EQUAL: COMPARE REMAINING CHARACTERS ONE BY ONE
COSYEN_NEXT INY
            LDA     (MATCHP),Y      ; READ SYMNAMP'S NAME BYTE AT Y
            BMI     COSYEN_SWAP     ; BIT 7 SET: SYMNAMP NAME ENDS FIRST ->
                                    ; SYMNAMP IS SHORTER/EARLIER -> SYMNAMP2
                                    ; COMES AFTER -> SWAP
            LDA     (SEGHEADP),Y    ; READ SYMNAMP2'S NAME BYTE AT Y
            BMI     COSYEN_DONE     ; BIT 7 SET: SYMNAMP2 NAME ENDS FIRST ->
                                    ; SYMNAMP2 IS SHORTER/EARLIER -> ALREADY
                                    ; IN ORDER (C CLEAR)
            CMP     (MATCHP),Y      ; SYMNAMP2[Y] VS SYMNAMP[Y]
            BEQ     COSYEN_NEXT     ; EQUAL: CONTINUE TO NEXT CHARACTER
            BCS     COSYEN_SWAP     ; SYMNAMP2[Y] > SYMNAMP[Y]: OUT OF ORDER
                                    ;   -> SWAP
            RTS                     ; SYMNAMP2[Y] < SYMNAMP[Y]: IN ORDER

            ; OUT OF ORDER: SWAP THE TWO 2-BYTE POINTERS IN THE BUCKET TABLE
COSYEN_SWAP LDY     #$01
COSYEN_LOOP LDA     (SYMNAMP2),Y    ; EXCHANGE SYMNAMP2[Y] <-> SYMNAMP[Y]
            TAX
            LDA     (SYMNAMP),Y
            STA     (SYMNAMP2),Y
            TXA
            STA     (SYMNAMP),Y
            DEY
            BPL     COSYEN_LOOP     ; REPEAT FOR LO BYTE (Y: 1 -> 0)
            RTS                     ; RETURN WITH C SET (SWAP PERFORMED)

COSYEN_DONE CLC                     ; SYMNAMP2 ENDS FIRST: ALREADY IN ORDER
            RTS

; ============================================================================
; PR_SYMTBL
;
; PRINTS THE SYMBOL TABLE (AND OPTIONALLY CROSS-REFERENCES) TO THE LISTING
; OUTPUT CHANNEL AFTER THE END OF PASS 2.
;
; STEPS:
;   1. CHECK XREF_ENAB; IF CLEAR, RETURN IMMEDIATELY (NO SYMBOL TABLE).
;   2. CALL PR_PAS_FIL TO FLUSH THE ERROR SUMMARY FIRST.
;   3. BUILD THE PAGE HEADER TITLE STRING AT LISTING_BUF:
;        IF XREF_MODE IS SET: 'SYMBOL TABLE WITH CROSS REFERENCES'
;        OTHERWISE:           'SYMBOL TABLE             '
;   4. RESET VAL_OUT AND FORCE A PAGE BREAK VIA OUT_LN_PGB.
;   5. SORT THE HASH TABLE VIA SORT_SYMTBL.
;   6. INITIALISE COLUMN COUNTERS: XREF_COL2 (SYMBOL-VALUE COLUMN) = 9,
;        XREF_COL1 (NEXT TAB STOP) = 1.
;   7. ITERATE OVER THE SORTED (COMPACTED) HASH-TABLE ENTRIES
;        (HASHTBLP FROM HASHTST TO SORTED_END):
;      A. LOAD THE ENTRY POINTER INTO SYMTBLP AND WALK TO THE END-OF-NAME BYTE.
;      B. SKIP ENTRIES WHOSE TYPE BITS INDICATE THEY ARE BUILT-IN OPCODE
;         ENTRIES OR SIMILAR INTERNAL MARKERS (TYPE & $30 != 0 AFTER SHIFT).
;      C. CALL FMT_SYM_NM TO WRITE NAME + TYPE INDICATOR.
;      D. IF XREF_MODE: CALL FMT_MAC_XR TO OUTPUT XREF CHAIN.
;         OTHERWISE: TAB-FILL AND WRITE VALUE USING OUT_VA_DI2.
;      E. FLUSH LISTING LINE VIA FLUSH_LINE WHEN COLUMN EXCEEDS XRNAMCOLMAX.
;   8. FLUSH ANY REMAINING PARTIAL LINE.
; ============================================================================
PR_SYMTBL   CLD
            BIT     XREF_ENAB   ; SYMBOL TABLE OUTPUT ENABLED?
            BMI     PRSY_CONT
            RTS                 ; NO: SKIP ENTIRELY

PRSY_CONT   JSR     PR_PAS_FIL  ; PRINT PASS SUMMARY (FLUSHES ERROR COUNTS)

            ; BUILD TITLE STRING IN LISTING HEADER AT LISTING_BUF
            LDX     #$2D        ; CLEAR 46 BYTES OF TITLE AREA WITH SPACES
            LDA     #' '
PRSY_CLEAR  STA     LISTING_BUF,X
            DEX
            BPL     PRSY_CLEAR

            ; COPY THE APPROPRIATE HEADER STRING INTO THE TITLE AREA
            LDX     #$0C        ; DEFAULT: 'SYMBOL TABLE' HEADER (13 CHARS,
                                ; NO XREF)
            BIT     XREF_MODE   ; CROSS-REFERENCE MODE ACTIVE?
            BPL     PRSY_COPY
            LDX     #$21        ; YES: FULL HEADER 'SYMBOL TABLE WITH CROSS
                                ; REFERENCES'
PRSY_COPY   LDA     TBL_HDR,X   ; COPY FROM HEADER STRING TABLE AT TBL_HDR
            STA     LISTING_BUF,X
            DEX
            BPL     PRSY_COPY

            LDA     #$00
            STA     VAL_OUT     ; CLEAR VAL_OUT BEFORE OUTPUTTING HEADER
            JSR     OUT_LN_PGB  ; FORCE A NEW PAGE AND EMIT THE HEADER

            JSR     SORT_SYMTBL ; SORT THE SYMBOL TABLE (COMPACT +
                                ; SHELL SORT)

            ; INITIALISE HASH-TABLE SCAN POINTER AT HASHTST (START OF
            ; SORTED ENTRIES)
            LDA     HASHTST
            STA     HASHTBLP
            LDA     HASHTST+1
            STA     HASHTBLP+1

            ; INITIALISE COLUMN LAYOUT: VALUE COLUMN AT 9, FIRST TAB STOP AT 1
            LDX     #$09
            STX     XREF_COL2   ; SYMBOL VALUE COLUMN
            LDX     #$01
            STX     XREF_COL1   ; NEXT TAB STOP

            ; MAIN ITERATION LOOP: PROCESS EACH SORTED HASH-TABLE BUCKET
PRSY_LOOP   LDY     #$00
            LDA     (HASHTBLP),Y ; LOAD HEAP POINTER FROM BUCKET (LO BYTE)
            STA     SYMTBLP
            INY
            LDA     (HASHTBLP),Y ; HEAP POINTER (HI BYTE)
            STA     SYMTBLP+1

            ; SCAN TO THE END-OF-NAME BYTE (BIT 7 SET) IN THE HEAP ENTRY
            LDY     #$FF
PRSY_SCAN   INY
            LDA     (SYMTBLP),Y
            BPL     PRSY_SCAN   ; BIT 7 CLEAR: NOT YET AT END OF NAME

            ; INSPECT TYPE BITS (BITS 6 AND 5 OF END-OF-NAME BYTE) TO FILTER
            ; ENTRIES
            ASL     A           ; BIT 7 -> CARRY (ALWAYS SET HERE); BIT 6 -> N
            BPL     PRS_PROC    ; BIT 6 CLEAR: NOT A MACRO-ONLY ENTRY; PROCESS
            AND     #$30        ; CHK BITS 5 AND 4 (NOW SHIFTED: ORIG BITS 4,3)
            BEQ     PRS_PROC    ; BOTH ZERO: PROCESS THIS ENTRY
            JMP     PRS_ADVAN   ; INTERNAL/BUILT-IN ENTRY: SKIP, ADVANCE TO
                                ; NEXT BUCKET

            ; PROCESS THIS SYMBOL ENTRY
PRS_PROC    STY     SYM_NM_OFF  ; SYM_NM_OFF = Y (OFFSET TO END-OF-NAME BYTE)
            JSR     FMT_SYM_NM  ; WRITE NAME + TYPE INTO LISTING BUFFER

            BIT     XREF_MODE   ; CROSS-REFERENCE MODE?
            BPL     PRS_NOCRS   ; NO: WRITE VALUE WITH TAB-FILL

            ; WITH CROSS-REFERENCES: OUTPUT XREF LIST
            JSR     FMT_MAC_XR  ; WRITE DEFINITION LINE + XREF CHAIN
            LDX     #$01        ; RESET LISTING COLUMN TO 1 FOR NEXT ENTRY
            JMP     PRS_ADVAN

            ; WITHOUT CROSS-REFERENCES: TAB-FILL TO NEXT STOP AND WRITE VALUE
            ; DIGITS
PRS_NOCRS   CPX     XRNAMCOLMAX ; HAS LISTING COLUMN REACHED THE NAME-COLUMN
                                ; MAXIMUM?
            BCS     PRSY_FLUSH  ; YES: FLUSH LINE AND START NEW ONE
            LDA     XREF_COL1   ; ADVANCE BOTH COLUMN COUNTERS BY LISTTABSPC
            CLC
            ADC     LISTTABSPC
            STA     XREF_COL1   ; XREF_COL1 += LISTTABSPC
            LDA     XREF_COL2
            CLC
            ADC     LISTTABSPC
            STA     XREF_COL2   ; XREF_COL2 += LISTTABSPC
            LDA     #' '        ; FILL LISTING BUFF WITH SPACES UP TO XREF_COL1
PRSY_FILL   STA     LIST_BUF,X
            INX
            CPX     XREF_COL1
            BCC     PRSY_FILL
            JMP     PRS_ADVAN   ; ADVANCE TO NEXT HASH-TABLE BUCKET

            ; LISTING LINE FULL: FLUSH IT AND RESET COLUMN
PRSY_FLUSH  TXA                 ; Y = CURRENT LISTING COLUMN
            TAY
            JSR     FLUSH_LINE  ; FLUSH LISTING LINE
            LDX     #$09        ; RESET XREF_COL2 TO 9
            STX     XREF_COL2
            LDX     #$01        ; RESET XREF_COL1 TO 1
            STX     XREF_COL1

            ; ADVANCE HASHTBLP TO THE NEXT BUCKET (2 BYTES PER BUCKET)
PRS_ADVAN   LDA     HASHTBLP
            CLC
            ADC     #$02
            STA     HASHTBLP
            BCC     PRSY_ISEND
            INC     HASHTBLP+1

            ; CHECK WHETHER HASHTBLP HAS REACHED SORTED_END
PRSY_ISEND  LDA     HASHTBLP
            CMP     SORTED_END
            BEQ     PRSY_CHKHI  ; LO BYTES EQUAL: CHECK HI BYTE
            JMP     PRSY_LOOP   ; NOT AT END: PROCESS NEXT BUCKET
PRSY_CHKHI  LDA     HASHTBLP+1
            CMP     SORTED_END+1 ; COMPARE HI BYTES
            BEQ     PRS_DOFLS
            JMP     PRSY_LOOP   ; NOT AT END YET

            ; ALL BUCKETS PROCESSED: FLUSH ANY REMAINING PARTIAL LISTING LINE
PRS_DOFLS   CPX     #$01        ; ANY NON-EMPTY CONTENT IN THE LISTING BUFFER?
            BEQ     PRSY_RETURN ; NO (ONLY THE LEADING SPACE): SKIP FLUSH
            TXA
            TAY
            JSR     FLUSH_LINE  ; FLUSH THE LAST LISTING LINE
PRSY_RETURN RTS

; ============================================================================
; FMT_SYM_NM
;
; FORMATS ONE SYMBOL TABLE ENTRY (NAME, TYPE, AND VALUE) INTO THE LISTING
; OUTPUT BUFFER STARTING AT LIST_BUF[X].  LEAVES X POINTING PAST THE LAST
; WRITTEN CHARACTER.
;
; THE ENTRY IN THE PRIMARY HEAP HAS THIS LAYOUT:
;   BYTES 0..N-1   : NAME CHARACTERS (ASCII, ALL BITS 7 CLEAR)
;   BYTE  N        : LAST NAME CHARACTER WITH BIT 7 SET AS END-OF-NAME MARKER;
;                    BITS 6 AND 5 ENCODE THE ENTRY TYPE:
;                     BIT 6 CLEAR, BIT 5 CLEAR -> LABELLED ADDRESS / .EQU VALUE
;                     BIT 6 SET                -> MACRO DEFINITION
;                     BIT 5 SET,BIT 6 CLEAR    -> EXTERNAL SYMBOL
;                                                 (SHOWN AS '****')
;   BYTES N+1..N+3 : 24-BIT VALUE (LO, MID, HI) FOR ADDRESS / .EQU ENTRIES
;
; OUTPUT FORMAT:
;   <NAME>  [PADDED TO XREF_COL2 WITH SPACES]  $ <VALUE_HEX>
;   OR, FOR MACROS:   <NAME>  [PADDED]  MACRO
;   OR, FOR EXTERNAL: <NAME>  [PADDED]  $ ****
;
; ENTRY:  SYMTBLP -> SYMBOL HEAP RECORD
;         X = CURRENT WRITE INDEX INTO LIST_BUF[]
;         SYM_NM_OFF = Y OFFSET TO END-OF-NAME BYTE, PRE-COMPUTED
;         XREF_COL2 = TARGET COLUMN FOR THE '$' TYPE INDICATOR
; EXIT:   X ADVANCED PAST THE WRITTEN TEXT; SYMVAL[0..2] SET (FOR
;         VALUE ENTRIES)
; ============================================================================
FMT_SYM_NM  LDY     #$00
FOS_READN   LDA     (SYMTBLP),Y     ; READ NAME BYTE FROM HEAP
            BMI     FOSYNA_PAD      ; BIT 7 SET: END OF NAME
            CMP     #'*'            ; MNEMONIC TABLE TERMINATOR '*'? (SKIP IT)
            BEQ     FOSYNA_SKIP     ; SKIP IF IT IS
            STA     LIST_BUF,X      ; COPY NAME CHARACTER TO LISTING BUFFER
            INX
FOSYNA_SKIP INY
            BNE     FOS_READN       ; CONTINUE UNTIL END-OF-NAME BYTE

            ; PAD THE NAME FIELD WITH SPACES UP TO THE TARGET COLUMN
            ; (XREF_COL2)
FOSYNA_PAD  LDA     #' '
            STA     LIST_BUF,X
            INX
            CPX     XREF_COL2       ; REACHED TARGET COLUMN?
            BCC     FOSYNA_PAD      ; NO: KEEP PADDING

            ; EMIT THE '$' TYPE INDICATOR
            LDA     #'$'
            STA     LIST_BUF,X
            INX

            ; DECODE ENTRY TYPE FROM THE END-OF-NAME BYTE (BIT 7 WAS SET)
            LDA     (SYMTBLP),Y     ; RE-READ THE END-OF-NAME BYTE
            ASL     A               ; DISCARD BIT 7 (ALWAYS 1); BIT 6 -> CARRY
            ASL     A               ; BIT 6 (NOW N): 1 = MACRO OR EXTERNAL
            BCS     FOS_MACRO       ; CY SET (ORIGINAL BIT 6 = 1): MACRO ENTRY
            BMI     FOSYNA_EMIT     ; N SET (ORIGINAL BIT 5 = 1): REGULAR VALUE
                                    ; ENTRY WAIT: AFTER TWO ASL, THE BIT THAT
                                    ; WAS ORIGINALLY BIT 5 IS NOW BIT 7
                                    ; (N FLAG); IF N SET -> VALUE (THIS COVERS
                                    ; .EQU / LABEL ENTRIES WITH TYPE $A0)

            ; EXT SYMBOL (NOT MACRO, NOT PLAIN VALUE): EMIT '****' PLACEHOLDER
            LDA     #'*'
            STA     LIST_BUF,X
            INX
            STA     LIST_BUF,X
            INX
            STA     LIST_BUF,X
            INX
            STA     LIST_BUF,X
            INX
            RTS

            ; REGULAR ADDRESS/.EQU ENTRY: READ 24-BIT VALUE AND EMIT HEX DIGITS
FOSYNA_EMIT INY
            LDA     (SYMTBLP),Y     ; VALUE LO BYTE
            STA     SYMVAL
            INY
            LDA     (SYMTBLP),Y     ; VALUE MID BYTE
            STA     SYMVAL+1
            INY
            LDA     (SYMTBLP),Y     ; VALUE HI BYTE
            STA     SYMVAL+2
            JMP     OUT_VA_DI2      ; OUT_VA_DIG: EMIT UP TO 6 HEX DIGITS

            ; MACRO ENTRY: REPLACE THE PRECEDING '$' WITH 'M' AND WRITE 'ACRO'
FOS_MACRO   DEX                     ; STEP BACK TO OVERWRITE THE '$' CHARACTER
            LDA     #'M'
            STA     LIST_BUF,X
            INX
            LDA     #'A'
            STA     LIST_BUF,X
            INX
            LDA     #'C'
            STA     LIST_BUF,X
            INX
            LDA     #'R'
            STA     LIST_BUF,X
            INX
            LDA     #'O'
            STA     LIST_BUF,X
            INX
            RTS

; ============================================================================
; FMT_MAC_XR
;
; FORMATS THE CROSS-REFERENCE LISTING ENTRY FOR ONE SYMBOL OR MACRO.
; CALLED BY PR_SYMTBL WHEN XREF_MODE IS ACTIVE, AFTER FMT_SYM_NM
; HAS WRITTEN THE NAME INTO THE LISTING BUFFER.
;
; LAYOUT EMITTED INTO THE LISTING BUFFER (STARTING AT LIST_BUF[X]):
;   <SPACES TO COLUMN 16>  <DEFINITION_LINE>  <XREF_LINE> ...
;
; THE DEFINITION LINE NUMBER IS READ FROM THE SYMBOL TABLE ENTRY:
;   AT OFFSET SYM_NM_OFF + 6 FROM SYMTBLP (LO BYTE, HI BYTE).
;
; CROSS-REFERENCE RECORDS FORM A BACKWARDS-LINKED LIST IN THE PRIMARY HEAP
; (OR SECONDARY HEAP IF EXP_BANK IS SET).  EACH 4-BYTE XREF RECORD:
;   BYTES 0-1: POINTER TO THE PREVIOUS XREF RECORD FOR THIS SYMBOL (OR 00 00)
;   BYTES 2-3: SOURCE LINE NUMBER WHERE THIS SYMBOL WAS REFERENCED
;
; THE ROUTINE REVERSES THIS LIST BY FOLLOWING IT TO THE EARLIEST RECORD,
; THEN PRINTS LINE NUMBERS FROM OLDEST TO NEWEST.
;
; WHEN THE LISTING COLUMN X REACHES OR EXCEEDS XRNUMCOLMAX, THE CURRENT
; LISTING LINE IS FLUSHED VIA FLUSH_LINE AND A NEW LINE IS STARTED WITH 16
; SPACES OF INDENTATION.
;
; ENTRY:  SYMTBLP -> SYMBOL HEAP ENTRY; X = CURRENT LISTING COLUMN
;         SYM_NM_OFF; EXP_BANK / BNKCTL REFLECT CURRENT BANK
; EXIT:   X UPDATED; SYMTBLP CLOBBERED; LISTING LINE(S) FLUSHED AS NEEDED
; ============================================================================
FMT_MAC_XR  LDA     #' '        ; PAD TO COLUMN 16 WITH SPACES
FOMAXR_PAD  STA     LIST_BUF,X
            INX
            CPX     #$10        ; REACHED COLUMN 16?
            BCC     FOMAXR_PAD

            ; LOCATE THE DEFINITION LINE NUMBER FIELD IN THE SYMBOL TABLE ENTRY
            LDA     SYM_NM_OFF  ; SYM_NM_OFF: OFFSET TO END-OF-NAME BYTE
            CLC
            ADC     #$06        ; SKIP TYPE(1) + VALUE_PTR(2) + REF_COUNT(1)
                                ;   + XREF_CHAIN_PTR(2) = 6 BYTES PAST NAME END
            TAY
            LDA     (SYMTBLP),Y ; DEFINITION LINE NUMBER (LO BYTE)
            STA     SYMVAL
            INY
            LDA     (SYMTBLP),Y ; DEFINITION LINE NUMBER (HI BYTE)
            STA     SYMVAL+1
            LDA     #$00
            STA     SYMVAL+2    ; ZERO-EXTEND TO 24 BITS FOR FMT_DEC_16

            ; ADVANCE SYMTBLP TO POINT AT THE XREF CHAIN LINK FIELD (4 BYTES
            ; BEFORE THE DEFINITION LINE NUMBER, SINCE DEFINITION = CHAIN + 4
            ; IN THE LAYOUT)
            INY
            TYA                 ; Y = OFFSET TO DEF LINE LO (SYM_NM_OFF+6)
            CLC
            ADC     SYMTBLP
            STA     SYMTBLP
            LDA     SYMTBLP+1
            ADC     #$00
            STA     SYMTBLP+1   ; SYMTBLP NOW -> BYTE SYM_NM_OFF+8 IN THE ENTRY

            JSR     FMT_DEC_16  ; WRITE DEFINITION LINE NUMBER

            LDA     #' '        ; SPACE AFTER DEFINITION LINE NUMBER
            STA     LIST_BUF,X
            INX

            ; POSITION SYMTBLP AT THE XREF CHAIN LINK FIELD (4 BYTES BACK)
            LDA     SYMTBLP
            SEC
            SBC     #$04
            STA     SYMTBLP
            LDA     SYMTBLP+1
            SBC     #$00
            STA     SYMTBLP+1   ; SYMTBLP -> XREF CHAIN LINK (2 BYTES)

            ; READ THE FIRST XREF CHAIN LINK (POINTER TO MOST-RECENT XREF
            ; RECORD)
            LDY     #$00
            LDA     (SYMTBLP),Y ; CHAIN LINK LO BYTE
            PHA
            INY
            LDA     (SYMTBLP),Y ; CHAIN LINK HI BYTE
            STA     SYMTBLP+1
            PLA
            STA     SYMTBLP     ; SYMTBLP -> MOST-RECENT XREF RECORD (OR 00 00)

            ORA     SYMTBLP+1   ; IS THE CHAIN EMPTY (00 00)?
            BNE     FOMAXR_CONT ; NO: FOLLOW THE CHAIN
            JMP     FOMAXR_DONE ; YES: NO XREF ENTRIES; DONE

            ; REVERSE THE XREF LINKED LIST IN PLACE (FORWARD-LINK WHILE
            ; PRINTING). THE LIST IS SINGLY-LINKED FROM NEWEST TO OLDEST; WE
            ; NEED TO WALK TO THE BEGINNING AND PRINT IN FORWARD ORDER.
FOMAXR_CONT LDA     #$00        ; SCRATCHP = 0 (WILL HOLD THE REVERSED 'NEXT'
                                ; PTR)
            STA     SCRATCHP
            STA     SCRATCHP+1

            .IF     NOT-KIM1
            ; SWITCH TO EXPANSION RAM BANK IF AVAILABLE
            BIT     EXP_BANK
            BPL     FOMAXR_WALK ; NO EXPANSION RAM: SKIP BANK SWITCH
            LDA     BNKCTL
            AND     #$FC        ; BANK 3
            ORA     BNK_CTL_BT  ; SELECT WORKING BANK
            STA     BNKCTL
            .ENDIF

            ; WALK BACKWARD THROUGH THE XREF CHAIN, REVERSING LINKS AS WE GO
FOMAXR_WALK LDA     SYMTBLP
            SEC
            SBC     #$04        ; STEP 4 BYTES BACK TO REACH THIS RECORD'S LINK
                                ; FIELD
            STA     SYMTBLP
            LDA     SYMTBLP+1
            SBC     #$00
            STA     SYMTBLP+1

            LDY     #$00
            LDA     (SYMTBLP),Y ; READ THE PREVIOUS-RECORD POINTER (LO)
            STA     SYMNAMP
            INY
            LDA     (SYMTBLP),Y ; PREVIOUS-RECORD POINTER (HI)
            STA     SYMNAMP+1

            ; OVERWRITE THE LINK FIELD WITH THE FORWARD POINTER
            ; (REVERSE THE LINK)
            LDA     SCRATCHP+1
            STA     (SYMTBLP),Y ; WRITE REVERSED LINK HI
            DEY
            LDA     SCRATCHP
            STA     (SYMTBLP),Y ; WRITE REVERSED LINK LO

            LDA     SYMNAMP     ; IS THE PREVIOUS-RECORD POINTER NON-NULL?
            ORA     SYMNAMP+1
            BEQ     FOM_PRINT   ; ZERO: REACHED THE END -> START PRINTING

            ; NOT YET AT START: CONTINUE REVERSING
            LDA     SYMTBLP
            STA     SCRATCHP    ; SCRATCHP = CURRENT RECORD (FOR NEXT
                                ; ITERATION)
            LDA     SYMTBLP+1
            STA     SCRATCHP+1
            LDA     SYMNAMP
            STA     SYMTBLP     ; SYMTBLP = PREVIOUS RECORD
            LDA     SYMNAMP+1
            STA     SYMTBLP+1
            JMP     FOMAXR_WALK ; CONTINUE TRAVERSAL

            ; SYMTBLP IS NOW THE FIRST (OLDEST) XREF RECORD;
            ; PRINT FROM HERE FORWARD
FOM_PRINT   LDY     #$02        ; OFFSET 2 WITHIN XREF RECORD = SOURCE LINE
                                ; NUMBER
            LDA     (SYMTBLP),Y ; LINE NUMBER LO BYTE
            STA     SYMVAL
            INY
            LDA     (SYMTBLP),Y ; LINE NUMBER HI BYTE
            STA     SYMVAL+1

            .IF     NOT-KIM1
            ; RESTORE RAM BANK (MAIN BANK 0) AFTER READING FROM EXPANSION RAM
            BIT     EXP_BANK
            BPL     FOM_FMT16
            LDA     BNKCTL
            AND     #$FC        ; MASK OUT OTHER BITS
            ORA     #$03        ; BANK 0 = MAIN DATA BANK
            STA     BNKCTL
            .ENDIF

FOM_FMT16   JSR     FMT_DEC_16  ; WRITE LINE NUMBER IN DECIMAL

            LDA     #' '        ; SPACE AFTER LINE NUMBER
            STA     LIST_BUF,X
            INX

            ; CHECK IF LISTING LINE IS FULL
            CPX     XRNUMCOLMAX ; COLUMN >= XRNUMCOLMAX?
            BCC     FOM_CON2    ; NO: CONTINUE ON THIS LINE

            ; FLUSH CURRENT LINE AND START A NEW INDENTED LINE
            TXA
            TAY
            JSR     FLUSH_LINE  ; FLUSH LISTING LINE
            LDX     #$01
            LDA     #' '
FOM_INDNT   STA     LIST_BUF,X  ; INDENT NEW LINE TO COLUMN 16
            INX
            CPX     #$10
            BCC     FOM_INDNT

            ; FOLLOW THE FORWARD-REVERSED LINK TO THE NEXT (MORE-RECENT)
            ; XREF RECORD
FOM_CON2    .IF     NOT-KIM1
            BIT     EXP_BANK
            BPL     FOM_CON3
            LDA     BNKCTL
            AND     #$FC        ; BANK 3
            ORA     BNK_CTL_BT  ; SWITCH TO EXPANSION RAM
            STA     BNKCTL
            .ENDIF

FOM_CON3    LDY     #$00
            LDA     (SYMTBLP),Y ; READ THE (NOW-REVERSED) FORWARD LINK LO BYTE
            INY
            ORA     (SYMTBLP),Y ; OR WITH HI BYTE: IS IT 00 00?
            BEQ     FOMAXR_DONE ; YES: LAST RECORD; DONE

            LDY     #$00
            LDA     (SYMTBLP),Y ; READ FORWARD LINK LO BYTE
            PHA
            INY
            LDA     (SYMTBLP),Y ; FORWARD LINK HI BYTE
            STA     SYMTBLP+1
            PLA
            STA     SYMTBLP     ; SYMTBLP -> NEXT XREF RECORD
            JMP     FOM_PRINT   ; PRINT NEXT LINE NUMBER

            ; ALL XREF RECORDS PRINTED; RESTORE MAIN BANK IF NEEDED
FOMAXR_DONE .IF     NOT-KIM1
            BIT     EXP_BANK
            BPL     FOM_CON4
            LDA     BNKCTL
            AND     #$FC        ; MASK OUT OTHER BITS
            ORA     #$03        ; RESTORE BANK 0
            STA     BNKCTL
            .ENDIF

            ; FLUSH THE FINAL LISTING LINE IF ANY CONTENT WAS WRITTEN PAST
            ; COLUMN 16
FOM_CON4    CPX     #$10        ; ONLY INDENTATION WRITTEN (COLUMN = 16)?
            BEQ     FOM_RETRN   ; YES: NOTHING TO FLUSH
            TXA
            TAY
            JSR     FLUSH_LINE  ; FLUSH THE LAST XREF LINE
FOM_RETRN   RTS

; ============================================================================
; FMT_DEC_16
;
; CONVERTS THE 16-BIT UNSIGNED VALUE IN SYMVAL/SYMVAL+1 TO A DECIMAL ASCII
; STRING AND WRITES IT INTO THE LISTING BUFFER AT LIST_BUF[X], ADVANCING X.
;
; ALGORITHM: SUCCESSIVE SUBTRACTION USING THE POWERS-OF-TEN TABLE AT POW_OF_10
; (ENTRIES: 10000, 1000, 100, 10).  FOR EACH POWER OF TEN, SUBTRACTS
; REPEATEDLY AND COUNTS, BUILDING EACH DECIMAL DIGIT.  THE UNITS DIGIT IS
; DERIVED FROM THE REMAINDER.
;
; LEADING ZEROS ARE SUPPRESSED FOR THE TEN-THOUSANDS DIGIT (THE FIRST
; SUBTRACTION LEVEL, Y=6) BY SKIPPING ITS OUTPUT WHEN THE COUNT REMAINS '0'.
; REMAINING DIGITS (THOUSANDS THROUGH UNITS) ARE ALWAYS EMITTED.
;
; ENTRY:  SYMVAL/SYMVAL+1 = 16-BIT VALUE (0..65535)
;         X = WRITE INDEX INTO LIST_BUF[]
;         Y = CALLER'S Y (SAVED IN FD1_Y_SAV AND RESTORED ON EXIT)
; EXIT:   LIST_BUF[X..] = DECIMAL DIGIT CHARACTERS; X ADVANCED PAST THE DIGITS
;         SYMVAL/SYMVAL+1 CLOBBERED (REDUCED TO ZERO DURING COMPUTATION)
; ============================================================================
FMT_DEC_16  STY     FD1_Y_SAV       ; SAVE CALLER'S Y
            LDY     #$06            ; START AT THE HIGHEST POWER (10000, IDX 6)

FODE16_LOOP LDA     #'0'            ; CURRENT DIGIT STARTS AT '0'
            STA     DEC_DIGIT

            ; SUBTRACT THE CURRENT POWER OF TEN UNTIL THE VALUE GOES NEGATIVE
FOD_SUBST   LDA     SYMVAL
            SEC
            SBC     POW_OF_10,Y     ; SUBTRACT POWER[Y] (LO BYTE)
            STA     SYMVAL
            LDA     SYMVAL+1
            SBC     POW_OF_10+1,Y   ; SUBTRACT POWER[Y] (HI BYTE)
            STA     SYMVAL+1
            BCC     FODE16_UNDO     ; BORROW: SUBTRACTED TOO MANY TIMES
            INC     DEC_DIGIT       ; NO BORROW: INCREMENT DIGIT COUNT
            JMP     FOD_SUBST       ; SUBTRACT AGAIN

            ; UNDO THE LAST OVER-SUBTRACTION AND RESTORE SYMVAL TO THE
            ; REMAINDER
FODE16_UNDO LDA     SYMVAL
            ADC     POW_OF_10,Y     ; ADD BACK LO BYTE OF CURRENT POWER
            STA     SYMVAL
            LDA     SYMVAL+1
            ADC     POW_OF_10+1,Y   ; ADD BACK HI BYTE
            STA     SYMVAL+1

            ; WRITE DIGIT TO LISTING BUFFER (SUPPRESS LEADING ZERO FOR
            ; TEN-THOUSANDS)
            CPY     #$06            ; FIRST (MOST-SIGNIFICANT) DIGIT?
            BEQ     FODE16_SKIP     ; YES: SUPPRESS IF '0' (LEADING ZERO)
            LDA     DEC_DIGIT       ; LOAD COMPUTED ASCII DIGIT
            STA     LIST_BUF,X      ; WRITE TO LISTING BUFFER
            INX

FODE16_SKIP DEY                     ; MOVE TO NEXT LOWER POWER OF TEN
            DEY                     ; (TABLE ENTRIES ARE .WORD, 2 BYTES APART)
            BPL     FODE16_LOOP     ; Y >= 0: CONTINUE

            ; WRITE THE UNITS DIGIT (REMAINDER IN SYMVAL, 0..9)
            LDA     SYMVAL
            CLC
            ADC     #'0'            ; CONVERT REMAINDER TO ASCII
            STA     LIST_BUF,X
            INX
            LDY     FD1_Y_SAV       ; RESTORE CALLER'S Y
            RTS

; ============================================================================
; POWERS-OF-TEN TABLE
;
; FOUR 16-BIT LITTLE-ENDIAN ENTRIES USED BY FMT_DEC_16 FOR SUCCESSIVE-
; SUBTRACTION DECIMAL CONVERSION.  INDEXED WITH Y = 0, 2, 4, 6 (LO/HI PAIRS).
;
;   Y=0: $000A =    10
;   Y=2: $0064 =   100
;   Y=4: $03E8 = 1,000
;   Y=6: $2710 = 10,000
; ============================================================================
POW_OF_10   .WORD   $000A               ; 10
            .WORD   $0064               ; 100
            .WORD   $03E8               ; 1,000
            .WORD   $2710               ; 10,000

; ============================================================================
; INSTRUCTION SIZE TABLE
;
; 13-ENTRY BYTE TABLE INDEXED BY ADDR_MODE (0-12), GIVING THE TOTAL BYTE
; COUNT (OPCODE + OPERAND BYTES) FOR EACH 6502 ADDRESSING MODE.  USED BY
; HAN_DIREC TO ADVANCE LOCCNT BY THE CORRECT AMOUNT WHEN
; PROCESSING INSTRUCTIONS OR DIRECTIVE OPERANDS.
;
; INDEX  ADDRESSING MODE                          SIZE
;   0    ACCUMULATOR / IMPLIED                      1
;   1    IMMEDIATE            (#EXPR)               2
;   2    ZERO-PAGE / ABSOLUTE (EXPR)                2
;   3    ZERO-PAGE,X          (EXPR,X) ZP           2
;   4    ZERO-PAGE,Y          (EXPR,Y) ZP           2
;   5    INDEXED-INDIRECT X   ((EXPR,X))            2
;   6    INDIRECT-INDEXED Y   ((EXPR),Y)            2
;   7    ABSOLUTE             (EXPR)   ABS          3
;   8    ABSOLUTE,X           (EXPR,X) ABS          3
;   9    ABSOLUTE,Y           (EXPR,Y) ABS          3
;  10    PURE INDIRECT        ((EXPR))              3
;  11    (DIRECTIVE-INTERNAL, EQU / LABEL RECORD)   1
;  12    (DIRECTIVE-INTERNAL, TWO-BYTE DIRECTIVE)   2
; ============================================================================
INST_SIZE   .BYTE   $01         ; 0  - ACCUMULATOR / IMPLIED
            .BYTE   $02         ; 1  - IMMEDIATE
            .BYTE   $02         ; 2  - ZERO-PAGE OR ABSOLUTE (RESOLVED LATER)
            .BYTE   $02         ; 3  - ZERO-PAGE,X
            .BYTE   $02         ; 4  - ZERO-PAGE,Y
            .BYTE   $02         ; 5  - (ZP,X)
            .BYTE   $02         ; 6  - (ZP),Y
            .BYTE   $03         ; 7  - ABSOLUTE
            .BYTE   $03         ; 8  - ABSOLUTE,X
            .BYTE   $03         ; 9  - ABSOLUTE,Y
            .BYTE   $03         ; 10 - PURE INDIRECT
            .BYTE   $01         ; 11 - DIRECTIVE-INTERNAL (1 BYTE)
            .BYTE   $02         ; 12 - DIRECTIVE-INTERNAL (2 BYTES)

; =============================================================================
; BSS SEGMENT - UNINITIALISED BUFFERS
;
; LAID OUT AT FIXED OFFSETS ABOVE THE CODE IMAGE.  ALL REGIONS ARE PAGE-ALIGNED
;
; $3400-$34FF  DDEFSBUF  : DIRECT-DEFINITIONS BUFFER (COMMAND-LINE '==' TEXT)
; $3500-$35FF  OBJCOBUF  : OBJECT-CODE OUTPUT BUFFER (256 BYTES; FLUSHED PER
;                          FULL PAGE)
; $3600-$39FF  SRCPRBUF  : SOURCE PROGRAM READ BUFFER (1 KB)
; $3A00-$3EFF  LSTNGBUF  : LISTING OUTPUT ACCUMULATION BUFFER (1.25 KB)
; $3F00-$ABFF  (HEAP)    : SYMBOL TABLE PRIMARY HEAP - NAMES, VALUES, XREF
;                          RECORDS
; =============================================================================

            *=  BSS

DDEFSBUF    *=*+    $100        ; DIRECT-DEFINITIONS TEXT BUFFER (256 BYTES)
OBJCOBUF    *=*+    $100        ; OBJECT-CODE OUTPUT BUFFER (256 BYTES)
SRCPRBUF    *=*+    $400        ; SOURCE PROGRAM READ BUFFER (1 KB)
LSTNGBUF    *=*+    $500        ; LISTING OUTPUT ACCUMULATION BUFFER (1.25 KB)

; =============================================================================
; BSS2 SEGMENT - SYMBOL TABLE HASH TABLE AND MACRO ARGUMENT STACK
;
; $AC00-$BBFF  SYMHASHT : OPEN-ADDRESS HASH TABLE (4 KB; 2048 TWO-BYTE BUCKETS)
;                         EACH BUCKET HOLDS A 16-BIT POINTER INTO THE PRIMARY
;                         HEAP (HEAPST..HEAPEND) FOR THE CORRESPONDING SYMBOL
;                         ENTRY. SIZE IS CONTROLLED BY HASHSIZEC
;                         ($0F MASK = 4 K BUCKETS).
; $BC00-$BDFF  MACSTACK : MACRO INVOCATION ARGUMENT STACK (512 BYTES)
;                         GROWS UPWARD; MARGWRTP IS THE WRITE POINTER,
;                         MARGSTRP IS THE READ POINTER, MACSPTR TRACKS
;                         THE CURRENT FRAME BASE.
; =============================================================================

            *=  BSS2

SYMHASHT    *=*+    $1000       ; SYMBOL TABLE HASH TABLE (4 KB, 2 048 BUCKETS)
MACSTACK    *=*+    $200        ; MACRO INVOCATION ARGUMENT STACK (512 BYTES)

            .IF     NOT-KIM1

; =============================================================================
; BSS3 SEGMENT - SECONDARY HEAP (EXPANSION RAM, BANK 3)
;
; $0000-$FEFF (IN BANK 3) SCNDHEAP : SECONDARY HEAP FOR MACRO BODY TEXT,
;                                    CROSS-REFERENCE RECORDS, AND SYMBOL NAMES
;                                    WHEN EXP RAM IS DETECTED BY PROBE_MEM.
;                                    HEAP2WRP AND HEAP2PRP MANAGE WRITE/READ
;                                    POINTERS. EXP_BANK BIT 7 GATES ALL ACCESS.
; =============================================================================

            .BANK   3
            *=  BSS3

SCNDHEAP    *=*+    $FF00       ; SECONDARY HEAP IN EXPANSION RAM (~= 64 KB)
            .BANK   0
            
            .ENDIF

            *=  DATA

; =============================================================================
; MNEMONIC / OPCODE TABLE  (TABLE, .DATA SEGMENT)
;
; A LINEAR ARRAY OF VARIABLE-LENGTH ENTRIES TERMINATED BY A $00 BYTE.
; LOADED AT A SEPARATE ADDRESS (TABLE) FROM THE CODE SEGMENT.
; THE TABLE IS SEARCHED BY LKP_OPCODE VIA THE HASH TABLE (WHICH
; IS INITIALISED FROM THIS TABLE BY INIT_SYMTBL AT STARTUP).
;
; ENTRY TYPES AND THEIR LAYOUTS:
;
; TYPE $F8 - MULTI-MODE 6502 INSTRUCTION (SUPPORTS SEVERAL ADDRESSING MODES):
;   .BYTE  LENGTH          ; TOTAL ENTRY LENGTH IN BYTES (ALWAYS $13 = 19)
;   .BYTE  'MNEM*'         ; 4-CHAR MNEMONIC + '*' TERMINATOR
;   .BYTE  $F8             ; TYPE BYTE
;   .WORD  $0000           ; HANDLER ADDRESS (UNUSED FOR INSTRUCTIONS; $0000)
;   .BYTE  OP_ACC          ; OPCODE FOR ACCUMULATOR MODE ($FF = NOT AVAILABLE)
;   .BYTE  OP_IMM          ; OPCODE FOR IMMEDIATE MODE
;   .BYTE  OP_ZP           ; OPCODE FOR ZERO-PAGE MODE
;   .BYTE  OP_ZPX          ; OPCODE FOR ZERO-PAGE,X MODE
;   .BYTE  OP_ZPY          ; OPCODE FOR ZERO-PAGE,Y MODE
;   .BYTE  OP_INDX         ; OPCODE FOR (ZP,X) MODE
;   .BYTE  OP_INDY         ; OPCODE FOR (ZP),Y MODE
;   .BYTE  OP_ABS          ; OPCODE FOR ABSOLUTE MODE
;   .BYTE  OP_ABSX         ; OPCODE FOR ABSOLUTE,X MODE
;   .BYTE  OP_ABSY         ; OPCODE FOR ABSOLUTE,Y MODE
;   .BYTE  OP_IND          ; OPCODE FOR INDIRECT MODE
;
; TYPE $F4 - BRANCH INSTRUCTION (ALWAYS 2 BYTES: OPCODE + 8-BIT SIGNED OFFSET):
;   .BYTE  LENGTH          ; ALWAYS $09 = 9
;   .BYTE  'MNEM*'         ; 4-CHAR MNEMONIC + '*'
;   .BYTE  $F4             ; TYPE BYTE
;   .WORD  $0000           ; HANDLER ADDRESS (UNUSED)
;   .BYTE  OPCODE          ; SINGLE BRANCH OPCODE
;
; TYPE $F0 - IMPLIED / INHERENT INSTRUCTION (1 BYTE, NO OPERAND):
;   .BYTE  LENGTH          ; ALWAYS $09 = 9
;   .BYTE  'MNEM*'         ; 4-CHAR MNEMONIC + '*'
;   .BYTE  $F0             ; TYPE BYTE
;   .WORD  $0000           ; HANDLER ADDRESS (UNUSED)
;   .BYTE  OPCODE          ; SINGLE OPCODE BYTE
;
; TYPE $E8 - ASSEMBLER DIRECTIVE (PSEUDO-OP):
;   .BYTE  LENGTH          ; VARIABLE (NAME LENGTH + 4)
;   .BYTE  '.NAME*'        ; DIRECTIVE NAME + '*'
;   .BYTE  $E8             ; TYPE BYTE
;   .WORD  HANDLER         ; ADDRESS OF THE DIRECTIVE HANDLER ROUTINE
;
; .BYTE $00 ENDS THE TABLE.
;
; ALL MNEMONIC / DIRECTIVE NAMES ARE TERMINATED WITH THE '*' CHARACTER ($2A),
; WHICH LKP_OPCODE APPENDS TO THE IDENTIFIER BUFFER BEFORE HASH LOOKUP.
; =============================================================================

TABLE       .BYTE   $13         ; ENTRY LENGTH
            .BYTE   'ADC*'      ; MNEMONIC
            .BYTE   $F8         ; TYPE: MULTI-MODE INSTRUCTION
            .WORD   $0000       ; HANDLER (UNUSED)
            .BYTE   $FF         ; ACCUMULATOR (NOT AVAILABLE)
            .BYTE   $69         ; IMMEDIATE
            .BYTE   $65         ; ZERO-PAGE
            .BYTE   $75         ; ZERO-PAGE,X
            .BYTE   $FF         ; ZERO-PAGE,Y (NOT AVAILABLE)
            .BYTE   $61         ; (ZP,X)
            .BYTE   $71         ; (ZP),Y
            .BYTE   $6D         ; ABSOLUTE
            .BYTE   $7D         ; ABSOLUTE,X
            .BYTE   $79         ; ABSOLUTE,Y
            .BYTE   $FF         ; INDIRECT (NOT AVAILABLE)

            .BYTE   $13
            .BYTE   'AND*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $29
            .BYTE   $25
            .BYTE   $35
            .BYTE   $FF
            .BYTE   $21
            .BYTE   $31
            .BYTE   $2D
            .BYTE   $3D
            .BYTE   $39
            .BYTE   $FF

            .BYTE   $13
            .BYTE   'ASL*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $0A         ; ACCUMULATOR
            .BYTE   $FF
            .BYTE   $06
            .BYTE   $16
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $0E
            .BYTE   $1E
            .BYTE   $FF
            .BYTE   $FF

            .BYTE   $09         ; ENTRY LENGTH
            .BYTE   'BCC*'      ; BRANCH IF CARRY CLEAR
            .BYTE   $F4         ; TYPE: BRANCH INSTRUCTION
            .WORD   $0000
            .BYTE   $90         ; OPCODE

            .BYTE   $09
            .BYTE   'BLT*'      ; BRANCH IF LESS THAN (ALIAS FOR BCC)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $90

            .BYTE   $09
            .BYTE   'BCS*'      ; BRANCH IF CARRY SET
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $B0

            .BYTE   $09
            .BYTE   'BGE*'      ; BRANCH IF GREATER OR EQUAL (ALIAS FOR BCS)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $B0

            .BYTE   $09
            .BYTE   'BEQ*'      ; BRANCH IF EQUAL (Z=1)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $F0

            .BYTE   $13
            .BYTE   'BIT*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $FF         ; IMMEDIATE (NOT AVAILABLE)
            .BYTE   $24         ; ZERO-PAGE
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $2C         ; ABSOLUTE
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF

            .BYTE   $09
            .BYTE   'BMI*'      ; BRANCH IF MINUS (N=1)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $30

            .BYTE   $09
            .BYTE   'BNE*'      ; BRANCH IF NOT EQUAL (Z=0)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $D0

            .BYTE   $09
            .BYTE   'BPL*'      ; BRANCH IF PLUS (N=0)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $10

            .BYTE   $09         ; ENTRY LENGTH
            .BYTE   'BRK*'      ; SOFTWARE INTERRUPT
            .BYTE   $F0         ; TYPE: IMPLIED INSTRUCTION
            .WORD   $0000
            .BYTE   $00         ; OPCODE

            .BYTE   $09
            .BYTE   'BVC*'      ; BRANCH IF OVERFLOW CLEAR (V=0)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $50

            .BYTE   $09
            .BYTE   'BVS*'      ; BRANCH IF OVERFLOW SET (V=1)
            .BYTE   $F4
            .WORD   $0000
            .BYTE   $70

            .BYTE   $09
            .BYTE   'CLC*'      ; CLEAR CARRY
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $18

            .BYTE   $09
            .BYTE   'CLD*'      ; CLEAR DECIMAL MODE
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $D8

            .BYTE   $09
            .BYTE   'CLI*'      ; CLEAR INTERRUPT DISABLE
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $58

            .BYTE   $09
            .BYTE   'CLV*'      ; CLEAR OVERFLOW
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $B8

            .BYTE   $13
            .BYTE   'CMP*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $C9
            .BYTE   $C5
            .BYTE   $D5
            .BYTE   $FF
            .BYTE   $C1
            .BYTE   $D1
            .BYTE   $CD
            .BYTE   $DD
            .BYTE   $D9
            .BYTE   $FF

            .BYTE   $13
            .BYTE   'CPX*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $E0         ; IMMEDIATE
            .BYTE   $E4         ; ZERO-PAGE
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $EC         ; ABSOLUTE
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF

            .BYTE   $13
            .BYTE   'CPY*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $C0
            .BYTE   $C4
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $CC
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF

            .BYTE   $13
            .BYTE   'DEC*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $C6
            .BYTE   $D6
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $CE
            .BYTE   $DE
            .BYTE   $FF
            .BYTE   $FF

            .BYTE   $09
            .BYTE   'DEX*'      ; DECREMENT X
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $CA

            .BYTE   $09
            .BYTE   'DEY*'      ; DECREMENT Y
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $88

            .BYTE   $13
            .BYTE   'EOR*'      ; EXCLUSIVE OR
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $49
            .BYTE   $45
            .BYTE   $55
            .BYTE   $FF
            .BYTE   $41
            .BYTE   $51
            .BYTE   $4D
            .BYTE   $5D
            .BYTE   $59
            .BYTE   $FF

            .BYTE   $13
            .BYTE   'INC*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $E6
            .BYTE   $F6
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $EE
            .BYTE   $FE
            .BYTE   $FF
            .BYTE   $FF

            .BYTE   $09
            .BYTE   'INX*'      ; INCREMENT X
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $E8

            .BYTE   $09
            .BYTE   'INY*'      ; INCREMENT Y
            .BYTE   $F0
            .WORD   $0000
            .BYTE   $C8

            .BYTE   $13
            .BYTE   'JMP*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $4C         ; ABSOLUTE
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $6C         ; INDIRECT

            .BYTE   $13
            .BYTE   'JSR*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $20         ; ABSOLUTE ONLY
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $FF

            .BYTE   $13
            .BYTE   'LDA*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $A9
            .BYTE   $A5
            .BYTE   $B5
            .BYTE   $FF
            .BYTE   $A1
            .BYTE   $B1
            .BYTE   $AD
            .BYTE   $BD
            .BYTE   $B9
            .BYTE   $FF

            .BYTE   $13
            .BYTE   'LDX*'
            .BYTE   $F8
            .WORD   $0000
            .BYTE   $FF
            .BYTE   $A2
            .BYTE   $A6
            .BYTE   $FF
            .BYTE   $B6         ; ZERO-PAGE,Y (LDX HAS Y-INDEXED ZP AND ABS)
            .BYTE   $FF
            .BYTE   $FF
            .BYTE   $AE
            .BYTE   $FF
